      {
        tag: "event",
        id: "ev_17",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22role%22%3A%22Rocky%20Horror%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
              },
            ],
          },
          {
            tag: "message",
            text: _("Ha! They’re destroyed at last."),
          },
          {
            tag: "message",
            speaker: "Garak",
            text: _("Thanks for the help. I am glad to see that so many have survived the night. But there’s no time to talk, we must save the rest of our people and crush these earthen abominations."),
          },
        ],
      },
      {
        tag: "event",
        id: "on_undo_19",
        on: "on_undo",
        once: false,
      },
      {
        tag: "event",
        id: "ev_18",
        on: "moveto",
        once: false,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "23-25",
            y: "28-34",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "bridge_event",
                equals: "",
              },
              {
                tag: "variable",
                name: "found_zhul",
                equals: "",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("This bridge leads to the holy island at the center of our lake."),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("Hmmmm. Some of the druids that worship on the island may still be alive. We should go check."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Be careful. The bridge is broken, so we’ll have to wade through the shallow water."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "bridge_event",
            value: "warned",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_21",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "23-25",
            y: "28-31",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
