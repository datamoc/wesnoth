                tag: "variable",
                name: "rescued_elves",
                equals: 5,
              },
            ],
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("We’ve explored the village, and I think we’ve rescued the last of the survivors."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "if_39",
