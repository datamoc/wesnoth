            variable: "seen_mudcrawler",
            value: "yes",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Vecnu",
            text: _("Kaleh, Nym, help us!"),
          },
          {
            tag: "message",
            speaker: "Nym",
            portrait: "portraits/nym_moody.webp",
            text: _("What in Uria’s name is that?"),
          },
          {
            tag: "message",
            speaker: "Vecnu",
            text: _("They came with the stones that fell from the sky. I know not what they are, but more seem to be emerging from the craters. If we don’t stop them there will be nothing left of our village or our people."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("To battle, my friends! There are still those left who can fight."),
          },
        ],
      },
