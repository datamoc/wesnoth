      {
        tag: "event",
        id: "ev_27",
        on: "stable_found",
        once: true,
        children: [
          {
            tag: "message",
            text: _("Hey, Nisen, the rocks have stopped falling. You can come out now!"),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "rescued_elves",
            value: 1,
            mode: "add",
          },
          {
            tag: "message",
            speaker: "Nisen",
            text: _("Oh, thank Eloh, I thought they would never stop."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_26",
        on: "stable_found",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Naru",
            text: _("Is it safe to come out? I was so scared."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Where are all the other dustboks?"),
          },
          {
            tag: "message",
            speaker: "Naru",
            text: _("A hunting party left just yesterday, so unless the rocks fell all over the land, many of the dustboks have probably survived. The few that remained here were scared by the falling rocks and fled into the night. It took all my skill to calm Yasi and keep him from running."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("We’ll need your help in checking to see if the outer settlements survived. Who knows what kinds of damage they suffered in the night? And perhaps some of the people out in the desert have been able to round up some of the loose dusties."),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("We can only hope that hunting party returns soon."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_28",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "outer_villages",
            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22variable%22%3A%22outer_villages%22%2C%22terrain%22%3A%22*%5EVdt%2C*%5EVda%2C*%5EVdr%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22x%22%3A%2232-50%22%2C%22y%22%3A%221-12%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22x%22%3A%2213-37%22%2C%22y%22%3A%2220-34%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "total_elf_pool_gold_value",
            value: "$outer_villages.length",
            mode: "multiply",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "total_elf_pool_gold_value",
            value: "$elf_pool.length",
            mode: "divide",
          },
        ],
      },
      {
        tag: "event",
        id: "if_31",
        on: "branch_if_31",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "fate",
            less_than_or_equal_to: "$($max_fate|*0.5 - $luckiness|)",
          },
          {
            tag: "hook",
            name: "command:set_variable_rand",
            variable: "random_elf_pool_index",
            values: "1..$elf_pool.length",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "random_elf_pool_index",
            value: 1,
            mode: "sub",
          },
          {
            tag: "hook",
            name: "command:spawn_dynamic",
            type: "$elf_pool[$random_elf_pool_index].type",
            side: 1,
            x: "$x1",
            y: "$y1",
          },
          {
            tag: "hook",
            name: "command:store_unit_type",
            variable: "utbs_unit_type",
            types: "$elf_pool[$random_elf_pool_index].type",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "current_elf_pool_gold_value_received",
            value: "$utbs_unit_type.cost",
            mode: "add",
          },
          {
            tag: "message",
            text: _("Oh good, some elves have survived in this outer settlement. They’ve agreed to help us search for other survivors."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_32",
        on: "branch_if_32",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "fate",
            greater_than: "$($max_fate|*0.5 - $luckiness|)",
          },
          {
            tag: "message",
            text: _("The encampment is empty. I wonder what happened to the inhabitants?"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_30",
        on: "branch_if_30",
        once: true,
        children: [
          {
            tag: "condition",
            condition: "hook",
            hook: "predicate:variable_compare",
            variable: "village_at_$x1|_$y1|.captured_by",
            not_equals: "undead",
          },
          {
            tag: "set_variable",
            name: "max_fate",
            value: 30,
          },
          {
            tag: "hook",
            name: "command:set_variable_rand",
            variable: "fate",
            values: "1..$max_fate",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "expected_elf_pool_gold_value",
            value: "$($total_elf_pool_gold_value|*$seen_camps|/$outer_villages.length|)",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "luckiness",
            value: "$($current_elf_pool_gold_value_received - $expected_elf_pool_gold_value)",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "seen_camps",
            value: 1,
            mode: "add",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_31",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_32",
          },
        ],
      },
      {
        tag: "event",
        id: "if_33",
        on: "branch_if_33",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "village_at_$x1|_$y1|.captured_by",
            equals: "undead",
          },
          {
            tag: "message",
            text: _("This encampment has been abandoned. There are signs of a struggle and a few bloodstains but nothing else. I fear for those elves who lived out here."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_29",
        on: "capture",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_capturer_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22find_in%22%3A%22outer_villages%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "variable_compare",
