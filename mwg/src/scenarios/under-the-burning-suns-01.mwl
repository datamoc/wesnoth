            ],
          },
          {
            tag: "spawn",
            id: "u_14",
            type: "Cuttle Fish",
            side: 2,
            x: 25,
            y: 29,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_14",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("The water of the lake suddenly goes dark and unsettled, only to erupt in a swarm of tentacles the moment the first elf set foot off the island."),
          },
          {
            tag: "message",
            speaker: "Nym",
            portrait: "portraits/nym_moody.webp",
            text: _("What in Uria’s name is that?"),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("I felt a great darkness in this lake, but I knew not what it was. The falling rocks must have woken it from its sleep."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Protect the priestesses, we shall send this monstrosity back to the depths it came from!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "23-25",
            y: "26-28",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "rescued_elves",
            value: 1,
            mode: "add",
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("The great tree! It has been buried under the rocks. Our most holy sanctuary, defiled. Oh, Eloh, what shall we do?"),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("Is anyone still alive?"),
          },
          {
            tag: "spawn",
            id: "Zhul",
            type: "Quenoth Shaman",
            side: 1,
            x: 24,
            y: 26,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Zhul",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Zhul",
          },
          {
            tag: "spawn",
            id: "Ryoko",
            type: "Quenoth Mystic",
            side: 1,
            x: 25,
            y: 26,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Ryoko",
          },
          {
            tag: "spawn",
            id: "Yuni",
            type: "Quenoth Mystic",
            side: 1,
            x: 23,
            y: 26,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Yuni",
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("Finally! We were worried that no one else had survived."),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("Mother priestess, are you all right?"),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("There’s no time to stand on ceremony. I’m fine. I’m afraid only a few of us survived, but we will lend you what skills we have. Show me to those who need healing."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("But the great tree, it has been destroyed!"),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("All things of this world come to an end, but the power of Eloh endures. A new one shall grow in its place. Come now, let us see to the needs of our people."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "found_zhul",
            value: "yes",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:show_objectives",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_22",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "30-37",
            y: "25-32",
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("These fields seem strangely vacant. Where are the dustboks?"),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("Maybe they’re hiding in the stables. Let’s go check."),
          },
        ],
      },
