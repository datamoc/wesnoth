        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: _("story/frontier.webp"),
            text: _("Speaking of sense, I gots me a bad feeling in my gut about today. I’d better ready our hunting troop when I get back to the village, just in case..."),
          },
        ],
