          },
          {
            tag: "message",
            speaker: "Tarwen",
            text: _("By order of the Queen, the magistrate of this town is to travel with us to Elensefar for vetting."),
          },
          {
            tag: "message",
            speaker: "Baldras",
            text: _("The Crown did long since abandon our village. You Wesnothians be too busy countin’ the gold from our taxes to be sending aid against them orcs. Nobody here be leaving to nowhere."),
          },
          {
            tag: "message",
            speaker: "Tarwen",
            text: _("Insolent peasant. Try not my patience, else I shall be forced to drag thy deceased corpse back with me to the city."),
          },
          {
            tag: "message",
            speaker: "Baldras",
            text: _("Try it then, stinker."),
          },
          {
            tag: "message",
            speaker: "Tarwen",
            text: _("As you wish."),
          },
