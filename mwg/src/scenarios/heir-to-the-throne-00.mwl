            tag: "condition",
            variable: "bm_s30_victory",
            equals: "coward",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Lisar",
            x: 74,
            y: 36,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("A traitor? This is the Sceptre of Fire, symbol of the kings of Wesnoth, and I return after claiming it at great cost from the caverns of the north."),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("You know that Asheviere has proven a poor ruler. You know that I have been a just general. And now I hold the Sceptre, not my mother. Stand aside or die, soldier."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_1362",
        on: "branch_if_1362",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_s30_victory",
            not_equals: "coward",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Konrad",
            x: 74,
            y: 36,
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Leave my cousin out of this. You know who I am. And now you see I hold the Sceptre."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("You have heard lies about my war from Asheviere — now hear the truth. This land is suffering. I know it, you know it, even Li’sar knows it; Asheviere’s own daughter driven to revolt."),
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Konrad%22%7D%2C%22children%22%3A%5B%5D%7D",
