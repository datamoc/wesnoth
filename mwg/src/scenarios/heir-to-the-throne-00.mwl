          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mentoring.webp",
            text: _("Be cautious, Konrad. We approach the Whitefang mountains, home to a vast orcish clan of the same name. They are allies of Asheviere’s, and powerful enemies of ours."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mentoring.webp",
            text: _("Even the great armies of yesteryear lacked the strength to defeat them in their home. We should do our best to slip quietly past."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-mad.webp",
            text: _("Your warning comes too late, Delfador. One of their leaders has already spotted us!"),
          },
