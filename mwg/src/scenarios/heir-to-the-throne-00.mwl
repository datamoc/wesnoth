                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Then it shall be done. I depart for the Heart Mountains at once."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("You’re leaving just like that? We’ve hardly had a moment of peace together since the Aethenwood!"),
