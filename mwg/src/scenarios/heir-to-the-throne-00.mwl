          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Konrad",
                text: _("An unsavory idea indeed. Razing the region’s farms might be sound military strategy, but I am not enthused about the prospect. Of course, Weldyn will surely pose a frighteningly difficult challenge if we do not..."),
              },
              {
                tag: "choice",
                text: _(""),
                event: "ev_1507_opt0",
              },
              {
                tag: "choice",
                text: _(""),
                event: "ev_1507_opt1",
              },
            ],
          },
        ],
