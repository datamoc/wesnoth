      {
        tag: "event",
        id: "if_1116",
        on: "branch_if_1116",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_s29_dwarves_suspicious",
            equals: "yes",
          },
          {
            tag: "message",
            speaker: "Geldar",
            text: _("What now, human? I already told ye, no-one gets in without someone to vouch for ’em."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_1117",
        on: "branch_if_1117",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_s29_dwarves_suspicious",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Geldar",
            text: _("Another attack! Up axes, and make ready to repel the invaders!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Peace, dwarves of Knalga! I am a man of Wesnoth, not an orc or a troll, and I come as a friend."),
          },
          {
            tag: "message",
            speaker: "Geldar",
            text: _("A man? Haven’t seen many o’ yer kind since our friends at the Doors fell, an’ you ain’t one o’ their’s. Who says we should trust ye?"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_1118",
        on: "branch_if_1118",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_s29_dwarves_suspicious",
            not_equals: "yes",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Konrad",
            x: 51,
            y: 11,
          },
          {
            tag: "message",
            speaker: "Relgorn",
            text: _("What brings you to th’ East Gate o’ Knalga, friends? You be wantin’ somethin’ from us, don’t you?"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Well, to be honest, people usually want something from <i><b>me</b></i> instead. I help with a problem someone is having, and then they send some spare fighters to join my army. Can you and I arrange anything like that?"),
          },
          {
            tag: "message",
            speaker: "Geldar",
            text: _("Spare fighters? I ain’t heard a jest that good since th’ trolls got Durrasil! Yer walkin’ through the corpse o’ our empire, fallen to rot an’ ruin, an’ ye got the gall to ask if we have extra axe-arms to send out with ye?"),
          },
          {
            tag: "message",
            speaker: "Relgorn",
            text: _("I’m afraid Geldar’s right. But problems — now problems we’ve got plenty of. Orc attacks, troll attacks, undead attacks. ’an now down in th’ mines—"),
          },
          {
            tag: "message",
            speaker: "Geldar",
            text: _("Relgorn, hush. That ain’t somethin’ fer outsiders to hear about."),
          },
          {
            tag: "message",
            speaker: "Relgorn",
            text: _("Do ye got a better idea? We already tried t’ split ourselves up an’ help, an’ tha’s when trolls took the gatehouse!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Relgorn",
            text: _("Listen, human... I’m only trustin’ you ’cause you been vouched for, unnerstand? All ye need to know is that some o’ our people’re trapped in a cave-in down in th’ old mines. You get ’em out, we’ll make it worth yer while."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "skip_moveto_dialogue",
            value: "yes",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "previous_x",
            value: "$x2",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "previous_y",
            value: "$y2",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "preview_poi_s29",
          },
        ],
      },
