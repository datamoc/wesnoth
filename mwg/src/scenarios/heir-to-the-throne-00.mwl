            object: "%7B%22id%22%3A%22konrad_sceptre%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:remove_object",
            object_id: "konrad_sceptre",
            id: "Konrad",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Together the princess and I have claimed the Sceptre of Fire, the staff of kings. In Haldric’s hands, it was our salvation from the Lich Lords. In mine, it shall save you and I both from the terror that is Asheviere. You will let us pass."),
          },
        ],
      },
