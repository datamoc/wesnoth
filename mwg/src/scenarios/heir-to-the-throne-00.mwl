      {
        tag: "event",
        id: "if_489",
        on: "branch_if_489",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_explained_port",
            equals: "$null",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("This port has many small boats for us to use! I won’t be able to travel through deep water, but I can certainly reach the coastal islands and reef."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "water.wav",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "bm_explained_port",
            value: "yes",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_490",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Konrad%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22W*%5E*%2CChw%5E*%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "disembark_konrad",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_491",
        on: "victory",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "disembark_konrad",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_492",
        on: "disembark_konrad",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_skiff",
            kill: "yes",
            id: "Konrad",
            type: "Skiff",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_embark_konrad",
            x: "$stored_skiff.x",
            y: "$stored_skiff.y",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_488",
        on: "moveto",
        once: false,
        children: [
          {
            tag: "filter",
            x: 4,
            y: 30,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
