      {
        tag: "event",
        id: "ev_251",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22x%22%3A%2223%22%2C%22y%22%3A%2236%22%2C%22radius%22%3A%223%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "aldril_woodsman",
            text: _("Don’ mind me. I’m jus’ a woodsman keeping ’is head down."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-glad.webp",
            text: _("Asheviere is an evil queen, woodsman. This is a time for action — join me and help fight for liberty and justice!"),
          },
          {
            tag: "message",
            speaker: "aldril_woodsman",
            text: _("She’s supposin’ to be the evil one, but here you are asking me to fight and die. Funny, that. If you’ll excuse me, it’s huntin’ season and I have a family to feed."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Konrad",
            x: 22,
            y: 37,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Konrad",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "ne",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "aldril_woodsman",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("Please? They say there’s more magic in one kind word than in all of Delfador’s enchantments put together."),
          },
          {
            tag: "message",
            speaker: "aldril_woodsman",
            text: _("Get lost."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "aldril_woodsman",
            text: _("... okay, fine, here’s a few pieces from the town treasury. Go spend ’em on drink or girls or whatever you soldiers do."),
          },
          {
            tag: "gold",
            side: 1,
            amount: 8,
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("You have gained 8 gold!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "aldril_woodsman",
            x: 26,
            y: 34,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "aldril_woodsman",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("If the people all banded together, they could easily depose Asheviere and make life better for everyone. But most just keep quietly to themselves... I guess I can’t blame them."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Maybe that’s what’s so important about being the heir — hope, and a symbol people can rally behind."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "bm_approached_aldril",
            value: "yes",
            mode: "value",
          },
        ],
      },
