      {
        tag: "event",
        id: "if_735",
        on: "branch_if_735",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_merle_recruited",
            not_equals: "visited",
          },
          {
            tag: "message",
            speaker: "Merle",
            text: _("Hullo, stranger. What brings you to these forsaken parts?"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("I am Konrad, son of Arand and heir to Garard’s throne! I’m on a quest to depose the evil queen Asheviere!"),
          },
          {
            tag: "message",
            speaker: "Merle",
            text: _("Here in the Dulatus, we don’ want no queen. Don’ much want no prince or king neither, though."),
          },
          {
            tag: "message",
            speaker: "Merle",
            text: _("Once, these hills was rich with gold, an’ granite. King Garard took most o’ it to pay fer his wars, an’ his bride Asheviere took the rest. Now we’ve got nothin’ but empty mines an’ dusty vaults."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("I’m sorry for your misfortunes, friend. Perhaps we can work together for the benefit of us both."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("You have the facilities to store things of value, and we sometimes have more gold and supplies than we wish to carry with us on our march. If you store and guard our excess gold for us now, once I overthrow Asheviere and assume the throne I will be happy to help revitalize the Dulatus."),
          },
          {
            tag: "message",
            speaker: "Merle",
            text: _("Hmm... I suppose we’ve got nothin’ else to do. You’re not worried we’re gonna steal it, or sell ye out to the queen?"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("You yourself said that you have no love for Asheviere. I am no fool ready to squander my earnings, but I would rather take a risk and make a friend than live my life in distrust."),
          },
          {
            tag: "message",
            speaker: "Merle",
            text: _("Alright, kid. It’s a deal. We’ll hang onto your extra gold, free of charge."),
          },
          {
            tag: "set_variable",
            name: "bm_merle_stored_gold",
            value: 0,
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "bm_merle_recruited",
            value: "visited",
            mode: "value",
          },
        ],
      },
