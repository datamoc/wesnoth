            raw: "yes",
          },
          {
            tag: "message",
            speaker: "Faghmok",
            text: _("Peace, pinkski— humans! Hah, don’t you look scared to see me. You must be the great Prince Konrad!"),
          },
          {
            tag: "message",
            speaker: "Faghmok",
            text: _("I am Fagh-mok the Honorable, honest warrior of the chief’s guard. The nasty queen Asheviere told us all sorts of things about you, prince. But I’m sure it’s all lies."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("You are no friend of the dark queen, then? Yet your clan fights alongside her as an ally."),
          },
          {
            tag: "message",
            speaker: "Faghmok",
            text: _("They have been misled! Our foolish chief dares to oppose you, oh mighty Konrad! But if there were to be a new chief... myself, for example..."),
          },
          {
            tag: "message",
            speaker: "Faghmok",
            text: _("..."),
          },
          {
            tag: "message",
            speaker: "Faghmok",
            text: _("If you’re interested, come meet me just outside our camp."),
          },
