      {
        tag: "event",
        id: "ev_1659",
        on: "start",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "bm_turns",
                equals: "$bm_milestone_scepter",
              },
              {
                tag: "variable",
                name: "status_s30",
                not_equals: "in_progress",
              },
              {
                tag: "variable",
                name: "status_s30",
                not_equals: "completed",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_1660",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_1661",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "familiar",
            x: 50,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "familiar",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_konrad",
