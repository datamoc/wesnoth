        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("After a long trek, Prince Haldric and his companions find themselves on a sunny beach. While normally this would be a pleasant occurrence, they find the saurians hard at work there."),
          },
          {
            tag: "message",
            speaker: "Ssirk",
            text: _("Monsters! We’re being invaded by monsters."),
          },
          {
            tag: "message",
            speaker: "Tirasch",
            text: _("We must hold the beach until we can call our naga friends."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            portrait: "portraits/haldric-mad.webp",
            text: _("Us, monsters? Hmph... prepare to meet our blades."),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("(<i>Sigh</i>) I bet he sees none of the irony in that."),
          },
        ],
