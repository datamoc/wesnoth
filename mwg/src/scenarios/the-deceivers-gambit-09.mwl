            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "$saurian_guide_id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "saurian_guide_name",
            value: "$STORE_UNIT_VAR_store.name",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("What ails you, $saurian_guide_name? I have trusted you thus far as a sign of good faith — please don’t make me regret that decision."),
          },
          {
            tag: "message",
            speaker: "$saurian_guide_id",
            text: _("Oh Great One, the other Great One livesss in thessse cold mountain sssnowsss. But it is dangerousss! I am eldessst of my tribe... near sssixteen years of age. Age hasss made me weak; too weak to travel thessse landsss without help."),
          },
          {
            tag: "message",
            speaker: "$saurian_guide_id",
            text: _("But you are young! You are mighty! Your fire ssshall warm usss in the cold and protect usss from the dangersss! Together, yesss, together we ssshall reach the valley!"),
          },
