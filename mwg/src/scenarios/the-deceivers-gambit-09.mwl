          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Delfador",
            x: 21,
            y: 18,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "$companion_id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "companion_name",
            value: "$STORE_UNIT_VAR_store.name",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "$companion_id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "companion_name",
            value: "$STORE_UNIT_VAR_store.name",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.role",
                value: "escort1",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
