      {
        tag: "event",
        id: "ev_69",
        on: "new_turn",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "unit_exists",
                exists: "no",
                side: 3,
              },
            ],
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("$saurian_guide_name, could we not have brought augurs along on this journey? I’ve mastered many forms of magic, but the light of a healer is beyond my reach."),
          },
          {
            tag: "message",
            speaker: "$saurian_guide_id",
            text: _("Oh Great One, you know it isss forbidden! The malesss are not permitted! Only you and I; usss femalesss may look upon the other Great One; your sssister, our massster, our god!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Us females? Err, yes, that’s right."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_68",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
