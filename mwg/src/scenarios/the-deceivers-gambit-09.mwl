              },
            ],
          },
          {
            tag: "message",
            speaker: "$saurian_guide_id",
            text: _("Oh Great One! Sssave me!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "$saurian_guide_id",
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_72",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 10,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
              },
            ],
          },
          {
            tag: "message",
            speaker: "$saurian_guide_id",
            text: _("The sssnow, the windsss, it chillsss usss... Oh Great One, even with your warmth, we cannot ssstay here long!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("We must keep moving."),
          },
        ],
      },
      {
        tag: "event",
