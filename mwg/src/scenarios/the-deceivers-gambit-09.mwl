            kill: "no",
            id: "$companion_id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "companion_name",
            value: "$STORE_UNIT_VAR_store.name",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "$companion_id",
            text: _("That’s the last one ’o them, and with all the caves collapsed there won’t be more! Nothing left to do but wait for Delfador to come back out, and relax... for real this time. Great work everybody."),
          },
          {
            tag: "hook",
            name: "command:set_achievement",
