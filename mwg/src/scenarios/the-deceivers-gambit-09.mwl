        on: "explain_cave_defenders",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "$companion_id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "companion_name",
            value: "$STORE_UNIT_VAR_store.name",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "$companion_id",
            text: _("Look out! One of them was lurking just inside the cave entrance!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_244",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%7D%2C%22children%22%3A%5B%5D%7D",
