        id: "ev_245",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 2,
          },
          {
            tag: "condition",
            variable: "turn_number",
            equals: 1,
          },
          {
            tag: "hook",
            name: "command:set_variables",
            payload: "%7B%22name%22%3A%22emerging_units%22%2C%22mode%22%3A%22replace%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22split%22%2C%22attributes%22%3A%7B%22key%22%3A%22type%22%2C%22separator%22%3A%22%2C%22%2C%22list%22%3A%22Soulless%2C%20%20%20%20%20%20%20Walking%20Corpse%2C%20Walking%20Corpse%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "foreach",
            variable: "emerging_units",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:store_locations",
                variable: "_mwg_random_locations_0",
                filter: "%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22find_in%22%3A%22cave_locations%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22type%22%3A%22Cave%20Entrance%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D",
              },
              {
                tag: "set_variable",
                name: "_mwg_random_remaining_2",
                value: 1,
              },
              {
                tag: "while",
                children: [
