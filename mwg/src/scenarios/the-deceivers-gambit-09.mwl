          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 18,
            ys: 7,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 18,
            y: 7,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("So many bones! And they don’t look human... Is such death all work of your great dragon?"),
          },
          {
            tag: "message",
            speaker: "$saurian_guide_id",
            text: _("No, this valley is cursssed... My grandmother usssed to sssay there were once many powerful creaturesss in thisss place, but they were ssslain long before I wasss hatched. Now only our Great One remainsss."),
          },
          {
            tag: "message",
            speaker: "$saurian_guide_id",
            text: _("But once you find her, then there ssshall be two! Together the Great Onesss will be unssstoppable!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_71",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
