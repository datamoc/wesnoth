      },
      {
        tag: "event",
        id: "ev_8",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("On the road to Knalga, the party was opposed by the forces of Asheviere."),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            text: _("The Queen has sent me to stop you, impostor!"),
          },
          {
            tag: "message",
            speaker: "Advisor",
            text: _("That’s the Princess, Li’sar. The daughter of the Queen, and her successor!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("I’m no impostor. It seems that your mother has lied to you."),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            portrait: "portraits/lisar-mad.webp",
            text: _("This is treason! Your lies will perish with you!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("There is no use in reasoning. She will understand only one thing. To arms!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Li'sar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "set_variable",
            name: "unit.hitpoints",
            value: 1,
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "unit",
          },
          {
            tag: "message",
            portrait: "portraits/lisar-defeat.webp",
            text: _("I surrender! Don’t hurt me, impostor."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("I said before I’m not an impostor, but if you yield, I will spare your life."),
          },
          {
            tag: "message",
            portrait: "portraits/lisar-defeat.webp",
            text: _("Let me go!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-human-concerned.webp",
            text: _("Think about the story of the old king. Ask somebody who knew of him."),
          },
          {
            tag: "message",
            portrait: "portraits/lisar-defeat.webp",
            text: _("The old king? I have heard about that, but I know it is not true. My mother told me."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Your mother has lied to you, child. Now I suggest you reconsider, and either join us, or flee as an exile. There will be a great battle soon, and if you are on the wrong side of it, we may not have the opportunity to spare your life a second time."),
          },
          {
            tag: "message",
            portrait: "portraits/lisar-defeat.webp",
            text: _("I am not a child, and I do not want to talk about it! You said you would spare me, so be on your way. The northern road should be safe for you."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Good day to you, then. Come, men, to the northern road!"),
          },
          {
            tag: "message",
            portrait: "portraits/lisar-defeat.webp",
            text: _("(Ha ha, little do they know just how many undead have wandered the northern road of late. Surely they are doomed!)"),
          },
          {
            tag: "win",
          },
        ],
      },
