      {
        tag: "event",
        id: "if_53",
        on: "branch_if_53",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_gave_familiar_to_konrad",
            equals: "yes",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("And the outcome is no mystery — there is a small fleet of boats shattered among the river islands! I shall send a scout to investigate."),
          },
          {
            tag: "spawn",
            id: "familiar",
            type: "Fire Wraith",
            side: 4,
            x: 3,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "familiar",
          },
          {
            tag: "hook",
