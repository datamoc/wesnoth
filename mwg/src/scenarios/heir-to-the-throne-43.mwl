        once: true,
        children: [
          {
            tag: "condition",
            variable: "jeniver_drake_kills_remaining",
            equals: 15,
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("That’s fifteen drakes you’ve defeated. I’m already learning so much from dissecting the corpses! Fifteen more and I’m sure I’ll learn something practical."),
          },
