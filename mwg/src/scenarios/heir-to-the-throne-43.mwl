            unit: "familiar",
            x: 14,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 3000,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "familiar",
            x: 3,
            y: 10,
          },
          {
            tag: "message",
            speaker: "familiar",
            text: _("Fsss... crackle crackle hiss!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_54",
        on: "branch_if_54",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_gave_familiar_to_konrad",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("And the outcome is no mystery — there is a small fleet of boats shattered among the river islands! I shall send my familiar to investigate."),
          },
          {
            tag: "spawn",
            id: "familiar",
            type: "War Harbinger",
            side: 4,
            x: 3,
            y: 10,
          },
          {
            tag: "hook",
