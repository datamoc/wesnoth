          },
          {
            tag: "message",
            speaker: "Caradoc",
            text: _("He’s <i>dead</i>! This is dark sorcery like in my granddad’s time in the old country! The penalty is death. Attack and destroy them both!"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Hey! Don’t do that, or I will need more of them."),
