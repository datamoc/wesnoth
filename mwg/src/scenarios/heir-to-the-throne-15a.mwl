      {
        tag: "event",
        id: "ev_75",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%22side%22%3A%223%2C4%2C5%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("This ruined skeleton bears a curious amulet. Magical, perhaps? There is an inscription explaining its function..."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_konrad",
            kill: "no",
            id: "Konrad",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Konrad",
            x: "$unit.x",
            y: "$unit.y",
            raw: "yes",
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22amulet%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Konrad",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("How odd. In death, this skeleton was a puppet. But in life, he or she must have been a craftsman of legendary skill. Fortune has smiled upon us today — I will take this artifact for myself."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "refresh_artificers_amulet",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Konrad",
            x: "$stored_konrad.x",
            y: "$stored_konrad.y",
            raw: "yes",
          },
        ],
      },
      {
