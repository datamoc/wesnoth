      {
        tag: "event",
        id: "if_68",
        on: "branch_if_68",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "status_s15b",
            equals: "completed",
          },
          {
            tag: "message",
            speaker: "Kaelor",
            text: _("Hail, strangers! The seals are failing, and the sister senior sent us to find aid. You must return with us to help our home, else all may soon be lost!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-glad.webp",
            text: _("Don’t worry, warrior, we’ve already been to your home and fought to restore the seals! Your people are safe."),
          },
          {
            tag: "message",
            speaker: "Kaelor",
            text: _("Can it be true? Joyous news! You have my deepest gratitude, young one. Aid us in battle against these undead stragglers, and my warriors and I shall be glad to join you."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_69",
        on: "branch_if_69",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "status_s15b",
            not_equals: "completed",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Hail, strangers! How have these undead come to trouble you?"),
          },
          {
            tag: "message",
            speaker: "Kaelor",
            text: _("Nay, ’tis we who have come to trouble them! The seals are failing, and the sister senior sent us to cut through these restless dead and find aid for our home! But who are you to ask, stranger of the south?"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Well met. I am Konrad. But I don’t understand — you said you’re looking for help?"),
          },
          {
            tag: "message",
            speaker: "Kaelor",
            text: _("Indeed. I come from a monastery, some days travel northwards. A powerful magic that once protected my home has weakened, and I was sent to seek aid."),
          },
          {
            tag: "message",
            speaker: "Kaelor",
            text: _("But if you serve the light and not the darkness, then that aid is you! Fight alongside me to vanquish these undead now, then return with us north and help our home. Otherwise, all shall soon be lost!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_65",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_66",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_67",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
