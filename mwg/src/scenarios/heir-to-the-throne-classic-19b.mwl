              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22%24armored_knight%22%2C%22type%22%3A%22Death%20Knight%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("The Death Knight explodes into a cloud of dust as it is eradicated. Its armor, however, drops to the ground and remains intact. The heavy black steel is polished to a mirror shine."),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            text: _("Delfador... that breastplate... how did it end up here?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Its owner was surely a famous warrior in life. I wonder who it was. That plate must have a powerful enchantment to have resisted centuries of decay. Choose wisely who will bear it."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "temp_armor_x",
            value: "$x1",
            mode: "value",
          },
