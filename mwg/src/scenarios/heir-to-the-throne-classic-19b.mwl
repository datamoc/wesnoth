            value: 0.4,
            mode: "multiply",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "Lich_store",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "die",
        once: false,
        children: [
