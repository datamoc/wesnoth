              },
            ],
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Cylanna! I need you!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "die",
        once: true,
