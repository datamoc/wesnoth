      {
        tag: "event",
        id: "ev_14",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Uh oh. There is someone else here. Hey! He is being attacked by a cuttlefish!"),
          },
          {
            tag: "message",
            speaker: "Growloff",
            text: _("Look my pet, here’s a yummy treat!"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Or...is he <i>talking</i> to it?!"),
          },
          {
            tag: "message",
            speaker: "Cylanna",
            text: _("It is worse than that. I think <i>we</i> are the treat!"),
          },
          {
            tag: "message",
            speaker: "Growloff",
            text: _("Who is ready for a merfolk snack?"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Brace yourselves."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "recruit",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_recruit_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Sea%20Serpent%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Oh no! Look what he has frisking at his heels now. And I thought the cuttlefish was bad!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Growloff",
            text: _("You killed my pet! You’ll pay for that!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Growloff%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            hitpoints: 1,
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Growloff%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Growloff",
          },
          {
            tag: "message",
            speaker: "Growloff",
            text: _("Don’t kill me!"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("But you attacked us with these monsters."),
          },
          {
            tag: "message",
            speaker: "Growloff",
            text: _("They are my friends. I’ve been so lonely here...and you killed so many of my friends. They could be your friends too. Spare me, and I’ll give you my favorite cuttlefish. His name is Inky."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("I do not want a dangerous beast like that!"),
          },
          {
            tag: "message",
            speaker: "Growloff",
            text: _("But he’s tame! Really! He understands dozens of commands. He’ll do what you tell him. He’s a really nice fish."),
          },
          {
            tag: "message",
            speaker: "Cylanna",
            text: _("Maybe we could use a pet sea monster."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Very well. I will take the cuttlefish. But do not trouble us again, or I shall kill you and all the rest of your pets."),
          },
          {
            tag: "message",
            speaker: "Growloff",
            text: _("Of course, of course. I promise! I never wanted to hurt you nice people anyway."),
          },
          {
            tag: "spawn",
            id: "Inky",
            type: "Cuttle Fish",
            side: 1,
            x: 5,
            y: 2,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Inky",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Inky",
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Right. Tell me how to control this thing."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
