        once: true,
        children: [
          {
            tag: "message",
            speaker: "Alanin",
            text: _("Well, the elves are behind me for now, but their riders are fast and will catch up quickly."),
          },
          {
            tag: "message",
            speaker: "Alanin",
            text: _("My only hope is to convince the peasants to stop the elves from passing through their land, so I can get ahead of those riders."),
