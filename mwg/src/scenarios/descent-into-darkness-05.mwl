          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "siege_of_laurelmor.ogg",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_2",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
