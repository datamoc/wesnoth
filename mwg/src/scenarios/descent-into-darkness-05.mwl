        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
            side: 4,
            cells: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22type%22%3A%22Walking%20Corpse%22%2C%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22variation%22%3A%22drake%2Cdwarf%2Cgoblin%2Cgryphon%2Cmounted%2Csaurian%2Cspider%2Cswimmer%2Ctroll%2Cwose%2Cwolf%2Cbat%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22filter_wml%22%2C%22attributes%22%3A%7B%22experience%22%3A%220%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Darken Volk",
            unit: "Darken Volk",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: 1,
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Even before the very founding of Wesnoth, you have hounded my people at every turn. You have trampled our fields, slaughtered our livestock, and burned our houses. You have brought war to a place of peace and death to a place of life. You are nothing but remorseless killers and savage beasts. Your kind deserves no mercy and shall receive none. I will crush you into the dust and make you into my slaves for all eternity."),
          },
          {
            tag: "message",
            speaker: "Borth",
            text: _("The silly necromancer is trying to talk us to death! You have caused us enough trouble, human. It is time for you to die."),
          },
          {
            tag: "message",
            speaker: "P'Gareth",
            text: _("Ummm... unless... you are already dead, like the skeletons?"),
          },
          {
            tag: "message",
            speaker: "K'Vark",
            text: _("Then it will be time for you to die again!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "die",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%22%2C%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                side: "2,3,4",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("How puny and weak you look in death."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "die",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%22%2C%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                side: "2,3,4",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("You and your kind deserve no eternal rest in death. After this battle, I’ll raise your corpse and make your bones dance for me, orc. But for now, I’ve one last one to take care of—"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "remaining_orc_leader",
            kill: "no",
            side: "2,3,4",
          },
          {
            tag: "switch",
            variable: "remaining_orc_leader.side",
            children: [
              {
                tag: "case",
                equals: 2,
                children: [
                  {
                    tag: "set_variable",
                    name: "escape_to_x",
                    value: 11,
                  },
                  {
                    tag: "set_variable",
                    name: "escape_to_y",
                    value: 1,
                  },
                ],
              },
              {
                tag: "case",
                equals: 3,
                children: [
                  {
                    tag: "set_variable",
                    name: "escape_to_x",
                    value: 8,
                  },
                  {
                    tag: "set_variable",
                    name: "escape_to_y",
                    value: 26,
                  },
                ],
              },
              {
                tag: "case",
                equals: 4,
                children: [
                  {
                    tag: "set_variable",
                    name: "escape_to_x",
                    value: 40,
                  },
                  {
                    tag: "set_variable",
                    name: "escape_to_y",
                    value: 7,
                  },
                ],
              },
            ],
          },
          {
            tag: "message",
            speaker: "$remaining_orc_leader.id",
            text: _("Retreat!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "orc_leader_store",
            kill: "yes",
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("He flees! The coward!"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("That is no surprise. Orcs may like to make a show of strength, but will always flee in the face of an overwhelming force. Nevertheless, the Whitefangs are still numerous and have some ties to other orcish clans. You must hunt this chieftain down before he can alert the others, else we may soon have dozens more on our tail."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("By ‘you’, you mean... on my own?"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Your apprenticeship is nearly over; you are more than capable of handling a single, half-dead orc on your own. After you have dealt with him, I do have a small favor I will ask of you. It will constitute the last part of your... training. I have some other things that I must attend to in preparation. In a few weeks, meet with me to the west, near the town of Tath."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("It will be done."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "victory",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:heal_unit",
            amount: "full",
            restore_statuses: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Darken%20Volk%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Darken Volk",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "darken_volk_store",
            kill: "yes",
            id: "Darken Volk",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Malin%20Keshar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("I’m not ready to die yet..."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Darken%20Volk%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Fool boy! With my demise, none in this world will aid you..."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "time_over",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Your incompetence at this simple task is appalling. You will never grow strong enough to be of use to me."),
          },
          {
            tag: "lose",
          },
        ],
      },
    ],
  },
]
