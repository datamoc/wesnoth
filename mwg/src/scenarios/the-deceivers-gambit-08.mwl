                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "saurian_leaders",
            kill: "no",
            side: "2,3,4,5,6,7,8",
          },
          {
            tag: "foreach",
            variable: "saurian_leaders",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scroll_to",
                x: "$leader.x",
                y: "$leader.y",
              },
              {
                tag: "hook",
                name: "command:clear_shroud",
                side: 1,
                xs: "$leader.x",
                ys: "$leader.y",
              },
              {
                tag: "hook",
                name: "command:lift_fog",
                side: 1,
                cells: "$leader.x,$leader.y",
                radius: 1,
              },
              {
                tag: "hook",
                name: "command:delay",
                time: 500,
              },
            ],
          },
          {
            tag: "message",
            speaker: "Barin",
            text: _("...what, you didn’t think we was trying to rob something, did ye? Naw, I’m your guide. I’d never hurt a friend of $companion_name’s."),
