        on: "pre_attack",
        once: true,
        children: [
          {
            tag: "filter",
            side: 9,
          },
          {
            tag: "message",
            text: _("The monssstersss hunt usss for sssport! Flee, flee!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("They really are unarmed juveniles! Hang on a minute, they’re not dangerous, maybe we should just let them be."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_246",
        on: "sighted",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_sighted_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%229%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("That saurian has different markings than the others I’ve seen, and is somewhat smaller. A juvenile or invalid, perhaps?"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_248_1",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 2,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                side: 1,
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "visible_human",
            kill: "no",
            side: 1,
          },
          {
            tag: "set_variable",
            name: "search_radius",
            value: 0,
          },
          {
            tag: "while",
            test: "wml_condition_tree('tree=%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22found_unit.length%22%2C%22greater_than%22%3A%220%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22search_radius%22%2C%22less_than_equal_to%22%3A%2299%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D')",
            children: [
              {
                tag: "hook",
                name: "command:store_unit",
                variable: "found_unit",
                kill: "no",
                side: "2,3,4,5,6,7,8",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "search_radius",
                value: 1,
                mode: "add",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: "$found_unit.x",
            y: "$found_unit.y",
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "$found_unit.x",
            ys: "$found_unit.y",
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "$found_unit.x,$found_unit.y",
            radius: 1,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 0,
          },
          {
            tag: "message",
            speaker: "$found_unit.id",
            text: _("We’re under assssault! Sssound the alarm and rally our warriorsss!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("They’ve spotted us! The time for stealth is past; now come the fire and the flame!"),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "first_spotted_turn",
            value: "$turn_number",
            mode: "value",
          },
          {
            tag: "hook",
