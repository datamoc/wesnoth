      {
        tag: "event",
        id: "ev_180",
        on: "attack_poachers",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:play_sound",
            file: "lightning.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Insolent fools, I am no sickly scribe, easy pickings for the robber!"),
          },
          {
            tag: "message",
            speaker: "Barin",
            text: _("Whoah, hey uh, what’s going on?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("You bandits trifle with an archmage of Wesnoth, famed and powerful. Step forth and meet your doom!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "$companion_id",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 11,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
