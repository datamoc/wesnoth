      {
        tag: "event",
        id: "ev_252",
        on: "die",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Alas, she has expired. Her wounds were too great. But we have learned much — we must capture another matriarch to find out who this ’great one’ is."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_251",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%2C5%2C6%2C7%2C8%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
              },
            ],
          },
          {
            tag: "message",
            speaker: "$unit.id",
            text: _("Who are you! Why bring death into my homesss..."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I am Delfador, war-mage of Wesnoth! Abandon the Blackcrest orcs to death by Wesnoth’s spears, or I will visit upon you the same destruction your allies would bring to us!"),
          },
          {
            tag: "message",
            speaker: "$unit.id",
            text: _("But tribe Earth-Becomes-Clay mussst fight Wesssnoth! The Great One has commanded us!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("The “Great One”? I had thought you matriarchs led your tribe. Tell me, elder, who is this of which you speak?"),
          },
          {
            tag: "message",
            speaker: "$unit.id",
            text: _("We sssauriansss are finally united... the Great One makesss usss... ssstrong..."),
          },
        ],
      },
