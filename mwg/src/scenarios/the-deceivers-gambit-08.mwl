      {
        tag: "event",
        id: "ev_122",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Delfador",
            text: _("The seven saurian matriarchs lie somewhere in this swamp. With most of their warriors away at war, they will be vulnerable."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("The Blackcrests have good reason to fight, but none of this should concern saurians — they’re not usually invaders. I need to figure out what’s going on with this alliance and put an end to it."),
          },
          {
            tag: "message",
            speaker: "$companion_id",
            text: _("You’re almost there! Jus’ a lil bit further... almost..."),
          },
