      {
        tag: "event",
        id: "ev_7",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Great%20Chief%20Brurbar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("The orcish chieftain is dead! Now we must make appear he was slain by an orcish hand!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "time_over",
        once: true,
        children: [
          {
            tag: "message",
            text: _("We are too late, the potion effects have worn off and we are visible!"),
          },
          {
            tag: "message",
            text: _("With our ruse revealed, the orcs will attack our forests instead of fighting among themselves."),
          },
        ],
      },
