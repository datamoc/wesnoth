            id: "Landar",
          },
          {
            tag: "message",
            text: _("This feels passing strange! Landar, remember to stay far from the wolves —they may be able to smell us."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 1,
            y: 29,
