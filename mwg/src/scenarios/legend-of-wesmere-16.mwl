        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            text: _("Here we are at last. Landar, are you sure you want to go through with this?"),
          },
          {
            tag: "message",
            text: _("Absolutely. Let’s do it!"),
          },
          {
            tag: "message",
            text: _("We need to kill the Great Chief and get out before the effect of the philter ends. Time to drink it down now!"),
