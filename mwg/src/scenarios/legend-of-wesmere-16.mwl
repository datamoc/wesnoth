      },
      {
        tag: "event",
        id: "ev_10",
        on: "victory",
        once: true,
        children: [
          {
            tag: "message",
            text: _("The Great Chief has been murdered! Whoever did it will only get da throne over my dead stinking body!"),
          },
          {
            tag: "message",
            text: _("I am the strongest warlord! I will be Chief!"),
          },
          {
            tag: "message",
            text: _("No way anyone will steal my throne!"),
          },
          {
            tag: "message",
            text: _("This is my time and I will kill anyone who disputes it!"),
          },
          {
            tag: "message",
            text: _("The plan is working! Now we will take back what’s ours!"),
          },
          {
            tag: "message",
            text: _("Softly, Landar. We still have to get out of here..."),
          },
        ],
      },
