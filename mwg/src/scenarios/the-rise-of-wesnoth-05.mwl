          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "lady_store",
            kill: "yes",
            id: "Lady Outlaw",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "victory",
        once: true,
        children: [
          {
