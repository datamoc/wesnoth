          },
          {
            tag: "hook",
            name: "command:set_variables",
            payload: "%7B%22name%22%3A%22this_item.modifications%22%2C%22mode%22%3A%22replace%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22literal%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22loyal%22%2C%22male_name%22%3A%22loyal%22%2C%22female_name%22%3A%22female%5Eloyal%22%2C%22description%22%3A%22Zero%20upkeep%22%2C%22help_text%22%3A%22%3Ci%3ELoyal%3C%2Fi%3E%20units%20don%E2%80%99t%20incur%20upkeep.%20Most%20units%20incur%20an%20upkeep%20cost%20at%20the%20end%20of%20every%20turn%2C%20which%20is%20equal%20to%20their%20level.%20Loyal%20units%20do%20not%20incur%20this%20cost.%5Cn%5Cn_%20During%20campaigns%2C%20certain%20units%20may%20opt%20to%20join%20the%20player%E2%80%99s%20forces%20of%20their%20own%20volition.%20These%20units%20are%20marked%20with%20the%20loyal%20trait.%20Although%20they%20may%20require%20payment%20to%20be%20recalled%2C%20they%20never%20incur%20any%20upkeep%20costs.%20This%20can%20make%20them%20invaluable%20during%20a%20long%20campaign%2C%20when%20gold%20is%20in%20short%20supply.%20This%20trait%20is%20never%20given%20to%20recruited%20units%2C%20so%20it%20may%20be%20unwise%20to%20dismiss%20such%20units%20or%20to%20send%20them%20to%20a%20foolish%20death.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22loyal%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22overlay%22%2C%22add%22%3A%22misc%2Floyal-icon.png%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22healthy%22%2C%22male_name%22%3A%22healthy%22%2C%22female_name%22%3A%22female%5Ehealthy%22%2C%22description%22%3A%22Always%20rest%20heals%22%2C%22help_text%22%3A%22Renowned%20for%20their%20vitality%2C%20some%20dwarves%20are%20sturdier%20than%20others%20and%20can%20rest%20even%20when%20traveling.%5Cn%5Cn_%20%3Ci%3EHealthy%3C%2Fi%3E%20units%20have%201%20additional%20hitpoint%2C%20and%20gain%201%20more%20per%20level.%20They%20will%20also%20heal%202%20hitpoints%20each%20turn%2C%20regardless%20of%20whether%20they%20engaged%20in%20combat%20the%20turn%20before.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22healthy%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22increase_total%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22times%22%3A%22per%20level%22%2C%22increase_total%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D",
          },
        ],
      },
