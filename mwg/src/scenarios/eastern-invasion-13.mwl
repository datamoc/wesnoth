          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "prisoners_remaining",
            value: 1,
            mode: "sub",
          },
          {
            tag: "message",
            text: _("I... Hunger..."),
          },
          {
            tag: "message",
            speaker: "Owaec",
            text: _("By the Clans, she wields slaves as weapons! This injustice will not stand!"),
          },
          {
            tag: "message",
            speaker: "Terraent",
            text: _("By all that is holy, she wields slaves as weapons! This evil will not stand!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "dwarvish_prisoners",
          },
          {
            tag: "message",
            text: _("More prisoners approach from the northwest! I have not the time to depart and return with Gweddry, or those dwarves will surely be slain."),
          },
          {
            tag: "message",
            speaker: "Owaec",
            text: _("I may have failed my original mission, but in the name of the Clans, I will not fail these prisoners now!"),
          },
          {
            tag: "message",
            speaker: "Terraent",
            text: _("I may have failed my original mission, but by the holy Light, I will not fail these prisoners now!"),
          },
        ],
