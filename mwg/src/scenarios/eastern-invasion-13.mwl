            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 41,
            y: 3,
          },
          {
            tag: "message",
            text: _("Alas, my long days of riding have been for naught. I could not catch the undead scout before it could report back to its mistress!"),
          },
          {
            tag: "message",
            text: _("Gweddry had hoped we might take this necromancer by surprise. But now that she is alerted, and with the rest of our army yet weeks away, she will have more than enough time to prepare for our arrival."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Mal-Yrna",
            text: _("Minion, what’s this? Soldiers of Wesnoth approach from the north? That area should have been cleansed over a month ago."),
          },
          {
            tag: "message",
            speaker: "Mal-Yrna",
            text: _("No matter. Bring in the next batch of prisoners. I have need of them a little sooner than expected."),
          },
