            name: "command:config_side",
            side: 1,
            recall_filter: "%7B%22tag%22%3A%22filter_recall%22%2C%22attributes%22%3A%7B%22type_adv_tree%22%3A%22Elvish%20Fighter%2C%20Elvish%20Archer%2C%20Elvish%20Scout%22%7D%2C%22children%22%3A%5B%5D%2C%22gettext%22%3A%5B%5D%2C%22location%22%3A%7B%22file%22%3A%22C%3A%5C%5CUsers%5C%5Cmiche%5C%5Cdev%5C%5Cwesnoth-1.19.27%5C%5Cdata%5C%5Ccampaigns%5C%5CLegend_of_Wesmere%5C%5Cscenarios%5C%5Cchapter2%5C%5C08_Council_of_Hard_Choices.cfg%22%2C%22line%22%3A58%2C%22column%22%3A1%7D%7D",
          },
        ],
      },
      {
        tag: "event",
        id: "side_traits_2",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
