        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Malatus",
            text: _("Halt! Who goes there?"),
          },
          {
            tag: "message",
            speaker: "Dwar-Ni",
            text: _("Look! It is the traitor Li’sar, with the old mage and the filthy elven lord. Quickly, capture them! The Queen wishes to make them her prisoners."),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            text: _("What? I, a traitor? It is the Queen who is a traitor, for not obeying the wishes of King Garard II. We have the Sceptre of Fire, so let us in!"),
          },
          {
            tag: "message",
            speaker: "Malatus",
            text: _("You leave us no choice but to kill you."),
          },
        ],
      },
