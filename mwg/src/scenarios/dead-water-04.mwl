          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("What is your name?"),
          },
          {
            tag: "message",
            speaker: "Keshan",
            text: _("I am Keshan."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("How did you come to be in a cage?"),
          },
          {
            tag: "message",
            speaker: "Keshan",
            text: _("I was hunting north of here when the small ones captured me. I killed many, but I was humiliated in the end."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Will you fight with us, Keshan?"),
          },
          {
            tag: "message",
            speaker: "Keshan",
            text: _("You have released me, so I owe you a great debt. I will fight with you."),
          },
          {
            tag: "message",
            speaker: "Gwabbo",
            text: _("Don’t let him go too crazy. Those saurian spears can go right through his scales."),
          },
        ],
      },
