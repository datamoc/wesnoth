      {
        tag: "event",
        id: "ev_19",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("There are cages on the shore. I wonder why."),
          },
          {
            tag: "spawn",
            id: "Teeloa",
            type: "Merman Brawler",
            side: 1,
            x: 4,
            y: 27,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Teeloa",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Teeloa",
          },
          {
            tag: "message",
            speaker: "Teeloa",
            text: _("Help! Save me!"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Who are you? What is happening?"),
          },
          {
            tag: "message",
            speaker: "Teeloa",
            text: _("My name is Teelöa. I have been a slave to these saurians for almost two years. I saw you coming up the coast in strength, so I fled. They follow in my wake, and without your protection they will surely kill me."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("A slave!"),
          },
          {
            tag: "message",
            speaker: "Gilak",
            text: _("You! Merman! You have some property of oursss. Return it at once if you value your life."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("If you mean this merman, Teelöa, he is no longer your property. No person should be the property of another. Release all your slaves, or the wrath of the merfolk will fall upon you!"),
          },
          {
            tag: "message",
            speaker: "Cylanna",
            text: _("A brave and kindhearted choice! I cannot abide slavery."),
          },
          {
            tag: "message",
            speaker: "Gwabbo",
            text: _("Those were the words of a man and a leader, Kai Krellis, and well spoken. The folk are truly yours now."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Kai Krellis saw that it was so. The refugee merfolk, sore in their pride from fleeing their enemies, cheered his ultimatum and made ready to fight with a will."),
          },
          {
            tag: "message",
            speaker: "Gilak",
            text: _("Foolish merman! You will sssoon wish you had minded your own affairs."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Perhaps if I called out to the slaves, I could rouse them to help us fight against their captors."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You can choose when the slaves come out of their villages and attack their captors. When you are ready, right-click anywhere and select ‘Inspire the slaves to revolt’."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_21",
        on: "victory",
        once: true,
      },
      {
        tag: "event",
        id: "if_23",
        on: "branch_if_23",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.id",
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("There is a treasure chest there! Good bat!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_24",
        on: "branch_if_24",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.id",
            not_equals: "",
          },
          {
            tag: "message",
            text: _("There is a treasure chest here!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_22",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 2,
            y: 2,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_23",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_24",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gold.ogg",
          },
          {
            tag: "gold",
            side: 1,
            amount: 100,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You receive 100 gold."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_26",
        on: "branch_if_26",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.id",
          },
          {
            tag: "message",
            text: _("Neep!"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("I believe our bat is impressed! That must be a drake. I am told they are fearsome, but honorable, creatures. I think we can let him out of the cage."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_28",
        on: "branch_if_28",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.id",
            equals: "Kai Krellis",
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("This must be a drake. I am told they are honorable creatures. I am going to let him out of the cage."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_29",
        on: "branch_if_29",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.id",
            not_equals: "Kai Krellis",
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("That must be a drake. I am told they are fearsome, but honorable, creatures. Let him out of the cage."),
          },
          {
            tag: "message",
            text: _("Uh...If you say so."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_27",
        on: "branch_if_27",
        once: true,
        children: [
          {
