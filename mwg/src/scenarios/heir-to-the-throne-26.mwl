                variable: "random",
                values: "Peasant,Peasant,Woodsman",
              },
              {
                tag: "hook",
                name: "command:spawn_dynamic",
                type: "$random",
                side: 1,
                x: "$peasantX",
                y: "$peasantY",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "REPEAT_i",
                value: 1,
                mode: "add",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "explain_peasants",
          },
        ],
