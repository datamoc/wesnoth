        children: [
          {
            tag: "hook",
            name: "command:remove_trait",
            id: "$unit.id",
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            experience: 11,
            unit_name: "Tanry",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22%24unit.id%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "$unit.id",
            object: "%7B%22id%22%3A%22resilient%22%2C%22effects%22%3A%5B%7B%22applyTo%22%3A%22hitpoints%22%2C%22increaseTotal%22%3A4%7D%2C%7B%22applyTo%22%3A%22hitpoints%22%2C%22increaseTotal%22%3A1%7D%5D%2C%22abilities%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:heal_unit",
            amount: "full",
            restore_statuses: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22%24unit.id%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "$unit.id",
          },
          {
            tag: "message",
            speaker: "freed_slave",
            text: _("I— I can’t believe it. Have you come to rescue us? Others have tried before..."),
          },
          {
            tag: "message",
            text: _("By the Lords of Light, we’re saved! Take us with you! I don’t care who you are or where you’re going, as long as it’s away!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("I am Konrad, son of Arand and rightful heir to the throne of Wesnoth. Words cannot express my grief at the sorry state of you and your people here. Of course you may come with us, as may any other slaves who we are able to free!"),
          },
        ],
      },
