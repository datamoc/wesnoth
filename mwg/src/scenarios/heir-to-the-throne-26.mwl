      {
        tag: "event",
        id: "ev_65",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: "-1-98",
            y: 29,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "s26_from",
                equals: "n",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("We’ve reached the southern exit to the valley, and have dealt a great blow to these orcs! If only we could have truly liberated this place... but I know that far more people are suffering under Asheviere."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-mad.webp",
