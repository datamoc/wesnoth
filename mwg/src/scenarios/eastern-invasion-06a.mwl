          {
            tag: "message",
            speaker: "Dolburras",
            text: _("Many thanks ta ye! Feels good ta be finally breathin’ proper again."),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("How did you come to be captured by these undead?"),
          },
          {
            tag: "message",
            speaker: "Dolburras",
            text: _("Ran into a whole blasted army of ’em marchin’ from the Swamp o’ Dread. I think they be headed for Knalga! Someone oughta invade them for a change."),
          },
          {
            tag: "message",
            speaker: "Owaec",
            text: _("By the Clans! Do these undead mean to conquer all the world?"),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Dolburras, we are men of the King of Wesnoth, seeking the power to destroy these foul undead. Will you join us in our quest?"),
          },
          {
            tag: "message",
            speaker: "Dolburras",
            text: _("Kinna hardly go back ta Knalga with all them undead about! Aye, I’ll join ye."),
          },
