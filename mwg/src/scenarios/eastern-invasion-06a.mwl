      {
        tag: "event",
        id: "ev_19",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Dacyn",
            unit: "Dacyn",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Owaec",
            unit: "Owaec",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Addogin",
            unit: "Addogin",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Terraent",
            unit: "Terraent",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Hahid al-Ali",
            unit: "Hahid al-Ali",
            x: 8,
            y: 21,
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("We have done well to avoid conflict with the undead thus far. It is time to turn northward, toward our goal."),
          },
          {
            tag: "message",
            speaker: "Owaec",
            text: _("You still have yet to explain more about this goal."),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Wait, look, a small force of undead have already fortified this ford. We will have to fight them to cross the Great River."),
          },
          {
            tag: "message",
            speaker: "Dolburras",
            text: _("Let me out ’o this cage ye bag-o-bones! When the Alliance hears abo— <b>glug</b>"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "harm_dolburras",
          },
          {
            tag: "message",
            speaker: "Mal-un-Karad",
            text: _("Hahahaha! This dwarf is too short to keep his head out of the water. I wonder how long he’ll last?"),
          },
          {
            tag: "message",
            speaker: "Owaec",
            text: _("The undead are torturing that dwarf for sport! This shall not stand; we must rescue him before he drowns!"),
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Ho ho, you know what you need? My patented* elixir of water breathing! <span color='#BCB088' size='x-small'><i>*not patented</i></span>"),
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("One drink from this shimmering blue vial and you’ll move at full speed through swamps and shallow water!"),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Hahid al-Ali",
                text: _("Supplies are limited so <span strikethrough='true'>call now</span> buy now! <i>(elixirs only last for 1 scenario)</i>"),
              },
              {
                tag: "choice",
                text: _("Buy the elixir (10 gold)."),
                event: "ev_19_opt0",
              },
              {
                tag: "choice",
                text: _("Leave the elixir for Hahid."),
                event: "ev_19_opt1",
              },
            ],
          },
        ],
      },
