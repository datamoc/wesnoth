      {
        tag: "event",
        id: "ev_5",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-human-concerned.webp",
            text: _("It’s so dark in here I can hardly see!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("It is dark indeed. We shall have to light torches and tread slowly and carefully. It may be there are still dwarves down here who can aid us!"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("Indeed. We elves do not fare well in these dark pits."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_7",
        on: "branch_if_7",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "get_gryphons",
            equals: "yes",
          },
          {
            tag: "hook",
            name: "command:play_sound",
