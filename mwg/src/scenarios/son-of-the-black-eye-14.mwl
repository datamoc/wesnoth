          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Kte",
            cells: "4,3",
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("I’m here, Chief!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue-angry.webp~FL()~RIGHT()",
            text: _("Blood and stone, Grüü! You were supposed to be in position by first watch. It’s dawn!"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("Err, sorry, there were some humans in way. We squash, no problem."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("Better late than never. Now it’s time to kill! Let nobody escape! Everyone, keep an eye out for the shamans."),
          },
          {
            tag: "message",
            speaker: "Flar'Tar",
            text: _("Sounds simple enough."),
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 4,
            gold: 100,
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: 4,
            mode: "allow",
            types: "Troll Whelp",
          },
