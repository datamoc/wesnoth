      {
        tag: "event",
        id: "ev_18",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Jetto",
            unit: "Jetto",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Inarix",
            unit: "Inarix",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            role: "army",
            unit: "",
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("Well, boys, we’re home. I told you we would return one day."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "army_profile",
            value: "$STORE_UNIT_VAR_store.profile",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "army",
            portrait: "$army_profile~FL()~RIGHT()",
            text: _("Boy, have they ever built this place up."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("Listen up, orcs. Our main objective is to rescue the shamans. It won’t work to take the human runts head-on while they sneak the shamans out the back door."),
          },
          {
            tag: "message",
            speaker: "Flar'Tar",
            portrait: "portraits/flartar.webp~FL()~RIGHT()",
            text: _("What are you thinking, Chief?"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("My men know the land well. Flar’Tar and Al’Brock, both of you take a scout and circle around to the northeast and southeast respectively. Grüü, you take your trolls and circle around to the northwest. If all goes well, we shall surround them."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("I like this plan, Chief!"),
          },
          {
            tag: "message",
            speaker: "army",
            portrait: "$army_profile~FL()~RIGHT()",
            text: _("You always like his plans, Grüü."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("Of course. Squash elves, squash undead, squash dwarves, squash humans. Squash them all, very good plan!"),
          },
          {
            tag: "message",
            speaker: "army",
            portrait: "$army_profile~FL()~RIGHT()",
            text: _("Well, he has the right idea, anyway."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("Good, everyone move out. I will begin the attack from here. I want everyone to be in position by first watch at the latest. Is that clear?"),
          },
          {
            tag: "message",
            speaker: "Flar'Tar",
            portrait: "portraits/flartar.webp~FL()~RIGHT()",
            text: _("Yes, Chief."),
          },
          {
            tag: "message",
            speaker: "Al'Brock",
            portrait: "portraits/albrock.webp~FL()~RIGHT()",
            text: _("Understood."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_AlBrock",
            kill: "yes",
            id: "Al'Brock",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_FlarTar",
            kill: "yes",
            id: "Flar'Tar",
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("Uh, Chief..."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("... Yes, Grüü?"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("Can I get some gold with me?"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("Fine, take a hundred. Don’t lose it."),
          },
          {
            tag: "gold",
            side: 1,
            amount: -100,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_Gruu",
            kill: "yes",
            id: "Grüü",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_trolls",
            kill: "yes",
            side: "1,2,3",
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: "1,2,3",
            mode: "disallow",
            types: "Troll Whelp",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 4,
          },
          {
            tag: "set_variable",
            name: "stored_AlBrock.x",
            value: 25,
          },
