            tag: "spawn",
            id: "Klanir",
            type: "Drake Glider",
            side: 2,
            x: 13,
            y: 37,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Klanir",
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Klanir",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Klanir",
            x: "6, 5",
            y: "35,36",
            raw: "yes",
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Gorlack",
          },
          {
            tag: "message",
            speaker: "Klanir",
            text: _("Dominant Gorlack, I bring ill tidings of the hunt. The Flight of Karron was decimated by a pack of humans upon the grassy stretches. The last word from Dominant Karron spoke of their striving for a retreat to your eyrie. In a noble attempt to aid the imperiled Flight of Karron... My dominant, Vladnir, fell to our prey. Our flight was scattered east, deep into the Greatland."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _(".................."),
          },
          {
            tag: "message",
            speaker: "Klanir",
            text: _("I must relay what I know to Dominant Karron, should she still live."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Glider, take care."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Klanir",
            x: 0,
            y: 33,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Klanir",
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Gorlack",
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("Cold ssseason has arrived. Many moons of cold are now upon usssss."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("We shall set camp there... Where the wounded land bleeds its warming ichor... May it provide the safety for our weary flight that I have failed to."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 28,
            y: 7,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 2000,
          },
        ],
      },
