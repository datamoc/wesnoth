          {
            tag: "spawn",
            id: "u_9",
            type: "Wyrm",
            side: 2,
            x: 29,
            y: 5,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_9",
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 1,
            defeat_condition: "no_units_left",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "heroes_rite.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 2000,
          },
          {
            tag: "message",
            text: _("Ho! I do not believe what I see..."),
          },
          {
            tag: "message",
            text: _("It is magnificent."),
          },
          {
            tag: "message",
            text: _("It is a drakekin. Few have beheld such a being since the Time of Legend."),
          },
          {
            tag: "message",
            text: _("With our own eyes we behold a drakekin... It was the drakekin who led us from the Moonlit Wastes in the Time of Fate."),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("I know you are here, weakling Shek’kahan! You know better than to intrude upon my domain, Brother! Even if I must search this entire valley, I will find your hiding place. Fly, my pets! Sweep this place of every scaleless beast so I will have no distraction."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("It is... an Ancestor..."),
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("Shek’kahan, do you not recognize Khrakrahs...?"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_33",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_attacker_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Khrakrahs%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("Be no more."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_34",
        on: "attacker_hits",
        once: true,
        children: [
          {
            tag: "filter",
            unit: "Khrakrahs",
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("Your challenge is accepted."),
          },
          {
            tag: "message",
            text: _("! ! !"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_35",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Khrakrahs%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "dragon_retreated",
            value: "yes",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("I will return."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Khrakrahs",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.hitpoints",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Khrakrahs",
            x: 37,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Khrakrahs",
          },
        ],
      },
      {
        tag: "event",
        id: "if_37",
        on: "branch_if_37",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "dragon_retreated",
            equals: "yes",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "spawn_dragon",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_36",
        on: "victory",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "dragon",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_37",
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("Show yourself, Brother!"),
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("Khrakrahs, he is here..."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "gorlack_location",
            kill: "no",
            id: "Gorlack",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Zedrix",
            x: "$gorlack_location.x",
            y: "$gorlack_location.y",
            raw: "yes",
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("Behold, mighty Shek’kahan!"),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("You are bold to present such an imposter!"),
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("Impossster?! I am elder of Green Swamp Clan and all my years Shek’kahan protected usss. I could never missstake sssome impossster for him!"),
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("If you do not sssee this is Shek’kahan... then impossster is <b>you</b>!"),
          },
          {
            tag: "message",
            speaker: "Arinexis",
            text: _("Do not sssay ssso much, Zedrix! You will be eaten!"),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("You are bold indeed, little saurian. What you have told me is false, yet a mere liar could not speak so bravely before a dragon."),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("Indeed, your heart believes the falsehood you speak... because it wishes to."),
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("..."),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("<span color='cyan'>_ Zedrix, your Heart shall Reveal its Truth.</span>"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 35,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 35,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "rumble.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 6000,
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("Khrakrahs... your brother is dead. He fell protecting his domain and humble sssubjectsss... ... of which I am all that is left."),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("So then it is true..."),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("It was nigh every season he would intrude upon my domain or me his. Each time, there was such a glorious battle between us, the sons of Drugis, as to impart even the clouds with fright. I must not have challenged him enough that he grew weak, vulnerable. Now another great battle between us there will never be. Now there is only me."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 3000,
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("I go."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Khrakrahs",
            x: 33,
            y: 2,
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Ancestor, you spoke that Shek’kahan grew weak... Yet to his last breath, he was fearless."),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("Yes, Shek’kahan was fearless."),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("<b>That</b> was his weakness."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Khrakrahs",
            x: 37,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Khrakrahs",
          },
        ],
      },
    ],
  },
]
