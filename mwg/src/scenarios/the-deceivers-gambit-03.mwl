      },
      {
        tag: "event",
        id: "ev_3",
        on: "turn",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                side: "$side_number",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_4",
        on: "recruit",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_recruit_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%2C%22type%22%3A%22Elder%20Wose%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                type: "Elder Wose",
                side: "$side_number",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: "$side_number",
            mode: "disallow",
            types: "Elder Wose",
          },
        ],
      },
      {
        tag: "event",
        id: "if_7",
        on: "branch_if_7",
        once: true,
        children: [
          {
            tag: "filter_condition",
