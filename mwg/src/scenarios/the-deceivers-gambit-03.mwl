            text: _("Boruroom! Burarum!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("What?! The tree speaks!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I’ve heard tell of tree-folk... you must be a wose! Err, I’m terribly sorry for the fireball. I couldn’t tell you apart from an ordinary oak."),
          },
          {
            tag: "message",
            speaker: "leader2",
            text: _("Burarum! Boom-toom-hun-rum-tum-ala-lola-ala?"),
          },
          {
            tag: "message",
            speaker: "leader2",
            text: _("A-rumgur-gurmum-un-rumba-ala-burarum! Burarum-ala-bortum-untum! A-rumgur-gurmum-un-rumba-ala-boruroom! BURARUM!!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("It can’t understand me, and I can’t understand it... Oh no..."),
