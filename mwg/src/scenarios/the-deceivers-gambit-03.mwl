          {
            tag: "spawn",
            id: "Deoran",
            type: "Veteran Cavalier",
            side: 3,
            x: 23,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Deoran",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Deoran",
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("Halt!! Who are you, and why do you trouble the trees of the Grey Grove? Speak, strangers, for the wrath of Wesnoth and the Lintanir elves is upon you!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Peace! Peace! You must be the man King Garard sent me to meet: Ambassador Deoran."),
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 3,
            team_name: "wesnoth",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Please, can you speak with these woses and tell them we’re not their enemies? This whole battle has been a terrible misunderstanding."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("You’re a courier from Wesnoth? My apologies for the harsh words; long has it been since Weldyn sent to this lonely post."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("But apology alone will not make right your transgressions against this rare and precious wose-grove. If you really are who you claim to be, explain yourself to me at once."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Deoran",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:heal_unit",
            amount: "full",
