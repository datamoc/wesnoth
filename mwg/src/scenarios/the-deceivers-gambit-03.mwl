          {
            tag: "condition",
            variable: "autoenrage_player_army",
            greater_than: "$( 5*$autoenrage_ai_army )",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "autoenrage2_timer",
            value: 1,
            mode: "add",
          },
