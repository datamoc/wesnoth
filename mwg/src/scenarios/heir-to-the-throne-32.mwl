          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "message1a",
            value: "You cannot deny, cousin, that Asheviere sent her dwarvish lackies to slay Wesnoth’s wild gryphons and steal their eggs! I may have benefitted from the act, but that does not change Asheviere’s decision to do it.",
            mode: "value",
          },
          {
            tag: "hook",
