        id: "ev_16",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("Crelanu! (<i>Cough, cough</i>) We have come... for your book."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("We need to borrow it."),
          },
          {
            tag: "message",
            speaker: "Crelanu",
            text: _("Yes, I knew people like you would be coming, but the book is out of reach now — for all of us. I have given it to the elves. Only they know where it is."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Why would you do such a thing?"),
          },
          {
            tag: "message",
            speaker: "Crelanu",
            text: _("So that one like you would not be tempted to do what you intend. Oh, yes. I know well what you seek."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Then you can tell us what we want to know."),
          },
          {
            tag: "message",
            speaker: "Crelanu",
            text: _("I shall not."),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("We shall see."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "logo.png",
            text: _("Ras-Tabahn is sick. He is slowed, and will lose four hitpoints every turn. He will die if he reaches zero."),
          },
        ],
