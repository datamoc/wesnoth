                  },
                  {
                    tag: "message",
                    speaker: "Lord Logalmier",
                    text: _("Who is this?"),
                  },
                  {
                    tag: "message",
                    speaker: "Prince Haldric",
                    text: _("It’s Commander Aethyr, of Clearwater Port. I was sure you perished in the fighting there."),
                  },
                  {
                    tag: "message",
                    speaker: "Commander Aethyr",
                    text: _("No, sir. I was leading the final survivors of Clearwater Port. We were making our last stand at the lighthouse when one of your ships came. One of my men conked me on the head, then I woke up at sea."),
                  },
                  {
                    tag: "message",
                    speaker: "Commander Aethyr",
                    text: _("I come bearing news. Some ‘old friends’ have decided to make an appearance. You should go ‘greet’ them."),
                  },
                  {
                    tag: "message",
                    speaker: "Lady Jessene",
                    text: _("<small>(_I fear our friend has said too much. You go on ahead, I’ll catch up with you.)</small>"),
