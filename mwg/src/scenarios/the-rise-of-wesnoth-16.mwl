                equals: 4,
                children: [
                  {
                    tag: "message",
                    speaker: "Lady Dionli",
                    text: _("You were successful, Prince Haldric. I knew you could do it."),
                  },
                  {
                    tag: "message",
                    speaker: "Lord Logalmier",
                    text: _("Man of the west-north, you have earned your place on this great continent."),
                  },
                  {
                    tag: "message",
                    speaker: "Lord Aryad",
                    text: _("As per our agreement, you and your people—"),
                  },
                  {
                    tag: "message",
                    speaker: "Lord El'Isomithir",
                    text: _("—may stay."),
                  },
                  {
                    tag: "message",
                    speaker: "Lord Logalmier",
                    text: _("We hereby grant you the plains to the north of the Great River, and the plains and hills to the south of the Great River. Be kind to the land. In a time of need we may call upon you, remember our generosity."),
                  },
                  {
                    tag: "message",
                    speaker: "Prince Haldric",
                    text: _("Fair enough. I decree a ‘Pact of Mutual Aid’ between our peoples. But— aren’t you setting us in conflict with the dwarves?"),
                  },
                  {
                    tag: "message",
                    speaker: "Lord Logalmier",
                    text: _("No. The dwarves have returned to the north. But humans mine as well, no? They are your resources to guard now. In the future we would be willing to trade with you."),
                  },
