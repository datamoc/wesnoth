      {
        tag: "event",
        id: "ev_11",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("My lord! This road does not seem as safe as we had hoped. Look around us at the hills — there are undead about!"),
          },
          {
            tag: "message",
            speaker: "Selda-Mana",
            text: _("Who are these who approach? Let us kill them all!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("To arms, men! The undead hordes approach!"),
          },
          {
            tag: "message",
            speaker: "Moremirmu",
            text: _("There can be no surrender to these foul beasts of the pit! We fight until victory, or until every one of us is slain!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 3,
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-human-concerned.webp",
            text: _("There are just so many! What shall we do?"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("My people douse our weapons with holy water when fighting undead. It usually lasts until the end of the battle, and they shrink in utter fear of our blades... if that is possible for an undead minion."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Let us hold them off as long as we can!"),
          },
        ],
