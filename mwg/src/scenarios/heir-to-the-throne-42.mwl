          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "",
            ys: "",
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "",
            radius: 1,
            multiturn: "no",
          },
          {
            tag: "message",
            speaker: "Arshag",
            text: _("Fagh-mok? You?! You’re weak! You were nothing more than the chief’s sword-carrier!"),
          },
          {
            tag: "message",
            speaker: "Arshag",
            text: _("No, I should be chief instead! Khargol respected me most of all! I followed him from the beginning!"),
          },
          {
            tag: "message",
            speaker: "leader3",
            text: _("No, I should be chief! My warriors are the bravest, and I am the strongest warrior of all!"),
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "",
            ys: "",
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "",
            radius: 1,
            multiturn: "no",
          },
          {
            tag: "message",
            speaker: "leader4",
            text: _("Strongest?! I could kill both you AND that ingrate Fagh-Mok, with one hand tied behind my back!"),
          },
          {
            tag: "message",
            speaker: "faghmok",
            text: _("Oh yeah? Come here and try it, you worthless sack of slime!"),
          },
          {
            tag: "message",
            speaker: "Arshag",
            text: _("I say we kill all three of ’em! Warriors, fight to make me chief and I promise to bathe you all in gold and blood!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
