          {
            tag: "spawn",
            id: "leader3",
            type: "Naga Ringcaster",
            side: 3,
            x: 37,
            y: 15,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "leader3",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "leader3",
            x: 40,
            y: 11,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "leader3",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "leader3",
            text: _("Hisss... We are ready, Missstresss."),
          },
          {
            tag: "message",
            speaker: "Maudie",
            text: _("Kill their warriors, then shackle the others and march them north. I’ve more important places to be. Ta ta!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Maudie",
            x: 33,
            y: 23,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Maudie",
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Snake monsters! The pirates have brought naga!"),
          },
          {
            tag: "message",
            speaker: "Elyn",
            text: _("Curse it all! Thea, rally the farmers and keep yourself safe. I’ve got to take the old skiff and warn the merfolk that naga are here."),
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Rally the farmers? What farmers? Most of our fighting-age men are away with Dad."),
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Thea",
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Besides, the army hasn’t helped us. What makes you think the merfolk will?"),
          },
          {
            tag: "message",
            speaker: "Elyn",
            text: _("Merfolk are ancient enemies of the naga, and are part of the kingdom just the same as us. They’ll help us, but I have to get the word out!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Elyn",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "skiff",
            x: 41,
            y: 16,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "skiff",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("First Dad leaves, then my brother... It was nice while it lasted. I guess it’s up to me now."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_22",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "enable_tutorial_elements",
                equals: "yes",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Careful, everyone. Naga are powerful in water, but clumsier than we are on land. Don’t fight on the coast. Flee inland if we need to, and then cut them to pieces!"),
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("But we can’t afford to give up too many villages either. We’ll have a hard time recovering if our enemies’ gold reserves get out of hand."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 12,
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("I see movement on the horizon! Something is coming closer... it’ll reach us in barely an hour. Is Elyn finally back?"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_24",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 13,
          },
          {
            tag: "spawn",
            id: "Diondra",
            type: "Mermaid Enchantress",
            side: 1,
            x: 40,
            y: 19,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Diondra",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Diondra",
          },
          {
            tag: "spawn",
            id: "u_1",
            type: "Merman Fighter",
            side: 1,
            x: 41,
            y: 17,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_1",
          },
          {
            tag: "spawn",
            id: "u_2",
            type: "Merman Fighter",
            side: 1,
            x: 41,
            y: 18,
          },
          {
            tag: "hook",
