            id: "pap_s02",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_26",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22leader2%2Cleader3%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "unit_exists",
                exists: "no",
                id: "leader2,leader3",
              },
            ],
          },
          {
            tag: "message",
            text: _("Accursssed mermaid! We are lossst... I mussst essscape..."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "$unit.id",
            x: 27,
            y: 26,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_naga",
            kill: "yes",
            id: "$unit.id",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "cutscene_retreating_enemies",
            kill: "no",
            side: "2,3",
          },
          {
            tag: "foreach",
            variable: "cutscene_retreating_enemies",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_rand",
                variable: "retreatX",
                values: "$($this_item.x)",
              },
              {
                tag: "hook",
                name: "command:set_variable_rand",
                variable: "retreatY",
                values: 27,
              },
              {
                tag: "hook",
                name: "command:scenario_move",
                id: "$this_item.id",
                x: "$retreatX",
                y: "$retreatY",
                raw: "yes",
              },
              {
                tag: "hook",
                name: "command:kill_unit",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Diondra",
            text: _("Begone! Flee and cower in your dark caves and silent grottos!"),
          },
          {
            tag: "message",
            text: _("Thank you for helping us, mermaid of the bay! But what do we do now? Many of us are hurt. Our leader is away at war, and our constable is missing — or dead."),
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("No, my brother couldn’t be... not like that. It’d take more than a few snakes to kill Constable Elyn Nicolin. I know we’ll see him again."),
          },
          {
            tag: "message",
            text: _("But he’s not here now. What happens the next time the pirates come, Constable Thea?"),
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Constable Thea? I’m not— err..."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Thea",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.name",
                value: "Constable Thea",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Alright. Mermaid, are you willing to take the fight to these pirates?"),
          },
          {
            tag: "message",
            speaker: "Diondra",
            text: _("Of course. The fleeing naga follow the coast south and west. I must go in pursuit!"),
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Then that is where we’ll go too. We won’t cower in fear until the next attack, or wait for outside aid that may never come. We’re going to get out there, hunt down that pirate lady and put an end to this! What do you say, lads?"),
          },
          {
            tag: "message",
            text: _("Rah!"),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_27",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 25,
          },
          {
            tag: "message",
            speaker: "Diondra",
            text: _("We will not fight here forever, villagers. The black ship is our real quarry! Let us swiftly vanquish these naga and be done with it."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_28",
        on: "side_turn_end",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 1,
          },
          {
            tag: "condition",
            variable: "turn_number",
            equals: 30,
          },
          {
            tag: "message",
            speaker: "Diondra",
            text: _("I cannot fight on behalf of your village any longer, humans. I must pursue the black ship before it escapes us! You will have to finish this battle yourselves."),
          },
          {
            tag: "lose",
          },
        ],
      },
    ],
  },
