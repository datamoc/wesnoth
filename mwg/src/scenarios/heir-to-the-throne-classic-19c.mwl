        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Keh%20Ohn%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Keh Ohn",
            text: _("GRRROOOOAAAAR!"),
          },
          {
            tag: "message",
            text: _("Hurrah! We’ve killed their leader!"),
          },
          {
            tag: "message",
            text: _("Our leader is dead, but it matters not! Time enough to appoint a new leader after the battle is won! Fight on to the last, comrades!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-human-mad.webp",
            text: _("Keep on going down the river. While we’re at it, let us force as many drakes as possible to pay with their lives. They defy us, and now they will meet the same fate as their leader!"),
          },
          {
            tag: "message",
            text: _("We hear and obey, My Lord."),
          },
        ],
      },
      {
        tag: "event",
