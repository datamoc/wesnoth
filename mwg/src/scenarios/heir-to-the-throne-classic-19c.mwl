                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22find_in%22%3A%22drake_bases%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22find_in%22%3A%22drake_bases_melee%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_variable_rand",
            variable: "random",
            values: "10..50",
          },
          {
            tag: "hook",
            name: "command:modify_gold",
            side: 1,
            amount: "+$random",
          },
          {
            tag: "message",
            portrait: "items/gold-coins-medium.png",
            text: _("We’ve found $random gold in the drake nest."),
          },
          {
            tag: "foreach",
            variable: "drake_bases",
            item: "this_item",
            index: "i",
            children: [
