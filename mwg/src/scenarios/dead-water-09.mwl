22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Kai%20Krellis%22%2C%22message%22%3A%22You%20must%20be%20Caladon.%20We%20are%20glad%20to%20see%20you.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Caladon%22%2C%22message%22%3A%22I%20am%20Caladon.%20Am%20I%20glad%20to%20see%20YOU%3F%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Kai%20Krellis%22%2C%22message%22%3A%22I%20am%20Kai%20Krellis%20of%20Jotha.%20I%20am%20seeking%20a%20flaming%20sword%2C%20and%20I%20am%20told%20you%20know%20where%20to%20find%20it.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Caladon%22%2C%22message%22%3A%22Ha!%20A%20MERman%20wants%20the%20Flaming%20Sword%20of%20AGNOVON!%20Why%20would%20YOU%20be%20able%20to%20get%20it%20when%20so%20many%20others%20could%20NOT%3F%20Although%20you%20do%20have%20an%20impressive%20collection%20of%20allies%20there.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Kai%20Krellis%22%2C%22message%22%3A%22Whether%20I%20can%20succeed%20or%20not%2C%20I%20must%20try.%20Will%20you%20help%20me%20find%20it%3F%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Caladon%22%2C%22message%22%3A%22I%20will%20show%20you%20EXACTLY%20where%20it%20is%2C%20but%20knowing%20where%20to%20FIND%20it%20isn%E2%80%99t%20the%20hard%20part.%20Oh%2C%20no!%20You%20will%20see%2C%20my%20fine%20merman%2C%20you%20will%20see.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Cylanna%22%2C%22message%22%3A%22We%20would%20be%20very%20grateful%20if%20you%20would%20guide%20us.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Caladon%22%2C%22message%22%3A%22I%20would%20be%20HAPPY%20to%20guide%20such%20a%20pretty%20mermaid%20AND%20her%20friends.%20Follow%20me%20everybody!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22scorp%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22time_of_day%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22Caladon_stored%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22Caladon_discovered%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22endlevel%22%2C%22attributes%22%3A%7B%22result%22%3A%22victory%22%2C%22bonus%22%3A%22yes%22%2C%22carryover_add%22%3A%22yes%22%2C%22carryover_percentage%22%3A%2240%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
