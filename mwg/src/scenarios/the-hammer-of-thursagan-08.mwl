      {
        tag: "event",
        id: "ev_52",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Behold! The West Gate of Kal Kartha! The largest of their many doors."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 39,
            y: 0,
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("And under siege, as we feared — by orcs. But we are not too late! The defenders yet hold."),
          },
          {
            tag: "message",
            speaker: "leader3",
            text: _("Ahhh... more stinky-midgets, come to get killed just like these cowards in their den."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("There is a mighty host between us and our kin. Let us bring them that orc’s head as a guesting-gift!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_54",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 6,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                side: 6,
              },
              {
                tag: "predicate",
                name: "unit_exists",
                exists: "yes",
                side: "2,3,4,5",
                x: "27-98",
                y: "0-6",
              },
            ],
          },
          {
            tag: "gold",
            side: 6,
            amount: 125,
          },
          {
            tag: "message",
            speaker: "Dulcatulos",
            text: _("Kal Kartha shall not fall!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_53",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22role%22%3A%22fallback_guard%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_55",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Dulcatulos%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Kal Kartha is taken. Our mission has failed."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_56",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%2C5%22%2C%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Useless grunts! We should have taken the gate weeks ago! Fight harder!"),
          },
          {
            tag: "gold",
            side: "2,3,4,5",
            amount: 40,
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: "2,3,4,5",
            income: 18,
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("I think they’ve been reinforced. I really don’t like orcs."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_57",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%2C5%22%2C%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                side: "2,3,4,5",
              },
            ],
          },
          {
            tag: "message",
            text: _("Grr... nasty stinky-midgets. We know what you’re up to in there. We’ll be back."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "cutscene_retreating_enemies",
            kill: "no",
            side: 2,
          },
          {
            tag: "foreach",
            variable: "cutscene_retreating_enemies",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scenario_move",
                id: "$this_item.id",
                x: 40,
