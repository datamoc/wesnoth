                raw: "yes",
              },
              {
                tag: "hook",
                name: "command:kill_unit",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "cutscene_retreating_enemies",
            kill: "no",
            side: 3,
          },
          {
            tag: "foreach",
            variable: "cutscene_retreating_enemies",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scenario_move",
                id: "$this_item.id",
                x: 40,
