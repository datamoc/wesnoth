            id: "Minister Edren",
            unit: "Minister Edren",
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Well, let’s un-petrify that lich and take his book, then get into the sewers. Umm, what language would that book be in?"),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("Some pep talk. The book will probably be in the Old Wesfolk tongue."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Ohh."),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("Just get the book, I think I should be able to translate it."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Then, into Southbay’s sewer."),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("Right."),
          },
