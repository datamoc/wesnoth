          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Inarix",
            unit: "Inarix",
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("If we are going to make it to Bitok, and then back to Dorest before spring, we have to get a move on. Break camp as soon as possible. Destroy all opposition in your path, I want this area to be firmly under my control by the time we are through here."),
          },
          {
            tag: "message",
            speaker: "Braga",
            portrait: "portraits/orcs/warlord.webp~FL()~RIGHT()",
            text: _("Black-Eye! We won’t submit to an upstart like you!"),
          },
          {
            tag: "message",
            speaker: "Meato",
            portrait: "portraits/orcs/grunt-2.webp~FL()~RIGHT()",
            text: _("Turn around and go back to where you came from or you’ll find your head on a pike! Right?"),
          },
          {
            tag: "message",
            speaker: "Ragvan",
            text: _("Right!"),
          },
          {
            tag: "message",
            speaker: "Kergai",
            text: _("Right!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("It’s been a chilly winter. How about we warm ourselves up a bit by giving these traitors a good whupping, boys?"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Yeah!"),
          },
