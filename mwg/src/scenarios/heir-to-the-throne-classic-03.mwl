      },
      {
        tag: "event",
        id: "ev_4",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "30,30,31",
            y: "8,9,10",
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-mad.webp",
            text: _("This is no time to return to our vessel! We must take control of the island!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:add_item",
            x: 25,
            y: 30,
            item_name: "",
            image: "scenery%2Frock3.png",
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: 1,
            mode: "disallow",
            types: "Mage",
          },
          {
            tag: "spawn",
            id: "Delfador",
            type: "Elder Mage",
            side: 1,
            x: 25,
            y: 11,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
