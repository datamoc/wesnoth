            value: "yes",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Look, there’s a dragon in these caves!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Khrakrahs",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "ne",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("You dare trespass into <i>my</i> lair?"),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("And which of the great dragons are you?"),
          },
          {
            tag: "message",
            speaker: "Khrakrahs",
            text: _("I am Khrakrahs, greatest dragon of all time! Haldric killed Shek’kahan my brother, but he was weaker than me, and you will not find me so easy to defeat. Now get out of my volcano!"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("I’d rather face one powerful dragon than hundreds of mighty elves. Continue!"),
          },
        ],
      },
