              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("We have defeated them! Now what do we do?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("We must continue north. It is too late to return to the safety of Elensefar or Alduin before winter falls. We must therefore cross the great river and continue toward the land of the dwarves. Hurry, let us go!"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_13",
          },
          {
