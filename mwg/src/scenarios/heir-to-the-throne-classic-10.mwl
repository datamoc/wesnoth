          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Indeed, the majestic beasts were now circling the mountain’s peak. Several glared in Konrad’s direction, their eagle eyes fixed on him at an incredible distance."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gryphon-shriek-1.ogg",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "gryphon_store",
            kill: "no",
            side: 3,
