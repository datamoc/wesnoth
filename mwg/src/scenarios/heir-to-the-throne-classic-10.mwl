                value: "$this_item.y",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "range_x",
                value: "$temp_x|, $destination_x",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "range_y",
                value: "$temp_y|, $destination_y",
