                filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22x%22%3A%22%24temp_x%22%2C%22y%22%3A%22%24temp_y%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Amazing! I have never before heard of such behavior in gryphons."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("What does it mean?"),
          },
          {
            tag: "message",
