      {
        tag: "event",
        id: "story_8",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("21 IV, 23 YW I never would have been able to escape the trees without ghosts. They had proven their worth and saved my life. Thus Ras-Tabahn had also moved up in my estimation. After we escaped the trees, we met no more resistance on the road, and soon arrived at the meeting place where Ras-Tabahn was waiting."),
          },
        ],
