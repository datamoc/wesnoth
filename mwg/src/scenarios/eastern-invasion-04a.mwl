            x: 1,
            y: 2,
            item_name: "",
            image: "items%2Fgohere.png",
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("... hmm, mercenaries are not known for their loyalty. If we can show we are gaining ground, they may turn and run. If we can defeat their leader, the outcome may be even better."),
          },
        ],
      },
      {
        tag: "event",
