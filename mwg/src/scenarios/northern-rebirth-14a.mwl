        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("After the feast had wound down, everyone gathered in the conquered castle to decide on their course of action."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_6",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Tallin",
          },
        ],
      },
      {
        tag: "objectives",
        side: 1,
        victory: _(""),
