          {
            tag: "message",
            speaker: "Gwaba",
            text: _("Nepba, it’s noon. The orcs are groggy and sleepy. This is our moment!"),
          },
          {
            tag: "message",
            speaker: "Nepba",
            text: _("Let’s just take a look around for now. We must not act rashly."),
          },
          {
            tag: "message",
            speaker: "Gwaba",
            text: _("I looked this morning and the door to the cave with the Trident of Storms is open! When the others see that we’ve reclaimed it, they’ll rise up and we’ll finally drive out the orcs!"),
          },
          {
            tag: "message",
            speaker: "Nepba",
            text: _("I don’t like our odds. Someone could shoot us from the castle while we swim to the entrance."),
          },
          {
            tag: "message",
            speaker: "Gwaba",
            text: _("Let’s try swimming around the cave. There are cliffs and kelp that are easy to hide in."),
          },
