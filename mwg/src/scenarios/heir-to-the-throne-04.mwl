          {
            tag: "switch",
            variable: "temp_village_number",
            children: [
              {
                tag: "case",
                equals: 1,
                children: [
                  {
                    tag: "message",
                    speaker: "1Mer1",
                    text: _("Are you coming to liberate us? Finally, we stand a chance against the orcs!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: 4,
                children: [
                  {
                    tag: "message",
                    speaker: "4Mer1",
                    text: _("Now that we are free, together we can defeat our oppressors!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: 5,
                children: [
                  {
                    tag: "message",
                    speaker: "5Mer1",
                    text: _("Let’s take back the Trident the orcs stole from us!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: 6,
                children: [
                  {
                    tag: "message",
                    speaker: "6Mer1",
                    text: _("Death to the orcs! Come, my brethren, let us fight the orcs and drive them from our shores!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: 8,
                children: [
                  {
                    tag: "message",
                    speaker: "8Mer1",
                    text: _("Thank you for rescuing us! Now we can help you fight the evil orcs!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: 9,
                children: [
                  {
                    tag: "message",
                    speaker: "9Mer1",
                    text: _("Freedom! Now where are those orcs? Let me at ’em!"),
                  },
                ],
              },
            ],
          },
        ],
      },
