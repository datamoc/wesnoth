      {
        tag: "event",
        id: "ev_77",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Jeniver",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("It’s so exciting to finally see woses up close! I hear they have a spectacular resistance to poison! Wose sap... curing — yes, if I could just extract a bucket of wose sap I’m certain I could learn their secrets."),
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("Now, err, well, of course sap extraction would be problematic from a live specimen, them being our allies and all. But, ah, we are on a battlefield. <b><i>We</i></b> don’t have to be the ones doing the cutting."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("You’re asking me to help you rob the dead. Don’t you think that’s a bit ghoulish, Jeniver?"),
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("But just imagine the possibilities! I ask you to help me stand next to a wose when it dies. If I can, I’m sure — yes I’m sure I can gather enough sap to begin curing poisons."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "st_jeniver_troll_flesh_taken",
            value: "yes",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_78",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22race%22%3A%22wose%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent%22%2C%22attributes%22%3A%7B%22id%22%3A%22Jeniver%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("It’s falling over! Oh, now’s my chance to collect some sap!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "magicmissile.wav",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "magicmissile.wav",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Jeniver%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Jeniver",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Konrad",
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("It works! It works! Oh, I knew it! Now, err, I suppose I’d better quickly get back to the battle before the woses wonder what I was doing with their friend."),
          },
        ],
      },
