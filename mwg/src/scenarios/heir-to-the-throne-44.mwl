          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%2C%22canrecruit%22%3A%22no%22%2C%22animate%22%3A%22no%22%2C%22fire_event%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Har hum har ... hmm ... well ... har alam dum ... good."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-glad.webp",
            text: _("Those undead will bother you no more, Sir Wose. Will you join us? We march towards Weldyn, to depose the dark queen Asheviere."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("March? So hasty. Harum-alam-alam ... no, we are not soldiers ... harum ... not at all. And we are not ... hum ... not many."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Hmm ... but there was something ... something to help ..."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Har dum ... oh, yes, the dust."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Dust carried ... har alam dum ... by a skeleton. Something magical. I put it ... harum ... where did I put it..."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gold.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I see it — a pouch of powdered sapphire! A valuable component for all kinds of spells. I used the last of my supply in the defense of Elensefar, and have sorely missed it since. Thank you for your gift, Haralamdum."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mentoring.webp",
            text: _("Konrad, with this I can conjure up powerful earthen elementals. Malal must have stashed it away here. Now it is ours."),
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Konrad",
          },
          {
            tag: "hook",
            name: "command:allow_extra_recruit",
            id: "Delfador",
            types: "Granite Golem",
          },
          {
            tag: "win",
          },
        ],
      },
