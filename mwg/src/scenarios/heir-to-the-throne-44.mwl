      {
        tag: "event",
        id: "ev_74",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Here we are! Whatever evil lurks within these caves, we shall put an end to it."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 750,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "wose-die.wav",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "wose-die.wav",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 4,
            fog: "yes",
            shroud: "yes",
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Well, I say ... hmm dum har ... young Master Delfador?"),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Harum-alam-alam. So it is! Hmm hmm alam ... how is ... hum ... the ambassador? He was here ... hmm ... just the other day."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("That was many years ago, I’m afraid. You are the woses who once resided at the Grey Grove? I see you have learned the language of men."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Hmm ... yes ... alam ... alam dum ... very useful ... language ... yes ... hum ... now these undead ... harum ... very troubling."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("I am sure ... dum hum ... you could help rid us of these ... alam hurum ... infernal undead ... yes, harum-alam-alam. Afterwards, we could perhaps... hmm ... help you too. Har alam dum."),
          },
        ],
      },
