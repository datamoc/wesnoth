            time: 250,
          },
          {
            tag: "spawn",
            id: "Galdrad",
            type: "Elvish Champion",
            side: 6,
            x: 0,
            y: 11,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Galdrad",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Galdrad",
            x: 1,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Ethiliel",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Galdrad",
            text: _("Ethiliel! What in Irdya is going on here?"),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            portrait: "portraits/ethiliel-mad.webp",
            text: _("These snakes have captured Mebrin, and committed who knows what horrible atrocities against him! Galdrad, we must take him back!"),
          },
          {
            tag: "message",
            speaker: "Galdrad",
            text: _("Kidnapped Mebrin? I have heard otherwise. Ethiliel, this is Urza Afalas of the humans."),
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_afalas",
            x: 1,
            y: 12,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Afalas",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "ne",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Afalas",
            x: 0,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Ethiliel",
            x: 1,
            y: 9,
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            text: _("We’ve met. This absolute scum, pig of a mudling—"),
          },
          {
            tag: "hook",
            name: "command:harm_unit",
            amount: 6,
            damage_type: "impact",
            delay: 0,
            animate: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Afalas%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Afalas",
            primary_attack_name: "ensnare",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Afalas",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.status.slowed",
                value: "yes",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Afalas",
            text: _("Argh!"),
          },
          {
            tag: "message",
            speaker: "Galdrad",
            text: _("Enough, Ethiliel! I can corroborate the humans’ story. Some days ago, this outlaw came to me with unlikely words."),
          },
          {
            tag: "message",
            speaker: "Afalas",
            text: _("...yeah, I did. I heard them rangers in the forest southways, knew they’d be wantin’ my head. I could’a ran and hid, but I wanted to make things right. I went and found Mebrin’s bones, and brought them to the Aethenwood."),
          },
          {
            tag: "message",
            speaker: "Afalas",
            text: _("You may think us men to all be criminals and outlaws, but we’re still living beings, and we still know justice an’ truth. My brothers an’ I did wrong. It’s my responsibility to make things right."),
          },
          {
            tag: "message",
            speaker: "Galdrad",
            text: _("Afalas’ words could have seen him imprisoned, or worse, but at the height of my anger he produced the skull of a lich. The druids confirmed it — the skull was Mebrin’s."),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            portrait: "portraits/ethiliel-mad.webp",
            text: _("The Mebrin I know is so gentle. So wise! It cannot be... can it?"),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            text: _("I did not want to believe the humans’ words. I could not bear to believe... But if Mebrin really did turn to undeath, then I have been the cause of so much meaningless bloodshed."),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            text: _("It’s true, isn’t it..."),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            text: _("..."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Ethiliel",
            x: 2,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Ethiliel",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            text: _("Urza Afalas, thank you. I see now that not all humans are alike, and that you, too, are capable of courage and loyalty. Vengeance only begets more vengeance. You — and your brothers, posthumously — are forgiven."),
          },
          {
            tag: "message",
            speaker: "Afalas",
            text: _("<i>You</i> forgive <i>me</i>! After all the blood—"),
          },
          {
            tag: "message",
            speaker: "Galdrad",
            text: _("And Urza Afalas graciously accepts your forgiveness. Now come, Ethiliel. You have been away from your people for far too long. Our attack against Westin is over."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "epilogue",
            value: "elves",
            mode: "value",
          },
          {
            tag: "win",
          },
        ],
      },
