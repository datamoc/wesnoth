          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22race%22%3A%22orc%2Cgoblin%22%2C%22animate%22%3A%22no%22%2C%22fire_event%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("Oh, what’s this? Seems one of our young magi knows how to seize the initiative."),
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("A proper war-mage is far too valuable to waste on the front lines; I may have a special assignment for you. What’s your name, boy?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("<i>(_Commendation from the king himself! This is a dream come true.)</i>"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I’d be honored, my lord! But I can’t give you my name — I’m just an apprentice; Alduin has not yet assigned me one. And... I suppose I shouldn’t want to leave without my master’s blessing..."),
          },
          {
            tag: "message",
            speaker: "Methor",
            text: _("By the traditions of our order, no apprentice shall venture alone; that privilege is first awarded only to the journeymen!"),
          },
          {
            tag: "message",
            speaker: "Methor",
            text: _("...but apprentice, truth be told, you’ve had a journeyman’s skill for quite some time now. I was hoping to impart a little more wisdom before advancing you, but now I understand that fate has other plans."),
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Methor%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Methor",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
          },
          {
            tag: "message",
            speaker: "Methor",
            text: _("Thorum restro targa thorum..."),
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Methor%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Methor",
            object: "%7B%22id%22%3A%22skill_ghostcapture_standing%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "lightning.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 150,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "lightning.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 150,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "lightning.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 150,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Methor",
            text: _("The light waxes bright. By the power of the high provost and the blessing of the five sages, I declare you to be nameless NO LONGER!"),
          },
          {
            tag: "message",
            speaker: "Methor",
            text: _("<i><b>DELFADOR</b></i> you shall be, and Delfador shall be YOU."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "door-close.wav",
          },
          {
            tag: "hook",
            name: "command:remove_object",
            object_id: "skill_ghostcapture_standing",
            id: "Methor",
          },
          {
            tag: "message",
            speaker: "Methor",
            text: _("Delfador, open your eyes. And OPEN THEM AGAIN! I grieve for the apprentice I have lost, but I celebrate the journeyman Wesnoth has gained. Your naming ceremony is complete."),
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Delfador",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "delfador",
            kill: "yes",
            id: "Delfador",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Delfador",
          },
          {
            tag: "hook",
            name: "command:store_unit",
