      {
        tag: "event",
        id: "ev_79",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Garard",
            text: _("At last, here we stand on the eve of battle! Remember the plan: General Lionel, soften up the orcish warriors while my knights look for an opening; Methor, command the camp in my absence — those goblin raiders are still being a nuisance."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 0,
            y: 16,
          },
          {
