          },
          {
            tag: "message",
            speaker: "Carcyn",
            text: _("Carcyn Fisher at your service, and this is my friend Shynal."),
          },
          {
            tag: "message",
            speaker: "Shynal",
            text: _("“Friend?” (<i>Giggle</i>) Oh, yes, we’re very good friends."),
          },
          {
            tag: "message",
            speaker: "Carcyn",
            text: _("Or... you know. Thanks so much for getting us out, sir. We would be glad to follow you!"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("You are Carcyn the Third I presume?"),
          },
        ],
