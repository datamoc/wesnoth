      {
        tag: "event",
        id: "ev_18",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("Greetings! I am Ras-Tabahn the mage."),
          },
          {
            tag: "message",
            speaker: "Carcyn Fisher",
            text: _("Greetings, traveler. I am Carcyn Fisher the Second. How can I be of service?"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("I come with an offer. An offer of training in the magical arts. An offer of learning, adventure, and escape from this town."),
          },
          {
            tag: "message",
            speaker: "Carcyn Fisher",
            text: _("No one in <i>my</i> town wishes to “escape”! We don’t care to hear your offer. Peddle your corruption elsewhere."),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("The offer is not intended for <i>you</i>, it is for your youth. I will send my agents to every house and public space in this town and repeat my offer. You will allow this."),
          },
          {
            tag: "message",
            speaker: "Carcyn Fisher",
            text: _("I will do no such thing! I will be dead before I allow you to ensorcell our children!"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("That may well be true."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("Hmm. The youngsters most willing to leave may be the ones in the jailhouse. I should investigate."),
