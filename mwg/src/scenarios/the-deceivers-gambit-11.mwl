          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Drakefador",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Drakefador",
            text: _("Saurians of Saurgrath! It is I, your Great One, bringing an even greater warning!"),
          },
          {
            tag: "message",
            speaker: "Drakefador",
            text: _("These orcs have, umm, conspired to betray you! You must strike first and kill them all — now hear me and obey!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "defector4",
            text: _("Can it be? The Great One ssspeaksss to usss! I am not worthy! I am blessed to hear your great voice, unusssual though it may be!"),
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            id: "Drakefador",
            hidden: "yes",
          },
          {
            tag: "message",
            speaker: "defector3",
            text: _("Yesss, the great fiery one has sssaved usss! If the orcsss will betray us, then we mussst ssstrike firssst!"),
          },
          {
            tag: "message",
            speaker: "defector2",
            text: _("...caution, caution, ssomething isss not right! Where are the ssseven matriarchsss? Why does the Great One ssspeak ssso nasssally?"),
          },
          {
            tag: "message",
            speaker: "defector3",
            text: _("Do you not sssee her majesssty? It isss not our place to quessstion the great fiery one!"),
          },
          {
            tag: "message",
            speaker: "Ghuvog",
            text: _("Shut it, all of you! I don’t know why any of youse care what some off-brand dragon says, but don’t forget that you lizards made a deal to fight with us against Wesnoth. Even paid <i>us</i> for the privilege, you dumb little worms! Now form up and get in line, before I have to beat some discipline into you!"),
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 3,
            color: "green",
          },
          {
            tag: "message",
            speaker: "defector1",
            text: _("You insssult usss! Worssse, you dare insssult the Great One! Curssses upon you, cursses upon you! We ssshall fight you, we mussst fight you!"),
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: "4,5,6",
            color: "green",
          },
          {
            tag: "message",
            speaker: "defector3",
            text: _("Yesss, we mussst fight! Fight the orcsss!"),
          },
          {
            tag: "message",
            speaker: "Ghuvog",
            text: _("Oh yeah? Try me, you filthy sacks of lizard slime; I’ll teach youse your proper place! To arms, Blackcrests!!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:teleport",
            id: "Drakefador",
