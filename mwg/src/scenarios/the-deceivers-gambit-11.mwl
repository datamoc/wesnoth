      {
        tag: "event",
        id: "ev_147",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Ghuvog%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "trigger_before_victory",
          },
          {
            tag: "message",
            speaker: "Ghuvog",
            text: _("All right, all right, I know when I’m beat! Let’s not be hasty, there’s no need for more death and violence. <span size='x-small'>Against me, anyhow. Nasty pink-skin whelps.</span>"),
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("Watch your tongue, vermin! I am no ’whelp’, but King Garard of Wesnoth, second of his name! And in that name, for the Kingdom of Wesnoth, I hereby annex these lands from the Great River in the south to the foothills of the Heart Mountains in the north! You orcs shall fall beneath our swords as wheat before the scythe!"),
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("...but I am no fool. Wesnoth is tired of war, and your lord Garard is nothing if not merciful. I will spare your life and the life of your warriors, on one condition. You must hereby swear an oath to gather both your clan from here, and Clan Whitefang from the hills around Fort Garard. You shall leave these lands and never return so long as I draw breath, on pain of death!"),
          },
          {
            tag: "message",
            speaker: "Ghuvog",
            text: _("Yeah yeah yeah, whatever you say. We was just leaving; isn’t that right, boys? <span size='x-small'>Nasty filthy pink-skins.</span>"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Ghuvog",
            x: 25,
            y: 12,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Ghuvog",
            x: 28,
            y: 5,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Ghuvog",
            x: 18,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            all: "yes",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_148",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "skill_polymorph_stoat_cancel",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "skill_illusion_cancel",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("After all this time... Wesnoth is finally at peace. It is as if a veil of shadows has been lifted from upon my eyes!"),
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("Delfador, you rascal, you’ve truly outdone yourself this time. They tell me how you turned the saurians against the orcs, sowed chaos from behind; truly incredible!"),
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("Delfador the “Great One”, hah! Now that’s the stuff legends are made of. So legendary, in fact..."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "Delfador",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "delfX",
            value: "$STORE_UNIT_VAR_store.x",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "Delfador",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "delfY",
            value: "$STORE_UNIT_VAR_store.y",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Garard",
            x: "$delfX",
            y: "$delfY",
            raw: "yes",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("“The Great” you were called by the enemy, and “The Great” you shall be called until the end of your days. Kneel, Delfador, war-mage of Wesnoth. And rise, “Delfador the Great”, High Advisor to the Crown!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "delfador",
            kill: "yes",
            id: "Delfador",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Garard",
            text: _("Now come, let us celebrate my— our— ...all right, <i><b>your</b></i> success! Victory! Victory! Victory by the name of Delfador!!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_methor",
            kill: "yes",
            id: "Methor",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_garard",
            kill: "yes",
            id: "Garard",
          },
          {
            tag: "win",
          },
        ],
      },
