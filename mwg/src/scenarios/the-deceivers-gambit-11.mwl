          {
            tag: "message",
            speaker: "$companion_id",
            text: _("Whaddid you say, boss?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Oh, nothing. I feel like something bad normally happens if we take this long to finish a battle, but right now everything seems fine."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("We’re <i>definitely not</i> missing out on significant events happening elsewhere... events that we really should have been present for..."),
          },
          {
            tag: "lose",
          },
        ],
      },
