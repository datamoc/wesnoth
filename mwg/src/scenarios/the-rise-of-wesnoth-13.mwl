      {
        tag: "event",
        id: "story_21",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: _("story/trow_story_13-Peoples_in_Decline.webp"),
            text: _("The island that King Haldric and his crew are approaching was at one time a volcano that is now slowly sinking into the sea. The elder Crown Prince of Southbay had managed to establish a foothold on this Island, despite the belligerent nature of its reptilian inhabitants. There will be little left of that foothold by now."),
          },
        ],
      },
