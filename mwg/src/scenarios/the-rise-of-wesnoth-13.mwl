      {
        tag: "event",
        id: "ev_14",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("After some time at sea an island is spotted. The Eldaric docks at a crude port that appears to be deserted."),
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            text: _("Land! Land! Bless the Lords of Light!"),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("This is the Elder Prince’s island all right. We had a heck of a time pacifying the drakes who live here. Oh my, it looks like they’ve rearmed!"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("We come in peace. We only seek to re-provision our ships."),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("<small>(_I don’t think diplomacy is going to work.)</small>"),
          },
          {
            tag: "message",
            speaker: "Garash",
            text: _("So, prey, you have come to trouble us again. Prepare to die! For the glory of Morogor!"),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("<small>(_Do I need to say, <i>“I told you so”</i>?)</small>"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "new_turn",
        once: true,
        children: [
