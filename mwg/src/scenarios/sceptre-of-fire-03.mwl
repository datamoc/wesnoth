            text: _("Ah! Go away!"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Was that Thursagan? Finding him wasn’t as difficult as I thought it would be."),
          },
          {
            tag: "message",
            speaker: "Baglur",
            text: _("Och, but it donna mean much unless he stops running away from us."),
          },
          {
            tag: "set_variable",
            name: "thursagan_hunt",
            value: -1,
          },
        ],
      },
