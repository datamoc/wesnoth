            variable: "thursagan_hunt",
            value: -1,
            mode: "add",
          },
          {
            tag: "message",
            speaker: "$unit.id",
            text: _("Another empty shack... But there is this suspicious slab of wood. Let’s see what’s underneath, shall we?"),
          },
          {
            tag: "switch",
            variable: "thursagan_hunt",
            children: [
              {
                tag: "case",
                equals: 3,
                children: [
                  {
                    tag: "message",
                    speaker: "narrator",
                    portrait: "portraits/thursagan.webp",
                    text: _("What do you people want?! Leave me alone!"),
                  },
                  {
                    tag: "message",
                    speaker: "Rugnur",
                    text: _("Old sage, we come with a message from Lord Durstorn. He asks you to come back to the city."),
                  },
                  {
                    tag: "message",
                    speaker: "narrator",
                    portrait: "portraits/thursagan.webp",
                    text: _("Ha! That fool thinks he can order me around. Why does he want me to go back, anyway?"),
                  },
                  {
                    tag: "message",
                    speaker: "Baglur",
                    text: _("We have entered into a bargain with the King of Wesnoth to craft a sceptre for him."),
                  },
                  {
                    tag: "message",
                    speaker: "narrator",
                    portrait: "portraits/thursagan.webp",
                    text: _("Oh, and now I suppose Durstorn wants me to craft it, eh? Well I’m not going to."),
                  },
                  {
                    tag: "message",
                    speaker: "$unit.id",
                    text: _("He just ducked back down underground..."),
                  },
                  {
                    tag: "hook",
                    name: "command:play_sound",
                    file: "rumble.ogg",
                  },
                  {
                    tag: "hook",
                    name: "command:scroll_to",
                    x: 4,
                    y: -1,
                  },
                  {
                    tag: "hook",
                    name: "command:scroll_to",
                    x: -11,
                    y: -1,
                  },
                  {
                    tag: "hook",
                    name: "command:scroll_to",
                    x: 4,
