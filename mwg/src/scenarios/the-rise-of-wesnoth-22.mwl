      {
        tag: "event",
        id: "ev_18",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Haldric approaches the place where Lich-Lord Jevyan has made landfall. The final confrontation looms before him."),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Jevyan",
            text: _("You cannot win. Give me the Ruby of Fire and I will go in peace."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("This ends here, Jevyan. Even if I believed your words I couldn’t give you the Ruby of Fire."),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Jevyan",
            text: _("Bah! Even if you have learned to conceal the power of the Ruby of Fire you will deliver it unto me in death!"),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("You’re a fool, Jevyan. How do you think we secured our place here? We had to give the elves the Ruby of Fire. We just signed a treaty with the elves ensuring our place here."),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Jevyan",
            text: _("No! I don’t believe it. Only a fool would give away an artifact of such power."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            portrait: "portraits/haldric-mad.webp",
            text: _("A fool, or a desperate band of refugees!"),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Jevyan",
            text: _("Casting fire is the least of the Ruby’s abilities. You are twice a fool, for having failed to plumb more than its most trivial use and for having given it away."),
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            text: _("You shouldn’t give such toys to elves! Bah! It matters little to me. I’m no wizard. All I got is my axe. Heh, heh. It’s all I need — prepare to die, orcish scum!"),
          },
          {
            tag: "message",
            speaker: "Minister Edren",
            text: _("Ha. Let all of the minions of Darkness be cast down!"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            portrait: "portraits/haldric-mad.webp",
            text: _("It matters little, because here you fall!"),
          },
          {
            tag: "message",
            speaker: "Sir Ruddry",
            text: _("For all of the good people of Clearwater Port!"),
          },
          {
            tag: "message",
            speaker: "Sir Ladoc",
            text: _("For the honor of Southbay!"),
          },
          {
            tag: "message",
            speaker: "Commander Aethyr",
            text: _("We don’t need some magic trinket to beat you! Prepare to meet your fate, you decrepit sack of bones! For the honor of all of the people of the west-north!"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            portrait: "portraits/haldric-mad.webp",
            text: _("Charge!"),
          },
          {
            tag: "message",
            speaker: "Ut'Tan-Grorag",
            text: _("I hate it when my prey gets chatty! Get them, it’s a long boat ride back home!"),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Jevyan",
            text: _("We shall soon see if you have the Ruby of Fire!"),
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            type: "Jevyan Cloaked",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Jevyan%20Cloaked%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "message",
            speaker: "Familiar",
            text: _("<i>Clack</i>! <i>Clack!</i>"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("<small>(_Commander, you remember the plan right?)</small>"),
          },
          {
            tag: "message",
            speaker: "Commander Aethyr",
            text: _("<small>(_Yes, sir. I am ready.)</small>"),
          },
        ],
      },
