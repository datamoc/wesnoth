      {
        tag: "event",
        id: "if_152",
        on: "branch_if_152",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_met_lisar_early",
            equals: "yes",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("We meet again, princess! I’ve beaten you before, and I’ll do so again. Elensefar deserves a better ruler than you."),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("Konrad. I underestimated you once before — never again. You should have picked a different battle, princeling."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_153",
        on: "branch_if_153",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "bm_met_lisar_early",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-mad.webp",
            text: _("Your Highness, we meet at last! I’ve heard stories about the battles you’ve won in your mother’s name. I won’t let Elensefar be one of them!"),
          },
          {
            tag: "message",
            speaker: "Lisar",
            portrait: "portraits/lisar-mad.webp",
            text: _("Hello, “Konrad.” I think you’re a little out of your depth, pretender — the battlefield is no place for a con man."),
          },
          {
            tag: "message",
            speaker: "Lisar",
            portrait: "portraits/lisar-mad.webp",
            text: _("Your lies have sown enough discord and chaos among my people. How convenient that you’re here; I can capture both you and Maddock at the same time."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_154",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 9,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Lisar",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Maddock",
            text: _("Elensefar has weathered countless storms, Your Highness. Your queen will be neither the first nor the last that breaks upon our shores."),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("You’ve been a capable lord, Maddock, and from what I can tell you truly care about your city. If it’s any consolation, when all’s said and done I intend to make sure you stand a fair trial."),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("As for you, Delfador... you’re going to regret what you did to my brother."),
          },
        ],
      },
