      {
        tag: "event",
        id: "ev_35",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Alanin",
            unit: "Alanin",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Baglur",
            unit: "Baglur",
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Those are orcs, aren’t they?"),
          },
          {
            tag: "message",
            speaker: "Baglur",
            text: _("Aye, in all their destructive glory. Looks like they’re trying to strip the metal from the rails."),
          },
          {
            tag: "message",
            speaker: "Alanin",
            text: _("That’s terrible, someone should stop them!"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Do orcs always stink so bad? I’ve heard that they are stupid and messy, but this is almost unbearable!"),
          },
          {
            tag: "message",
            speaker: "Bragdash",
            text: _("We see you, we hear you, sneaky little moles! Pidmer, go skewer them!"),
          },
          {
            tag: "message",
            speaker: "Pidmer",
            text: _("Um... aren’t we needed for the salvage?"),
          },
          {
            tag: "message",
            speaker: "Bragdash",
            text: _("No! You’ve been straining and struggling, but those metal tracks defeat you! It takes a strong orc to break that steel, you go deal with those little cave rats. You can keep their shiny helmets, they might fit you!"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Uh, well, we’re not getting through without a fight..."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Rugnur",
            x: 12,
            y: 26,
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("... let’s set up a base here."),
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Ce",
            cells: "12-14,25",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Ke",
            cells: "12,26",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Ur^Vct",
            cells: "10,27",
          },
          {
            tag: "hook",
            name: "command:capture_village",
            side: 1,
            cells: "10,27",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_36",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 9,
            y: 24,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22This%20old%20cart%20still%20rolls%20smoothly%20on%20the%20track...%20it%E2%80%99s%20forged%20by%20us%20dwarves%2C%20I%20shouldn%E2%80%99t%20be%20surprised!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22narrator%22%2C%22image%22%3A%22wesnoth-icon.png%22%2C%22message%22%3A%22A%20dwarf%20can%20ride%20the%20carts%20along%20the%20tracks.%20Use%20the%20context%20menu%20(usually%20right-click%20menu)%20to%20board%20or%20exit%20the%20cart.%20If%20a%20cart%20rider%20is%20involved%20in%20combat%2C%20the%20rider%20exits%20the%20cart.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("This old cart still rolls smoothly on the track... it’s forged by us dwarves, I shouldn’t be surprised!"),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("A dwarf can ride the carts along the tracks. Use the context menu (usually right-click menu) to board or exit the cart. If a cart rider is involved in combat, the rider exits the cart."),
          },
        ],
      },
