          {
            tag: "message",
            speaker: "Tallin",
            text: _("There he goes! Quick, get him!"),
          },
          {
            tag: "message",
            speaker: "starting_speaker",
            text: _("I don’t think so, you living vermin."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("We’ll have to kill these revenants to get after him. There are only two of them. This shouldn’t last long."),
