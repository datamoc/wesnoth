            side: 1,
            x: "18-20",
            y: "28-30",
          },
          {
            tag: "message",
            text: _("Uh... Which way?"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Blast it! We lost him."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("It makes no difference in the end, because we will hunt him down and crush him to powder. HEAR THAT, YOU OLD SKELETON?"),
          },
          {
            tag: "message",
            speaker: "Malifor",
            text: _("(<i>Faint cackle of laughter in the distance</i>)"),
          },
          {
            tag: "message",
            speaker: "Camerin",
            text: _("Yeah! This is gonna be fun!"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Let us proceed with caution. Nobody is to go off by himself. We don’t know what could be lurking in these tunnels."),
          },
