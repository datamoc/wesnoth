            unit: "Sister_Thera",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Sister_Thera",
          },
          {
            tag: "message",
            speaker: "Sister Thera",
            text: _("Freedom at last! Thank you, Lord Tallin."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Just ‘Tallin’. I am no Lord, just a humble peasant trying to restore our people to freedom."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "$unit.id",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            text: _("Look at this. There’s some sort of opening in the wall..."),
          },
          {
            tag: "message",
            speaker: "Sister Thera",
            text: _("It was there when I was thrown down here. The hole wasn’t big enough for me to go through, but perhaps one of you might enlarge it?"),
          },
          {
            tag: "message",
            text: _("Hmmm, let’s see..."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "cave-in.ogg",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Uu",
            cells: "3,27",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            text: _("There we go. Now let’s see where this tunnel leads."),
          },
        ],
      },
      {
