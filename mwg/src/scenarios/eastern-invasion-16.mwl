        on: "capture",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_capturer_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "owner_side",
                less_than_or_equal_to: 4,
              },
              {
                tag: "predicate",
                name: "lua_condition",
                code: "return wesnoth.current.turn<=5",
              },
            ],
          },
          {
            tag: "set_variable",
            name: "search_radius",
            value: 0,
          },
          {
            tag: "while",
            test: "wml_condition_tree('tree=%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22found_unit.length%22%2C%22greater_than%22%3A%220%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22search_radius%22%2C%22less_than_equal_to%22%3A%2299%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D')",
            children: [
              {
                tag: "hook",
                name: "command:store_unit",
                variable: "found_unit",
                kill: "no",
                side: "$owner_side",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "search_radius",
                value: 1,
                mode: "add",
              },
            ],
          },
          {
            tag: "message",
            speaker: "$found_unit.id",
            text: _("Sire, you are of course welcome to capture any of my villages if you need them, but please know that it will make it more difficult to heal my injured soldiers."),
          },
        ],
