      {
        tag: "event",
        id: "ev_51",
        on: "elf_alliance",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "s04_phase",
            value: "elf_alliance",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("Your crimes are too great, Urza Afalas, and your word cannot be trusted. You will fall alongside the undead you helped create!"),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            portrait: "portraits/ethiliel-mad.webp",
            text: _("You will pay for taking Mebrin from us! Once I rescue him from your clutches, I never again intend to leave his side."),
          },
          {
            tag: "message",
            speaker: "Afalas",
            text: _("Then this parley is over! You may have caused the doom of all of us!"),
          },
          {
            tag: "hook",
            name: "command:reset_fog",
          },
          {
            tag: "hook",
            name: "command:config_side",
