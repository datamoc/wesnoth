      {
        tag: "event",
        id: "ev_66",
        on: "trigger_mebrin",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "s04_phase",
                equals: "bandit_alliance",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("Who comes... My old tormentors?"),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("I am Deoran, soldier of the South Guard! We have come to put an end to your villainy, Mebrin of the elves — if that is who you are."),
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("Mebrin? No, I am called Mal M’Brin now, mortals. It is the name I took when I unchained myself from the shallow-mindedness of my kind and passed over into enlightenment."),
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("There is infinity at the brink of death... I have touched the void at the heart of all things, and I have begun to probe the mystic arts far beyond what any living elf knows."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Skeleton Archer",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_67",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Skeleton",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_68",
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 8,
            recruit: "Skeleton Archer",
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("Rise, my minions, and let all vermin tremble! The race of man shall be stricken off the face of the green world. Your corpses will serve me! Your bones will dance for my pleasure! I’ll make humanity into the mindless slaves that you all deserve to be!"),
          },
          {
            tag: "message",
            speaker: "Afalas",
            text: _("I done enough evil in my life. Time t’ do somethin’ good fer a change."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            portrait: "portraits/deoran-mad.webp",
            text: _("Attack!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_71",
        on: "new_turn",
        once: false,
      },
      {
        tag: "event",
        id: "ev_72",
        on: "moveto",
        once: true,
        children: [
