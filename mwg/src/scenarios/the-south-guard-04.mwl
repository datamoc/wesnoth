      {
        tag: "event",
        id: "ev_59",
        on: "bandit_alliance",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "s04_phase",
            value: "bandit_alliance",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("I am sorry Ethiliel, but Afalas’s words ring true. If Mebrin has truly fallen to undeath, then mankind must unite against him."),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            text: _("You would free me from one Urza, only to betray me to another? All you humans are the same! You are no better than these outlaws, the very pigs who defiled your dead and sacked your farms."),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            portrait: "portraits/ethiliel-mad.webp",
            text: _("Deoran, even your conspiring with criminals shall not keep from us our greatest sage. Soon all of you vile humans shall learn that the Aethenwood protects its own!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
