          {
            tag: "hook",
            name: "command:recall_unit",
            id: "$companion_id",
            unit: "$companion_id",
            x: 3,
            y: 5,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "$companion_id",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
