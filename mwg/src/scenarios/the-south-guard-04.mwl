              },
              {
                tag: "variable",
                name: "s04_phase",
                equals: "bandit_alliance",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("Yes, yes, step into the mouth of my cave. Fight me in the dead of night, when I am at my best!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_74",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 8,
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("You dare strike me?! Puny humans, I’m darkness incarnate! I’m power beyond your comprehension!"),
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("<b><i>You</i></b> think you can destroy <b><i>me</i></b>? Were Ethiliel here I might have held back, but you humans are nothing but a worthless blight upon this wretched world. Suffer and die."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_73",
