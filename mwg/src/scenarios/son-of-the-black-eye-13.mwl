            name: "command:config_recruit",
            side: 1,
            mode: "disallow",
            types: "Saurian Skirmisher, Saurian Augur",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "last_breath",
        once: true,
        children: [
          {
