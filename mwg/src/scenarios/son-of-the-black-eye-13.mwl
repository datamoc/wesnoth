      {
        tag: "map",
        id: "scenario_13_The_Dwarvish_Stand",
        file: "13_The_Dwarvish_Stand.map",
      },
      {
        tag: "unit",
        id: "Kapou_e",
        type: "Orcish Leader",
        side: 1,
        x: 6,
        y: 16,
      },
      {
        tag: "unit",
