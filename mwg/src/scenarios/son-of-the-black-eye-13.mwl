          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Blast it, without Inarix to lead her saurians, we can no longer count on their help."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "got_saurians",
            value: "no",
            mode: "value",
