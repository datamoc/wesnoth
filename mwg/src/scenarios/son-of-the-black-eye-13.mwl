            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.name",
                value: "Pelondras",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "if_9",
        on: "branch_if_9",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "darstang_dead",
            equals: "yes",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Darstang",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.name",
                value: "Trithalsul",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "start",
        once: true,
        children: [
          {
            tag: "spawn",
            id: "Thelarion",
            type: "Elvish Champion",
            side: 4,
            x: 17,
            y: 1,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Thelarion",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_8",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_9",
          },
          {
            tag: "message",
            speaker: "Darstang",
            text: _("My my, look at this, two abandoned keeps. Probably built by those orcs in one of their pointless wars against each other."),
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_Kapoue",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_AlBrock",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_FlarTar",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Grüü",
            unit: "Grüü",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Jetto",
            unit: "Jetto",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Inarix",
            unit: "Inarix",
          },
          {
            tag: "message",
            speaker: "Thelarion",
            text: _("Blast it, the orcs have caught up to us."),
          },
          {
            tag: "message",
            speaker: "Darstang",
            text: _("Elf, our kind can move and fight far better and faster in these conditions than your kind can. Take the orcish prisoners and hurry to Melmog. The dwarves shall stop this orcish menace!"),
          },
          {
            tag: "message",
            speaker: "Thelarion",
            text: _("Very well, but our human allies will also stay behind and help you. After all, we are dealing with the Son of the Black-Eye here."),
          },
          {
            tag: "message",
            speaker: "Darstang",
            text: _("Bah, have it your way then. Now, hurry on your way elf."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Thelarion",
          },
          {
            tag: "message",
            speaker: "Darstang",
            text: _("Bah, cowardly little elves. No dwarf would have ever agreed to such a proposal. Good riddance too, those elves just get in the way. Come on men, it’s time to show those orcs our steel!"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("Ahhh, nice. I finally get chance to squash dwarves again."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue-angry.webp~FL()~RIGHT()",
            text: _("Let’s make them pay for what they did to our people. Blood and steel!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Victory! ... Grüü, what <i>is</i> that you are eating?"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("A human-worm’s dog. Animal meat very tasty. When we fight humans again, can I have a pony?"),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kapou'e%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I’m done. My people are doomed!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Orcish%20Shaman%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Ouch! This hurts!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("The Council will never be complete again. This is hopeless."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gr%C3%BC%C3%BC%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Oh no, I am defeated."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "if_15",
        on: "branch_if_15",
        once: true,
        children: [
          {
            tag: "condition",
