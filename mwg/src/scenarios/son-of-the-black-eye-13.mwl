        tag: "event",
        id: "ev_3",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_Kapoue",
            kill: "yes",
            id: "Kapou'e",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_AlBrock",
            kill: "yes",
            id: "Al'Brock",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_FlarTar",
            kill: "yes",
            id: "Flar'Tar",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_4",
        on: "prerecruit",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_recruit_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%2C2%2C3%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "unit.upkeep",
            value: "$unit.level",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "unit.upkeep",
            value: 1,
            mode: "sub",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "unit.variables.great_horde_upkeep_mod_applied",
            value: "yes",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "unit",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "horde_units",
            kill: "yes",
            side: "1,2,3",
          },
          {
            tag: "foreach",
            variable: "horde_units",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.upkeep",
                value: "$this_item.level",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.upkeep",
                value: 1,
                mode: "sub",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.variables.great_horde_upkeep_mod_applied",
                value: "yes",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "post_advance",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_advance_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%2C2%2C3%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_wml%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22modifications%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22loyal%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "unit.upkeep",
            value: "$unit.level",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "unit.upkeep",
            value: 1,
            mode: "sub",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "unit.variables.great_horde_upkeep_mod_applied",
            value: "yes",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "unit",
          },
        ],
      },
      {
        tag: "event",
        id: "if_8",
        on: "branch_if_8",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "thelarion_dead",
            equals: "yes",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Thelarion",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
