          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 29,
            y: 14,
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("Your Highness! We have finally found you! Thank the Bright Gods you are free! Your father had originally sent us to rescue you."),
          },
          {
            tag: "message",
            speaker: "Eryssa",
            text: _("Yes, or so I have heard. You honor me, but this brave man reached the mark before you."),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("You must be the famous Tallin."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("At your service."),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("We have heard much of your intelligence and courage. The number of humans over the centuries who have earned the respect and admiration of the Northern Elves are extremely few, but you are one of them."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("I am honored, sir, and I hope that I will live up to the trust that the Northern Elves have bestowed upon me."),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("I am sure you will, Tallin. The trust of the elves is seldom misplaced. Also know that the Northern Enclaves will always be open to you."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Thank you, sir."),
          },
          {
            tag: "message",
            speaker: "Eryssa",
            text: _("What is the status of our troops, Hidel?"),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("They are all here, my lady! Hand picked by your father — the finest and bravest elvish troops in the entire Northlands."),
          },
          {
            tag: "message",
            speaker: "Eryssa",
            text: _("Excellent! We shall assist Tallin to the fullest in crushing the orcish host. Not only are we in debt to him but by doing so we will be serving our cause as well as we serve his."),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("As you wish, my lady."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Very well, people. The road ahead is clear, onward to victory!"),
          },
        ],
      },
