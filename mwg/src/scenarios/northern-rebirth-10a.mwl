          },
          {
            tag: "message",
            speaker: "Supporter",
            text: _("Hey! Where is he going?"),
          },
          {
            tag: "message",
            speaker: "Camerin",
            text: _("Krash man, you’re gonna miss all the fun!"),
          },
          {
            tag: "message",
