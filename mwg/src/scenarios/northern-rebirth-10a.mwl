      {
        tag: "event",
        id: "ev_9",
        on: "elvish_money",
        once: true,
        children: [
          {
            tag: "spawn",
            id: "Himadrin",
            type: "Elvish Outrider",
            side: 6,
            x: 27,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Himadrin",
          },
          {
            tag: "message",
            speaker: "Himadrin",
            text: _("Which one of you rabble is Tallin?"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("I am."),
          },
          {
            tag: "message",
            speaker: "Himadrin",
            text: _("Princess Eryssa sends you this gold along with the order to stay clear of any Northern Elf if you know what’s good for you."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Why? What did I ever do to the Northern Elves?"),
          },
          {
            tag: "message",
            speaker: "Himadrin",
            text: _("The ill treatment that she received while in your care is an insult to every Northern Elf. Consequently if you, or any of your henchmen show your face around us ever again, you will be shot on sight."),
          },
          {
            tag: "gold",
            side: 1,
            amount: 1500,
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Tell the Princess to get off her high horse and stop acting like such a priss!"),
          },
          {
            tag: "message",
            speaker: "Himadrin",
            text: _("You dare insult our princess!"),
          },
          {
            tag: "message",
            speaker: "Ro'Arthian",
            text: _("You better get lost, elf, before we kill you."),
          },
          {
            tag: "message",
            speaker: "Himadrin",
            text: _("This insult will forever be remembered by the Northern Elves! The day will soon come when your race shall regret your folly!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Himadrin",
          },
          {
            tag: "message",
            speaker: "Camerin",
            text: _("Pff, elves. What a bunch of stuck-up snots!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "if_12",
        on: "branch_if_12",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            greater_than_or_equal_to: 18,
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Phew, they are defeated at last."),
          },
          {
            tag: "message",
            speaker: "Eryssa",
            text: _("Hidel, let me introduce to you my savior: Tallin."),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("It is an honor to meet you, Tallin."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("The honor is mine, sir."),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("We have heard much of your intelligence and courage. The number of humans over the centuries who have earned the respect and admiration of the Northern Elves are extremely few, but let it be known that you are one of them."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("I am honored, sir, and I hope that I will live up to the trust that the Northern Elves have bestowed upon me."),
          },
          {
            tag: "message",
            speaker: "Hidel",
            text: _("I am sure you will, Tallin. The trust of the elves is seldom misplaced."),
          },
          {
            tag: "message",
            speaker: "Ro'Arthian",
            text: _("If you lot are quite finished exchanging pleasantries..."),
          },
          {
            tag: "message",
            speaker: "Ro'Sothian",
            text: _("(<i>Snicker</i>)"),
          },
          {
            tag: "message",
            speaker: "Ro'Arthian",
            text: _("... the road ahead is clear and I am eager to blast some more orcs. Shall we proceed?"),
          },
          {
            tag: "message",
            speaker: "Camerin",
            text: _("Yeah, let’s get on with it!"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Right. Onward, men!"),
          },
        ],
      },
