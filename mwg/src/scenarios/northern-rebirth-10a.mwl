        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Upon emerging from the tunnels, the party found themselves surrounded."),
          },
          {
            tag: "message",
            speaker: "Tor",
            text: _("Haha, suckers! We got you now!"),
          },
          {
            tag: "message",
            speaker: "Bor",
            text: _("Hahaha! They walked right into our trap."),
          },
          {
            tag: "message",
            speaker: "Glu",
            text: _("And we have already sent the gold ahead to the Master!"),
          },
          {
            tag: "message",
            speaker: "Oof",
            text: _("Now let’s make mush out of these puny creatures!"),
          },
          {
            tag: "message",
            speaker: "Supporter",
            text: _("Oh no, we are surrounded!"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Courage shall be the harder, heart the keener, and our spirit greater as our strength lessens. Kill them all!"),
          },
          {
            tag: "message",
            speaker: "Camerin",
            text: _("Yeeahhh! I like it!"),
          },
        ],
