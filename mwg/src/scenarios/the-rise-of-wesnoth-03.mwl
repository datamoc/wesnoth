      {
        tag: "event",
        id: "ev_12",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Prince Haldric",
            portrait: "portraits/haldric-surprised.webp",
            text: _("Argh, the orcish vanguard must have flanked us even further to the east! They’re already holding the mouth of the pass. We have to get out of the mountain pass before winter comes or we’re all doomed!"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Father, I wish you were here..."),
          },
          {
            tag: "message",
            speaker: "Lady Outlaw",
            text: _("I’d drop the sentiment and pick up your sword. There’s plenty of fighting ahead of us!"),
          },
          {
            tag: "message",
            speaker: "Tan-Schmog",
            text: _("You won’t get any further than this, meat!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 7,
            y: 4,
          },
          {
            tag: "message",
            text: _("Who goes there?"),
