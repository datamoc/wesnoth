          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Burin_the_Lost",
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            portrait: "portraits/burin-annoyed.webp",
            text: _("Burin, Burin the Lost. Who be ye?"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("I’m Prince Haldric, we have little time to talk. We must make haste through the pass... What are you?"),
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            portrait: "portraits/burin-annoyed.webp",
            text: _("I’m a dwarf, you fool of a boy! I got lost while exploring deep underground, almost a century ago. I’ve never found my way home. But it seems nice enough here."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Nice? The orcs have come, and we must flee!"),
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            text: _("Orcs! It’s been a long time since I felt the satisfying crunch of one of those under my axe. Time for a fight!"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("You’ve fought orcs before?"),
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            text: _("Fool boy! Where did you grow up? Enough of this, let’s go get some orcs!"),
          },
        ],
      },
