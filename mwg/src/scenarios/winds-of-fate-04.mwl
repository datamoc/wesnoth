        defeat: _("Not hold all villages at the end of turn 18 Death of Gorlack Death of Resha"),
      },
      {
        tag: "event",
        id: "if_2",
        on: "branch_if_2",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "this_item.advances_to",
            equals: "",
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            recall_cost: "$( $this_item.cost * 0.5 )",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22find_in%22%3A%22this_item%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
        ],
      },
