          {
            tag: "message",
            speaker: "Zedrix",
            text: _("Arinexisss... Your time hass come too sssoon!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "zedrix_death",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Zedrix%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("My dragon, I have failed you..."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: 1,
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "se",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            side: 1,
            hidden: "yes",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "clashers",
            kill: "yes",
            side: 1,
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: 1,
            mode: "disallow",
            types: "Drake Clasher",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "drakes_killed_nagas",
            value: "no",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Shussek",
            text: _("Ssssss! Leave our reef, fish imps."),
          },
          {
            tag: "message",
            speaker: "Poseira",
            text: _("Naga interlopers, these isles are now annexed to the realm of Lord Typhon, and by his decree, you are banished from them."),
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            side: 1,
            hidden: "no",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 8,
            y: 25,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1500,
          },
          {
            tag: "message",
            speaker: "Nemas",
            text: _("My liege! Drakes have made landfall to your south!"),
          },
          {
            tag: "message",
            speaker: "Poseira",
            text: _("Drakes?! By the gods, how can they be out this far from their rocks?"),
          },
          {
            tag: "message",
            speaker: "Shussek",
            text: _("Ssssss! What is this? You bring bizarre winged hirelings to our parley... Treachery!"),
          },
          {
            tag: "message",
            speaker: "Poseira",
            text: _("Naga interlopers, this shall be my final warning to you, depart at once!"),
          },
          {
            tag: "message",
            speaker: "Shussek",
            text: _("We will ‘de-part’ your fins from you and gulp your fry by the thousands. Ssssss!"),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Long have the merfolk harried us. Now they hinder our journey across their ocean realm."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Without dominion over these shoals, we cannot reprovision. Yet the flight is direly weary from the journey. We should avoid conflict."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("We outmatch them. We shall overcome them as so we always have."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("If that is your will. Yet pray first recall the folly of Dominant Morogor at the Battle of the Crystal Sea."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("... You speak true, Resha. We must repeat not the ancient mistakes."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("I shall allow a sojourn of three days. The whole of the flight will rest. Except for we that are strongest of wing... We shall harass the sea devils whenever they offer the chance. By the third day’s end, we must hold all their settlements. For from those shall we, all at once, carry away <i>their</i> provisions with our rested flight."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("We might also forge a truce with the serpents."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("A truce with prey..."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Grant me your trust, for alien possibilities exist in this wider world. If we slay none of these serpents, I might turn their leader to our side. Yet I must get close enough to grasp the strange words it speaks. Otherwise, having not summoned us here, they will assume us allies of the merfolk."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("I shall consider this."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "Nemas",
            text: _("My liege, permission to engage the drakes?"),
          },
          {
            tag: "message",
            speaker: "Poseira",
            text: _("Permission denied. Stay on your keep and let your forces engage them."),
          },
          {
            tag: "message",
            speaker: "Nemas",
            text: _("With all due respect, sir, I am no coward. My father always led from the front and his fighters respected him for it."),
          },
          {
            tag: "message",
            speaker: "Poseira",
            text: _("Remain at your post, Nemas, that is an order. I have something special planned to turn the tides in our favor."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Resha",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Strange waves circle the northernmost shoals. I fear the northern mermish plan to unleash monsters from the deep."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Slaying their leader will halt their doing so."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("That might spread us too thin. I must advise against it."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            unit: "Nemas",
          },
          {
            tag: "message",
            speaker: "Nemas",
            text: _("Advance!"),
          },
          {
            tag: "message",
            speaker: "Poseira",
            text: _("Nemas, you are violating a direct order! Return to your keep at once!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 5,
          },
          {
            tag: "message",
            speaker: "Poseira",
            text: _("Release the Kraken!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15_1",
        on: "turn",
        once: false,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 5,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Poseira",
              },
            ],
          },
          {
            tag: "switch",
            variable: "turn_number",
            children: [
              {
                tag: "case",
                equals: 5,
                children: [
                  {
                    tag: "hook",
                    name: "command:set_variable_dynamic",
                    variable: "kraken_id",
                    value: "Slimysuckers",
                    mode: "value",
                  },
                  {
                    tag: "hook",
                    name: "command:set_variable_dynamic",
                    variable: "kraken_name",
                    value: "Slimysuckers",
                    mode: "value",
                  },
                  {
                    tag: "hook",
                    name: "command:set_variable_dynamic",
                    variable: "kraken_msg",
                    value: "Glarbelblarg!",
                    mode: "value",
                  },
                ],
              },
              {
