        children: [
          {
            tag: "condition",
            variable: "this_item.level",
            less_than_or_equal_to: 1,
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            recall_cost: "$( $this_item.cost + $this_item.cost * 0.4 * $this_item.experience ^ 2 / $this_item.max_experience ^ 2 )",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22find_in%22%3A%22this_item%22%7D%2C%22children%22%3A%5B%5D%7D",
