      {
        tag: "event",
        id: "ev_34",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "horse-canter.wav",
          },
          {
            tag: "spawn",
            id: "Elurin",
            type: "Elvish Scout",
            side: 2,
            x: 4,
            y: 16,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Elurin",
          },
          {
            tag: "message",
            speaker: "Elurin",
            text: _("Who disturbs our forest?"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("A delegation of the Northern Alliance, urgently seeking the road through to Kal Kartha."),
          },
          {
            tag: "message",
            speaker: "Elurin",
            text: _("We allow few outsiders in our forest paths, and no dwarves since the war in the east. No axe-bearers shall come near our trees. Return whence you came!"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Winter comes on our heels, and your forest straddles the only gap between the snow-choked mountains and the river. If there is war in Kal Kartha, as you say, then that is all the more reason for us to make haste. Please tell me what you know of our kin, elf."),
          },
          {
            tag: "message",
            speaker: "Elurin",
            text: _("I will say no more. I have already given our answer. Return whence you came."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("No. We have our duty. We must pass."),
          },
          {
            tag: "message",
            speaker: "Elurin",
            text: _("You shall not pass here."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("We must aid our kin. If you will not let us through peacefully, you leave us no choice but to fight."),
          },
          {
            tag: "message",
            speaker: "Elurin",
            text: _("So be it, then. Yours will not be the first bones to nourish the earth of our forest."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Elurin",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "horse-canter.wav",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_35",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
