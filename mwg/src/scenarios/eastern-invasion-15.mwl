      {
        tag: "event",
        id: "ev_27",
        on: "council_start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Aeraeka",
            text: _("Well try again! It is absolutely imperative that we get a response from the Northerners."),
          },
          {
            tag: "message",
            speaker: "Halric",
            text: _("If help was coming, we would have heard about it by now. They’re either unwilling or unable to march. What we need to consider is-"),
          },
          {
            tag: "spawn",
            id: "Mefel",
            type: "Silver Mage",
            side: 2,
            x: 9,
            y: 11,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Mefel",
          },
          {
            tag: "message",
            speaker: "Mefel",
            text: _("Urgent report from the south, Sire! I’m afraid it can’t wait."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad_II.webp",
            text: _("Denogyc, you’re excused. Get some rest. Minister Mefel, what news of Kerlath?"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Denogyc",
            x: 9,
            y: 19,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Denogyc",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Mefel",
            x: 9,
            y: 8,
          },
          {
            tag: "message",
            speaker: "Mefel",
            text: _("The siege around Westin has been broken, but Kerlath’s forces are badly depleted. I’m afraid we won’t be able to mount a counter-offensive in time to support you, especially with Mal-Xlana still holding Fort Tahn."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 9,
            y: 19,
          },
          {
            tag: "spawn",
            id: "Halrad",
            type: "General",
            side: 2,
            x: 9,
            y: 18,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Halrad",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Dacyn",
            unit: "Dacyn",
            x: 9,
            y: 20,
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Gweddry",
            unit: "Gweddry",
            x: 11,
            y: 20,
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Owaec",
            unit: "Owaec",
            x: 10,
            y: 20,
          },
          {
            tag: "message",
            speaker: "Aeraeka",
            text: _("Oh, what now..."),
          },
          {
            tag: "message",
            speaker: "Halrad",
            text: _("My Liege, your former High Advisor Dacyn is here, and he says he has vital information on how to defeat the undead."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Mefel",
            x: 12,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Mefel",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Dacyn",
            x: 9,
            y: 8,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Gweddry",
            x: 8,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Gweddry",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "ne",
                mode: "value",
              },
