            x: 10,
            y: 13,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Zhul",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("He’s still breathing. Eloh, what grace I have, give unto him."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("He’s stirring."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "$ally_id",
            x: 8,
            y: 13,
