          {
            tag: "spawn",
            id: "Eloh",
            type: "Divine Incarnation",
            side: 2,
            x: 9,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Eloh",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("So, the elf’s puny friends think they can save him. But you are too late. He is already mine!"),
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: 10,
            y: 13,
            item_name: "",
            image: "",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "stored_kaleh.hitpoints",
            value: 10,
            mode: "sub",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "stored_kaleh.facing",
            value: "n",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_kaleh",
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("Your struggles were mildly entertaining, but futile in the end. For I am powerful beyond your imagining, and this is the seat of my power!"),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("You are not Eloh. You are but a pitiful mockery of her power and glory!"),
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("Is that what you think? I shall prove you wrong. Look out upon your people and despair!"),
          },
          {
            tag: "spawn",
            id: "Anarion",
            type: "Quenoth Fighter",
            side: 3,
            x: 7,
            y: 15,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Anarion",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 100,
          },
          {
            tag: "spawn",
            id: "Zylea",
            type: "Tauroch Rider",
            side: 3,
            x: 11,
            y: 15,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Zylea",
          },
          {
            tag: "message",
            speaker: "Anarion",
            text: _("All hail Eloh!"),
          },
          {
            tag: "message",
            speaker: "Zylea",
            text: _("Death to the heretics!"),
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("They worship their true god."),
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("Come and bow down before your true master, boy."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Your wish is my command."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Kaleh",
            x: 9,
            y: 11,
          },
          {
            tag: "hook",
            name: "command:harm_unit",
            amount: "$stored_kaleh.attack[0].damage",
            alignment: "lawful",
            damage_type: "blade",
            animate: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Eloh%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Eloh",
            primary_attack_name: "sword",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Eloh",
            portrait: "portraits/eloh_rage.webp",
            text: _("Argh, you stabbed me!"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("I have crossed deserts, mountains, and oceans and watched my people bleed every step of the way. I did not come all this way to give up now. I am tired of being called boy; I am Kalehssar, the leader of my people and I will fight you until my dying breath!"),
          },
          {
            tag: "message",
            speaker: "Eloh",
            portrait: "portraits/eloh_rage.webp",
            text: _("I command you to stop this foolishness!"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Never!"),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("The shell brooches Melusand gave us, they’re glowing!"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("You will never dominate us, not while hope survives!"),
          },
          {
            tag: "message",
            speaker: "Eloh",
            portrait: "portraits/eloh_rage.webp",
            text: _("So be it. You choose death? Then you shall receive it from those you hold most dear. Kill the unbelievers, let none survive!"),
          },
          {
            tag: "message",
            speaker: "Anarion",
            text: _("Yes mistress."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Ignore our brethren, we must destroy her!"),
          },
        ],
      },
      {
        tag: "event",
