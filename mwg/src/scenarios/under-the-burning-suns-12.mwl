                greater_than: 0,
              },
              {
                tag: "hook",
                name: "command:random_location",
                source: "_mwg_random_locations_0",
                variable: "_mwg_random_pick_1",
              },
              {
                tag: "hook",
                name: "command:spawn_dynamic",
                type: "$unit_type_table[$unit_type_table_i].type",
                side: 2,
                x: "$random_placement_location.x",
                y: "$random_placement_location.y",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "unit_type_table_i",
                value: "$(($unit_type_table_i + 1) % $unit_type_table.length)",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "_mwg_random_remaining_2",
                value: -1,
                mode: "add",
              },
            ],
          },
