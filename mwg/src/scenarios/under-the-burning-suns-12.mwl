          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Nym",
            x: 9,
            y: 13,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
