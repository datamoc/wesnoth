      {
        tag: "event",
        id: "ev_8",
        on: "eloh_death",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Eloh",
            portrait: "portraits/eloh_rage.webp",
            text: _("You think you killed me? You have no idea what you are facing."),
          },
          {
            tag: "message",
            speaker: "Nym",
            portrait: "portraits/nym_moody.webp",
            text: _("Who is she really? Could it be Zhangor, back to avenge his imprisonment?"),
          },
          {
            tag: "message",
            speaker: "Eloh",
            portrait: "portraits/eloh_rage.webp",
            text: _("Nonsense. Unlike that fool, I do not care about petty things like revenge. Nor do I depend on mortals to enact my will. No, I shall destroy you myself!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Eloh",
          },
          {
