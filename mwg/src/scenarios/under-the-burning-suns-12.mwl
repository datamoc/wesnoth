            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_4",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_5",
