            kill: "yes",
            id: "Malin Keshar",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "malin",
            x: 5,
            y: 16,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Malin Keshar",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1500,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 4,
            y: 15,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1500,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("What sorcery is this? Darken Volk, what’s going... on..?"),
          },
          {
            tag: "spawn",
            id: "Fake_Malin",
            type: "Apprentice Mage",
            side: 4,
            x: 3,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Fake_Malin",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Where is everything? Who are you?"),
          },
          {
            tag: "message",
            speaker: "Fake Malin",
            text: _("I am Malin Keshar."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("No, <i>I</i> am Malin Keshar. Tell me who you are, and this time, make it believable."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "wail-sml.wav",
          },
          {
            tag: "spawn",
            id: "Fake_Malin",
            type: "Apprentice Necromancer",
            side: 4,
            x: 3,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Fake_Malin",
          },
          {
            tag: "message",
            speaker: "Fake Malin",
            text: _("I am Malin Keshar, but no longer the naive, uncertain boy I once was."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("I am no boy, nor am I uncertain. And I certainly won’t be questioned by a mere reflection like you."),
          },
          {
            tag: "message",
            speaker: "Fake Malin",
            text: _("The distorted reflection you see mirrors the reality within. An ever morphing perspective, warped by a profusion of uncertain ambitions."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Nonsense. My convictions are strong and my mind is set. I have but one goal. I will gain power. I will master death, and I will use it to protect my home and slaughter these orcs. And I’ll make my family and my people accept me back."),
          },
          {
            tag: "message",
            speaker: "Fake Malin",
            text: _("When you are drawn in many directions at once, which one will you choose? If you try for them all, you shall be torn apart."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Protecting my home and slaying the orcs are the same thing. If you mean choosing between my family and gaining more power... they will come around and see reason. I will make sure of it."),
          },
          {
            tag: "hook",
