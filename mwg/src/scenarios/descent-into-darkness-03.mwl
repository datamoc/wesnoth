      {
        tag: "event",
        id: "ev_3",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("I sense many lifeforms in this cavern, but none are very powerful. Most likely they are merely nothing more than beasts. Still, we may be able to use them to continue your training."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Better than nothing. Which way do these creatures lie?"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("East."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Malin Keshar",
            x: 19,
            y: 12,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 23,
            y: 16,
          },
          {
            tag: "message",
            speaker: "YOgre1",
            text: _("Me kill you!"),
          },
          {
            tag: "hook",
            name: "command:harm_unit",
            amount: 6,
            animate: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22YOgre2%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "YOgre2",
            primary_attack_name: "cleaver",
            secondary_attack_name: "cleaver",
          },
          {
            tag: "message",
            speaker: "YOgre2",
            text: _("No, me kill you!"),
          },
          {
            tag: "hook",
            name: "command:harm_unit",
            amount: 5,
            animate: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22YOgre1%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "YOgre1",
            primary_attack_name: "cleaver",
            secondary_attack_name: "cleaver",
          },
          {
            tag: "message",
            speaker: "YOgre1",
            text: _("No, me kill— I see human!"),
          },
          {
            tag: "message",
            speaker: "YOgre2",
            text: _("Human! We smash human!"),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Simple-minded, obtuse creatures."),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("This should be an easy task for you. Once you have slain them both, we shall turn them into skeletons."),
          },
        ],
      },
