      {
        tag: "event",
        id: "ev_7",
        on: "cutscene1",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:heal_unit",
            moves: "full",
            amount: "full",
            restore_statuses: "yes",
            restore_attacks: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
            side: 1,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("The ogres are dead."),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Good... I have already showed you how to raise a skeleton before, but perhaps it would be best if we... went over it once again. Other than for ghouls, flesh and blood are useless for undead creatures. First, let out the blood and innards and dispose of them."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Very well."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Malin Keshar",
            x: "$loc1.x",
            y: "$loc1.y",
            raw: "yes",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "axe.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 750,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("What a mess."),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Leave it. The ghouls will take care of it in due course. Next, strip away the flesh. A little remaining is fine; too much will hamper your skeletons’ movement."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 350,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "axe.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "axe.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 750,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("And then?"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Bind the strings of energy to the bone. Skeletons are no more than puppets. Novices will directly control their movement with strands of dark magic, but you should have no need for such crude methods. Instead, impart your will upon the skeleton, spread the threads over the bones, then let loose the twine from your hand. If your will is strong enough, the skeleton will be able to move on its own."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("I will try."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 400,
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: "$loc1.x",
            y: "$loc1.y",
            item_name: "",
            image: "",
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Do it again."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 750,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 400,
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: "$loc2.x",
            y: "$loc2.y",
            item_name: "",
            image: "",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Ur",
            cells: "18,8;19,8;19,7",
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Good. Now head north. I sense another ogre there."),
          },
        ],
