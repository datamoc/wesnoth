        once: true,
        children: [
          {
            tag: "message",
            speaker: "Vlagnor",
            text: _("What are you merfolk doing here?"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("We have business with Tyegëa on the other side of the island."),
          },
          {
            tag: "message",
            speaker: "Vlagnor",
            text: _("The mermaid witch?"),
          },
          {
            tag: "message",
            speaker: "Cylanna",
            text: _("Witch?!"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Witch?"),
          },
          {
            tag: "message",
            speaker: "Vlagnor",
            text: _("She kill drakes. If you are her friend, we will kill you. We do not want MORE merfolk blasting and stabbing."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("We are going around this island whether you want us to or not."),
          },
          {
            tag: "message",
            speaker: "Vlagnor",
            text: _("This is OUR territory and you will not pass."),
          },
