          {
            tag: "message",
            text: _("But I can help! Really! You could use me and my men’s skills on the long road ahead!"),
          },
          {
            tag: "message",
            speaker: "King Eldaric IV",
            text: _("Haldric, what say you on this matter?"),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Prince Haldric",
                portrait: "portraits/haldric-annoyed.webp",
                text: _("Hmm... after some thought..."),
              },
              {
                tag: "choice",
                text: _("I think that your skills may be useful. You may join us."),
                event: "ev_18_opt0",
              },
              {
                tag: "choice",
                text: _("Your word can’t be trusted. Prepare to meet your gods!"),
                event: "ev_18_opt1",
              },
            ],
          },
          {
            tag: "message",
            speaker: "King Eldaric IV",
            text: _("Son, you must lead our people through the south pass. I will remain behind to hold off these vile monsters for as long as I can."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("But, Father!"),
          },
          {
            tag: "message",
            speaker: "King Eldaric IV",
            text: _("It’s the only way. Go now, and don’t look back! Luck be with you!"),
          },
          {
            tag: "win",
          },
        ],
      },
