            unit: "u_5",
          },
          {
            tag: "spawn",
            id: "u_6",
            type: "Caravan",
            side: 1,
            x: 10,
            y: 29,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_6",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "u_6",
          },
          {
            tag: "spawn",
            id: "Alanin",
            type: "Dragoon",
            side: 1,
            x: 11,
            y: 29,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Alanin",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Alanin",
          },
          {
            tag: "message",
            speaker: "Alanin",
            text: _("That’s right. I’ll be coming over along with the silver."),
          },
          {
            tag: "message",
            speaker: "Glildur",
            text: _("Hey! You can’t do that — this road is an elvish road. We’re not letting you transport gold and jewels on it without paying a toll."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("What are you talking about?! This road has always been open to all."),
          },
          {
            tag: "message",
            speaker: "Glildur",
            text: _("Yes, we have allowed people to use it, but it is our road."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Not true! This is dwarvish land; if anything, it’s our road!"),
          },
          {
            tag: "message",
            speaker: "Glildur",
            text: _("Nevertheless, if you try to move your caravans here, you have to pay the toll or face our wrath!"),
          },
          {
            tag: "message",
            speaker: "Haldric II",
            text: _("We Wesnothians and you elves have a treaty! Do you really mean to break it in defense of a road that is not even yours?!"),
          },
          {
            tag: "message",
            speaker: "Glildur",
            text: _("I was never among those who agreed to that treaty. Not all of us elves are as low as Kalenz or make deals with those who betrayed us."),
          },
          {
            tag: "message",
            speaker: "Haldric II",
            text: _("Ah, I see — you are one of the rebels. Our treaty with the elves does not apply to you, so I have no problem with slaying you if you stand in our way. Rugnur, we will proceed with the shipment."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Very well. Glildur, if the high elvish council has made an alliance with these humans, I would advise you to follow it. But not doing so is your choice."),
          },
          {
            tag: "spawn",
            id: "u_7",
            type: "Elvish Hero",
            side: 3,
            x: 21,
            y: 15,
          },
