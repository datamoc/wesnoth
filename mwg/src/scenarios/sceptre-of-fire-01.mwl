                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%2C%22first_time_only%22%3A%22no%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_condition%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22chest_14_9%22%2C%22equals%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22chest_14_9%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22rune_choice%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22This%20is%20part%20of%20our%20stash%20of%20field%20runes%2C%20we%20can%20use%20them%20to%20get%20a%20small%20temporary%20boost.%20We%20don%E2%80%99t%20have%20very%20many%20though%2C%20and%20need%20to%20contribute%20funds%20for%20replacements.%20Should%20I%20take%20this%20one%3F%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22option%22%2C%22attributes%22%3A%7B%22default%22%3A%22yes%22%2C%22image%22%3A%22attacks%2Fblank-attack.png~BLIT(icons%2Funit-groups%2Fcross_30.png~SCALE(60%2C60)%2C0%2C0)%22%2C%22label%22%3A%22No%22%2C%22description%22%3A%22Not%20now.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22command%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22set_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22chest_14_9%22%2C%22value%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22option%22%2C%22attributes%22%3A%7B%22image%22%3A%22misc%2Frune_icon.png~BLIT(scenery%2Fsummoning-circle6.png~CROP(6%2C6%2C60%2C60)%2C0%2C0)%22%2C%22cost%22%3A%228%22%2C%22label%22%3A%22Force%20%3Cspan%20style%3D'italic'%3E%20(_%24cost%7Cg)%3C%2Fspan%3E%22%2C%22description%22%3A%22Increases%20melee%20weapon%20damage%20by%202%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22command%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22if%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22v