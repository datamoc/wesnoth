            equals: "Baran",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "baran_store",
            x: "recall",
            y: "recall",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "victory",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_11",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_12",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "time_over",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Mordak",
            text: _("Your brother’s plan to ambush me has failed. He is our prisoner now."),
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("My brother, kidnapped? I have failed you, Baran! And even now Mordak’s forces descend upon the village!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22type%22%3A%22Dark%20Adept%2CDark%20Sorcerer%2CVampire%20Bat%2CBlood%20Bat%2CDread%20Bat%2CNecromancer%2CSoulless%2CWalking%20Corpse%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("I hear these creatures are nigh-immune to our weapons, let us see!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22type%22%3A%22Dark%20Adept%2CDark%20Sorcerer%2CVampire%20Bat%2CBlood%20Bat%2CDread%20Bat%2CNecromancer%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("That was not so hard!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Arvith%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("All is lost now that I am dead..."),
          },
          {
            tag: "lose",
          },
        ],
      },
    ],
  },
]
