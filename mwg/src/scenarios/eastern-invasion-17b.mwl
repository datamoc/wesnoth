      {
        tag: "event",
        id: "ev_28",
        on: "last_breath",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_killer_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22id%22%3A%22Mal-Ravanal%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "ghostplague_no_recursion",
                not_equals: "$unit.id",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "explain_ghostplague",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "$unit.id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghostplague_x",
            value: "$STORE_UNIT_VAR_store.x",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "$unit.id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghostplague_y",
            value: "$STORE_UNIT_VAR_store.y",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "$unit.id",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghostplague_no_recursion",
            value: "$STORE_UNIT_VAR_store.id",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "$unit.id",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "Mal-Ravanal",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghostplague_side",
            value: "$STORE_UNIT_VAR_store.side",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "wail.wav",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.attacks_left",
                value: 0,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.attacks_left",
                value: 0,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
