      {
        tag: "event",
        id: "ev_141",
        on: "defeat",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("With the staunchest defenders of Wesnoth bested on their home ground, the once-great kingdom was plunged into final darkness under the hand of Mal-Ravanal."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_142",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gweddry%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("So much death... so much senseless destruction..."),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("Unfortunate. Gweddry has fought with me since the very beginning, only to fall so close to the end."),
          },
