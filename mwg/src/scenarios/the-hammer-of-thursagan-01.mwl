            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Aiglondur",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "se",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("<i>Up axes!</i> We will be the Northern Alliance’s arm today, and kill or scatter these invaders."),
          },
          {
            tag: "message",
            speaker: "Bashnark",
            text: _("We are the true orcs, not the weaklings who ally with human-worms and stinky-midgets like you. Come out of your hole and fight us or we will burn your fields to ash!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "die",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "cutscene_retreating_enemies",
            kill: "no",
            side: 2,
          },
          {
            tag: "foreach",
            variable: "cutscene_retreating_enemies",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scenario_move",
                id: "$this_item.id",
                x: 41,
                y: "$($this_item.y)",
                raw: "yes",
              },
              {
                tag: "hook",
                name: "command:kill_unit",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "message",
            text: _("What is this? Their vanquished leader wears a cloak-pin of dwarvish make. And it bears a loremaster’s emblem."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("The maker’s mark is strange to me. We had best consult the lord Hamel."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
