            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "kill_total",
            value: 1,
            mode: "add",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_26",
          },
        ],
      },
