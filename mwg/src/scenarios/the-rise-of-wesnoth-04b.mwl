          {
            tag: "spawn",
            id: "Sir_Ladoc",
            type: "Knight",
            side: 1,
            x: 39,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Sir_Ladoc",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Sir_Ladoc",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Sir Ladoc",
            x: 34,
            y: 14,
          },
          {
            tag: "message",
            speaker: "Sir Ladoc",
            text: _("Hold there! You cannot pass. You’ve already stumbled on the orcish rear guard. The main body of their forces is on the road to Southbay. It is an army of nightmarish size."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("I’m Haldric, my father was King Eldaric IV in the lands northwest of here. Soldier, aren’t you on the wrong side of the lines?"),
          },
          {
            tag: "message",
            speaker: "Sir Ladoc",
            text: _("They overran my post. I got hit on the head pretty good. When I came to the orcish army had already passed my position."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Tell me, how fares Southbay?"),
          },
          {
            tag: "message",
            speaker: "Sir Ladoc",
            text: _("Southbay won’t fall without one hell of a fight, sir. They’ll stand to the last! I only wish I was there!"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Well, we can’t go back, and the road ahead is blocked... I guess we’ll have to risk it and go through the Oldwood forest, then make a break for Clearwater Port."),
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            portrait: "portraits/burin-annoyed.webp",
            text: _("Oh great, now a forest. I should have stayed at home and taken my chances with the orcs!"),
          },
          {
            tag: "message",
            speaker: "Sir Ladoc",
            text: _("Sir, if you don’t mind, I’ll go with you."),
          },
          {
            tag: "message",
            speaker: "Lady Outlaw",
            text: _("On we go..."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "last_done",
            value: "Midlands",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23",
        on: "time_over",
        once: true,
        children: [
          {
