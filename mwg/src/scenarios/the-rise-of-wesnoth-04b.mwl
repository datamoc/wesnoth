          {
            tag: "message",
            speaker: "Lady Outlaw",
            text: _("Feel my wrath, you orcish scum!"),
          },
          {
            tag: "message",
            speaker: "Tan-Vrodis",
            text: _("HUMANS... I see humans!"),
          },
          {
            tag: "message",
            speaker: "Tan-Bok",
