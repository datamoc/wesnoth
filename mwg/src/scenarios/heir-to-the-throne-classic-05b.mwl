            unit: "u_3",
          },
          {
            tag: "message",
            speaker: "Xakae",
            text: _("Surprise! Searching for magi, and all I get is these foul humans!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
