            type: "White Mage",
            side: 1,
            x: 10,
            y: 12,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Moremirmu",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Moremirmu",
          },
          {
            tag: "set_variable",
            name: "moremirmu",
            value: 1,
          },
          {
            tag: "message",
            speaker: "Moremirmu",
            text: _("I was hiding in this holy place, planning how to defeat the evil undead. Now with your help, I can destroy them."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Join us, wise one. We welcome your aid!"),
          },
          {
            tag: "message",
            speaker: "Moremirmu",
            text: _("If we eradicate the undead blight on these islands, I will surely go with you. Otherwise, I plan to finish my task here before moving on."),
          },
