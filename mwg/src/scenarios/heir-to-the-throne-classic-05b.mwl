          {
            tag: "spawn",
            id: "Kalba",
            type: "Merman Fighter",
            side: 1,
            x: 26,
            y: 11,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Kalba",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Kalba",
          },
          {
            tag: "spawn",
            id: "Gnaba",
            type: "Merman Fighter",
            side: 1,
            x: 30,
            y: 13,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Gnaba",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Gnaba",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-concerned.webp",
            text: _("Whew, I survived. But now where am I? Is this island inhabited?"),
          },
          {
            tag: "message",
            speaker: "Kalba",
            text: _("We have heard only the worst things about this place, my lord. It is said that the legions of the undead have come here in great numbers and devastated the island into an ugly wasteland."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-concerned.webp",
            text: _("Let’s hope these rumors are not true! I have none of my men or gold with me! How could I defend myself?"),
          },
          {
            tag: "message",
            speaker: "Kalba",
            text: _("There are still some bands of humans hiding on the island, my lord. If you recruit some of them to help, we might have some hope of holding off the undead hordes!"),
          },
          {
            tag: "spawn",
            id: "Delurin",
            type: "Outlaw",
            side: 1,
            x: 19,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Delurin",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Delurin",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Delurin",
            x: 20,
            y: 11,
          },
          {
            tag: "message",
            speaker: "Delurin",
            text: _("Maybe we can make a deal! Help us defeat those evil creatures! You may use our gold reserves to lead us!"),
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 1,
            gold: 100,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You receive 100 pieces of gold!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("There are some ancient temples to the southwest; I wonder what might be inside them!"),
          },
        ],
      },
      {
        tag: "event",
