      {
        tag: "event",
        id: "story_22",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("The Sceptre, initially dulled from decades of dust and debris, began to glow from the ruby’s inner fire. Dwarvish runes on the golden handle lit up in pulsating blue. The heat and light were comforting in the pitch-black."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_23",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("An early encounter with the Sceptre in the hands of its new owners left several trolls as smoking husks. Sensing the awakening of a powerful magic, the dwellers of the deep quickly scattered and remained out of sight."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_24",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Delfador led his young charges through lonely corridors and abandoned tunnels for four days. For the first time Konrad saw signs of fatigue in the old wizard’s normally inscrutable face. Finally, fresh air greeted the party..."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_25",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Konrad,Urug-Telfar,Unan-Ka_tall",
          },
        ],
      },
      {
