          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_81",
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("Uncle Kaylan, we’re here! Are you alright? What can I do to help?"),
          },
          {
            tag: "message",
            speaker: "Kaylan",
            text: _("If we can hold Blackwater for just a few more days, victory shall be assured! I am encircled and trapped in the port, but with your help the siege can be broken. Hearken to my words, Konrad, and Blackwater Port shall yet endure!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_82",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 7,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Kaylan",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Kaylan",
            text: _("Brothers-in-arms, fighting side-by-side! Not since the death of the old king have I felt this way, young Konrad. If I have but one regret in my life, it is that I could not raise you here as my own."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Master Delfador told me: You wanted to raise me in Blackwater Port among other humans, but he felt it was too dangerous."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("I don’t mind though. I like elves, and we still got to come visit you sometimes."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("And I was quite right, too. A military town is no place for a young child; Blackwater Port has seen its fair share of battles since I first rescued you, Konrad."),
          },
        ],
      },
