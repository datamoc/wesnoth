      },
      {
        tag: "event",
        id: "ev_101",
        on: "die",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "bm_kaylan_dead",
            value: "yes",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("Kaylan, no! Please, you have to get back up! You have to keep fighting!"),
          },
        ],
