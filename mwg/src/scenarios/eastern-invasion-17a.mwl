            file: "silence.ogg",
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("As the messenger passed out of the city gates, silence settled over the valley of the Weldyn. Children buried their fathers, mothers entombed their sons; soldiers slept where they stood, spears still clutched behind pale knuckles. The only sound was the incessant drum-march of skeletal feet, ever-growing outside the walls."),
          },
        ],
