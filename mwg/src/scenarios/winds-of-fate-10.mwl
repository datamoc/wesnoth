      {
        tag: "event",
        id: "ev_31",
        on: "victory",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Gorlack",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Behold what ends you have wrought. You can no easier cast us off these peaks than we could pull you from the deep."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("I offer you this pact. All the peaks are our domain. For our metal works, so too are the soils within them. The vast under world beneath these we shall not violate. Both of us may hunt the lowlands so long as one takes not the other as game."),
          },
          {
            tag: "message",
            speaker: "Thurdakor",
            text: _("Nae sure ah like the sound o’ this deal."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("It is the best you will have. We covet the soil as little as you do the clouds. We shall find no better neighbors than each other."),
          },
          {
            tag: "message",
            speaker: "Thurdakor",
            text: _("Yer nae easy tae haggle with, dragon."),
          },
          {
            tag: "message",
            speaker: "Thurdakor",
            text: _("Sae be it, a deal we hae. Ah wull even set free mah wee pet dragon fur ye."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "loc",
            kill: "no",
            id: "Thurdakor",
          },
          {
            tag: "hook",
            name: "command:store_reachable_locations",
            variable: "hole",
            filter: "%7B%22tag%22%3A%22store_reachable_locations%22%2C%22attributes%22%3A%7B%22range%22%3A%22movement%22%2C%22moves%22%3A%22max%22%2C%22variable%22%3A%22hole%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Thurdakor%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22Aa%2CHa%2CMs%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D",
