                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Malin%20Keshar%22%2C%22message%22%3A%22The%20dead%20fish%20returns%20home.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22object%22%2C%22attributes%22%3A%7B%22id%22%3A%22super_zombie_buff%22%2C%22take_only_once%22%3A%22yes%22%2C%22silent%22%3A%22yes%22%2C%22duration%22%3A%22forever%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22x%22%3A%2231%22%2C%22y%22%3A%2215%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22new_ability%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22abilities%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22dummy%22%2C%22attributes%22%3A%7B%22id%22%3A%22feeding%22%2C%22name%22%3A%22feeding%22%2C%22female_name%22%3A%22female%5Efeeding%22%2C%22description%22%3A%22This%20unit%20gains%201%20hitpoint%20added%20to%20its%20maximum%20whenever%20it%20kills%20a%20unit%2C%20except%20units%20that%20are%20immune%20to%20plague.%22%2C%22special_note%22%3A%22This%20unit%20gains%201%20hitpoint%20added%20to%20its%20maximum%20whenever%20it%20kills%20a%20living%20unit.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22attack%22%2C%22range%22%3A%22melee%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22set_specials%22%2C%22attributes%22%3A%7B%22mode%22%3A%22append%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22poison%22%2C%22attributes%22%3A%7B%22id%22%3A%22poison%22%2C%22name%22%3A%22poison%22%2C%22description%22%3A%22This%20attack%20poisons%20living%20targets.%20Poisoned%20units%20lose%208%20HP%20every%20turn%20until%20they%20are%20cured%20or%20are%20reduced%20to%201%20HP.%20Poison%20cannot%2C%20of%20itself%2C%20kill%20a%20unit.%22%2C%22special_note%22%3A%22The%20victims%20of%20this%20unit%E2%80%99s%20poison%20will%20continually%20take%20damage%20until%20they%20can%20be%20cured%20in%20town%20or%20by%20a%20unit%20which%20cures.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22increase_total%22%3A%2232%22%2C%22increase%22%3A%2232%22%2C%22heal_full%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22set_achievement%22%2C%22attributes%22%3A%7B%22content_for%22%3A%22descent_into_darkness%22%2C%22id%22%3A%22did_sushi%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
