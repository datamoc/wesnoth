            time: 250,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I call upon the name of An-Usrukhar the Great. I invoke the Mirror of Evanescent Time!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "lightning.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 150,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I challenge life against death! I invoke freedom against order! I wield light against darkness!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "lightning.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 150,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("May the coils of servitude be broken! Spirit of the damned, be freed from your master."),
          },
          {
            tag: "hook",
            name: "command:remove_object",
            object_id: "skill_ghostcapture_standing",
            id: "Delfador",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "hook",
            name: "command:remove_object",
            object_id: "disable_wail",
            id: "Aethyr",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Aethyr",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 4,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Aethyr",
            text: _("..."),
          },
          {
            tag: "message",
            speaker: "Aethyr",
            text: _("My mind... is my own..."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Speak, spectre! Tell me of this place. Where is the drake they call the “Great One”?"),
          },
          {
            tag: "message",
            speaker: "Aethyr",
            text: _("I do not know. I know nothing of drakes. I am a man. My name is Aethyr... I had almost forgotten. I died long ago, in a great battle..."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Aethyr",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.name",
                value: "Aethyr",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("You’re the spirit of a human? How did you come to roam these drakish halls, so far from the lands of men?"),
          },
          {
            tag: "message",
            speaker: "Aethyr",
            text: _("Iliah-Malal brought me here. He made me promises of life renewed, but instead bound me to his will. Perhaps Iliah-Malal will know of your drake."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("A necromancer? Troubling. Yes, I should very much like to meet this Iliah-Malal."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Aethyr",
          },
