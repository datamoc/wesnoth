                tag: "set_variable",
                name: "this_item.side",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "restore_polymorph",
          },
        ],
