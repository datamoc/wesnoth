              },
            ],
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("A ghost! Walking corpses are a great evil, but mastery over spirits is far fouler still. Damned vessels, conscious but enslaved... yet where there are enchantments, there are opportunities."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "remove_polymorph",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "skill_counterspell_cancel",
          },
          {
            tag: "message",
            speaker: "Delfador",
