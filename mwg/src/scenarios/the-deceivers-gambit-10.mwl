            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "turns_since_first_zombie",
            value: 1,
            mode: "add",
          },
          {
            tag: "switch",
            variable: "turns_since_first_zombie",
            children: [
              {
                tag: "case",
                equals: 6,
                children: [
                  {
                    tag: "set_variable",
                    name: "undead_count",
                    value: 2,
                  },
                ],
              },
              {
                tag: "case",
                equals: 10,
                children: [
                  {
                    tag: "hook",
                    name: "command:set_variable_dynamic",
                    variable: "undead_interval",
                    value: 0,
                    mode: "sub",
                  },
                  {
                    tag: "set_variable",
                    name: "undead_count",
                    value: 3,
                  },
                ],
              },
              {
                tag: "case",
                equals: 14,
                children: [
                  {
                    tag: "hook",
                    name: "command:set_variable_dynamic",
                    variable: "undead_interval",
                    value: 0,
                    mode: "sub",
                  },
                  {
                    tag: "set_variable",
                    name: "undead_count",
                    value: 4,
                  },
                ],
              },
              {
                tag: "case",
                equals: 18,
                children: [
                  {
                    tag: "set_variable",
                    name: "undead_count",
                    value: 6,
                  },
                ],
              },
              {
                tag: "case",
                equals: 22,
                children: [
                  {
                    tag: "set_variable",
                    name: "undead_count",
                    value: 9,
                  },
                ],
              },
              {
                tag: "case",
                equals: 26,
                children: [
                  {
                    tag: "set_variable",
                    name: "undead_count",
                    value: 12,
                  },
                ],
              },
            ],
          },
