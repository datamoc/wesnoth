      {
        tag: "event",
        id: "if_33",
        on: "branch_if_33",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s31_impending_malady",
            equals: "no_tweak",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Failed in part, but not in whole. While thus far we have been fortunate enough to evade the lava, we are still lost deep underground, with the bulk of our stores and rations lost to flame."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Indeed, hunger and weakness already gnaw at my stomach. We must find a way to the surface soon, or these caves may yet prove our doom..."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_34",
        on: "branch_if_34",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s31_impending_malady",
            not_equals: "no_tweak",
