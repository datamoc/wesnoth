      {
        tag: "event",
        id: "if_10",
        on: "branch_if_10",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s31_impending_malady",
            equals: "recall_cost",
          },
          {
            tag: "message",
            portrait: "none",
            text: _("<i>_ Blue sparks leapt from the wizard’s staff as he and his young ward plunged into the corrosive water with supernatural haste, resurfacing moments later inside a larger chamber. _ The sounds of rupturing earth behind rose to a crescendo, then faded into the distance, as meanwhile an uncomfortable heat pressed close at their backs.</i>"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_11",
        on: "branch_if_11",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s31_impending_malady",
            equals: "no_recruits",
          },
          {
            tag: "message",
            portrait: "none",
            text: _("<i>_ Blue sparks leapt from the wizard’s staff as he and his young ward sped away from the rising lava with supernatural haste. The few veterans able to follow dashed madly through the cave, then passed alongside Konrad into a larger chamber. _ The sounds of rupturing earth behind rose to a crescendo, then faded into the distance, as meanwhile an uncomfortable heat pressed close at their backs.</i>"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_12",
        on: "branch_if_12",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s31_impending_malady",
            equals: "limited_commands",
          },
          {
            tag: "message",
            portrait: "none",
            text: _("<i>_ Blue sparks leapt from the wizard’s staff as he and his young ward sped away from the rising lava with supernatural haste, leaving both their brave volunteers and Li’sar’s distracted soldiers far behind as they passed into a larger chamber. _ The sounds of rupturing earth rose to a crescendo, then faded into the distance, as meanwhile an uncomfortable heat pressed close at their backs.</i>"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_13",
        on: "branch_if_13",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s31_impending_malady",
            equals: "reduced_healing",
          },
          {
            tag: "message",
            portrait: "none",
            text: _("<i>_ Blue sparks leapt from the wizard’s staff as he and his young ward sped away from the rising lava with supernatural haste. The harried soldiers plunged deeper and deeper into the smothering darkness, further and further from the light of the sun. _ The sounds of rupturing earth behind rose to a crescendo, then faded into the distance, as meanwhile an uncomfortable heat pressed close at their backs.</i>"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_14",
        on: "branch_if_14",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s31_impending_malady",
            equals: "hitpoint_loss",
          },
          {
            tag: "message",
            portrait: "none",
            text: _("<i>_ Blue sparks leapt from the wizard’s staff as he and his young ward sped away from the rising lava with supernatural haste. The harried soldiers held back vomit as they beat a path through the horrifying squalor filling their tunnel, then passed thankfully into a larger chamber. _ The sounds of rupturing earth behind rose to a crescendo, then faded into the distance, as meanwhile an uncomfortable heat pressed close at their backs.</i>"),
          },
        ],
      },
      {
        tag: "event",
