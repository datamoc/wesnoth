                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Lisar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Lisar",
            portrait: "portraits/lisar-defeat.webp",
            text: _("Aaaaah! I can’t believe it should end like this..."),
