          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22remove_item%22%2C%22attributes%22%3A%7B%22x%22%3A%2210%22%2C%22y%22%3A%225%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22unit%22%2C%22attributes%22%3A%7B%22type%22%3A%22Merman%20Triton%22%2C%22id%22%3A%22Grateful%20Merman%22%2C%22name%22%3A%22Grateful%20Merman%22%2C%22x%22%3A%2210%22%2C%22y%22%3A%225%22%2C%22side%22%3A%221%22%2C%22hitpoints%22%3A%2215%22%2C%22unrenamable%22%3A%22yes%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22modifications%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22loyal%22%2C%22male_name%22%3A%22loyal%22%2C%22female_name%22%3A%22female%5Eloyal%22%2C%22description%22%3A%22Zero%20upkeep%22%2C%22help_text%22%3A%22%3Ci%3ELoyal%3C%2Fi%3E%20units%20don%E2%80%99t%20incur%20upkeep.%20Most%20units%20incur%20an%20upkeep%20cost%20at%20the%20end%20of%20every%20turn%2C%20which%20is%20equal%20to%20their%20level.%20Loyal%20units%20do%20not%20incur%20this%20cost.%5Cn%5Cn_%20During%20campaigns%2C%20certain%20units%20may%20opt%20to%20join%20the%20player%E2%80%99s%20forces%20of%20their%20own%20volition.%20These%20units%20are%20marked%20with%20the%20loyal%20trait.%20Although%20they%20may%20require%20payment%20to%20be%20recalled%2C%20they%20never%20incur%20any%20upkeep%20costs.%20This%20can%20make%20them%20invaluable%20during%20a%20long%20campaign%2C%20when%20gold%20is%20in%20short%20supply.%20This%20trait%20is%20never%20given%20to%20recruited%20units%2C%20so%20it%20may%20be%20unwise%20to%20dismiss%20such%20units%20or%20to%20send%20them%20to%20a%20foolish%20death.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22loyal%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22overlay%22%2C%22add%22%3A%22misc%2Floyal-icon.png%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22quick%22%2C%22male_name%22%3A%22quick%22%2C%22female_name%22%3A%22female%5Equick%22%2C%22help_text%22%3A%22%3Ci%3EQuick%3C%2Fi%3E%20units%20have%201%20extra%20movement%20point%2C%20but%205%25%20less%20hitpoints%20than%20usual.%5Cn%5Cn_%20Quick%20is%20the%20most%20noticeable%20trait%2C%20particularly%20in%20slower%20moving%20units%20such%20as%20trolls%20or%20heavy%20infantry.%20Units%20with%20the%20quick%20trait%20often%20have%20greatly%20increased%20mobility%20in%20rough%20terrain%2C%20which%20can%20be%20important%20to%20consider%20when%20deploying%20your%20forces.%20Also%2C%20quick%20units%20aren%E2%80%99t%20quite%20as%20tough%20as%20units%20without%20this%20trait%20and%20are%20subsequently%20less%20good%20at%20holding%20contested%20positions.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22movement%22%2C%22increase%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22increase_total%22%3A%22-5%25%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Grateful%20Merman%22%2C%22message%22%3A%22Thank%20you.%20I%20got%20captured%20by%20the%20naga%20and%20have%20been%20trapped%20here%20for%20ages%2C%20I%20don%E2%80%99t%20know%20how%20long.%20So%20close%20to%20the%20water%2C%20but%20so%20far.%20I%20don%E2%80%99t%20think%20I%20could%20have%20lasted%20much%20longer.%20It%20was%20horrible.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22Well%2C%20help%20us%20get%20revenge%20on%20the%20naga.%20We%20are%20here%20to%20destroy%20Yechnagoth.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Grateful%20Merman%22%2C%22message%22%3A%22Gladly.%20Just%20let%20me%20recover%20my%20strength%20first.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: 10,
            y: 5,
            item_name: "",
            image: "",
          },
          {
            tag: "spawn",
            id: "Grateful_Merman",
            type: "Merman Triton",
            side: 1,
            x: 9,
            y: 4,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Grateful_Merman",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Grateful_Merman",
          },
          {
            tag: "message",
            speaker: "Grateful Merman",
            text: _("Thank you. I got captured by the naga and have been trapped here for ages, I don’t know how long. So close to the water, but so far. I don’t think I could have lasted much longer. It was horrible."),
          },
          {
            tag: "message",
            text: _("Well, help us get revenge on the naga. We are here to destroy Yechnagoth."),
          },
          {
            tag: "message",
            speaker: "Grateful Merman",
            text: _("Gladly. Just let me recover my strength first."),
          },
        ],
      },
      {
