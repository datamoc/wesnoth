            text: _("Thanks, I think we’re going to need all the support we can get."),
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "-1-51",
            ys: "36-51",
          },
          {
            tag: "message",
            text: _("Now that you have found a fortress to protect your people, we can bring in the other ships."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "ambient/ship.ogg",
          },
          {
            tag: "hook",
            name: "command:add_item",
            x: 10,
            y: 38,
            item_name: "",
            image: "scenery%2Fgalleon.png~RC(magenta%3Ered)",
          },
          {
            tag: "hook",
            name: "command:add_item",
            x: 9,
