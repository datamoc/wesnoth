                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22sound%22%2C%22attributes%22%3A%7B%22name%22%3A%22gold.ogg%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22I%20found%20a%20chest%20in%20the%20hold%20of%20this%20wrecked%20ship.%20It%20looks%20like%20sunken%20treasure!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22gold%22%2C%22attributes%22%3A%7B%22amount%22%3A%2275%22%2C%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
