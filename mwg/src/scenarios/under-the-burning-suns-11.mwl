tone.%20Now%20I%20wonder%20where%20we%20might%20find%20the%20right%20keys%3F%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22if%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22have_unit%22%2C%22attributes%22%3A%7B%22canrecruit%22%3A%22yes%22%2C%22side%22%3A%223%2C4%22%2C%22count%22%3A%220%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22then%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Kaleh%22%2C%22message%22%3A%22Hey%2C%20what%20about%20the%20two%20keys%20that%20we%20found%20on%20the%20bodies%20of%20the%20undead%20and%20saurian%20leaders%3F%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Kaleh%22%2C%22message%22%3A%22I%20have%20an%20idea.%20I%20bet%20Eloh%20has%20given%20them%20to%20those%20she%20trusts%20most.%20And%20one%20saurian%20and%20one%20skeleton%20were%20guarding%20the%20door.%20The%20keys%20must%20be%20being%20held%20by%20one%20of%20each%20faction.%20I%20bet%20the%20leaders%20would%20be%20in%20charge%20of%20such%20valuable%20objects.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22set_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22found_door%22%2C%22value%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22show_objectives%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D",
