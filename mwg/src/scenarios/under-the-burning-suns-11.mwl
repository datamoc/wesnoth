      {
        tag: "event",
        id: "event5",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: 12,
            y: 40,
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("I have captured the keep. This castle is somewhat ruined, but it will serve our purposes. Now, I wonder where the merfolk are?"),
          },
          {
            tag: "foreach",
            variable: "merfolk_units",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
                x: 6,
                y: 42,
              },
            ],
          },
          {
            tag: "message",
            text: _("Fear not, here we are! We have explored the southern half of the island. And except for those lizards you found, and some abandoned villages, it seem to be empty. We captured those villages for you, to help support your troops."),
          },
          {
            tag: "hook",
            name: "command:capture_village",
            side: 1,
            cells: "8-29,42-45",
