                tree: "%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22have_unit%22%2C%22attributes%22%3A%7B%22id%22%3A%22Shynal%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22have_unit%22%2C%22attributes%22%3A%7B%22id%22%3A%22Carcyn%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("addressed_plural^This is going to cost us, but I want to keep some gold around for emergencies — I think 50 is about right. You help me collect some. (<i>Cough, cough</i>)"),
          },
          {
            tag: "message",
            speaker: "Carcyn",
            text: _("Right away sir."),
          },
          {
            tag: "message",
            speaker: "Shynal",
            text: _("Are you feeling well?"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("Yes, yes. I’m quite all right."),
          },
          {
            tag: "message",
            speaker: "Shynal",
            text: _("I don’t fancy wading in the water to fight these things."),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("No problem. We can lure them onto land."),
          },
          {
            tag: "message",
            speaker: "Shynal",
            text: _("How?"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("addressed_plural^Have you never been fishing before? With bait of course."),
          },
        ],
      },
