      {
        tag: "event",
        id: "ev_15",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Okean",
            text: _("You! You have destroyed the town of Carcyn!"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("The town is hardly destroyed. I just encouraged a change of leadership."),
          },
          {
            tag: "message",
            speaker: "Okean",
            text: _("Your words mock us. Those humans were valuable trading partners of ours. We will have justice!"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("Actually, I expect you will follow them into the ground if you try to harm us."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
