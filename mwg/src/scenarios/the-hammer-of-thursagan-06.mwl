        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "new_turn",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I have never seen the formal banishment before. One reads of it in the old tales, of course, but to hear it with one’s own ears? It was... unsettling."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("It is not something we do often. The last such was in my grandsire’s time. But look upon the human’s wrists if you have any doubt it was merited."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Shackles. Scars. No, Angarthing, I would not doubt you, even if it were my place to doubt a loremaster."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "banishment",
        once: true,
        children: [
          {
            tag: "set_variable",
            name: "fade_duration_remaining",
            value: 250,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "fade_duration_remaining",
                greater_than: 0,
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "fade_duration_remaining",
                value: 5,
                mode: "sub",
              },
              {
                tag: "set_variable",
                name: "volume",
                value: 100,
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: "$fade_duration_remaining",
                mode: "multiply",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: 250,
                mode: "divide",
              },
              {
                tag: "hook",
                name: "command:volume",
                music: "$volume",
              },
              {
                tag: "hook",
                name: "command:delay",
                time: 5,
              },
            ],
          },
          {
            tag: "hook",
            name: "command:volume",
            music: 0,
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "silence.ogg",
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 15,
            ys: 9,
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "15,9",
            radius: 1,
            multiturn: "no",
          },
          {
            tag: "spawn",
            id: "Ollin",
            type: "Peasant",
            side: 3,
            x: 15,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Ollin",
          },
          {
            tag: "message",
            speaker: "Ollin",
            text: _("Don’t kill me, masters! Please don’t kill me!"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("You’re in no danger from us. What lies to the east of here?"),
          },
          {
            tag: "message",
            speaker: "Ollin",
            text: _("You wear no mask. You... you’re not with them?"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("What are you talking about?"),
          },
          {
            tag: "message",
            speaker: "Ollin",
            text: _("The masked dwarves. Killing, burning, kidnapping. Look..."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "maskX",
            value: "$STORE_UNIT_VAR_store.x",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "maskY",
            value: "$STORE_UNIT_VAR_store.y",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: "$maskX",
            y: "$maskY",
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "$maskX",
            ys: "$maskY",
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "$maskX,$maskY",
            radius: 2,
            multiturn: "no",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "masked_speaker",
            text: _("Fellow dwarves, hail! We’re looking for a human refugee, a male with a broken arm. Have you seen him? Our master demands his life."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("He is here. How has he wronged your master, that you seek his death?"),
          },
          {
            tag: "message",
            speaker: "masked_speaker",
            text: _("Does it matter? He is only a dirtgrubbing human, not fit to polish the boots of the true people."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("What is your name, masked one? Will you stand behind your deed? I am a witness."),
          },
          {
            tag: "message",
            speaker: "masked_speaker",
            text: _("A witness? My name is... my name is not important. My deed will speak its own truth."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("You speak without honor. Mine is the power of our ancient Law; speak your name and give up your murder, or the Law will cast you forth. I am a witness!"),
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 2,
            team_name: "evil",
          },
          {
            tag: "message",
            speaker: "masked_speaker",
            text: _("If you were a witness of the true people, you would not let a dirtgrubber hide behind your robes. I deny you!"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("The Law speaks: you are cast out. You are un-dwarf. I AM A WITNESS!"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Up axes!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Ollin",
          },
          {
            tag: "hook",
            name: "command:place_shroud",
            side: 1,
            xs: "$maskX",
            ys: "$maskY",
            radius: 2,
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "knalgan_theme.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "battle.ogg",
          },
          {
            tag: "set_variable",
            name: "fade_duration_remaining",
            value: 0,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "fade_duration_remaining",
                greater_than: 0,
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "fade_duration_remaining",
                value: 5,
                mode: "sub",
              },
              {
                tag: "set_variable",
                name: "volume",
                value: 100,
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: "$fade_duration_remaining",
                mode: "multiply",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: 0,
                mode: "divide",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: "$(100-$volume)",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:volume",
                music: "$volume",
              },
              {
                tag: "hook",
                name: "command:delay",
                time: 5,
              },
            ],
          },
          {
            tag: "hook",
            name: "command:volume",
            music: 100,
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "die",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Our castle is small, and these masked dwarves are many. This will be a bloody fight."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("The masked ones must have raided this place before. Damaging the castle would have made it harder for the peasants to rally a defense."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                side: 2,
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_21",
        on: "die",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "cutscene_retreating_enemies",
            kill: "no",
            side: 2,
          },
          {
            tag: "foreach",
            variable: "cutscene_retreating_enemies",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scenario_move",
                id: "$this_item.id",
                x: 31,
                y: "$($this_item.y)",
                raw: "yes",
              },
              {
                tag: "hook",
                name: "command:kill_unit",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("They are defeated!"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("You have acted in honor. I am a witness."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I do not wish to imagine what could drive dwarves to such depravity. These outlaws must have been desperate; consumed by fear or madness."),
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 15,
            ys: 12,
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "15,12",
            radius: 4,
            multiturn: "no",
          },
          {
            tag: "spawn",
            id: "Ollin",
            type: "Peasant",
            side: 3,
            x: 15,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Ollin",
          },
          {
            tag: "spawn",
            id: "u_11",
            type: "Peasant",
            side: 3,
            x: 18,
            y: 13,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_11",
          },
          {
            tag: "spawn",
            id: "u_12",
            type: "Woodsman",
            side: 3,
            x: 13,
            y: 13,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_12",
          },
          {
            tag: "message",
            speaker: "Ollin",
            text: _("Thank you for your help, and for saving us!"),
          },
          {
            tag: "message",
            speaker: "Ollin",
            text: _("I do not mean to sound ungrateful, but — the masked ones... they always come back..."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("There is a camp of mages not far upriver. If they have not yet departed, they can help you. Travel westways, to lands of the Northern Alliance. There you will be safe, and welcomed."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("We dwarves travel east. We must reach Kal Kartha, more urgently now than ever. Before anything terrible happens, if we are lucky..."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22role%22%3A%22masked_speaker%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "masked_speaker",
            text: _("..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_22",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Aiglondur%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I fall!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Angarthing%22%7D%2C%22children%22%3A%5B%5D%7D",
