      {
        tag: "event",
        id: "ev_15",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("The maps show a village nearby. Their keep should be just ahead, but something doesn’t feel right."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("It’s too quiet... and I think I smell traces of smoke on the wind. There has been fire near here recently, and not a clean one."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Look sharp for the inhabitants here. They might have something to tell us."),
          },
        ],
      },
      {
        tag: "event",
