              },
            ],
          },
          {
            tag: "message",
            speaker: "Chantal",
            text: _("You don’t remember me, do you, Deoran... We shared good memories together, back in the Lintanir."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("... Chantal? No, not here... War is no... place for you..."),
