      {
        tag: "event",
        id: "ev_14",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Nil-Galion%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Nil-Galion",
            text: _("Deluded fool, you are rescuing a necromancer. I can only hope that you are too late, and that our souls will rest in peace."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Nil-Galion",
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("Follow their back trail!"),
          },
          {
            tag: "hook",
            name: "command:show_objectives",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Arvith%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("All is lost now that I am dead..."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "if_17",
        on: "branch_if_17",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "baran_store.id",
            equals: "Baran",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "baran_store",
            x: "recall",
            y: "recall",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
