            speaker: "Mal Keshar",
            text: _("<i>I suppose there is some irony in this.</i>"),
          },
          {
            tag: "message",
            speaker: "Mal Keshar",
            text: _("I was not aware that dragons still existed. This was most unexpected. Nevertheless, this shall be a worthwhile test of my new powers."),
          },
          {
            tag: "message",
            speaker: "Xanthric",
            text: _("<i><big>A derelict corpse like you has no business challenging a dragon! Even my lowly elementals will be more than a match for you. Rise, my thralls!</big></i>"),
          },
