            equals: "Tallin",
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Hmm... the wall here looks very thin and damaged. Let’s bring it down, it could offer us a faster way to navigate these caves."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_33",
        on: "branch_if_33",
        once: true,
        children: [
          {
