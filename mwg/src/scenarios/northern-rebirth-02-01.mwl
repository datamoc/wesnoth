            event: "branch_if_23",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("The old gate opens, revealing a narrow tunnel."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_32",
        on: "branch_if_32",
        once: true,
        children: [
          {
            tag: "condition",
