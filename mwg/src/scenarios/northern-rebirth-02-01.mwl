            not_equals: "Tallin",
          },
          {
            tag: "message",
            text: _("Look, the wall here seems to be very thin and damaged. We might be able to bring it down."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Do it. It can give us a faster way to traverse through these caves."),
          },
        ],
