      {
        tag: "event",
        id: "ev_5",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "21,22,23-25,26,27,28,29,30-31",
            y: "12-21,13-22,14-22,15-23,14-22,15-23,14-22,15-22",
          },
          {
            tag: "message",
            text: _("I’ve never pushed so far. We are crossing the border of the Black-Eye lands."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 4,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "trolls_appear",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "trolls_appear",
        once: true,
        children: [
          {
            tag: "spawn",
            id: "Blemaker",
            type: "Troll Warrior",
            side: 3,
            x: 30,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Blemaker",
          },
          {
            tag: "spawn",
            id: "Gr__",
            type: "Troll Hero",
            side: 3,
            x: 29,
            y: 8,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Gr__",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Gr__",
          },
          {
            tag: "spawn",
            id: "Toughkon",
            type: "Troll Whelp",
            side: 3,
            x: 31,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Toughkon",
          },
          {
            tag: "spawn",
            id: "Pe",
            type: "Troll Whelp",
            side: 3,
            x: 32,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Pe",
          },
          {
            tag: "message",
            speaker: "Blemaker",
            text: _("Look! Dwarves are fighting orcs!"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Father, we should help them. Orcs are our allies."),
          },
          {
            tag: "message",
            speaker: "Blemaker",
            text: _("I don’t know. Orcs have been our allies in the past, but they treat us as fools."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("But, Father, we don’t know what they are seeking there. Between us, we could squash these dwarves."),
          },
          {
            tag: "message",
            speaker: "Blemaker",
            text: _("Right, my son. We help our orcish friends. But you take care... I would be desperate if something happened to you."),
          },
          {
            tag: "hook",
            name: "command:show_objectives",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Blemaker%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Father! Oh no!"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Filthy dwarves! Now I’ll kill you to the last!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gr%C3%BC%C3%BC%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Oh no, I’m defeated."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kwili%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I die!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("You were warned, dwarf. Riders, spread out over the area and collect what you can from each of these houses. If anyone refuses to pay, tie them up and take what they have anyway. Let them know that they live only on my good graces. I’ll take the army to Barag Gór. Catch up when you’re done."),
          },
          {
            tag: "message",
            speaker: "doggie",
            text: _("Sounds like fun. All right boys, let’s go!"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "trolls_appear",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: 0,
            y: 4,
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("We’ve succeeded! We’ve passed through the Mountains of Haag! Look at these green hills! The land of the free tribes is near now. I can see the walls of Barag Gór in the distance."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "victory",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:modify_unit",
            side: 1,
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gr%C3%BC%C3%BC%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Grüü",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kapou'e%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I’m done. My people are doomed!"),
          },
          {
            tag: "lose",
          },
        ],
      },
    ],
