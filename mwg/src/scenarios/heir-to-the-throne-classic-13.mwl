        once: true,
        children: [
          {
            tag: "condition",
            variable: "true_entrance_location",
          },
          {
            tag: "message",
            text: _("This old mine seems to be connected to the main tunnels."),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("I am hesitant to enter. It will be so difficult in the darkness!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mad.webp",
            text: _("There is no time for idle chatter or delay of any kind. Onward!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_19",
        on: "branch_if_19",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "true_entrance_location",
            not_equals: "",
          },
          {
            tag: "message",
            text: _("I have reached the mine entrance, but there is no tunnel here. Rock and rubble completely block the way."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("I hope we can make it through the main doors, then."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("It is our only choice now. Hurry!"),
          },
        ],
      },
