        on: "branch_if_15",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "true_entrance_location",
          },
          {
            tag: "message",
            text: _("The doors... they can be moved!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Quickly, now, let us slip inside and hope the dwarves do not object..."),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("... and that the orcs do not follow."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_16",
        on: "branch_if_16",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "true_entrance_location",
            not_equals: "",
          },
          {
            tag: "message",
            text: _("The doors are closed and barred from the inside!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-human-concerned.webp",
            text: _("We can’t get in! What should we do now?"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("It is said that the orcs used old mine tunnels to surprise the dwarves. There appears to be one nearby, to the north-east."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Then we must make it to that tunnel!"),
          },
        ],
      },
