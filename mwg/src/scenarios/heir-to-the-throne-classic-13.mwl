              },
            ],
          },
          {
            tag: "message",
            speaker: "Uncle Somf",
            text: _("How are we doing, $outlaw_name|?"),
          },
          {
            tag: "message",
            speaker: "$outlaw_advisor_store.id",
            text: _("The same as always, Uncle!"),
          },
          {
            tag: "message",
            speaker: "Uncle Somf",
            text: _("That bad, huh?"),
          },
