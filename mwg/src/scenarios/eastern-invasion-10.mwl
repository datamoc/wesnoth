          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 36,
            y: 16,
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Ugh, spellcasting always gives me the shivers. There’s a reason the more civilized people of my homeland don’t trifle with magic!"),
          },
          {
            tag: "message",
            speaker: "Terraent",
            text: _("For a mage of the Light, the words you speak are dark indeed."),
          },
          {
            tag: "message",
            speaker: "Addogin",
            text: _("I’m a simple man. I use simple tools and weapons. This magic stuff is givin’ me the creeps."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Dacyn",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "se",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("This antechamber only has room for eight. I must go to retrieve the artifact, and Gweddry has agreed to accompany me, so that leaves room for six more."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
