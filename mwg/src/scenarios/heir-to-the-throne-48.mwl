          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("Li’sar, as a general of Wesnoth you were surely familiar with Dan’Tonk’s defenses. Do you have any insight into its weaknesses? Is there anything we can use against the general?"),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("There was a hidden tunnel, once, but I had it collapsed some years ago. Sorry."),
          },
