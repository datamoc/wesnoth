            tag: "filter",
            side: 1,
            x: 24,
            y: 1,
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("<i>Crimson pool, essence of life, Flesh and blood flow away to rot, Leaving only bones to remain.</i>"),
          },
