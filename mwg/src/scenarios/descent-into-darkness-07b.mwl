          {
            tag: "message",
            text: _("Hunt down the undead! Destroy them all!"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("The city guard has entered the manor. We will have to hold them off while we search."),
          },
        ],
      },
