        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 5,
            y: 15,
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("<i>There is nothing good or bad, but thinking makes it so.</i>"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 1,
            y: 9,
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("<i>Mirrors of shallow blue, cold and opaque, they stare, Piercing, unblinking, a pitiless reflection, Shattering our brittle, fancied reality.</i>"),
          },
        ],
      },
      {
        tag: "event",
