        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 7,
            y: 1,
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("<i>Emerald, verdant green gives way, Touched by shadow, dark dye of black, An abhorrent stain of pestilence.</i>"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "moveto",
        once: true,
