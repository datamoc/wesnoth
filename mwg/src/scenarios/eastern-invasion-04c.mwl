      {
        tag: "event",
        id: "if_43",
        on: "branch_if_43",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "first_prisoner_freed",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("How did these undead come to imprison you?"),
          },
          {
            tag: "message",
            speaker: "Terraent",
            text: _("It is a sad tale. My allies and I were questing when we were ambushed and captured by ghostly warriors. Their leader has been toying with us, forcing us to fight for their amusement."),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("No soldier deserves such treatment. We will try to free as many of you as possible."),
          },
          {
            tag: "message",
            speaker: "Terraent",
            text: _("Five of my comrades are still imprisoned. We will gladly enter your service in appreciation for our freedom."),
          },
        ],
      },
