      {
        tag: "event",
        id: "ev_5",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Fal Khag",
            text: _("I long to burn human cities, but that weaselly witch thinks we’re only good enough for these puny villages. These hapless clods barely have anything, but at least the witch’s gold is good."),
          },
          {
            tag: "message",
            speaker: "Fal Khag",
            text: _("Ride, you worms! Let’s finish our raid before their hunters return."),
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "goodguys_store",
          },
          {
