          {
            tag: "message",
            text: _("Chief, more wyrms are attacking the east tunnels! There’s too many of them! What do we do?"),
          },
          {
            tag: "message",
            speaker: "Chief Dra-Nak",
            text: _("I’m not going to let everything I’ve worked for fall apart so easily! These vermin are WEAK! We are STRONG!"),
          },
          {
            tag: "message",
            text: _("Okay, but that’s not really a battle pla-"),
