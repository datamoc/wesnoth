            value: "$konrad_store.y",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "Rholandir",
            text: _("Lord Kalenz, Lord Konrad, our forces are nigh! Do not lose hope!"),
          },
        ],
      },
      {
        tag: "event",
