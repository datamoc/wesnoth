      },
      {
        tag: "unit",
        id: "Lanbec_h",
        type: "General",
        side: 2,
        x: 29,
        y: 38,
        name: _("Lanbec’h"),
      },
      {
        tag: "unit",
        id: "u_1",
        type: "Orcish Grunt",
        side: 1,
        x: 15,
        y: 2,
      },
      {
        tag: "event",
        id: "carryover_10",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "carryover_percentage",
            value: 40,
          },
        ],
      },
      {
        tag: "event",
        id: "story_11",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Refusing to yield to fear, Kapou’e rallied his warriors in preparation for the upcoming battle."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_12",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("He was not disappointed. A few days later the main body of the human army arrived. Driven to a desperate rage by the death of his son-in-law, Earl Lanbec’h led the army himself."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_13",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Kapou_e,Lanbec_h",
          },
        ],
      },
      {
        tag: "event",
        id: "clock_14",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "turn_limit",
            value: 18,
          },
        ],
      },
      {
        tag: "objectives",
        side: 1,
        victory: _("Defeat Lanbec’h Resist until your people are ready to go (turn 13) Then move Kapou’e to the signpost in the northeast Move Kapou’e to the signpost in the northeast"),
        defeat: _("Death of Kapou’e"),
        children: [
          {
            tag: "defeat",
            condition: "hook",
            hook: "predicate:turn_limit",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_1",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:play_music",
            file: "loyalists.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "battle.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "heroes_rite.ogg",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_2",
        on: "prestart",
        once: true,
      },
      {
        tag: "event",
        id: "ev_3",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
            side: 1,
            cells: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Vrag",
            unit: "Vrag",
          },
          {
            tag: "message",
            speaker: "Lanbec'h",
            text: _("So this is the bold orc who has dared kill my son-in-law."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("And this is that stupid human who dares march against Kapou’e — Son of the Black-Eye!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 6,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("As Kapou’e saw the hardened troops pour out of the human encampment, he began to have second thoughts."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("They are too many and too tough. The few here don’t stand a chance."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("The Son of the Black-Eye will never ‘flee’. But making a ‘strategic withdrawal’ is another matter."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("My father often spoke of the shamans of the Great Council who live in Barag Gór in the lands of the free tribes. We shall ask them for support. With their help, perhaps we can unite the orcish tribes and crush these humans."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_helper",
            kill: "no",
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("$stored_helper.name|!"),
          },
          {
            tag: "message",
            speaker: "Helper",
            text: _("Yeah, Chief?"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("You, gather up our people and assemble them on the road some distance north of here. We will hold back the humans here until you are finished."),
          },
          {
            tag: "message",
            speaker: "Helper",
            text: _("Done."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "u_1",
          },
          {
            tag: "hook",
            name: "command:add_item",
            x: 28,
            y: 1,
            item_name: "",
            image: "scenery%2Fsignpost.png",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "prepare_retreat",
            value: "yes",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:show_objectives",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: 27,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "Kapoue_leaves",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 13,
          },
          {
            tag: "set_variable",
            name: "stored_helper.x",
            value: 27,
          },
          {
            tag: "set_variable",
            name: "stored_helper.y",
            value: 1,
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_helper",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 25,
            y: 1,
          },
          {
            tag: "message",
            speaker: "Helper",
            text: _("Chief, we have all our people ready to go. Come on, this way. We managed to gather the last of the gold from the treasury as well."),
          },
          {
            tag: "gold",
            side: 1,
            amount: 100,
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Took you long enough. Let’s go!"),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "retreat",
            value: "yes",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "kapoue_leaves",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("We’ll be back, you foul mud-sucking humans!"),
          },
          {
            tag: "message",
            speaker: "Lanbec'h",
            text: _("That’s right, flee, you cowardly orcs! This land is mine!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue-angry.webp",
            text: _("In your dreams, worm. When the time comes you will pay for all this with your life!"),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kapou'e%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I’m done. My people are doomed!"),
          },
          {
            tag: "lose",
          },
        ],
      },
    ],
  },
]
