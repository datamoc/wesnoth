        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Delfador became Li’sar’s High Counselor, advising her in the most important matters of state. He lived until a ripe old age and was granted a royal funeral, after which he was buried in the Royal Crypt in Weldyn."),
