          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "time_over",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Commander Aethyr",
            text: _("I see masts on the horizon. Jevyan’s fleet is here! It’s all over."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 9,
            y: 33,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "scenery/signpost.png",
            text: _("Please Disembark in an Orderly Fashion and Proceed South"),
          },
          {
            tag: "message",
            text: _("Hmm, they left off the ‘or the orcs will eat you’ part."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 7,
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "jessica_store",
            x: 14,
            y: 38,
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("I’m back, things went well! Haldric, I sure hope you know what you’re doing."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Umm, we’ll talk about it later. I’m just a little busy at the moment. I’m glad you made it back in one piece."),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("Yes, it looks like you could use all of the help you can get."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_21",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("We’ve defeated Jevyan’s forces. The ships must disembark their passengers quickly—"),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
            text: _("Haldric, what’s going on? What’s the plan?"),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("We’re going to confront Jevyan and destroy him."),
          },
          {
            tag: "message",
            speaker: "Lady Jessene",
