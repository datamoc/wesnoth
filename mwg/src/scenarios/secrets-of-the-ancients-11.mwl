      {
        tag: "event",
        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Blianxkep",
            text: _("The fish people gave good value for the last load. More metal of that type is desired."),
          },
          {
            tag: "message",
            speaker: "Krissaz",
            text: _("Firssst, pay us our ssshare."),
          },
          {
            tag: "message",
            speaker: "Blianxkep",
            text: _("Wait, who approaches?"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("I am a mage and not a threat to you gentle... reptiles. I wish only to animate some spirits, so I won’t disturb your salvage operation."),
          },
          {
            tag: "message",
            speaker: "Krissaz",
            text: _("No! You can’t make thisss place more haunted than it isss! The femalesss already won’t come here, and we are forced to rely on these ssserpents for protection."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("I was only informing you out of courtesy. In truth, I don’t require your permission."),
          },
          {
            tag: "message",
            speaker: "Blianxkep",
            text: _("We will help you drive off this foe if you will consider your share paid in full."),
          },
          {
            tag: "message",
            speaker: "Krissaz",
            text: _("When the mage isss dead and her dead horde put to ressst, we agree. We will have been compensssated adequately."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Every time..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "victory",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Good. Now I can practice recruiting ghosts."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "portraits/undead/ghost.webp~SCALE(93, 93)",
            text: _("You can now recruit ghosts!"),
          },
          {
            tag: "set_variable",
            name: "distance",
            value: 0,
          },
          {
            tag: "while",
            test: "wml_condition_tree('tree=%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22location.length%22%2C%22less_than%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22distance%22%2C%22less_than_equal_to%22%3A%2220%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D')",
            children: [
              {
                tag: "hook",
                name: "command:store_locations",
                variable: "location",
                filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22variable%22%3A%22location%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%22x%22%3A%2216%22%2C%22y%22%3A%224%22%2C%22radius%22%3A%22%24distance%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "distance",
                value: 1,
                mode: "add",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Vendraxis",
            text: _("Human, take me with you!"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Why should I allow that? Your people attacked me!"),
          },
          {
            tag: "message",
            speaker: "Vendraxis",
            text: _("I tried to ssstop them! For myself, I wissshed not to attack. I wissshed to learn. My race livesss but a short time compared to yoursss. I would learn to exssstend my ssspan, and the planetsss told me you know this sssecret."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Actually, I am searching for that secret now. But could you follow the orders of a woman?"),
          },
          {
            tag: "message",
            speaker: "Vendraxis",
            text: _("I have ssstared into the darknesss between the starsss and not been intimidated by the void, but your mind holds a darknesss of another kind, frightening and forbidden by my clan. I sssubmit to your power. Now that I know you are female, I will find it easier as it isss the way of my kind."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Very well, come along. I am Ardonna."),
          },
          {
            tag: "message",
            speaker: "Vendraxis",
            text: _("Yesss, but the planetsss tell me your name isss now untrue. I do not underssstand thisss."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Nor do I. Your planets are quite cryptic."),
          },
          {
            tag: "message",
            speaker: "Vendraxis",
            text: _("They reveal what they will."),
          },
        ],
      },
