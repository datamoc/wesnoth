      },
      {
        tag: "event",
        id: "ev_9",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Asheviere",
            text: _("So, these rebels come at last to face me, while most of my army is off fighting the fickle clans."),
          },
          {
            tag: "message",
            speaker: "clanboss",
            text: _("Wretched wench. Your army is tasting death as we speak. The clans have arrived to unseat you, pretender!"),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            text: _("Surrender, Mother. The land’s blood is spent. I have come to take my rightful place."),
          },
          {
            tag: "message",
            speaker: "Asheviere",
            text: _("Ahh. My own daughter, a turncoat. So it is true. Such treason my reign must endure! But endure it will."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("How long must the people endure your rule? Give the throne to your daughter. She is the rightful heir. We even hold the Sceptre to prove it!"),
          },
          {
            tag: "message",
            speaker: "Asheviere",
            portrait: "portraits/asheviere-mad.webp",
            text: _("Delfador! My old tormentor! Treason! Men! Seize them! Kill them! Kill them all!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "attacker_hits",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                any: "yes",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22type%22%3A%22Gryphon%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22id%22%3A%22Li'sar%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22id%22%3A%22Delfador%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "filter",
            unit: "Asheviere",
          },
          {
            tag: "message",
            text: _("Take this, witch!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Asheviere%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Asheviere",
          },
          {
            tag: "hook",
