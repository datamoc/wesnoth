            value: 0,
          },
          {
            tag: "set_variable",
            name: "troll_hole",
            value: 0,
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "last_done",
            value: "none",
            mode: "value",
          },
          {
            tag: "hook",
