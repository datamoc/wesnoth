      {
        tag: "event",
        id: "story_21",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("After the defeat of the nagas, Haldric’s refugees take on fresh water and hunt small game, relieved to have land beneath their feet. When they depart, even the sea-weather is milder."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_22",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: _("story/trow_story_15-A_New_Land.webp"),
            text: _("After a week’s steady sailing eastward, they begin to hear the cries of gulls and feel the loom of the land. The Great Continent appears before them over the summer-lit seas."),
          },
        ],
      },
      {
        tag: "event",
