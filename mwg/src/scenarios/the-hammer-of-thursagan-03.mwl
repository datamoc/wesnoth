      },
      {
        tag: "event",
        id: "ev_27",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Marth-Tak",
            text: _("In the name of the Alliance, quit these lands now!"),
          },
          {
            tag: "message",
            speaker: "Gorthas",
            text: _("We will fare where we will and take what we will, dog of an orc. To the dark gods with you and your precious ‘Alliance’. Even your own kind are fed up with your peacemaking!"),
          },
          {
            tag: "message",
            text: _("Stinkin’ weakling! No true orc would fight for somethin’ as stupid as the Alliance."),
          },
          {
            tag: "message",
            speaker: "Marth-Tak",
            text: _("You underestimate our strength. We shall see who the true orc is after this battle is over!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Now that is a sight still strange to my eyes — an orc fighting for the Northern Alliance."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I’m surprised myself that so many of the orcish tribes came over to the Alliance. Not so strange to see humans raiding us, worse luck."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Marth-Tak",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Marth-Tak",
            text: _("You, on the road! Are you of the Northern Alliance or not?"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("We are."),
          },
          {
            tag: "message",
            speaker: "Marth-Tak",
            text: _("Well, then, honor the treaty as I have. Fight to repel these invaders."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("That is our duty."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("For the Alliance! Axes up!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_28",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Marth-Tak%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("We have failed our duty to the Alliance."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_29",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gorthas%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "cutscene_retreating_enemies",
            kill: "no",
            side: 2,
          },
          {
            tag: "foreach",
            variable: "cutscene_retreating_enemies",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scenario_move",
                id: "$this_item.id",
                x: 50,
                y: "$($this_item.y)",
                raw: "yes",
              },
              {
                tag: "hook",
                name: "command:kill_unit",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Marth-Tak",
            text: _("My thanks, dwarves. These bandits might have hacked a bloody swathe through the Alliance’s tribes if we had not killed them here."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("My thanks to you, for proving there are orcs I can fight alongside rather than against. But we cannot linger here to celebrate; we are journeying east."),
          },
          {
            tag: "message",
            speaker: "Marth-Tak",
            text: _("East, eh? You won’t find many friends in that direction. There’s talk of wolves, and worse. Travel safely."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_30",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Aiglondur%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I fall!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_31",
        on: "die",
        once: true,
        children: [
          {
