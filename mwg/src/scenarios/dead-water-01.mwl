          {
            tag: "spawn",
            id: "Gwabbo",
            type: "Merman Netcaster",
            side: 1,
            x: 33,
            y: 19,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Gwabbo",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Gwabbo",
          },
          {
            tag: "message",
            speaker: "Gwabbo",
            text: _("Back, you fiend! You have not won...I will return to finish this."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Gwabbo",
            x: 19,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Gwabbo",
            text: _("Kai! We are under attack! Fell creatures invaded our village and slew without mercy. I managed to fight my way clear, and have come to seek your aid."),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("What manner of creatures were they?"),
          },
          {
            tag: "message",
            speaker: "Gwabbo",
            text: _("I have never seen their like before in all my years. They were like men, but they had no skin. Our spears went right through them; they <i>laughed</i> at our weapons. And they smelled like nothing in the sea, of dank earth and rottenness."),
          },
          {
            tag: "message",
            speaker: "Cylanna",
            text: _("Undead. This will be your first real test as a leader, Kai Krellis. You must defeat these creatures."),
          },
          {
            tag: "message",
            speaker: "Gwabbo",
            text: _("Kai, please lead us against them yourself, it will hearten the folk. And — if you will permit — you now reach the age where a kai must learn battle skills."),
          },
          {
            tag: "message",
            speaker: "Cylanna",
            text: _("Gwabbo speaks wisely. You must fight; I will protect you as much as I can...but when war looms, a kai must lead. It is our way."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You have few trained fighters, so you can only recruit three of each level 1 unit. There is no limit on citizens."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_25",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "Mal-Kevek",
            text: _("Rise, my slaves! We will create an army for Lord Ravanal."),
