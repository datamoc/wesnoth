              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MK",
            kill: "no",
            id: "Mal-Kevek",
          },
          {
            tag: "message",
            text: _("Foolish fish-men. You cannot kill <i>me</i> that easily."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("The merfolk saw a shadowy shape rise from the dead body of the necromancer and disappear under the mountain."),
