            value: 0,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "_mwg_repeat_0",
                less_than: "$zombie_number_pattern[ $($number_of_captured_villages % 5) ].number",
              },
              {
                tag: "hook",
                name: "command:spawn_dynamic",
                type: "$zombie_type",
                side: "$unit.side",
