      {
        tag: "event",
        id: "ev_5",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("The stolen book lies within Lady Karae’s manor at the north end of the city. It will be difficult for us to defeat the entire city guard, so we must stay hidden as long as possible. For now, we can make use of this fog. I shall use it to cast a spell to obscure the town guards’ vision."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 450,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 350,
          },
