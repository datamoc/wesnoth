              },
            ],
          },
          {
            tag: "message",
            speaker: "Nym",
            portrait: "portraits/nym_moody.webp",
            text: _("Kaleh? Zhul? I’m still stuck back here..."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "if_61",
        on: "branch_if_61",
