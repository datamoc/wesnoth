          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "2-10",
            ys: "30-36",
          },
          {
            tag: "message",
            text: _("All the paths lead to this chamber. Is this just a dead end? It seems to be some sort of temple, but it has obviously been abandoned for a long time. All that is left is that stone altar. What god they were worshiping I have no idea, but the dried blood and cracked bones on the altar do not bode well."),
          },
          {
            tag: "message",
            speaker: "$ally_id",
            text: _("I don’t like the smell of this place."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("I feel some sort of presence... Ugh... it makes my skin crawl."),
          },
          {
            tag: "switch",
            variable: "ally_id",
            children: [
              {
                tag: "case",
                equals: "Grog",
                children: [
                  {
                    tag: "message",
                    speaker: "Nym",
                    text: _("Grog, I thought you said that you’d been here before? Where are we supposed to go from here?"),
                  },
                ],
              },
              {
                tag: "case",
                equals: "Nog",
                children: [
                  {
                    tag: "message",
                    speaker: "Nym",
                    text: _("Nog, I thought you said that you’d been here before? Where are we supposed to go from here?"),
                  },
                ],
              },
              {
                tag: "case",
                equals: "Rogrimir",
                children: [
                  {
                    tag: "message",
                    speaker: "Nym",
                    text: _("Rogrimir, I thought you said that you’d been here before? Where are we supposed to go from here?"),
                  },
                ],
              },
              {
                tag: "case",
                equals: "Jarl",
                children: [
                  {
                    tag: "message",
                    speaker: "Nym",
                    text: _("Jarl, I thought you said that you’d been here before? Where are we supposed to go from here?"),
                  },
                ],
              },
            ],
          },
          {
            tag: "message",
            speaker: "$ally_id",
            text: _("I never explored this deep into the complex. But every lair has to have a back door somewhere."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Well I refuse to give up. There must be some way out. Search everywhere, people."),
          },
        ],
