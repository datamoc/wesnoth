          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22item%22%2C%22attributes%22%3A%7B%22x%22%3A%2217%22%2C%22y%22%3A%2221%22%2C%22image%22%3A%22items%2Fchest-plain-open.png%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22sound%22%2C%22attributes%22%3A%7B%22name%22%3A%22gold.ogg%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22Looks%20like%20the%20guards%20at%20this%20outpost%20had%20been%20saving%20away%20a%20bit%20of%20loot.%20I%20don%E2%80%99t%20suppose%20they%E2%80%99re%20going%20to%20mind%20anymore%20if%20we%20made%20use%20of%20it.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22store_gold%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%2C%22variable%22%3A%22gold_amount%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22set_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22min_gold%22%2C%22value%22%3A%22120%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22if%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22gold_amount%22%2C%22greater_than%22%3A%220%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22then%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22set_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22profit%22%2C%22value%22%3A%22%24(max(%5B50%2C%20%24min_gold%20-%20%24(%24gold_amount%20*%206%2F10)%5D))%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22gold%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%2C%22amount%22%3A%22%24profit%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22profit%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22modify_side%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%2C%22gold%22%3A%22%24min_gold%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22gold_amount%2Cmin_gold%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:add_item",
            x: 17,
            y: 21,
            item_name: "",
            image: "items%2Fchest-plain-open.png",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gold.ogg",
          },
          {
            tag: "message",
            text: _("Looks like the guards at this outpost had been saving away a bit of loot. I don’t suppose they’re going to mind anymore if we made use of it."),
          },
          {
            tag: "hook",
