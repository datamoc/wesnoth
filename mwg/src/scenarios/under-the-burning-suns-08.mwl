      {
        tag: "event",
        id: "ev_38",
        on: "start_training",
        once: true,
        children: [
          {
            tag: "spawn",
            id: "Blessed_Kali",
            type: "Haunt",
            side: 3,
            x: 8,
            y: 39,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Blessed_Kali",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "respawn_trainees",
          },
          {
            tag: "message",
            speaker: "Blessed Kali",
            text: _("All right you runts, let’s try this again. Pior, remember to swing your sword with your whole body, not just your arms."),
          },
          {
            tag: "message",
            speaker: "Novice Pior",
            text: _("Yes, sir."),
          },
          {
            tag: "message",
            speaker: "Blessed Kali",
            text: _("Dani, keep your feet moving. If you stand still you’re a dead man."),
          },
          {
            tag: "message",
            speaker: "Novice Dani",
            text: _("Right, sir."),
          },
          {
            tag: "message",
            speaker: "Blessed Kali",
            text: _("Iona, try to vary your attacks more. You’re becoming too predictable."),
          },
          {
            tag: "message",
            speaker: "Novice Iona",
            text: _("I’ll try, sir."),
          },
          {
            tag: "message",
            speaker: "Blessed Kali",
            text: _("And remember, everyone, we’re going to keep practicing until I’m satisfied. So, ready... attack!"),
          },
          {
            tag: "message",
            text: _("Wait a minute, I don’t see any targets or practice dummies. Who are they supposed to be attacking?"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("I believe that would be us. But perhaps we can give them a few lessons in proper fighting style."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_39",
        on: "new_turn",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Blessed Kali",
              },
              {
                tag: "predicate",
                name: "unit_exists",
                exists: "no",
                id: "Novice Iona,Novice Dani,Novice Pior",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Blessed Kali",
            text: _("Come on! I ain’t going anywhere for the rest of the day, and unless you can fight better than that, neither are you. Now get your sorry behinds up off the ground and do it all over again. You numbskulls aren’t getting the easy treatment on my watch, no sir!"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "respawn_trainees",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_40",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Blessed%20Kali%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Blessed Kali",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "respawn_trainees",
          },
          {
            tag: "message",
            speaker: "Novice Pior",
            text: _("Finally, we get to take a break. I am so sick of fighting practice."),
          },
          {
            tag: "message",
            speaker: "Novice Dani",
            text: _("Kali’s just a hardass because he’s bitter that he never became a high priest."),
          },
          {
            tag: "message",
            speaker: "Novice Iona",
            text: _("Hey, c’mon, maybe we can grab some food from the kitchen before we have to go to prayers."),
          },
          {
            tag: "message",
            speaker: "Novice Pior",
            text: _("Good idea! I hope they let us go outside tomorrow; I so miss the sun."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Novice Iona",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Novice Dani",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Novice Pior",
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("Still lambasting those novices after all these years, that guy definitely had too much of a work ethic."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("Sniff, who were those children? Why did they die, in the dark, so many years ago? May Eloh shine her eternal light upon their souls."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("The past is the past, and there’s nothing we can do about it. Right now we have our own people to worry about."),
          },
        ],
      },
