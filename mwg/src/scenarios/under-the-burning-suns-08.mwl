      {
        tag: "event",
        id: "ev_94",
        on: "kill_submerged_units",
        once: false,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "drowning_units",
            kill: "no",
          },
          {
            tag: "message",
