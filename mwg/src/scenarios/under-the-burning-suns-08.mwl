            type: "Longbowman",
            side: 2,
            x: 43,
            y: 26,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_31",
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("You disappoint me, Kaleh. You are weak, and not worthy of my guidance... Do as you like, but know that while you may be the appointed leader of your people, I am your god, and you defy me at your peril!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Eloh",
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("You are not the god I grew up with. You may be all-powerful, but I will not be your puppet. I am still their leader and as long as I draw breath I will do what I think is best for my people."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("Kaleh, would you mind telling me what in Uria’s name is going on."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("There’s no time. Right now we have to prepare ourselves for another battle. I’d better head back to the outpost and rally our troops. I fear a whole lot of hurt is going to be coming up through those hills very soon."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("Well, now we’re really in for it. I hope you know what you’re doing, Kaleh."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Kaleh",
            x: 17,
            y: 18,
          },
          {
            tag: "switch",
            variable: "ally_id",
            children: [
              {
                tag: "case",
                equals: "Grog",
                children: [
                  {
                    tag: "message",
                    speaker: "Grog",
                    text: _("Grog no like humans either. They mean. But they sound great when they go squish."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "Nog",
                children: [
                  {
                    tag: "message",
                    speaker: "Nog",
                    text: _("Nog no like humans either. They mean. But they sound great when they go squish."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "Rogrimir",
                children: [
                  {
                    tag: "message",
                    speaker: "Rogrimir",
                    text: _("I never liked humans much anyway. I’ll be glad to be fighting something besides undead."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "Jarl",
                children: [
                  {
                    tag: "message",
                    speaker: "Jarl",
                    text: _("I never liked humans much anyway. I’ll be glad to be fighting something besides undead."),
                  },
                ],
              },
            ],
          },
          {
