            unit: "u_17",
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Lo! Karron reinforces us."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("I see Gorlack still lasts... Wing, descend upon the interlopers. Leave no survivors!"),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Karron, their leader is to remain alive. I want no repeat of last time."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("You do not command me, Gorlack."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("I remind you it is by Vladnir’s order this creature remain whole."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("So be it. My wing will hold your prize inviolate. Mostly."),
          },
        ],
      },
      {
