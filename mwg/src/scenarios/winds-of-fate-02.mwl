            unit: "u_21",
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Our hunters will complete the harvesting. Now, see to—"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Resha",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Lo! An unknown wing approaches from northwest!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: "1,6",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Koli",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1500,
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Announce yourselves!"),
          },
          {
            tag: "message",
            speaker: "Koli",
            text: _("I am Second Intendant Koli of Flight Omakon."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("The troubled Domain of Omakon is six dozen leagues away. They are strangely far out..."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("They are rogue."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("State your purpose here!"),
          },
          {
            tag: "message",
            speaker: "Koli",
            text: _("My dominant has sent me to observe the status of this isle."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("So your dominant has you probing for soft scales... Probe just a little closer, rogue!"),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("If you approach any closer, then by the Ways of Morogor we shall Proclaim you Rogue."),
          },
          {
            tag: "message",
            speaker: "Koli",
            text: _("If my flight were rogue, you would already know it. For when the time comes to move against you, we shall first warn of our cold intent. As a final honorable act towards you, our fellow drakes... Then the needs of our hatchlings will demand the taking of your hunting grounds."),
          },
          {
            tag: "message",
            speaker: "Koli",
            text: _("For now, I go."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("Indeed, return to your dominant. Tell her of what you have seen here this day. What we have done to these creatures is only a glimpse of the fate which awaits you!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "rogue_flight",
            kill: "no",
            side: 7,
          },
          {
            tag: "foreach",
            variable: "rogue_flight",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scenario_move",
                unit: "$this_item.id",
                x: 0,
                y: 0,
              },
              {
                tag: "hook",
                name: "command:store_unit",
                variable: "MODIFY_UNIT_store",
                kill: "yes",
                id: "$this_item.id",
              },
              {
                tag: "foreach",
                variable: "MODIFY_UNIT_store",
                item: "this_item",
                children: [
                  {
                    tag: "hook",
                    name: "command:set_variable_dynamic",
                    variable: "this_item.facing",
                    value: "nw",
                    mode: "value",
                  },
                  {
                    tag: "hook",
                    name: "command:unstore_unit",
                    variable: "this_item",
                  },
                ],
              },
              {
                tag: "hook",
                name: "command:kill_unit",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("The rogue flights grow bolder."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Soon they will not matter. Go ensure that our captive is attended to, Resha."),
          },
        ],
      },
    ],
  },
