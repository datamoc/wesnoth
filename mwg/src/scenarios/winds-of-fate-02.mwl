              },
            ],
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Speak, prey. Your kind fares beyond these isles. You will tell us of your destinations."),
          },
          {
            tag: "message",
            speaker: "Viragar",
            text: _("Release me now and maybe I let some of you live... for future sport of my archers! Hahahaha!"),
          },
