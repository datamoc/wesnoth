      {
        tag: "event",
        id: "ev_13",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Grüü",
            unit: "Grüü",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Jetto",
            unit: "Jetto",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Inarix",
            unit: "Inarix",
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue-angry.webp",
            text: _("Earl Lanbec’h, you slimy coward, come out and face me if you have the guts!"),
          },
          {
            tag: "message",
            speaker: "Arthain",
            text: _("Sorry there, old chap. You’re deemed too insignificant for the likes of the Earl to deal with. He’s left that pleasure to me instead."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue-angry.webp",
            text: _("Foolish human. Attack, men! I want that city to be orcish territory within the week. Smite, stab, and slay!"),
          },
          {
            tag: "message",
            speaker: "Al'Brock",
            portrait: "portraits/albrock.webp~FL()~RIGHT()",
            text: _("Easier said than done, Chief. There are many humans in that city. And they are well armed, too."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("No matter. Horde smash!"),
          },
        ],
      },
