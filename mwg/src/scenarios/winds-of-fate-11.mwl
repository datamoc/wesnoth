                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22modify_unit%22%2C%22attributes%22%3A%7B%22experience%22%3A%22%24(%24unit.experience%20%2B%2032)%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22%24unit.id%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22set_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22amount%22%2C%22value%22%3A%2232%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22floating_text%22%2C%22attributes%22%3A%7B%22x%22%3A%22%24x1%22%2C%22y%22%3A%22%24y1%22%2C%22text%22%3A%22%3Cspan%20color%3D'cyan'%3E_%20%2B%24amount%20experience%3C%2Fspan%3E%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22clear_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22amount%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
