      {
        tag: "event",
        id: "if_56",
        on: "branch_if_56",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "talar_dead",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Mal-Talar",
            text: _("Ah, it’s the garrison that escaped me back at that border outpost. They won’t get lucky again this time!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_55",
        on: "side_turn_end",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 1,
          },
          {
            tag: "message",
            speaker: "Naken-alvak",
            text: _("Intruders... living men... from the southeast..."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_56",
          },
          {
            tag: "message",
            speaker: "Mal-Mana",
            text: _("And see who is among them! I shall inform Mal-Ravanal at once."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_58",
        on: "branch_if_58",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "fork_04c",
            equals: "yes",
          },
          {
            tag: "message",
            speaker: "Mal-Ravanal",
            text: _("Dacyn, is that you again? So this is where you ran off to. I would recognize your nauseating aura anywhere."),
          },
          {
            tag: "message",
            speaker: "Mal-Ravanal",
            text: _("I should put you out of your misery right now, but then again, I wanted you to see the results of all my long years of research. I guess it can wait a little longer."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_59",
        on: "branch_if_59",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "fork_04c",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Mal-Ravanal",
            text: _("Wait a moment! That nauseating holier-than-thou aura..."),
          },
          {
            tag: "message",
            speaker: "Mal-Ravanal",
            text: _("... ah, Dacyn, what an unexpected surprise! Last time we spoke, you blasted me before I could even finish telling you about my research."),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("If only it had ended back then. Stop this madness. Let this torment come to an end."),
          },
          {
            tag: "message",
            speaker: "Mal-Ravanal",
            text: _("Torment? What torment? You’re the one who seems to be miserable. But don’t worry, if your goal was to become one of these mindless thralls, you came to the right place. You know what they say. No brain, no pain!"),
          },
        ],
      },
