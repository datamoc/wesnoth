      {
        tag: "event",
        id: "ev_11",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Gweddyn",
            text: _("Ho Rudic! Welcome. You are late, old friend."),
          },
          {
            tag: "message",
            speaker: "Bone Captain",
            text: _("Late."),
          },
          {
            tag: "message",
            speaker: "Gweddyn",
            text: _("Not talking much today? What happened?"),
          },
          {
            tag: "message",
            speaker: "Bone Captain",
            text: _("Happened? Dead."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("<small>(_ Keep quiet about that.)</small>"),
          },
          {
            tag: "message",
            speaker: "Gweddyn",
            text: _("Ha! Well, actually, you do look terrible. Very... gray, and your face is... But we’re speaking! You can’t actually be dead!"),
          },
          {
            tag: "message",
            speaker: "Bone Captain",
            text: _("Yes. Dead."),
          },
          {
            tag: "message",
            speaker: "Gweddyn",
            text: _("What madness is this?"),
          },
          {
            tag: "message",
            speaker: "Bremen",
            text: _("It’s sorcery my lord. Dark sorcery."),
          },
          {
            tag: "message",
            speaker: "Gweddyn",
            text: _("Necromancy! The penalty for that is death. Rudic, who is responsible for this?"),
          },
          {
            tag: "message",
            speaker: "Bone Captain",
            text: _("She."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Ah, well. I should have known this wouldn’t be easy."),
          },
          {
            tag: "message",
            speaker: "Gweddyn",
            text: _("Kill her!"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("We must leave no one alive to report us, or the entire country will become unsafe. We have no choice. We must kill them all."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "closing",
        once: true,
        children: [
