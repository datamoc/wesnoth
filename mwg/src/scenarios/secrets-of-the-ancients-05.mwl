          {
            tag: "message",
            speaker: "Ardonna",
            text: _("What in the world are <i>you</i>?"),
          },
          {
            tag: "message",
            speaker: "Shadow",
            text: _("Spirit and shadow. You will follow."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("You’re a ghost... a real ghost! I will indeed follow you. Lead on."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Shadow",
          },
