              {
                tag: "variable",
                name: "met_wose",
                equals: "yes",
              },
              {
                tag: "have_unit",
                id: "Haralamdum",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Har hum har ... hmm ... well ... har alam dum ... good."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Those undead will bother you no more, Sir Wose."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 2000,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("We still must find the exit from these caverns, Konrad."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Yes, Delfador. I’m afraid we must be going, Sir Wose."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Well, I say ... hmm dum har ... young Master Delfador? Harum-alam-alam. So it is! Hmm hmm alam ... how is your head?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("My head?"),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Just the other day ... hmm ... I was speaking with that twig ... alam ... alam dum ... Thorodor? Hmm ... yes ... hum ... he said you took a ... alam har ... nasty blow to the head ... hmm ... and he feared you were dead."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("That was many years ago, I’m afraid. Now, we really must be moving along ..."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("So hasty ... hmm ... there was something ..."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("Har dum ... oh, yes, the book."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Book?"),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("When you asked Thorodor for ... harum ... assistance? Hmm ... hmm ... He thought you meant the book ... har hmm ... but you had rushed off ... alam ... alam dum ... and died before he could tell you I have it."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I remember no book."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("I am sure ... dum hum ... well, the head ... alam lum alam ... yes, it was somewhere around here ... hum dum da dum ... Thorodor thought it ... hmm ... quite important ... lum harum dum ... perhaps near my home stump?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I am sorry, I remember no book. Now, we really must be off."),
          },
          {
            tag: "message",
            speaker: "Haralamdum",
            text: _("So hasty. Har alam dum."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("The wose silently fade into the forest."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%224%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
