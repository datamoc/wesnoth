      {
        tag: "event",
        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "l3_store_kalenz",
            kill: "yes",
            side: 1,
            not_id: "Cleodil",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "loyals",
            kill: "no",
          },
          {
            tag: "foreach",
            variable: "loyals",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:recall_unit",
                id: "$this_item.id",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "message",
            text: _("Yess! It’s the elves who stole our gold! The bounty is mine!"),
          },
          {
            tag: "message",
            text: _("I saw them first, fool! The bounty is all mine."),
          },
          {
            tag: "message",
            text: _("What are they talking about?"),
          },
          {
            tag: "message",
            text: _("It would seem the saurians put a bounty on our heads for having the effrontery to take our gold back after they stole it. Are you interested?"),
          },
          {
            tag: "message",
            text: _("No, but my axe is interested in some saurian heads! They ha’ been too friendly with the orcs for my liking!"),
          },
          {
            tag: "message",
            text: _("Remember, we are here on a mission. We will fight these saurians if we must, but our mission is to get to Thoria."),
          },
          {
            tag: "message",
            text: _("They are far too numerous to risk battle with. Let’s cross the river!"),
          },
          {
            tag: "message",
            text: _("We can outrun them in the woods and mountains beyond the north shore. But crossing the river without a bridge? We dwarves know water is a very dangerous thing!"),
          },
          {
            tag: "message",
            text: _("Indeed, this river is, I believe, Arkan-Thoria. There are fell legends about it. Maybe they are but children’s tales... Still, be very careful when you cross it."),
          },
          {
            tag: "message",
            text: _("You speak my thought, Cleodil. Close in behind me; I’ll guard you from harm myself. Look to your weapons as we cross, all! And be wary."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Before Kalenz left the Ka’lian he had ordered $left_behind_kalenz to stay and guard it."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: "0-36,0-16,20-36,0-4,22-36,0-2,27-36,34-36",
            y: "0-3,4,4,5,5,6,6,7",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22command%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22We%20made%20it.%20Onwards%20to%20Thoria!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22id%22%3A%22Olurf%22%2C%22message%22%3A%22At%20last!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22id%22%3A%22Landar%22%2C%22message%22%3A%22We%E2%80%99ll%20need%20to%20settle%20things%20with%20these%20saurians%20once%20and%20for%20all!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22id%22%3A%22Cleodil%22%2C%22message%22%3A%22Hasn%E2%80%99t%20enough%20blood%20been%20shed%3F%20I%20think%20we%20can%20compose%20matters%20with%20them%20after%20the%20threat%20of%20the%20orcs%20has%20been%20met.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22endlevel%22%2C%22attributes%22%3A%7B%22result%22%3A%22victory%22%2C%22bonus%22%3A%22yes%22%2C%22carryover_add%22%3A%22yes%22%2C%22carryover_percentage%22%3A%2240%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("We made it. Onwards to Thoria!"),
          },
          {
            tag: "message",
            text: _("At last!"),
          },
          {
            tag: "message",
            text: _("We’ll need to settle things with these saurians once and for all!"),
          },
          {
            tag: "message",
            text: _("Hasn’t enough blood been shed? I think we can compose matters with them after the threat of the orcs has been met."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
