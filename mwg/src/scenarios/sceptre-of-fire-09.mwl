      {
        tag: "event",
        id: "ev_31",
        on: "start",
        once: true,
        children: [
          {
            tag: "spawn",
            id: "u_10",
            type: "Troll",
            side: 5,
            x: 26,
            y: 8,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_10",
