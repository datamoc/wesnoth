            equals: "Krawg",
          },
          {
            tag: "message",
            speaker: "Krawg",
            text: _("Wha’?"),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Krawg puzzled over a stone tile sitting loose on the small mesa. Beneath a spattering of bat guano, there was a glowing rune. Krawg didn’t know what to make of it, so the gryphon left it for now."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_21",
