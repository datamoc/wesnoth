            value: "Shock Trooper",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_11",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_Linneus",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 750,
          },
          {
            tag: "message",
            speaker: "Helicrom",
            text: _("We shall pincer them from the other side of this path. When we are done, no one shall fear the open roads and night sky more than the armies of Weldyn. Strike quickly, strike silently... and leave no one alive."),
          },
          {
