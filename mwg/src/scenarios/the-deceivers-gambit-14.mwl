      {
        tag: "event",
        id: "ev_70",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Methor",
            unit: "Methor",
            x: 45,
            y: 4,
          },
          {
            tag: "hook",
