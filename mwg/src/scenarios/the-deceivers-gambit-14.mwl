      {
        tag: "event",
        id: "ev_71",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Methor%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("No! Methor... Don’t die!"),
          },
          {
            tag: "message",
            speaker: "Methor",
            text: _("Delfador, my sweet, wonderful apprentice... I couldn’t be more proud of you..."),
          },
        ],
      },
