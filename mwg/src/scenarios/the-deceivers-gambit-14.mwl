            id: "Delfador",
            recall_filter: "%7B%22type_adv_tree%22%3A%22Mage%2CSpearman%2CBowman%2CHeavy%20Infantryman%2CFencer%2CFootpad%2CThief%2CRogue%20Mage%2CPoacher%2CCavalryman%2CHorseman%22%7D",
