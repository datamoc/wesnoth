      {
        tag: "event",
        id: "ev_12",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("With great trepidation, Prince Haldric leads his refugee band into the Swamp of Esten. In the center of that very swamp a shroud of fog descends over young Prince Haldric."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("I have a very bad feeling about this. This awful swamp and its crazy cult... Before these troubles started we used to have to clear the swamp every spring and fall."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("I suppose with the rampaging bands of murderous orcs roaming about that hasn’t been done in a while."),
          },
          {
            tag: "message",
            speaker: "Burin the Lost",
            portrait: "portraits/burin-annoyed.webp",
            text: _("I miss the orcs... We go all this way, and (<i>sniff</i>) what a lovely smell we have discovered."),
          },
          {
            tag: "message",
            speaker: "Lady Outlaw",
            text: _("This is too quiet. I don’t like this one bit, not one bit at all."),
          },
          {
            tag: "message",
            speaker: "Prince Haldric",
            text: _("Wait, I think I hear something... To arms!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_15",
        on: "branch_if_15",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "possible_scorpion_locs.length",
            greater_than_or_equal_to: 1,
          },
          {
            tag: "hook",
            name: "command:set_variable_rand",
            variable: "scorpion_loc_i",
            values: "0..$|($|possible_scorpion_locs.length - 1)",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "spawn_x",
            value: "$|possible_scorpion_locs[$|scorpion_loc_i].x",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "spawn_y",
            value: "$|possible_scorpion_locs[$|scorpion_loc_i].y",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: "$|spawn_x",
            y: "$|spawn_y",
          },
        ],
      },
