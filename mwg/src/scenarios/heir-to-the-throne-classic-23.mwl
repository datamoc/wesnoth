        once: true,
        children: [
          {
            tag: "condition",
            variable: "units_to_slay",
            greater_than: 1,
          },
          {
            tag: "message",
            speaker: "Sir Ruga",
            text: _("Even as I pledge my lance to your service, my Clan fights on!"),
          },
        ],
      },
