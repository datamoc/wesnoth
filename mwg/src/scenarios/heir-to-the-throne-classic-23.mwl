      {
        tag: "event",
        id: "ev_7",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Greetings, men of the plains."),
          },
          {
            tag: "message",
            speaker: "Sir Daryn",
            text: _("What do these intruders want? We did not invite them here, that is certain."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("We come in peace! We wish for you to aid us in our struggle against Asheviere, the evil queen."),
          },
          {
            tag: "message",
            speaker: "Sir Alric",
            text: _("We will not join you. You who are led by these youths and this old man."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("You are for us or against us. If you do not join us to overthrow the evil queen, we will strip you of your power, once the throne is rightfully reclaimed."),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("Hah! You think you can seize the throne? Defeat us in battle and we will join you, or leave now and never return!"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("Very well. We will fight you."),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("Fools! We will run you down like dogs!"),
          },
          {
            tag: "message",
            speaker: "Sir Alric",
            text: _("There is no turning back for you now. This is a fight to the death!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 3,
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Delfador, this is sheer madness. We cannot afford to play games when we should be marching against the Queen."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Lord Bayar, halt this folly! I challenge you to a personal combat."),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("Ho! You have amused me, young heir. Ho, ho, challenge indeed."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Young heir? Then you assent to my claim?"),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("Impudence. Bah! Do you see orcs on our plains? Did we not grant you a test of your strength?"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("I fail to see the purpose of this exercise. It only weakens us."),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("No, whelp. You may be weakened, but the horse clans are eternal. I will promise you this, however. If you can defeat me in battle, I myself will join your siege of Weldyn."),
          },
          {
            tag: "message",
            speaker: "Sir Ruga",
            text: _("Aye."),
          },
          {
            tag: "message",
            speaker: "Sir Daryn",
            text: _("Aye."),
          },
          {
            tag: "message",
            speaker: "Sir Alric",
            text: _("Aye."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_10",
        on: "branch_if_10",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "units_to_slay",
            greater_than: 1,
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("I cannot believe this! You have defeated me! You are now my liege, and I leave the battlefield in shame. But the Clan shall fight on!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Their leader has fallen but still they fight!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Bayar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "set_variable",
            name: "clan_bayar",
            value: 1,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_10",
          },
        ],
      },
      {
        tag: "event",
        id: "if_12",
        on: "branch_if_12",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "units_to_slay",
            greater_than: 1,
          },
          {
            tag: "message",
            speaker: "Sir Daryn",
            text: _("You can defeat me, but the Clan will never fall. Our numbers are endless!"),
          },
        ],
      },
      {
        tag: "event",
