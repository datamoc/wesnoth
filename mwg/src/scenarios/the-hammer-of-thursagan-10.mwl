                variable: "fade_duration_remaining",
                value: 5,
                mode: "sub",
              },
              {
                tag: "set_variable",
                name: "volume",
                value: 100,
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: "$fade_duration_remaining",
                mode: "multiply",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: 0,
                mode: "divide",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "volume",
                value: "$(100-$volume)",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:volume",
                music: "$volume",
              },
              {
                tag: "hook",
                name: "command:delay",
                time: 5,
              },
            ],
          },
          {
            tag: "hook",
            name: "command:volume",
            music: 100,
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Aiglondur speaks the truth. The deed is done. Though the heart of the darkness is gone, there is still much to do. Much will have to be done to amend the desecration of the Hammer and the evil that has been done here."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("But first, we must bring this news to the rest of Kal Kartha. A new Lord must be chosen."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Aye, let us go."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_65",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22id%22%3A%22Dufon%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Dufon",
            text: _("You shall never pass through here! The doors I guard are sealed by the power of the Hammer itself."),
          },
          {
            tag: "message",
            text: _("You won’t stop us!"),
          },
          {
            tag: "message",
            speaker: "Dufon",
            text: _("Fools! Even should you defeat me, the master’s ritual will soon be complete and you shall all become his slaves!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_67",
        on: "die",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 37,
            ys: 21,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 37,
            y: 21,
          },
          {
            tag: "message",
            text: _("It seems that the guard spoke the truth. The eastern way is shut fast! There are two curious runes on the ground."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("The way is sealed by the ancient runelore of the Hammer. No amount of force can open these doors."),
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("Most curious. I’ve never encountered magic of this sort before."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("You know something of runes, Angarthing. You have read Thursagan’s notebook."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Aye."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Can you open the doors?"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Perhaps. We must be prepared for what lies beyond."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 37,
            y: 21,
