      {
        tag: "event",
        id: "ev_166",
        on: "elende_speaks_to_deoran",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Deoran",
              },
            ],
          },
          {
            tag: "message",
            speaker: "deoran_mirror",
            portrait: "portraits/deoran-sad-mirror.webp",
            text: _("Deoran the exile returns home; returns to a nation that scorned him, ignored his counsel and cast him away. What will become of the life he has built amongst Lintanir’s twilight eaves?"),
          },
          {
            tag: "message",
            speaker: "Deoran",
            portrait: "portraits/deoran-old-mirror.webp",
            text: _("I know my duty! A captain of Wesnoth will never entertain doubts of loyalty, whether to his country or his King."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_167",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22chantal_mirror%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Chantal",
              },
            ],
          },
          {
            tag: "message",
            speaker: "chantal_mirror",
            portrait: "portraits/shyde-mirror.webp",
            text: _("Chantal—"),
          },
          {
            tag: "message",
            speaker: "Chantal",
            portrait: "portraits/chantal-druid-mirror.webp",
            text: _("I already know what you’re going to say Elende! Don’t you dare; I will when I’m ready."),
          },
          {
            tag: "message",
            speaker: "chantal_mirror",
            portrait: "portraits/shyde-mirror.webp",
            text: _("Then you may soon understand some measure of your great-grandfather’s bygone sorrows..."),
          },
        ],
      },
