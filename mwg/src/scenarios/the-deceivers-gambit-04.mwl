      {
        tag: "event",
        id: "story_1175",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("After a hasty explanation, and with Deoran’s aid, Delfador made many apologies to the woses and their leader. Most of the destroyed trees had fortunately not been killed, merely injured. Over the next several days, and aided greatly by the woses’s natural regenerative abilities, Deoran showed Delfador how to nurse the crippled tree-folk back to health. _ At last, relations mended, the two of them set out to deliver King Garard’s message to the elves..."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_1176",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Eloreis,Parandra,Kalenz,Chantal,kalenz_mirror,chantal_mirror,deoran_mirror,delfador_mirror1,delfador_mirror1,delfador_mirror2,delfador_mirror3,delfador_mirror4",
          },
        ],
      },
      {
        tag: "objectives",
        side: 1,
        victory: _("Find the Sylph Fill the central pool with water Defeat all enemies"),
        defeat: _("Death of Delfador, Deoran, Chantal, or Kalenz Death of Delfador, Deoran, Chantal, or Kalenz Loss of Delfador Turns run out"),
      },
      {
        tag: "event",
