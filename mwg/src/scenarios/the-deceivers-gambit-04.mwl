              },
            ],
          },
          {
            tag: "message",
            text: _("Glob glob glob."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_9",
        on: "branch_if_9",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.type",
            equals: "Fire Guardian",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_condition_tree",
                tree: "%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22unit.type%22%2C%22equals%22%3A%22Fire%20Wraith%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Fsss crackle hiss."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_6",
        on: "branch_if_6",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.id",
            equals: "familiar",
          },
          {
            tag: "filter_condition",
            children: [
              {
