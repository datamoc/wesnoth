            portrait: "portraits/lich-mirror.webp",
            text: _("Lich’s eye and brother’s bone; what have you sacrificed to save your people, Kalenz? Your greatest fear stands before you... ahead of you?"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            portrait: "portraits/kalenz-mirror.webp",
            text: _("That was long ago, Elende! This is about the humans’ story, not mine."),
          },
        ],
      },
