            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue-angry.webp",
            text: _("The Great Horde is almost here! Drive them out of our villages <b>now</b>!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_44",
        on: "branch_if_44",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_condition_tree",
                tree: "%7B%22tag%22%3A%22have_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22*%5EV*%22%2C%22y%22%3A%221-11%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22owner_side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Gork",
            text: _("Here we are!"),
          },
          {
            tag: "message",
            speaker: "greathordewarlord1",
            portrait: "portraits/orcs/grunt-6.webp",
            text: _("What’s this? This weakling has let humans enter Prestim? I will lead the horde and push them to the river!"),
          },
          {
            tag: "message",
            speaker: "greathordewarlord2",
            portrait: "portraits/orcs/grunt-5.webp",
            text: _("Bah! I’m the only one strong enough to drive out the humans! The Great Horde follows me!"),
          },
          {
            tag: "message",
            speaker: "Earl Lanbec'h",
            text: _("Look at that, the stupid orcs are starting to fight amongst themselves! Now’s our chance, everyone attack!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "if_45",
        on: "branch_if_45",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "__invalid_if__",
            not_equals: "",
          },
          {
            tag: "message",
            speaker: "Gork",
            text: _("Here we are! Hold on Prestim, we will help you push them to the river!"),
          },
          {
            tag: "message",
            speaker: "Earl Lanbec'h",
            text: _("They are too numerous now, RETREAT!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%225%22%2C%22animate%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%2C%22animate%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
