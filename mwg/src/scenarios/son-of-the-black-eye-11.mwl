                tag: "hook",
                name: "command:kill_unit",
                filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22x%22%3A%22%24this_item.x%22%2C%22y%22%3A%22%24this_item.y%22%2C%22fire_event%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
              {
                tag: "set_variable",
                name: "this_item.moves",
                value: 0,
              },
              {
                tag: "set_variable",
                name: "this_item.attacks_left",
                value: 0,
              },
            ],
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "transport",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "start_boarding_next_transport",
          },
        ],
      },
      {
        tag: "event",
        id: "if_17",
