          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%224%22%2C%22animate%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("The Great Horde at last! I was beginning to think they would never come."),
          },
          {
            tag: "message",
            speaker: "Gork",
            text: _("Your defense of Prestim was heroic, facing such opposition surely undermined the morale of the humans. Now they are retreating to their fortresses and will not venture out again anytime soon."),
          },
          {
            tag: "message",
            speaker: "Pirk",
            text: _("It is now time to show them who we are and to lead the Great Horde in pursuit. We will not rest until we destroy Earl Lanbec’h. Smite, stab, slay!"),
          },
          {
            tag: "win",
          },
        ],
