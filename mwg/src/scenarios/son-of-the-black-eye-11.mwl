        once: false,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 4,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
              },
            ],
          },
          {
            tag: "set_variable",
            name: "i",
            value: 0,
          },
          {
            tag: "while",
            test: "wml_condition_tree('tree=%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22possible_boarders.length%22%2C%22less_than%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22i%22%2C%22less_than%22%3A%226%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D')",
            children: [
              {
                tag: "hook",
                name: "command:store_unit",
                variable: "possible_boarders",
                kill: "no",
                side: 4,
                not_type: "Transport Galleon",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "i",
                value: 1,
                mode: "add",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_21",
          },
        ],
      },
      {
        tag: "event",
        id: "if_23",
        on: "branch_if_23",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "boarding_locs.length",
            less_than: 1,
          },
          {
            tag: "hook",
