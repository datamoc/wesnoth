          },
          {
            tag: "hook",
            name: "command:unit_overlay",
            id: "Darken Volk",
            image: "misc/book-icon.png",
            object_id: "book_icon",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
