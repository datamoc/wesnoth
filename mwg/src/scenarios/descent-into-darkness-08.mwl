            unit: "Darken Volk",
            x: 6,
            y: 13,
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Now give the book to me."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Darken Volk grabs the mysterious book from Malin’s hands and stalks away."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Darken Volk",
