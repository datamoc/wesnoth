                value: "ne",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 8,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 10,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("You can’t just leave me here!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Malin Keshar",
            x: 6,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Malin Keshar",
            x: 7,
            y: 13,
          },
          {
            tag: "message",
            speaker: "advisor",
            text: _("Master, do you not see? He has merely been using you to get that book!"),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("What do you mean?"),
          },
          {
            tag: "message",
            speaker: "advisor",
            text: _("He cares not about your noble quest to push back the orcs. He needed your help to fight the mages!"),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Wait!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 11,
            y: 14,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("You used me! You knew the people of Parthyn would cast me out — you knew I had nobody else to turn to! You knew I would do whatever you said..."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 12,
            y: 15,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("After all this time... I haven’t just been a pawn to you... have I?"),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Why don’t you say anything?! Don’t you care at all?!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 15,
            y: 16,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("... you can’t abandon me too, not the way they did... Father, Drogan, Dela..."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 16,
            y: 16,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 19,
            y: 17,
          },
          {
            tag: "message",
            speaker: "advisor",
            text: _("He will not help you, but perhaps the book might. You were the one who helped him retrieve it. It is rightfully yours!"),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Yes, I suppose that is right..."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Darken Volk! That book is as much mine as it is yours! Give it back, or I will take it by force!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Darken Volk",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("You are even more of a fool than I thought."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 28,
