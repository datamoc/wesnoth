      },
      {
        tag: "event",
        id: "ev_6",
        on: "turn_refresh",
        once: false,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 2,
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%7B%22applyTo%22%3A%22movement_costs%22%2C%22movementCosts%22%3A%7B%22flat%22%3A99%7D%2C%22replace%22%3Atrue%7D%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Darken Volk",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_attacker_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Darken Volk",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("You let me believe Parthyn would accept me back, so when they didn’t, I would be willing to attack my own countrymen!"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("What you let yourself believe is no fault of mine. I gave you more power than you could have possibly dreamed. Use it to fight the orcs that annoy you so, not me."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("You took my home away from me. You took Drogan away. You turned my sister against me! You have ruined my life!"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("The only thing I have done is given you the power to achieve your own goals. The rest, you have done yourself."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("That’s not true! You can’t abandon me like this!"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Fighting the orcs is your ambition, not mine. You cannot expect me to help you in an endeavor that does not concern me at all."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("The very same to you! I helped you retrieve that book! If you will not help me with my mission, I will at least keep the fruits of my labor."),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Hardly. I will crush you easily."),
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Perhaps, but I have nothing left to lose..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_attacker_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22id%22%3A%22Darken%20Volk%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Now you shall pay for what you have done to me."),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Done? I have done nothing but give you an opportunity. What you choose to do with your life is not my business. Leave me alone!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: 4,
            y: 17,
