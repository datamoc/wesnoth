        on: "branch_if_5",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "hasBook",
            not_equals: "Malin",
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("Now go your own way, and I will go mine."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_3",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Malin Keshar",
            x: 5,
            y: 13,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Darken Volk",
            x: 8,
            y: 14,
          },
          {
            tag: "message",
            speaker: "Malin Keshar",
            text: _("Well, we got your precious book and made it out of Tath in one piece. What do we do now?"),
          },
          {
            tag: "message",
            speaker: "Darken Volk",
            text: _("‘We’? <i>We</i> do nothing."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_4",
          },
          {
            tag: "hook",
            name: "command:fire_event",
