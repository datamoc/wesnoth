            event: "branch_if_12",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_13",
          },
          {
            tag: "message",
            text: _("Blast it, the orcs have discovered us."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("What is your purpose for trespassing on orcish territory?"),
          },
          {
            tag: "message",
            text: _("Fool, do you really think we are going to tell you?"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Men, capture one of these elves and interrogate him. I am sure that will get us some answers."),
          },
        ],
      },
