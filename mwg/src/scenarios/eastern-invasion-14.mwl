            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent%22%2C%22attributes%22%3A%7B%22side%22%3A%227%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
