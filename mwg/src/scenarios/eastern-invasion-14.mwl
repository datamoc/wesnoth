        on: "select",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("On a quest of searing vengeance? Owaec my friend, what you need is my elixir of ulfserker fury! One taste of this bitter red ambrosia and you’ll fight until you drop, with <b><i>unlimited melee attacks</i></b> and the <b><i>berserk</i></b> melee special!"),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Hahid al-Ali",
                text: _("This offer expires as soon as your anger does! <i>(elixirs only last for 1 scenario)</i>"),
              },
              {
                tag: "choice",
                text: _("Buy the elixir for Owaec (30 gold)."),
                event: "ev_102_6_opt0",
              },
              {
                tag: "choice",
                text: _("Leave the elixir."),
                event: "ev_102_6_opt1",
              },
            ],
          },
        ],
      },
