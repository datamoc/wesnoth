            tag: "set_variable",
            name: "REPEAT_i",
            value: 0,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "REPEAT_i",
                less_than: 4,
              },
              {
                tag: "set_variable",
                name: "search_radius",
                value: 0,
              },
              {
                tag: "while",
                test: "wml_condition_tree('tree=%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22found_unit.length%22%2C%22greater_than%22%3A%220%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22search_radius%22%2C%22less_than_equal_to%22%3A%224%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D')",
                children: [
                  {
                    tag: "hook",
                    name: "command:store_unit",
                    variable: "found_unit",
                    kill: "no",
                    side: 7,
                  },
                  {
                    tag: "hook",
                    name: "command:set_variable_dynamic",
                    variable: "search_radius",
                    value: 1,
                    mode: "add",
