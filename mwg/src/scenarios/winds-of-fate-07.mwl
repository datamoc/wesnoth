        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: _("story/swamp-02.jpg"),
            text: _("A deep green swamp offered adequate game. Yet the saurian Arinexis urged him on to the much fatter prize that lay just ahead..."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_33",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: _("story/grim-altar.jpg"),
            text: _("For in the cold Jungle of Wesmere dwelt a great herd of a new prey–kind. Arinexis spoke of these ‘elves’ as dull witted with a capricious heart, the consequences of remaining too long within their stale realm."),
          },
        ],
      },
