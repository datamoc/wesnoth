        id: "ev_12",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Watchmen, report. What’s going on?"),
          },
          {
            tag: "message",
            speaker: "Vugreddyr",
            text: _("Help! Run for your lives!"),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("See for yourself. Undead approach from the east."),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Soldiers, to arms!"),
          },
        ],
      },
      {
