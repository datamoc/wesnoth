          {
            tag: "spawn",
            id: "Ratheln",
            type: "Red Mage",
            side: 3,
            x: 5,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Ratheln",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Ratheln",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Ratheln",
            x: 12,
            y: 12,
          },
          {
            tag: "message",
            speaker: "Preceptor",
            text: _("Master Perrin! Ratheln returns from the High Pass, with a company of dwarves. They look well-armed, and march in battle array."),
          },
          {
            tag: "message",
            speaker: "Master Perrin",
            text: _("Help, if we are fortunate. Hail! You on the road! Who comes bearing arms into our valley?"),
          },
          {
            tag: "message",
            speaker: "Glashal",
            text: _("‘Our’ valley, says Master Perrin. The arrogance of these mages is intolerable."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("A delegation of the Northern Alliance, traveling east. I believe we’ve found a friend of yours in the High Pass."),
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("They can help us, Master Perrin."),
          },
          {
            tag: "message",
            speaker: "Master Perrin",
            text: _("Well met, then. My students and I journeyed here to study the nest of drakes in the cliffs near the valley’s end."),
          },
          {
            tag: "message",
            speaker: "Master Perrin",
            text: _("Unfortunately, they’ve proven uncooperative. The brutes attacked us several times, and show no sign of stopping. I fear that they mean to kill us all!"),
          },
          {
            tag: "message",
            speaker: "Glashal",
            text: _("No more shall I suffer your cuts and needles. Long have you Prey harried us. I call a Hunt upon your kind, men and dwarves alike. None will leave this valley alive."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Harrumph. I wonder who is truly at fault here."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("We must fight or we will all be slain. Axes up!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Ratheln%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Master%20Perrin%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Master Perrin",
            text: _("Aaarrgh! This expedition was a terrible idea..."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Glashal%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            id: "Glashal",
            hidden: "yes",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "cutscene_retreating_enemies",
            kill: "no",
            side: 2,
          },
          {
            tag: "foreach",
            variable: "cutscene_retreating_enemies",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:scenario_move",
                id: "$this_item.id",
                x: 45,
                y: "$($this_item.y)",
                raw: "yes",
              },
              {
                tag: "hook",
                name: "command:kill_unit",
                unit: "$this_item.id",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Master Perrin",
            text: _("We’re grateful for your assistance, dwarves. Although I am sorry things came to blows — there is little left for us to study. The drakes are dead, and their castle is even more decrepit than it was before."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Angarthing",
            x: 36,
            y: 19,
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Hmm. This stonework is of dwarvish make. But long-abandoned and fallen into disrepair... by the decay, since even before the drakes came. There are orc-arrows embedded in the walls..."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I’ve a grim feeling about this. Knalga once suffered greatly at the hands of orcs. Kal Kartha is smaller by half, and not nigh as war-like."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Master Perrin",
            text: _("You have helped us; it is our duty to help you. Ratheln, it was your quick-thinking that brought Aiglondur here. If the dwarves allow it, will you accompany them in their journey east?"),
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("I will."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Ratheln",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I am grateful."),
          },
          {
            tag: "message",
            speaker: "Master Perrin",
            text: _("Then go safely and return swiftly. The rest of us shall make our retreat back to Alduin."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Aiglondur%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I fall!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_21",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Angarthing%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Oh no! Without a loremaster we cannot complete our mission!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_22",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Ratheln%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
