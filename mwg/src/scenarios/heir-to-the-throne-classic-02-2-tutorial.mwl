                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%2C%22x%22%3A%2216%2C11%2C9%22%2C%22y%22%3A%229%2C8%2C12%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: "$x1",
            y: "$y1",
          },
          {
            tag: "message",
            speaker: "Galdrad",
            text: _("That unit has captured our village! You’d better get him out; it heals him each turn and provides good defense."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_48",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_attacker_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Elvish%20Shaman%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Using me to attack is risky! I can slow the opponent with my ranged attack, but I hope you have a plan if I miss!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_49",
        on: "attack_end",
        once: true,
        children: [
          {
            tag: "filter",
            unit: "Thrag",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "second_unit.hitpoints",
                less_than: 21,
