                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%2C%22race%22%3A%22elf%22%2C%22level%22%3A%222%2C3%2C4%22%7D%2C%22children%22%3A%5B%5D%7D",
