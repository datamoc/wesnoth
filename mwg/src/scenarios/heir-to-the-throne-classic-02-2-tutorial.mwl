              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%2C%22first_time_only%22%3A%22no%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_condition%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22turn_number%22%2C%22numerical_equals%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22if%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22have_unit%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%2C%22race%22%3A%22elf%22%2C%22count%22%3A%225%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22then%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22You%20forgot%20to%20recruit%20troops!%20You%20can%20press%20%3Cb%3Eu%3C%2Fb%3E%20to%20undo%20your%20last%20move.%22%2C%22size%22%3A%2218%22%2C%22duration%22%3A%22unlimited%22%2C%22color%22%3A%22255%2C255%2C255%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22allow_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22on_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22Recruit%20or%20recall%20your%20troops%22%2C%22size%22%3A%2218%22%2C%22duration%22%3A%22unlimited%22%2C%22color%22%3A%22255%2C255%2C255%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22You%20forgot%20to%20capture%20a%20village!%20You%20can%20press%20%3Cb%3Eu%3C%2Fb%3E%20to%20undo%20your%20last%20move.%22%2C%22size%22%3A%2218%22%2C%22duration%22%3A%22unlimited%22%2C%22color%22%3A%22255%2C255%2C255%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22allow_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22on_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22print%22%2C%22attributes%22%3A%7B%22text%22%3A%22Capture%20a%20village%22%2C%22size%22%3A%2218%22%2C%22duration%22%3A%22unlimited%22%2C%22color%22%3A%22255%2C255%2C255%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D",
              },
            ],
