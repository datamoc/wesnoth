      {
        tag: "event",
        id: "ev_7",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "loyals",
            kill: "no",
          },
          {
            tag: "foreach",
            variable: "loyals",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:recall_unit",
