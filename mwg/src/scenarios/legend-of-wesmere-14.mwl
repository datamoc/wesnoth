            x: 38,
            y: 33,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_5",
          },
          {
            tag: "spawn",
            id: "u_6",
            type: "Horseman",
            side: 2,
            x: 42,
            y: 36,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_6",
          },
          {
            tag: "spawn",
            id: "u_7",
            type: "Horseman",
            side: 2,
            x: 40,
            y: 36,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_7",
          },
          {
            tag: "spawn",
            id: "u_8",
            type: "Horseman",
            side: 2,
            x: 40,
            y: 38,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_8",
          },
          {
            tag: "message",
            text: _("I see foul orcs to be ridden down! Charge!"),
          },
          {
            tag: "message",
            text: _("More of the cursed horse-pokers!! Run, let’s get out of here!"),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "portraits/goblins/rouser-2.webp",
            text: _("The not-at-all-brazen cry of a war-horn is heard in the distance."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "victory",
        once: true,
        children: [
          {
            tag: "message",
            text: _("We have thwarted the orcs once again!"),
          },
          {
            tag: "message",
            text: _("And we revived the alliance with the humans, which is no small thing."),
          },
          {
            tag: "message",
            text: _("Indeed it is not. As always, Cleodil, you speak with the wisdom and care that befits a healer. That is a good reminder for those who must walk the path of steel and warfare, and touches my heart."),
          },
          {
            tag: "message",
            text: _("A good fight against foul enemies. These orcs make a dwarf’s hackles rise; I might even fight them for free, next time."),
          },
          {
            tag: "message",
            text: _("The King is here! Hail Haldric II, King of Wesnoth!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Aldun",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Aldar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Tath will fall! We have failed!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Grol%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("I die? Great Chief never said anything about fighting elves and dwarves!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kalenz%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("I am defeated. Now the orcs will destroy us!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Landar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Farewell, Kalenz!"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("Nooo! We cannot continue without Landar!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Cleodil%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("I’m sorry I failed you, Kalenz... my beloved..."),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("Nooo! Cleodil! Without you I cannot go on!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
