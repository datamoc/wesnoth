            time: 1000,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("<i>_...And from moment to moment he felt more and more anger from the tree folk, which waved its branches menacingly at the nearby Fire Wraith.</i>"),
          },
