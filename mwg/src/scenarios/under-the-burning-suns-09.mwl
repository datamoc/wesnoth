            recruit: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_46",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "45-53",
            y: "25-29",
          },
          {
            tag: "hook",
            name: "command:set_variables",
            payload: "%7B%22name%22%3A%22unit_type_table%22%2C%22mode%22%3A%22replace%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22split%22%2C%22attributes%22%3A%7B%22list%22%3A%22Crab%20Man%22%2C%22key%22%3A%22type%22%2C%22separator%22%3A%22%2C%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "set_variable",
            name: "unit_type_table_i",
            value: 0,
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "_mwg_random_locations_0",
            filter: "%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22x%22%3A%2250%22%2C%22y%22%3A%2228%22%2C%22radius%22%3A%223%22%2C%22include_borders%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "set_variable",
            name: "_mwg_random_remaining_2",
            value: 3,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "_mwg_random_remaining_2",
                greater_than: 0,
              },
              {
                tag: "hook",
                name: "command:random_location",
                source: "_mwg_random_locations_0",
                variable: "_mwg_random_pick_1",
              },
              {
                tag: "hook",
                name: "command:spawn_dynamic",
                type: "$unit_type_table[$unit_type_table_i].type",
                side: 7,
                x: "$random_placement_location.x",
                y: "$random_placement_location.y",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "unit_type_table_i",
                value: "$(($unit_type_table_i + 1) % $unit_type_table.length)",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "_mwg_random_remaining_2",
                value: -1,
                mode: "add",
              },
            ],
          },
          {
            tag: "message",
            text: _("Where did those things come from? They look dangerous."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_47",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "38-42",
            y: "20-25",
          },
          {
            tag: "hook",
            name: "command:set_variables",
            payload: "%7B%22name%22%3A%22unit_type_table%22%2C%22mode%22%3A%22replace%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22split%22%2C%22attributes%22%3A%7B%22list%22%3A%22Crab%20Man%22%2C%22key%22%3A%22type%22%2C%22separator%22%3A%22%2C%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "set_variable",
            name: "unit_type_table_i",
            value: 0,
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "_mwg_random_locations_3",
            filter: "%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22x%22%3A%2241%22%2C%22y%22%3A%2223%22%2C%22radius%22%3A%223%22%2C%22include_borders%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "set_variable",
            name: "_mwg_random_remaining_5",
            value: 3,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "_mwg_random_remaining_5",
                greater_than: 0,
              },
              {
                tag: "hook",
                name: "command:random_location",
                source: "_mwg_random_locations_3",
                variable: "_mwg_random_pick_4",
              },
              {
                tag: "hook",
                name: "command:spawn_dynamic",
                type: "$unit_type_table[$unit_type_table_i].type",
                side: 7,
                x: "$random_placement_location.x",
                y: "$random_placement_location.y",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "unit_type_table_i",
                value: "$(($unit_type_table_i + 1) % $unit_type_table.length)",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "_mwg_random_remaining_5",
                value: -1,
                mode: "add",
              },
            ],
          },
          {
            tag: "message",
            text: _("What are those things? They looked like ticked off giant crabs."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_48",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "50-54",
            y: "13-17",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Eloh",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("You think you can strike me down. This is just a small part of my true power."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Small part or no, if it is mortally possible to destroy you, I shall. Your hands are stained in our blood; you are not our god."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_49",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Eloh%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Eloh",
            text: _("Don’t worry Kaleh, we will see each other again... I promise."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Eloh",
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("She freaks me out, but at least it seems that she can be destroyed."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("That was just an apparition, but if we meet again I will make her pay for all that she has done."),
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Zhul",
          },
          {
            tag: "hook",
            name: "command:unpetrify",
            id: "Zhul",
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("I’m sorry, Kaleh. My faith clouded my reason. But I wanted so very much to believe."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("You do not need to apologize. What you did was very brave. I wish to... to whatever god still watches over us, that this bloodshed was not necessary. But I could not let half my people be co-opted by that thing. As horrible as it sounds, even death is a better fate."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("So when you had the strange encounter with that human Durstrag and his guards, just after we escaped the caves, you were talking to Eloh, or whatever she is?"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Yes, she appeared only to me and demanded that I surrender to the humans. When I refused she threatened me, saying she would kill me if I refused. That’s when I really started to get suspicious."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("It is clear that that thing was not our god. I do not know what it was, but I have to keep believing that Eloh is out there somewhere. Without our faith, what do we have left?"),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("We have each other."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("That’s not enough. Look, you’re a wonderful girl Nym, and Kaleh, you’ve shown yourself to be a great leader, but our actions have to mean something more than just our day-to-day survival. There has to be a higher purpose, Eloh must have some sort of plan for us. We have to keep believing."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Peace, Zhul, we can discuss theology later. We still have work to do."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "tanstafaal_and_eloh_gone",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_50",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent%22%2C%22attributes%22%3A%7B%22id%22%3A%22Tanstafaal%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Tanstafaal",
            text: _("You cannot defeat me, I am protected by the goddess now. Finally, Kaleh, I will show everyone who is stronger!"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Oh Tanstafaal, I pity you. This battle was never about you."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_51",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Tanstafaal%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("No, do not kill him. He may deserve it, but he will not die at my hands."),
          },
          {
            tag: "message",
            speaker: "Tanstafaal",
            text: _("Never Kaleh. I will not be your lackey again!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Tanstafaal",
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Why did he have to kill himself? Oh, poor misguided Tanstafaal. We have lost too many elves today."),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("Do not blame yourself too much, it is Eloh who persuaded him to rebel."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Yes, she too will pay for her part in all of this."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "tanstafaal_and_eloh_gone",
          },
        ],
      },
      {
        tag: "event",
        id: "if_53",
        on: "branch_if_53",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "stored_Alastra.length",
            equals: 1,
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_Alastra",
            x: 9,
            y: 14,
          },
        ],
      },
      {
        tag: "event",
        id: "if_54",
        on: "branch_if_54",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "stored_Zelgant.length",
            equals: 1,
          },
          {
            tag: "hook",
