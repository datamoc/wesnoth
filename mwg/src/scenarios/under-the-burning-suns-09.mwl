      {
        tag: "event",
        id: "ev_52",
        on: "tanstafaal_and_eloh_gone",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "have_unit",
                id: "Tanstafaal,Eloh",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("It is finished. See, my people, Tanstafaal has been killed by his own hand, and the thing pretending to be our god is gone."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("You who call yourself Eloh, I challenge you, if you are truly our god, then show yourself, and strike me down where I stand!"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Nothing. Eloh may still watch over us, but that thing was not her. And yet, I do not hold a grudge against all of you who rebelled. I too was deceived at first, and unlike the pretender, I am merciful. For there are too few of us left for us to slaughter each other over minor grievances. Let us declare a general amnesty and unite again, going forward hand in hand, for, god or no god, I will help us find a better land, or die trying."),
          },
          {
            tag: "message",
            text: _("I think I speak for all of us when I say that we accept your offer of amnesty and will follow you again. You have proved yourself capable as a leader and we too tire of this bloodshed. In hindsight perhaps we were wrong about Eloh and Tanstafaal; we shall have to think about this long and hard."),
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            side: 3,
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%223%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Thank you. And I have also not forgotten the pledge I made to our merfolk friends. If it is possible, I would like to meet with your leader. Your conduct is a testament to your people, and I, at least, trust you."),
          },
          {
            tag: "message",
            text: _("Thank you."),
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "7-9",
            ys: "7-9",
          },
          {
            tag: "spawn",
            id: "Hekuba",
            type: "Necromancer",
            side: 4,
            x: 8,
            y: 8,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Hekuba",
          },
          {
            tag: "spawn",
            id: "Zilchis",
            type: "Necromancer",
            side: 4,
            x: 9,
            y: 7,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Zilchis",
          },
          {
            tag: "spawn",
            id: "Sultaria",
            type: "Necromancer",
            side: 4,
            x: 7,
            y: 7,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Sultaria",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Sultaria",
          },
          {
            tag: "message",
            speaker: "Hekuba",
            text: _("And what about us, little elf, did you forget about us?"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("I could never forget what you did to those merfolk."),
          },
          {
            tag: "message",
            speaker: "Hekuba",
            text: _("Good, for that is just a taste. You are fools to interfere with our affairs, and the Iron Council does not tolerate fools. The Dark Lady shall swallow your souls and you shall writhe in eternal torment. Arise my brethren, by her power those who have died shall rise up and join us! The very rocks too shall rise up out of the water to aid our crossing. Like a plague we shall pour forth and drive the non-believers before us!"),
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Wwt",
            cells: "14,16",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Wwt",
            cells: "17,16;19,15;19,16;19,17;19,19;20,15;20,17;20,19;20,20",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Wwf",
            cells: "17,15;18,15;18,16;19,18;19,20;20,16;20,18;21,19",
          },
          {
            tag: "hook",
