          },
          {
            tag: "message",
            speaker: "Kaylan",
            text: _("Reinforcements have arrived! Forward, men! I expect each of you to bring me back the head of an orc!"),
          },
          {
            tag: "message",
            speaker: "Mokolo Qimur",
            text: _("So many foul humans riding on horses! There is no way we can defeat them. Quick, we must make our escape!"),
