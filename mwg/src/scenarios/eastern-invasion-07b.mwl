%2C%7B%22tag%22%3A%22filter_recall%22%2C%22attributes%22%3A%7B%22trait%22%3A%22undead%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22set_extra_recruit%22%2C%22attributes%22%3A%7B%22x%22%3A%2220%22%2C%22y%22%3A%2225%22%2C%22extra_recruit%22%3A%22Walking%20Corpse%2CSoulless%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22fire_event%22%2C%22attributes%22%3A%7B%22name%22%3A%22plague_staff_picked_up%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22allow_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22switch%22%2C%22attributes%22%3A%7B%22variable%22%3A%22unit.id%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22Owaec%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Owaec%22%2C%22message%22%3A%22Do%20not%20insult%20me!%20No%20clansman%20will%20ever%20stoop%20to%20such%20black%20magic.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22Gweddry%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Gweddry%22%2C%22message%22%3A%22I%20already%20have%20an%20army%20of%20human%20soldiers%20%E2%80%94%20living%20soldiers.%20Let%20someone%20else%20use%20this%20staff.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22Dacyn%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Dacyn%22%2C%22message%22%3A%22Tempting!%20Most%20tempting...%20but%20I%20fear%20it%20would%20be%20unwise%20for%20me%20to%20wield%20such%20a%20thing.%20That%20privilege%20passes%20onto%20another.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22Hahid%20al-Ali%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Hahid%20al-Ali%22%2C%22message%22%3A%22Ha!%20Good%20joke!%20I%E2%80%99m%20not%20about%20to%20mess%20around%20with%20any%20of%20your%20foul%20northerner%20magic%3B%20necromancy%20was%20the%20cause%20of%20all%20this%20trouble%20in%20the%20first%20place.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22Terraent%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Terraent%22%2C%22message%22%3A%22I%20serve%20the%20light%2C%20not%20this%20staff%20of%20foul%20darkness!%20We%20should%20cast%20away%20this%20thing%20and%20be%20done%20with%20it.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22Konrad%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Konrad%22%2C%22message%22%3A%22...what%20foul%20thing%20is%20this%3F%20Remove%20it%20from%20my%20presence%3B%20necromancy%20shall%20not%20take%20root%20in%20Wesnoth%2C%20not%20under%20my%20watch.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22switch%22%2C%22attributes%22%3A%7B%22variable%22%3A%22unit.type%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22White%20Mage%2CMage%20of%20Light%2CPaladin%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22No.%20I%20serve%20that%20which%20is%20good%20and%20light%2C%20and%20will%20not%20wield%20such%20a%20dark%20magical%20artifact.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22switch%22%2C%22attributes%22%3A%7B%22variable%22%3A%22unit.race%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22case%22%2C%22attributes%22%3A%7B%22value%22%3A%22dunefolk%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22Fighting%20your%20northerners%E2%80%99%20foul%20magic%20is%20bad%20enough.%20Don%E2%80%99t%20expect%20me%20to%20wield%20that%20%E2%80%94%20civilized%20cultures%20don%E2%80%99t%20mess%20around%20with%20magic.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22else%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22I%20will%20not%20wield%20such%20a%20dark%20magical%20artifact%2C%20though%20I%20shall%20not%20begrudge%20its%20use%20by%20my%20companions.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D",
