            x: 2,
            y: 32,
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Cea",
            cells: "2,32",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Ke",
            cells: "2,32",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Ce",
            cells: "1,32",
          },
          {
            tag: "message",
            speaker: "Glildur",
            text: _("Aha! I’ve been looking all over for you dwarves, but now I’ve found you! Prepare to die!"),
          },
          {
            tag: "message",
            speaker: "Glonoin",
            text: _("Who in the earth’s guts are you?"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("I thought we left the elves behind at the gates way back when... it seems we have two enemies now!"),
          },
          {
            tag: "message",
            speaker: "Glonoin",
            text: _("So, elves, are you against these dwarves too? They’re attacking my clan for absolutely no reason!"),
          },
          {
            tag: "message",
            speaker: "Glildur",
            text: _("No reason? So you don’t have the ruby?"),
          },
          {
            tag: "message",
            speaker: "Glonoin",
            text: _("What ruby? They wanted to rent my tools to cut something, probably your ruby, but they didn’t offer me nearly enough!"),
          },
          {
            tag: "message",
            speaker: "Glildur",
            text: _("How about this — we defeat these crazed cave-dwellers, then you keep the spoils and their territory, and we keep the ruby?"),
          },
          {
            tag: "message",
            speaker: "Glonoin",
            text: _("Deal! Not like this is the first time we’ve faced this sort of insanity. We have no idea what this ruby is, and don’t care!"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Ah, they don’t scare me! We can take both of them!"),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("Don’t be a fool! We can’t take the elves, and it was a mistake to attack these dwarves, but if we have to fight, we should retreat once we get what we came for, the tools!"),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "elves_come",
            value: "yes",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:show_objectives",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Glonoin%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Glonoin",
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Ha! Now we can easily take their tools back to our own caves."),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("And how do you plan on doing that? There are elves swarming these hills, trying to kill us."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("I’m aware! Close the gates and keep them out! It should be easy to come up with a plan to outwit them later. Meanwhile, since the Shorbear’s rune workshops are in here, you and your runecrafters might as well make the sceptre now."),
          },
        ],
      },
