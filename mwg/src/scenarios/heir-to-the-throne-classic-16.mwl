        children: [
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Where are we? Which way now? I am tired of this darkness!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mentoring.webp",
            text: _("I am not sure of the way. Let me think for a moment."),
