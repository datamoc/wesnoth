            unit: "u_2",
          },
          {
            tag: "message",
            speaker: "Li'sar",
            portrait: "portraits/lisar-mad.webp",
            text: _("En garde!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("What in the world are you doing here?"),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            portrait: "portraits/lisar-mad.webp",
            text: _("Tracking you down, of course! You have escaped me for the last time!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mad.webp",
            text: _("Foolish girl! We are in the deepest of caverns, probably surrounded by all manner of creatures, and you still want to fight us? You will bring us all to ruin!"),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            portrait: "portraits/lisar-mad.webp",
            text: _("Don’t try to trick me! I know why you have come here! But I will put an end to you and your treason here. Then I will get the Sceptre, and return to the daylight again!"),
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "the_dangerous_symphony.ogg",
            play_once: "yes",
