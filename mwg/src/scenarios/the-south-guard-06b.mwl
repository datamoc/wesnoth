      {
        tag: "event",
        id: "if_86",
        on: "branch_if_86",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "pebbles_defense_length",
            greater_than_or_equal_to: 23,
          },
          {
            tag: "message",
            speaker: "Minister Hylas",
            text: _("Another poor soul claimed by the spreading darkness. At least her sacrifice was not in vain: we’ve had sufficient time to gather, train, and equip most of the region’s farmers and woodsmen, as well as recall the squad of fencers manning Fort Tahn."),
          },
        ],
      },
