            ],
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("Hold fast, men of the South Guard! No matter how daunting the evil that opposes us, we must weather this darkness and defend our homes!"),
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("Fool boy, you overestimate the strength of these decrepit peasants that you call soldiers. The rivers will run red with your blood! The smoke and ashes from your ruined homes will blot out the sky, and from the swamps and the black earth, your bones will rise again to serve me!"),
          },
        ],
      },
