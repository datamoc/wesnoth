        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Mebrin%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_killer_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("Fools! Imbeciles! You humans are a worthless blight upon this wretched world! I must purge you all — I must take revenge on all your race... I must..."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("These worthless humans just bested you and your armies. Your time has come, once-wise sage of the elves."),
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("I curse you, Deoran of Wesnoth! I curse you... may you one day know the same pain that your kind have inflicted on me..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_137",
