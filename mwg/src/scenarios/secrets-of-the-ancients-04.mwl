          {
            tag: "message",
            speaker: "Rudic",
            text: _("You! Dark girl. Why are you not in your cabin?"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("What if I said something in defense of the stowaways?"),
          },
          {
            tag: "message",
            speaker: "Rudic",
            text: _("I would pitch you over the side with them. What do you know?"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("They are my companions, and the poor things are just terribly hungry. I’m sorry we didn’t pay the full amount, but maybe we can reach some arrangement."),
          },
          {
            tag: "message",
            speaker: "Rudic",
            text: _("They killed my crew member and played me for a fool! The only arrangement that suits me is the lot of you off my ship, preferably at the bottom of the sea."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Oh dear. We must do this again. Come to me my friends! If you are still hungry, feed on a passenger first."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Rudic%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Good riddance. But, with the captain dead, who will sail the ship and guide us into port now?"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Rise Captain, and please retain your memories."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "rudic_stored",
            kill: "yes",
            id: "Rudic",
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Can you still sail this ship?"),
          },
          {
            tag: "message",
            speaker: "Bone Captain",
            portrait: "portraits/bone-captain1.webp",
            text: _("Sail. Yes. Need wind."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Oh! It worked! Take us to port, Captain, as soon as you do have the wind."),
          },
        ],
      },
