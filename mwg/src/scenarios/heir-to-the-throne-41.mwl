            id: "Mirya",
            primary_attack_range: "melee",
          },
          {
            tag: "message",
            speaker: "leader2",
            text: _("There, she’s dead. Better I lose a ransom than my life."),
          },
          {
            tag: "message",
            speaker: "leader2",
            text: _("Now get out of here. You pinkskins and your politics have caused me enough trouble already..."),
          },
          {
            tag: "win",
          },
        ],
      },
