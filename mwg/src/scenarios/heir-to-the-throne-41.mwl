          },
          {
            tag: "message",
            speaker: "leader2",
            text: _("Hands off!! Not another swing at me, or the mage gets it!"),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("..."),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("Okay, go ahead. We’re fighting to stop Mirya from returning to my mother, not to rescue her or to keep her as prisoner."),
