          {
            tag: "message",
            speaker: "Lionel",
            text: _("I am Lionel. I am the Lost General. I will avenge myself upon you all!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Avenge? What have we done to you that you must avenge?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Lionel? A General? I remember that name..."),
          },
          {
            tag: "message",
            speaker: "Lionel",
            text: _("Remember me, do you? Aye. I was the king’s finest general, sent down to these pits to retrieve the Sceptre. But the orcs trapped me and my men in this cavern, to starve to death. The dwarves were no help, leaving me to die. Now I will get revenge on you all!"),
          },
