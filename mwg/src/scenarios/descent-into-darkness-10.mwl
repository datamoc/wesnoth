      {
        tag: "event",
        id: "if_11",
        on: "branch_if_11",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "squidVille",
            equals: 1,
          },
          {
            tag: "message",
            speaker: "Mal Keshar",
            text: _("That was quite the nightmare..."),
          },
          {
            tag: "message",
            speaker: "Mal Keshar",
            text: _("...unless it was not one? No. No no no. I don’t even want to think about that."),
          },
          {
            tag: "message",
            speaker: "Mal Keshar",
            text: _("I need to go slaughter some foolish heroes to purge that from my mind."),
          },
          {
            tag: "set_variable",
            name: "squidVille",
            value: 2,
          },
        ],
      },
      {
        tag: "event",
        id: "if_12",
        on: "branch_if_12",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "squidVille",
            not_equals: 1,
          },
          {
            tag: "switch",
            variable: "timesForever",
            children: [
              {
                tag: "case",
                equals: 1,
              },
              {
                tag: "case",
                equals: 2,
                children: [
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("I will destroy you like the last foolish hero who challenged me."),
                  },
                ],
              },
              {
                tag: "case",
                equals: 3,
                children: [
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("Another foolish hero? Seriously?"),
                  },
                ],
              },
              {
                tag: "case",
                equals: 4,
                children: [
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("Is there an endless supply of foolish heroes with death wishes? Honestly, where do you all come from?"),
                  },
                ],
              },
            ],
          },
          {
            tag: "switch",
            variable: "randomHero",
            children: [
              {
                tag: "case",
                equals: "human",
                children: [
                  {
                    tag: "message",
                    speaker: "Foolish Hero",
                    text: _("Your doom is at hand, lich! It is nigh time you answered for your crimes against humanity!"),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("Narrow-minded and obtuse, as one would expect of cityfolk. Go back to your manors and taverns before I decide to kill you."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "bandit",
                children: [
                  {
                    tag: "message",
                    speaker: "Foolish Hero",
                    text: _("You have preyed on too many of my men. Our territory will be much more secure without your undead pestering us."),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("Not even real soldiers. How meaningless."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "elf",
                children: [
                  {
                    tag: "message",
                    speaker: "Foolish Hero",
                    text: _("We have finally found you, lich! Long have we heard of your abominable deeds, ensnaring the living with your dark sorceries and molding them into your slaves. Your wretched unlife ends here!"),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("Life or death, it is all the same. There are always those who try to kill me. Ever do they fail."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "dwarf",
                children: [
                  {
                    tag: "message",
                    speaker: "Foolish Hero",
                    text: _("Been a long time since I’ve smashed me some undead. Ye gots ye plenty o’ bones for me hammer ta break."),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("And it has been some time since I’ve had a supply of dwarven corpses to work with. I suppose I can put your hammers to good use in the mines."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "orc",
                children: [
                  {
                    tag: "hook",
                    name: "command:add_item",
                    x: 20,
                    y: 4,
                    item_name: "",
                    image: "scenery%2Fwhitefang-flag.png",
                  },
                  {
                    tag: "message",
                    speaker: "Foolish Hero",
                    text: _("I’ve finally found your lair, lich! You have attacked my tribe and wreaked havoc on our homes for many years. You slew my father and turned his body into one of your nasty creations. With your death, your annoying minions will pester us no longer!"),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("The Whitefang Orcs! It is you who despoiled my motherland and razed my home. It is you who forced me to resort to necromancy to protect myself. It is you who ended my mortal life and forced me to become a lich. And you desire vengeance? Hah! The irony of this would be hysterical if I could still feel such an emotion."),
                  },
                ],
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: "2,3",
            x: 16,
            y: 26,
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: "$x1",
            y: "$y1",
            item_name: "",
            image: "items%2Fbook5.png",
          },
          {
            tag: "switch",
            variable: "hero_type",
            children: [
              {
                tag: "case",
                equals: "human",
                children: [
                  {
                    tag: "message",
                    text: _("That’s an evil grimoire!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("It might be linked to the lich’s power! Try burning it."),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("<small>(faking pain)</small> Aaargh!"),
                  },
                  {
                    tag: "message",
                    text: _("It’s not catching fire!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("Still, it seems to be hurting the lich. Let us retreat and bring it with us. The mages may be able to destroy this and put an end to this lich."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "bandit",
                children: [
                  {
                    tag: "message",
                    text: _("That’s an evil grimoire!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("It might be linked to the lich’s power! Try burning it."),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("<small>(faking pain)</small> Aaargh!"),
                  },
                  {
                    tag: "message",
                    text: _("It’s not catching fire!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("Still, it seems to be hurting the lich. Let us retreat and bring it with us. We may yet find another way to destroy it and put an end to this lich."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "elf",
                children: [
                  {
                    tag: "message",
                    text: _("That’s an evil grimoire!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("It must be connected to the lich’s power. Perhaps if we burn it with faerie fire, the lich will be destroyed. Let us take it and retreat."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "dwarf",
                children: [
                  {
                    tag: "message",
                    text: _("That be an evil grimoire!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("Try destroyin’ the blasted thing."),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("<small>(faking pain)</small> Aaargh!"),
                  },
                  {
                    tag: "message",
                    text: _("Me axe kinna cut tha paper. It be protected by magic!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("Aye, but the lich still seems ta be hurtin’. Let’s take it ’n retreat. Maybe tha forge can destroy it."),
                  },
                ],
              },
              {
                tag: "case",
                equals: "orc",
                children: [
                  {
                    tag: "message",
                    text: _("Me like skull on book. It look good."),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("Idiot."),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("<small>(faking pain)</small> Aaargh!"),
                  },
                  {
                    tag: "message",
                    text: _("Uuuuuh, I can’t pull skull off book, but lich scream."),
                  },
                  {
                    tag: "message",
                    speaker: "Mal Keshar",
                    text: _("Defend the book, my minions! Aaargh!"),
                  },
                  {
                    tag: "message",
                    speaker: "speakinghero",
                    text: _("The book must be connected to the lich’s power! Take it and retreat. Once we smash that book, the lich should be destroyed."),
                  },
                ],
              },
            ],
          },
          {
            tag: "win",
          },
        ],
      },
