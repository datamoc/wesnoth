          {
            tag: "message",
            speaker: "Thursagan",
            text: _("Well, Theganli, what do you think of this ruby?"),
          },
          {
            tag: "message",
            speaker: "Theganli",
            text: _("Uh, um, yes, yes, very impressive ruby... even in this raw form, it has an odd brilliance!"),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("Do you think you could cut it in the manner my plans specify?"),
          },
          {
            tag: "message",
            speaker: "Theganli",
            text: _("Maybe... maybe... it will be hard, let me see..."),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("Very well. See what you can do."),
          },
