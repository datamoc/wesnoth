          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Theganli",
          },
          {
            tag: "message",
            speaker: "Theganli",
            text: _("Coming... coming... stop pounding on the door!"),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("He doesn’t need to come here, I’ll take the jewel to his shop. He’ll need his tools anyway."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Thursagan",
            x: 10,
            y: 3,
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: 11,
            y: 4,
            item_name: "",
            image: "items%2Fruby.png",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Thursagan",
            x: 11,
            y: 19,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Thursagan",
          },
          {
            tag: "foreach",
