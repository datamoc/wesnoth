            unit: "Thursagan",
            x: 13,
            y: 13,
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("So, you have returned. I assume you have obtained the required materials? My jeweler Theganli has spent great time and expense buying jewels from some of the northern clans. Now go to the forge and make your sceptre. What do you need to annoy me for?"),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("We don’t need you, we need the ruby. I’ll take it to Theganli and we’ll review the cuts we plan to make."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Durstorn",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "se",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Durstorn",
            portrait: "portraits/durstorn-insane.webp",
            text: _("You’re going to cut the jewel?! Are you insane?"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("What do you mean, sir? You knew all along the jewel would have to be cut to make the sceptre."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Oh... right, right. Fine!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Durstorn",
            x: 10,
            y: 10,
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Theganli?"),
          },
          {
            tag: "message",
            speaker: "Kuhnar",
            text: _("He’s in his shop, in the southern tunnel."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("<i>Harrumph!</i> Kuhnar, go summon him!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Kuhnar",
            x: 11,
            y: 18,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
