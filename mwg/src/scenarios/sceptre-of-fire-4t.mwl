          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Theganli",
            x: 10,
            y: 19,
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Well, do you have anything yet?!"),
          },
          {
            tag: "message",
            speaker: "Theganli",
            text: _("Ah, well, uh, no... no... unfortunately... it seems it can’t be cut, or scratched, or damaged at all! At least not by my tools..."),
          },
          {
            tag: "message",
            speaker: "Thursagan",
            text: _("So what do you propose we do? This ruby needs to be cut, and cut in a specific way."),
          },
          {
            tag: "message",
            speaker: "Theganli",
            text: _("Well... maybe you can ask the Shorbear clan? They have good tools... chisels made of a metal that could only be worked in the heat of a volcanic forge. I don’t know how true that legend is, but their work is well known among us gem crafters."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Shorbear? Who are they?"),
          },
          {
            tag: "message",
            speaker: "Theganli",
            text: _("Another group of dwarves that live south of here... above ground, if you can believe it! Yes, they’re the best jewelers..."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Well, Rugnur, what are you waiting for? Go down and get these tools from them, and carve the jewel!"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Fine! Go rent it from them."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Very well, sir. We’ll go south now."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Wait! Last time you made a bargain by yourself you lost us five thousand pieces of silver. I’m going with you this time!"),
          },
          {
            tag: "message",
            speaker: "Kuhnar",
            text: _("Are you sure that is wise, lord?"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Of course it is! You and Noiraran are going to come with us!"),
          },
          {
            tag: "message",
            speaker: "Kuhnar",
            text: _("Yes sir..."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%2C%22type%22%3A%22Dwarvish%20Miner%22%7D%2C%22children%22%3A%5B%5D%7D",
