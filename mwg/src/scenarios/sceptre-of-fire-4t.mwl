            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Kuhnar",
            text: _("Theganli! Come out of there, Durstorn orders you to come to the citadel."),
          },
          {
            tag: "spawn",
            id: "Theganli",
            type: "Dwarvish Runesmith",
            side: 2,
            x: 10,
            y: 19,
