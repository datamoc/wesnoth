        children: [
          {
            tag: "message",
            speaker: "Pirk",
            text: _("At last! The siege has been broken."),
          },
          {
            tag: "message",
            speaker: "Gork",
            text: _("Thank you, Son of the Black-Eye. If you hadn’t arrived when you did, I don’t know what would have happened to us."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("No problem! It was fun, wasn’t it, Grüü?"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Hahaha! Yeah!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("But, actually, we have come all the way from our lands to get your help."),
          },
          {
            tag: "message",
            speaker: "Vraurk",
            text: _("Why? What’s wrong?"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Those insolent humans have massed a huge army and attacked us. We defeated their vanguard but in the end we were forced to retreat."),
          },
          {
            tag: "message",
            speaker: "Pirk",
            text: _("Hmmmm, this situation is very serious. As you know by now, they have also hired these elves to attack us here."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Yes. It seems to me that the humans are declaring all-out war on us."),
          },
          {
            tag: "message",
            speaker: "Gork",
            text: _("We must give this matter careful consideration. Come inside the city, and we’ll discuss it."),
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            side: 1,
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Pirk%2CGork%2CVraurk%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Pirk,Gork,Vraurk",
          },
          {
