        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            text: _("So this is the Bay of Pearls. It looks like they have those merfolk working hard!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Indeed it does. It also looks like they have many, many troops. I should go around the bay and distract some of them. You and the rest rescue the merfolk!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Very well. Be careful!"),
          },
        ],
