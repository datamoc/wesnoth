      {
        tag: "event",
        id: "if_24",
        on: "branch_if_24",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "delfador_store.id",
            equals: "Delfador",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
