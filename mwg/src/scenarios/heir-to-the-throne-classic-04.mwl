            x: "recall",
            y: "recall",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23_opt0",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Safe journey to you, Konrad. Until we meet again!"),
          },
          {
            tag: "set_variable",
            name: "__next_scenario",
            value: "heir-to-the-throne-classic-05a",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23_opt1",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Safe voyage to you then, Konrad. May the weather be fair."),
          },
          {
            tag: "set_variable",
            name: "__next_scenario",
            value: "heir-to-the-throne-classic-05b",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-glad.webp",
            text: _("At last, we have freed the merfolk. Go back to the ocean and live in peace."),
          },
          {
            tag: "message",
            text: _("My lord! You may need the help of some of us who have skill in the sea in future. We would like to come with you and offer you help."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You may now recruit the noble merfolk!"),
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: 1,
            mode: "allow",
            types: "Merman Fighter,Merman Hunter,Mermaid Initiate",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Now where is Delfador? I hope he’s safe!"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_24",
          },
          {
            tag: "spawn",
            id: "Delfador",
            type: "Elder Mage",
            side: 1,
            x: 30,
            y: 10,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Delfador",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Delfador",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I am perfectly safe, friend!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-glad.webp",
            text: _("There you are! I am so glad you are all right! Now we may have a little rest."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I am afraid there is no time for rest, Konrad. Asheviere has laid siege to Elensefar, breaking the century-old treaty between Wesnoth and the Elense city-state. If the city falls, there is no telling how many other lands she may swallow up!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-concerned.webp",
            text: _("Oh no! What shall we do?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("You must lead your men to the city. Help defend it, or recapture it if it falls before you arrive!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("I must do that? But what about you, Delfador? You’re coming with me, right?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I am afraid not, Konrad. I have come across some important documents, and must make haste with them to the Elven Council. It seems that the time to stop Asheviere is shorter than I had thought."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-concerned.webp",
            text: _("But Delfador! I can’t do it on my own!"),
          },
          {
            tag: "message",
            text: _("On your own? My lord! We, your loyal soldiers, will support you!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("You will prevail. I have faith in you. Head north. Elensefar is but three days’ travel if you make haste."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Very well. But how do I get there?"),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Delfador",
                text: _("There are two ways to go, by ship or on foot. Each has its own dangers. You must choose between them."),
              },
              {
                tag: "choice",
                text: _("Ships? Ugh! I have been seasick for the last time. We shall walk!"),
                event: "ev_23_opt0",
              },
              {
                tag: "choice",
                text: _("Going by ship we may at least get a little rest for ourselves. By sea it is!"),
                event: "ev_23_opt1",
              },
            ],
          },
        ],
      },
