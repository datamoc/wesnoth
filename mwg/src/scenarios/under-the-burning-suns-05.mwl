            mode: "round",
          },
          {
            tag: "set_variable",
            name: "i",
            value: 1,
          },
          {
            tag: "set_variable",
            name: "REPEAT_i",
            value: 0,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "REPEAT_i",
                less_than: "$deaths",
              },
              {
                tag: "hook",
