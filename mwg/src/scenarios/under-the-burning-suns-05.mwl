            text: _("Those new troll shamans are decimating the dwarves with blasts of fire! This doesn’t look good."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "victims",
            kill: "no",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "deaths",
            value: "$victims.length",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "deaths",
