          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_41",
          },
          {
            tag: "message",
            text: _("HAHAHA! GOT YOU, SUCKERS!"),
          },
          {
            tag: "message",
            text: _("CHARGE!!"),
          },
          {
            tag: "message",
            text: _("Oh, hell! Form up, men, back to back! Don’t let them penetrate our ranks!"),
          },
          {
            tag: "message",
            text: _("That’s not all, my friends. GENERALS, CALL THE RESERVES!"),
          },
          {
            tag: "message",
            text: _("Oh yeah!"),
          },
          {
            tag: "message",
            text: _("HAHAHA!"),
          },
          {
            tag: "message",
            text: _("You are so dead, you human vermin!"),
          },
          {
            tag: "message",
            text: _("Oooooooh! Time to start the fun!"),
          },
          {
            tag: "gold",
            side: "2,3,4",
            amount: 1500,
          },
          {
            tag: "message",
            speaker: "Supporter",
            text: _("This doesn’t look good..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
