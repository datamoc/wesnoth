              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I have been slain!"),
          },
          {
            tag: "message",
            text: _("Killed him! Got his gold too. Let’s see, hmmm, about five-hundred gold pieces. Not bad."),
          },
          {
            tag: "gold",
            side: 1,
            amount: 512,
