          },
          {
            tag: "set_variable",
            name: "ai_caution",
            value: -1.0,
          },
        ],
      },
      {
        tag: "event",
        id: "story_20",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:play_music",
            file: "loyalists.ogg",
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("The humans rested for many days while they were equipped with new arms and armor and trained by the dwarves."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_21",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("But the peace was not to last. Early one morning Tallin, sore from head to foot from his training, was startled awake by the blare of trumpets, the pounding of drums and the rattle of steel as the humans and dwarves hurried to arm themselves."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_22",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("He sought out Hamel, who informed him that a massive host of orcs had arrived at the gates of the new Knalga."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_23",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("It was decided that Tallin’s men should sally forth to meet the orcs, while Hamel’s held open their retreat into the caves."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_24",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Tallin,Rakshas,Drung,Poul",
          },
        ],
      },
      {
        tag: "event",
        id: "clock_25",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "turn_limit",
            value: 18,
          },
        ],
      },
      {
        tag: "objectives",
        side: 1,
        victory: _("Resist until the end of turns Defeat Rakshas, if you can...<span foreground='white'><small> _(early finish bonus)</small></span>"),
        defeat: _("Death of Tallin"),
      },
      {
