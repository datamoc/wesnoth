              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-mad.webp",
            text: _("You are beaten, villain! With your defeat, we have severed the right hand of Asheviere!"),
          },
          {
            tag: "message",
            speaker: "Lisar",
            portrait: "portraits/lisar-defeat.webp",
            text: _("I can’t believe it. Bested so far from home, and during my own ambush. Embarrassing... Make it quick, then."),
          },
          {
            tag: "hook",
            name: "command:transform_unit",
            id: "Lisar",
            transform_to: "Bound Princess",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("No. You are to be my prisoner, and we shall ransom you to your mother in exchange for her abdication; a better and more merciful use of your head than petty vengeance. Delfador, do you have the Sceptre yet?"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "delfador_digs_for_sceptre",
