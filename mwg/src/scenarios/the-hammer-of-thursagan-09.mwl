          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("<small>(_ Psst, Angarthing... Karrag and those dwarves on the dais, they’re all <i>masked</i>.)</small>"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("<small>(_ I see it. There is something very wrong here.)</small>"),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("We are from Knalga; your clans are kin to ours of old. We but did our duty to kin."),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("We did not come to smite anyone, but to re-open contact and trade."),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("It is remembered in Knalga that Kal Kartha holds the Hammer."),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("On one condition. You must take off that mask and show your true face. I am a witness."),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("But the Law must see. A dwarf must put his name and his face behind his deeds. I am a witness."),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("The Law speaks. Against him with the eyes to see, no deception can hold. I AM A WITNESS!"),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
          {
            tag: "message",
            speaker: "Karrag",
            text: _("<span color='#87cefa'>"),
          },
