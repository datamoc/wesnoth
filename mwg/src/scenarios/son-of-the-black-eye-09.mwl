      },
      {
        tag: "unit",
        id: "Shan_Taum",
        type: "Orcish Warlord",
        side: 2,
        x: 35,
        y: 16,
        name: _("Shan Taum"),
      },
      {
        tag: "event",
        id: "carryover_14",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "carryover_percentage",
            value: 40,
          },
          {
            tag: "set_variable",
            name: "ai_aggression",
            value: 1.0,
          },
        ],
      },
      {
        tag: "event",
        id: "story_15",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("After clearing out the elves from the Silent Forest, Kapou’e and his party set out on the last leg of their journey. Within a few days they finally reached the city of Lmarig in the Mourned Hills, which was then ruled by Shan Taum the Smug."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_16",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Kapou_e,Shan_Taum,Fabstep,Klebar,Echarp",
          },
        ],
      },
      {
        tag: "event",
        id: "clock_17",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "turn_limit",
            value: 20,
          },
        ],
      },
      {
        tag: "objectives",
        side: 1,
        victory: _("Survive the Shan Taum menace for 20 turns Defeat Shan Taum<span foreground='white'><small> _(early finish bonus)</small></span>"),
        defeat: _("Death of Kapou’e Death of Grüü Death of a Shaman"),
      },
      {
        tag: "event",
        id: "ev_1",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:play_music",
            file: "the_city_falls.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "battle.ogg",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_2",
        on: "prestart",
        once: true,
      },
      {
        tag: "event",
        id: "ev_3",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
            side: 1,
            cells: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_4",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
            side: 2,
            cells: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Grüü",
            unit: "Grüü",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Jetto",
            unit: "Jetto",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Pirk",
            unit: "Pirk",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Gork",
            unit: "Gork",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Vraurk",
            unit: "Vraurk",
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("At last, here are the Mourned Hills! We can only hope for the best."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            portrait: "portraits/gruu.webp~FL()~RIGHT()",
            text: _("Why?"),
          },
          {
            tag: "message",
            speaker: "Gork",
            portrait: "portraits/old_orcish_shaman.webp~FL()~RIGHT()",
            text: _("You are a troll, so you don’t know. These lands are ruled by Shan Taum the Smug, who was a rival of Black-Eye Karun."),
          },
          {
            tag: "message",
            speaker: "Pirk",
            portrait: "portraits/orcish_shaman.webp~FL()~RIGHT()",
            text: _("I doubt he would welcome the son of the Black-Eye."),
          },
          {
            tag: "message",
            speaker: "Shan Taum",
            text: _("Who is that? Kapou’e! What are you doing in my lands, you weakling runt?"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue.webp~FL()~RIGHT()",
            text: _("Hold on, Shan Taum. We seek the Great Council, not a quarrel with you."),
          },
          {
            tag: "message",
            speaker: "Shan Taum",
            text: _("Bwahaha! You are nothing! Where is your land? You became a beggar. You are as pathetic as your father!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            portrait: "portraits/kapoue-angry.webp~FL()~RIGHT()",
            text: _("How can you talk that way about my father, you miserable coward?! I’ll make a mug from your skull!"),
          },
          {
            tag: "message",
            speaker: "Shan Taum",
            text: _("Really? What would you drink with it? Mint cordial?"),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Exasperated, Kapou’e launched an attack on his fellow orc Shan Taum the Smug."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "victory_cutscene",
        once: true,
        children: [
          {
            tag: "spawn",
            id: "Fabstep",
            type: "Orcish Shaman",
            side: 1,
            x: 31,
            y: 29,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Fabstep",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Fabstep",
          },
          {
            tag: "spawn",
            id: "Klebar",
            type: "Orcish Shaman",
            side: 1,
            x: 31,
            y: 29,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Klebar",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Klebar",
          },
          {
            tag: "spawn",
            id: "Echarp",
            type: "Orcish Shaman",
            side: 1,
            x: 31,
            y: 29,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Echarp",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Echarp",
          },
          {
            tag: "message",
            speaker: "Echarp",
            text: _("What is this? Are you mad?! Humans are to besiege our fortress at Prestim and you are fighting each other?!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Well, ermmm..."),
          },
          {
            tag: "message",
            speaker: "Echarp",
            text: _("Kapou’e, rumors tell of you making a long trip to seek assistance from us, and escorting Pirk, Gork and Vraurk. The Council is grateful for that."),
          },
          {
            tag: "message",
            speaker: "Fabstep",
            text: _("I know what you want from us but I’m afraid we can’t help you."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("But my people..."),
          },
          {
            tag: "message",
            speaker: "Echarp",
            text: _("You don’t understand. Orcs have been divided for ages. The only one who gave us some unity was your father, Black-Eye Karun. When we heard rumors of your exploits, we understood that you are a worthy son of your father."),
          },
          {
            tag: "message",
            speaker: "Vraurk",
            text: _("This is true. Now we are pressed from all sides by humans and elves; we need a leader that can unite all banners. This one is <i>you</i>!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Thank you."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Did you hear? There is a battle waiting for us at Prestim!"),
          },
          {
            tag: "message",
            speaker: "Echarp",
            text: _("Kapou’e, if Prestim falls, humans will have a strong bridgehead on this side of the river and your people won’t be safe. You are the only one that can help us defend Prestim!"),
          },
          {
            tag: "message",
            speaker: "Pirk",
            text: _("Go defend Prestim, Kapou’e. In the meantime, now that the Council is complete again, we will decide. We may have to form the Great Horde again and make you its leader."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Pirk",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Gork",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Vraurk",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Fabstep",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Klebar",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Echarp",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "time_over",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "victory_cutscene",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Shan%20Taum%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Shan Taum",
            text: _("Nooo! Don’t kill me, I surrender to you, little earthworm."),
          },
          {
            tag: "set_variable",
            name: "unit.hitpoints",
            value: 1,
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "unit",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "victory_cutscene",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kapou'e%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I’m done. My people are doomed!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Orcish%20Shaman%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Ouch! This hurts!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("The Council will never be complete again. This is hopeless."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gr%C3%BC%C3%BC%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Oh no, I am defeated."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "if_13",
        on: "branch_if_13",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "inarix_abandoned",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Inarix",
            text: _("Ahhh!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Blast it, without Inarix to lead her saurians, we can no longer count on their help."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "got_saurians",
            value: "no",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: 1,
            mode: "disallow",
            types: "Saurian Skirmisher, Saurian Augur",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Inarix%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_13",
          },
        ],
      },
    ],
