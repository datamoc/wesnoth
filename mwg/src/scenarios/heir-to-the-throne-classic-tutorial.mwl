      {
        tag: "event",
        id: "if_6",
        on: "branch_if_6",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "curr_distance.movement_cost",
            less_than_or_equal_to: "$moves_left",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "within_reach",
            value: "yes",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "if_5",
        on: "branch_if_5",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "enable_undo_messages",
            equals: "yes",
          },
          {
            tag: "foreach",
            variable: "student_team",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "moves_left",
                value: "$this_item.moves",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "student_team_member",
                value: "$this_item.id",
                mode: "value",
              },
              {
                tag: "foreach",
                variable: "all_targets",
                item: "this_item",
                children: [
                  {
                    tag: "hook",
                    name: "command:fire_event",
                    event: "branch_if_6",
                  },
                ],
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "if_7",
        on: "branch_if_7",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "within_reach",
            equals: "no",
          },
          {
            tag: "condition",
            variable: "enable_undo_messages",
            equals: "yes",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "undo_displayed",
            value: "yes",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "if_9",
        on: "branch_if_9",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "undo_displayed",
            equals: "yes",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "undo_displayed",
            value: "no",
            mode: "value",
          },
        ],
      },
      {
        tag: "event",
        id: "on_undo_8",
        on: "on_undo",
        once: false,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_9",
          },
        ],
      },
      {
        tag: "event",
        id: "check_undo",
        on: "moveto",
        once: false,
        children: [
          {
            tag: "filter",
            side: 1,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "student_team",
            kill: "no",
            side: 1,
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "within_reach",
            value: "no",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "target_enemies",
            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22radius%22%3A%221%22%2C%22variable%22%3A%22target_enemies%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_5",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_7",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "remove_check_undo",
        once: true,
      },
      {
        tag: "event",
        id: "ev_11",
        on: "select",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
          },
          {
            tag: "hook",
            name: "command:store_unit",
