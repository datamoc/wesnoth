        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent%22%2C%22attributes%22%3A%7B%22id%22%3A%22Delfador%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "student",
            text: _("Good morning, Delfador! Is it time to attack things?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Um, well..."),
          },
          {
            tag: "message",
            speaker: "student",
            text: _("Have you found an orc for me to fight, huh? A troll?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Quiet! I will summon an enemy for you..."),
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Delfador",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "lightning.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 25,
          },
          {
            tag: "spawn",
            id: "Quintain",
            type: "Quintain",
            side: 2,
            x: 12,
            y: 4,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Quintain",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 75,
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("... this quintain!"),
          },
          {
            tag: "message",
            speaker: "student",
            text: _("A quintain? You want me to fight a dummy?"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "attack_end",
        once: true,
        children: [
          {
            tag: "filter",
            unit: "student",
          },
          {
            tag: "message",
            speaker: "student",
            text: _("Hey! This quintain fights back!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Hmm, perhaps we should have started with a doll."),
          },
          {
            tag: "message",
            speaker: "student",
            text: _("Should I retreat?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Good idea!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Delfador",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "nw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Unfortunately, you’ve used up your turn attacking the quintain. The quintain now gets to attack."),
          },
          {
            tag: "message",
            speaker: "student",
            text: _("The <i>dummy</i> gets a turn?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Yes. It’s a magical quintain! If it hits you, it does 3 damage, and has 5 chances. If it hits every time, you’ll drop from $student_hp to $($student_hp-15) hitpoints. Brace yourself!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "turn_refresh",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 2,
          },
          {
            tag: "condition",
            variable: "turn_number",
            equals: 1,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Quintain",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.moves",
                value: 0,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "prevent_deadlock",
        on: "attack_end",
        once: true,
        children: [
          {
            tag: "filter",
            unit: "student",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "turn_end",
        once: true,
      },
      {
        tag: "event",
        id: "ev_17",
        on: "capture",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_capturer_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "student",
            text: _("Ouch! I need to heal! Only $student_hp hitpoints left!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("There are two villages within your reach. Visiting villages is a good idea, and ending your turn on one will heal you. To a village!"),
          },
          {
            tag: "hook",
            name: "command:store_villages",
            variable: "target_loc",
          },
        ],
      },
      {
        tag: "event",
        id: "prevent_deadlock",
        on: "attack_end",
        once: true,
        children: [
          {
            tag: "filter",
            unit: "student",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "turn_end",
        once: true,
      },
      {
        tag: "event",
        id: "ev_20",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: 8,
            y: 5,
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 1,
            recruit: "Elvish Fighter",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_21",
        on: "recruit",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
