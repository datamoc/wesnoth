          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "narrator",
                text: _("<i>Heir to the Throne, Classic</i> optionally includes the old <i>Battle Training</i> tutorial. Play <i>Battle Training</i>?"),
