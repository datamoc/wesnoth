[
  {
    tag: "game",
    schema: 0.1,
    title: _("Northern Winter"),
    children: [
      {
        tag: "side",
        id: 1,
        controller: "human",
        team_name: "elves",
        gold: 180,
        leader: "Konrad",
      },
      {
        tag: "side",
        id: 2,
        team_name: "orcs",
        gold: 130,
        recruit: "Orcish Grunt,Wolf Rider,Orcish Archer,Troll Whelp,Ogre",
        leader: "Halgar_Du_nar",
      },
      {
        tag: "side",
        id: 3,
        team_name: "orcs",
        gold: 130,
        recruit: "Orcish Grunt,Wolf Rider,Orcish Archer,Troll",
        leader: "Gorlak",
      },
      {
        tag: "map",
        id: "scenario_12_Northern_Winter",
        file: "12_Northern_Winter.map",
      },
      {
        tag: "unit",
        id: "Konrad",
        type: "Commander",
        side: 1,
        x: 12,
        y: 35,
        name: _("Konrad"),
      },
      {
        tag: "unit",
        id: "Halgar_Du_nar",
        type: "Orcish Warrior",
        side: 2,
        x: 7,
        y: 5,
        name: _("Halgar Du’nar"),
      },
      {
        tag: "unit",
        id: "Gorlak",
        type: "Orcish Warrior",
        side: 3,
        x: 35,
        y: 5,
        name: _("Gorlak"),
      },
      {
        tag: "unit",
        id: "u_1",
        type: "Thief",
        side: 1,
        x: 12,
        y: 35,
      },
      {
        tag: "event",
        id: "carryover_20",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "carryover_percentage",
            value: 40,
          },
          {
            tag: "set_variable",
            name: "ai_aggression",
            value: 0.75,
          },
          {
            tag: "set_variable",
            name: "ai_caution",
            value: -1.0,
          },
          {
            tag: "set_variable",
            name: "carryover_bonus",
            value: "yes",
          },
        ],
      },
      {
        tag: "event",
        id: "story_21",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Across the river were lands few humans had ever visited. The occasional distant thutter of orcish signal drums made the abundant pine forests nestled in rolling foothills both breathtaking and ominous."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_22",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Swirling, snow-laden winds tore at Konrad’s army, signaling the final exit of autumn and the onset of what would be a harsh winter."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_23",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Konrad,Halgar_Du_nar,Gorlak",
          },
        ],
      },
      {
        tag: "event",
        id: "clock_24",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "turn_limit",
            value: 32,
          },
        ],
      },
      {
        tag: "objectives",
        side: 1,
        victory: _("Defeat all enemy leaders"),
        defeat: _("Death of Konrad Death of Delfador Death of Kalenz Turns run out"),
        children: [
          {
            tag: "defeat",
            condition: "hook",
            hook: "predicate:turn_limit",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_1",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_turns",
            variable: "turn_limit",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "turn_limit",
            value: 1,
            mode: "add",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_2",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:play_music",
            file: "elvish-theme.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "nunc_dimittis.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "suspense.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "silvan_sanctuary.ogg",
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "weight_of_revenge.ogg",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_3",
        on: "prestart",
        once: true,
      },
      {
        tag: "event",
        id: "ev_4",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
            side: 2,
            cells: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
            side: 3,
            cells: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "prestart",
        once: true,
      },
      {
        tag: "event",
        id: "ev_7",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            text: _("This winter is bitterly cold! Perhaps we should stop here and rest a while."),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("Stop and rest? My lord, we must go hard after the Sceptre of Fire, lest it fall into the hands of our enemies!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("We have had a hard march ever since we were besieged by the undead in that foul valley. Now winter bears down upon us, and we have spent most of our money. This land looks fertile enough. Surely we can settle here for the winter!"),
          },
          {
            tag: "message",
            speaker: "human-advisor",
            text: _("Yes, let us rest a while! I am sure there are many challenges ahead, and I do not think I could endure another like the fording of the river for many days."),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("We are pursued by the forces of your arch-enemy, chasing the Sceptre of Fire, the fate of the realm in our hands, and you humans want to stop and rest? Onward, I say!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("They are right, Kalenz. I had wanted to acquire the Sceptre within a moon, but it is not to be. Our soldiers will begin to desert if they do not rest soon. But in these wild north lands, we must fight even for the right to rest. Look to the north! Those foul orcs will not allow us any peace!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-human-mad.webp",
            text: _("Then we shall wrest control of the land from them. To arms!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "new_turn",
        once: false,
        children: [
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "_mwg_random_locations_0",
            filter: "%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22Gs%2CGd%2CCo%2CKo%2CGll%5EFp%2CGll%5EFmw%2CGll%5EFdw%2CGd%5EVo%2CGd%5EVc%2CHhd%5EVo%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:random_count",
            source: "_mwg_random_locations_0",
            variable: "_mwg_random_remaining_2",
            expr: "size / ($turn_limit - $turn_number)",
            allow_less: "yes",
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "_mwg_random_remaining_2",
                greater_than: 0,
              },
              {
                tag: "hook",
                name: "command:random_location",
                source: "_mwg_random_locations_0",
                variable: "_mwg_random_pick_1",
              },
              {
                tag: "switch",
                variable: "loc.terrain",
                children: [
                  {
                    tag: "case",
                    equals: "Gs",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Aa",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Gd",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Aa",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Co",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Coa",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Ko",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Koa",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Gll^Fp",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Aa^Fpa",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Gll^Fmw",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Aa^Fma",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Gll^Fdw",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Aa^Fda",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Gd^Vo",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Aa^Voa",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Gd^Vc",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Aa^Vca",
                        mode: "value",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "Hhd^Vo",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "terrain",
                        value: "Ha^Voa",
                        mode: "value",
                      },
                    ],
                  },
                ],
              },
              {
                tag: "hook",
                name: "command:set_terrain",
                terrain: "$terrain",
                cells: "$loc.x,$loc.y",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "_mwg_random_remaining_2",
                value: -1,
                mode: "add",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("More snow is falling. We must finish this battle quickly. Onward, men!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 10,
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-human-concerned.webp",
            text: _("We must make haste before the snow overwhelms us!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_12",
        on: "branch_if_12",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "get_gryphons",
            equals: "yes",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("A camp was pitched in a secluded valley that protected its occupants from the worst of the winter weather and roving orc patrols. During this time, the valley walls echoed with the squeaks of gryphon hatchlings, who happily frolicked across the camp."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Konrad set his shamans to the task of corralling the animals. The elvish shamans had a natural rapport with the gryphlets, whose wings were still too small to carry a mount."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Konrad finally decided he could not wait until the gryphons grew to maturity — Delfador’s insistence that the Sceptre must be recovered was too compelling. And so after many days of rest, the party set out once again for the dwarven kingdom..."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_13",
        on: "branch_if_13",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "get_gryphons",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("A camp was pitched in a secluded valley that protected its occupants from the worst of the winter weather and roving orc patrols."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Eventually Delfador’s insistence that the Sceptre must be recovered proved too compelling, even when it meant dismantling the camp without the spring having yet fully arrived. And so after many days of rest, the party set out once again for the dwarven kingdom..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Victory is ours! We have secured the land from the orcs. Now we can rest here while the cold winter passes."),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("Let us not rest for too long though, friends. We must still reach the ancient dwarven lands before our foes do."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_12",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_13",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "victory",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "turn_limit",
            value: 1,
            mode: "sub",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "snowCoverage",
            value: "$turn_number",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "snowCoverage",
            value: 1,
            mode: "sub",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "snowCoverage",
            value: "$turn_limit",
            mode: "divide",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Konrad%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("We are vanquished, for I have been defeated!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Li'sar%22%2C%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("I can’t believe it should end like this!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kalenz%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I am finished!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Delfador%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("No! This is the end! We have been defeated!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Warven%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("At least I die an honorable death."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "have_warven",
            value: "no",
            mode: "value",
          },
        ],
      },
    ],
  },
]
