        side: 3,
        x: 2,
        y: 29,
        name: _("Ma-Rana"),
      },
      {
        tag: "event",
        id: "carryover_15",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "carryover_percentage",
            value: 40,
          },
          {
            tag: "set_variable",
            name: "ai_aggression",
            value: 1.0,
          },
          {
            tag: "set_variable",
            name: "carryover_bonus",
            value: "yes",
          },
        ],
      },
      {
        tag: "event",
        id: "story_16",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Kapou’e and the shamans rested and discussed the matter for three days. It was finally decided that it might be necessary to call up the Great Horde to deal with this massive human incursion. However, in order to do that, the entire Great Council would have to gather."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_17",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Since it was now obvious that the humans were going to try their best to prevent that by capturing or killing the shamans, Kapou’e was requested to escort the shamans to the harbor of Tirigaz where the rest of the Council was residing."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_18",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Leaving most of his people at Barag Gór, Kapou’e, accompanied by the shamans and his warriors, set off to Tirigaz."),
          },
        ],
      },
      {
        tag: "event",
        id: "loyal_19",
        on: "start",
        children: [
          {
            tag: "hook",
            name: "command:make_loyal",
            units: "Kapou_e,Na-Mana,Ma-Rana",
          },
        ],
      },
      {
        tag: "event",
        id: "clock_20",
        on: "start",
        children: [
          {
            tag: "set_variable",
            name: "turn_limit",
            value: 20,
          },
        ],
      },
      {
        tag: "objectives",
