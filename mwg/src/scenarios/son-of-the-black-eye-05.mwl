          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Grüü",
            unit: "Grüü",
            x: 16,
            y: 17,
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Jetto",
            unit: "Jetto",
            x: 16,
            y: 15,
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Pirk",
            unit: "Pirk",
            x: 21,
            y: 15,
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Gork",
            unit: "Gork",
            x: 20,
            y: 14,
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Vraurk",
            unit: "Vraurk",
            x: 19,
            y: 14,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("A couple of days into their journey, the party halted to rest for the night."),
          },
          {
            tag: "message",
            speaker: "Vraurk",
            text: _("Ahhh, I’m so tired. It was a good idea to halt in such a quiet place."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("It is too quiet. Just plain boring."),
          },
          {
            tag: "message",
            speaker: "Pirk",
            text: _("Shut up, I just heard something."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("You’re right. I can see something is moving in these hills. Looks like there are undead there."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 35,
            y: 1,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 1,
            y: 28,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Excellent! It is time for exercise!"),
          },
          {
            tag: "message",
            speaker: "Vraurk",
            text: _("Uh... I don’t think so. Let’s get out of here!"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("No way! Grüü want to crush some undead."),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("Grüü is right. It is not wise to let these undead remain here, cutting off our supply lines and path of retreat. In these days of turmoil, we don’t know what lies ahead, so it is best not to leave any threats to our rear."),
          },
          {
            tag: "message",
            speaker: "Vraurk",
            text: _("But..."),
          },
          {
            tag: "message",
            speaker: "Gork",
            text: _("Hush, Vraurk, we must trust the Son of the Black-Eye in these matters, for he is far more cunning in them than we are."),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("That’s right, let’s go!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Kapou'e",
            x: 18,
            y: 16,
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 28,
            y: 23,
          },
          {
            tag: "message",
            text: _("Hmmm, what a neat bottle! What is it?"),
          },
          {
            tag: "message",
            text: _("It is written H.O.L.Y W.A.T.E.R"),
          },
          {
            tag: "message",
            text: _("I’m thirsty... <i>Gulp gulp</i>"),
          },
          {
            tag: "message",
            text: _("Ahhh, that was yummy!"),
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: 29,
            y: 24,
            item_name: "",
            image: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 17,
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("The day is coming, these night creatures will soon return to the pit."),
          },
          {
            tag: "message",
            speaker: "Pirk",
            text: _("Grüü, are you forgetting we are also night creatures?"),
          },
          {
            tag: "message",
            speaker: "Grüü",
            text: _("Err... well..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kapou'e%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh! I’m done. My people are doomed!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Orcish%20Shaman%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Ouch! This hurts!"),
          },
          {
            tag: "message",
            speaker: "Kapou'e",
            text: _("The Council will never be complete again. This is hopeless."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gr%C3%BC%C3%BC%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Oh no, I am defeated."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
