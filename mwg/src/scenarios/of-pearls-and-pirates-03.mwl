            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 4,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:heal_unit",
            amount: "full",
            restore_statuses: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22skiff_captured%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "skiff_captured",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "skiff_captured",
            x: 30,
            y: 14,
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("Halfway done, everyone. We’ll need both skiffs to carry us all."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_22",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
