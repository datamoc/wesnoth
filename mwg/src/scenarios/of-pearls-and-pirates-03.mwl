            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%223%22%2C%22animate%22%3A%22yes%22%2C%22fire_event%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "lose",
          },
        ],
