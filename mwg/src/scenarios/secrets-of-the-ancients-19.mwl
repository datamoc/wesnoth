      {
        tag: "event",
        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("I had heard that mountains sometimes breathed fire like dragons, but that seemed a fanciful tale. From the look of this, that may actually be true."),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("Yes, it’s quite true. This mountain fire has some uses too. For example, trolls use it for welding together crude armor."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("Trolls! Do you think we shall encounter any?"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("I see no reason to expect..."),
          },
          {
            tag: "message",
            speaker: "Shurd",
            text: _("Invaders!"),
          },
          {
            tag: "message",
            speaker: "Brek",
            text: _("Crush them!"),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("... Yes. Yes, I do."),
          },
        ],
      },
