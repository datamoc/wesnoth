          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("<i>_None of the Golden Flame Tribe were as bright or as bold as Ougl had been. They did not understand the danger of the orcs.</i>"),
          },
