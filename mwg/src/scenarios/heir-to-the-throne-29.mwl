                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Angarthing%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("<i>(cough)</i> Who’s there?"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-glad.webp",
            text: _("I am Prince Konrad of Wesnoth, and a friend of Knalga. I’ve come to rescue you!"),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Aye, that so? ...ye weren’t who I was expectin’. <i>(cough)</i> But I’m not about to turn down help."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Angarthing",
            x: 4,
            y: 7,
          },
