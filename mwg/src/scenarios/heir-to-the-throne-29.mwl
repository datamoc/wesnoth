                ],
              },
              {
                tag: "hook",
                name: "command:play_sound",
                file: "water.wav",
              },
              {
                tag: "hook",
                name: "command:delay",
                time: 500,
              },
              {
                tag: "hook",
                name: "command:store_locations",
                variable: "hexes_to_flood",
                filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22!%2CXu*%2CW*%22%2C%22variable%22%3A%22hexes_to_flood%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent_location%22%2C%22attributes%22%3A%7B%22find_in%22%3A%22hexes_to_flood%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
