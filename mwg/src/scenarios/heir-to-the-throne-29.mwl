                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Cave%20Wall%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22Wo*%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Look out! The cavern beyond this wall is filled with water, and it’s flooding into our caves!"),
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "hexes_to_flood",
            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22x%22%3A%22%24unit.x%22%2C%22y%22%3A%22%24unit.y%22%2C%22variable%22%3A%22hexes_to_flood%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "set_variable",
            name: "flood_count",
            value: 0,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "flood_count",
                less_than: 40,
              },
              {
                tag: "foreach",
