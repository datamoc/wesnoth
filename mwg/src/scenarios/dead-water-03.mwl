        children: [
          {
            tag: "message",
            speaker: "Gashnok",
            text: _("Smells like lots of death in the south near that merman town. Hey, Vrunt, you think the wolves like eatin’ merfish?"),
          },
          {
            tag: "message",
            speaker: "Vrunt",
            text: _("Talking or not, fish are fish. Wolves’ll probably love them. Besides, look there! Some fresh ones are coming our way!"),
          },
          {
            tag: "message",
            speaker: "Gashnok",
            text: _("They look mighty good to me. Might even have a taste later, myself. Let’s get ’em, boys!"),
          },
          {
            tag: "message",
            speaker: "Kai Krellis",
            text: _("Beware, people!"),
          },
        ],
