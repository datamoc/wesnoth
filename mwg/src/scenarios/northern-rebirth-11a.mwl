          },
          {
            tag: "message",
            speaker: "Stalrag",
            text: _("Farewell, my friends. I now go to join my fallen brothers."),
          },
          {
            tag: "message",
            speaker: "Shinsplitter",
            text: _("No, Stalrag! Without you what will become of the Shinsplitters?"),
          },
          {
            tag: "message",
            speaker: "Stalrag",
            text: _("Shinsplitters... join Tallin... He is your new... leader... trust... and... serve... him... as... you... have... served... me."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Your death shall not go unavenged, brave Stalrag. DEATH TO THE ORCS!!"),
