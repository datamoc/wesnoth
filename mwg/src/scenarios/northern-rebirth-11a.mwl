          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Father Morvin",
            unit: "Father Morvin",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Sister Thera",
            unit: "Sister Thera",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Ro'Arthian",
            unit: "Ro'Arthian",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Ro'Sothian",
            unit: "Ro'Sothian",
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Gods of Light, look at that fortress! The castle Angthurim is even grimmer than its reputation!"),
          },
          {
            tag: "message",
            speaker: "Supporter",
            text: _("Hey, look who is here!"),
          },
          {
            tag: "message",
            speaker: "Rakshas",
            text: _("Where is my gold?!"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("It’s Rakshas!"),
          },
          {
            tag: "message",
            speaker: "Gore",
            text: _("Right here, Master."),
          },
          {
            tag: "message",
            speaker: "Rakshas",
            text: _("Ahhhhh, very good, my loyal servant. You will be richly rewarded for this! Tell me, what news do you have on that human vermin that has so persistently evaded my clutches?"),
          },
          {
            tag: "message",
            speaker: "Gore",
            text: _("We trapped him and his pitiful band of followers. By now they will have been mashed to paste and fed to the whelps."),
          },
          {
            tag: "message",
            speaker: "Rakshas",
            text: _("Hahahaha! Very g—"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("<big>RAKSHAS!!</big>"),
          },
          {
            tag: "message",
            speaker: "Rakshas",
            text: _("What?! YOU! YOU ANNOYING, DISGUSTING LITTLE VERMIN! DON’T YOU KNOW HOW TO DIE?!"),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Foul one, the only one who will be dying here is you. Stand and fight!"),
          },
          {
            tag: "message",
            speaker: "Rakshas",
            text: _("Bah! I have better things to do than stamp out your insignificant life. Generals, bring me his head!"),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22race%22%3A%22orc%22%2C%22side%22%3A%222%22%2C%22fire_event%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Ro’Arthian, send a message to Hamel. Tell him it’s time."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "spawn",
            id: "u_3",
            type: "Gryphon",
            side: 1,
            x: 31,
            y: 8,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_3",
          },
          {
            tag: "message",
            speaker: "Ro'Arthian",
            text: _("It’s done."),
          },
          {
            tag: "message",
            speaker: "Tallin",
            text: _("Very well. Forward! Victory or death!"),
          },
          {
            tag: "message",
            speaker: "Krash",
            text: _("Come on boys, let’s give it to ’em!"),
          },
        ],
