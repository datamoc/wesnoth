      {
        tag: "event",
        id: "story_6",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("After reaching the dwarvish keep and tending to their wounded, the humans led by Tallin, and the dwarves led by Lord Hamel, hurried deeper into the caverns for a hasty council."),
          },
        ],
      },
      {
        tag: "event",
