        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Camerin",
            unit: "Camerin",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: 1,
          },
          {
            tag: "foreach",
