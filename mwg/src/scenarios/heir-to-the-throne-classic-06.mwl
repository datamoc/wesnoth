            x: 5,
            y: 31,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("On the banks of Elensefar’s port district, three shadowy figures appeared."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("To Konrad’s surprise, they quickly made their way across the river’s mouth. The turbulent waters hid a nearly invisible ford, wide enough for two soldiers to march shoulder-to-shoulder."),
          },
          {
            tag: "spawn",
            id: "Reglok",
            type: "Rogue",
            side: 1,
            x: 6,
            y: 29,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Reglok",
          },
          {
