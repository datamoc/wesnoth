            tag: "hook",
            name: "command:make_loyal",
            unit: "Gelgar",
          },
          {
            tag: "spawn",
            id: "Gamlel",
            type: "Thief",
            side: 1,
            x: 19,
            y: 22,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Gamlel",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Gamlel",
          },
          {
            tag: "spawn",
            id: "Darglen",
            type: "Thief",
            side: 1,
            x: 17,
            y: 22,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Darglen",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Darglen",
          },
          {
            tag: "message",
            speaker: "Reglok",
            text: _("Let’s expel these invaders! Today, the city is ours again!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11_opt1",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Reglok",
            text: _("Very well. When you raise your red banner over any building in the city proper, we will see the sign and attack from the city’s northern gate."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Agreed. But, will you be able to see our flag if it’s dark?"),
          },
          {
            tag: "message",
            speaker: "Reglok",
            text: _("Yes, we will see it. In fact, we prefer to fight at night. I pray you do not lead us into slaughter."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Do not fear, friends. There will be a slaughter here, but it will be orcish blood staining the streets."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 4,
          },
          {
            tag: "spawn",
            id: "Reglok",
            type: "Rogue",
            side: 1,
            x: 22,
            y: 39,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
