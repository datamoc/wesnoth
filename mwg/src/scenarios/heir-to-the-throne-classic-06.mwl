                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22*%5EV*%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%22x%22%3A%2216%22%2C%22y%22%3A%2226%22%2C%22radius%22%3A%225%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("As the banner was raised, sounds of fighting could be heard from across the city."),
          },
          {
            tag: "spawn",
            id: "Reglok",
            type: "Rogue",
            side: 1,
            x: 15,
            y: 21,
          },
          {
            tag: "hook",
