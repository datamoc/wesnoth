      {
        tag: "event",
        id: "ev_10",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("The party arrived at Elensefar at last, but found that the city had already fallen to the savage orcs."),
          },
          {
            tag: "message",
            speaker: "Advisor",
            text: _("My lord! It seems the city has already fallen!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("This is terrible news! We must retake the city!"),
          },
          {
            tag: "message",
            speaker: "Advisor",
            text: _("There are so many of them. This will not be easy! And look to the north! It seems that the undead are allied with the orcs!"),
          },
          {
            tag: "message",
            speaker: "Muff Jaanal",
            text: _("Here come the elves! Our newly forged alliance with the orcs will give us the power to crush them with ease!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("We must take the city, and destroy the evil undead before reinforcements arrive!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11_opt0",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Reglok",
            text: _("Excellent. Two hours past midnight meet us on the west bank of the river, across from Elensefar’s docks."),
          },
