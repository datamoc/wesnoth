            unit: "Gelgar",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Gelgar",
          },
          {
            tag: "spawn",
            id: "Gamlel",
            type: "Thief",
            side: 1,
            x: 23,
            y: 39,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Gamlel",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Gamlel",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1250,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("As night began to fall, three dark figures crept out of the forest."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-elvish-mad.webp",
            text: _("Halt! Who goes there, friend or foe?"),
          },
          {
            tag: "message",
            speaker: "Reglok",
            text: _("Greetings, friend. We are from the Elensefar Thieves’ Guild. We would like to help you against the orcs!"),
          },
          {
            tag: "message",
            speaker: "Advisor",
            text: _("Thieves, hmmm? Who says we can trust such as you?"),
          },
          {
            tag: "message",
            speaker: "Gamlel",
            text: _("We would understand if you didn’t trust us, of course, but it is in our mutual interest to rid the city of the orcs!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Very well. You may join us."),
          },
          {
            tag: "message",
            speaker: "Reglok",
            text: _("We will serve you well, for we respect the help you are providing to our city. You shall find that there is honor, even among thieves."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Yes, but where is your fighting force? How can you help us?"),
          },
          {
            tag: "message",
            speaker: "Gelgar",
            text: _("We survive by stealth. We can help you sneak into the city and surround the orcs. Alternatively, we can lay in wait until you give us a signal then ambush the orcs’ rear."),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Konrad",
                text: _("Hmm... I have to consider this..."),
              },
              {
                tag: "choice",
                text: _("Help us infiltrate the city. We can do the rest."),
                event: "ev_11_opt0",
              },
              {
                tag: "choice",
                text: _("I want you to reinforce us once we break through their line."),
                event: "ev_11_opt1",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22type%22%3A%22Thief%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22type%22%3A%22Rogue%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: 1,
            mode: "allow",
            types: "Thief",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You can now recruit Thieves!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_14",
        on: "branch_if_14",
        once: true,
        children: [
          {
            tag: "condition",
