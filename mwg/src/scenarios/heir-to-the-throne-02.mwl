            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_108",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Elvish Scout",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_109",
          },
          {
            tag: "message",
            speaker: "Quillan",
            text: _("My riders and I are the first to break free of our encirclement! We are swift enough to escape the spears, but our slower brethren may be caught as they retreat."),
          },
          {
            tag: "message",
            speaker: "Quillan",
            text: _("They will be here soon. Konrad, you must help us all reach safety across the river!"),
          },
        ],
      },
