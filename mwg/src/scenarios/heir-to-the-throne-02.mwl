        on: "elf_preescape",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("Will none of you stay and help fight? If we all stand together, surely we can resist the invaders!"),
          },
          {
            tag: "message",
            text: _("To stand together is to fall together, Konrad. We defended our homes in the east as best we could, but now the decision has been made to scatter, not to fight."),
          },
          {
            tag: "message",
            text: _("The Aethenwood is but a backwater compared to Wesmere or the Lintanir; the might of Wesnoth is beyond our capacity to withstand. We must scatter and hide if we wish any hope of evading your kin."),
          },
        ],
      },
