            time: 500,
          },
          {
            tag: "message",
            speaker: "Quillan",
            text: _("Master Konrad, I am pleased to see that you have escaped! And even more pleased to see that you have returned."),
          },
          {
            tag: "message",
            speaker: "Quillan",
            text: _("Our lines have been broken; men pour into the Aethenwood. The marshals are coordinating a retreat, but are being harried at every step."),
          },
          {
            tag: "message",
            speaker: "leader5",
            text: _("Don’t let them get away! The queen demands a total victory!"),
          },
          {
            tag: "message",
            speaker: "leader3",
            text: _("Kill any who resist, but take the rest alive. We need prisoners for interrogation and slaves for the mines!"),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Elvish Scout",
            mode: "value",
          },
