      {
        tag: "event",
        id: "ev_14",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:modify_unit",
            facing: "se",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%227%22%2C%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D",
            side: 7,
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            hidden: "no",
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            facing: "nw",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%229%22%2C%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D",
            side: 9,
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            hidden: "no",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "tallin_store",
            kill: "no",
            id: "Tallin",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Tallin",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            hidden: "no",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("A few short hours later all the groups converged on the fortress."),
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Father Morvin",
            unit: "Father Morvin",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Sister Thera",
            unit: "Sister Thera",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Ro'Arthian",
            unit: "Ro'Arthian",
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Ro'Sothian",
            unit: "Ro'Sothian",
          },
          {
            tag: "message",
            text: _("Rakshas! You have evaded me for the last time. Now come out and die like a man!"),
          },
          {
            tag: "message",
            text: _("What the...? How did he get here?"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "hamel_store",
            kill: "no",
            id: "Hamel",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Hammel",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "ne",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_unit_hidden",
            hidden: "no",
          },
          {
            tag: "spawn",
            id: "u_57",
            type: "Dwarvish Steelclad",
            side: 8,
            x: 10,
            y: 32,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_57",
          },
          {
            tag: "spawn",
            id: "u_58",
            type: "Dwarvish Steelclad",
            side: 8,
            x: 10,
            y: 30,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_58",
          },
          {
            tag: "spawn",
            id: "u_59",
            type: "Dwarvish Thunderguard",
            side: 8,
            x: 9,
            y: 31,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_59",
          },
          {
            tag: "spawn",
            id: "u_60",
            type: "Dwarvish Thunderguard",
            side: 8,
            x: 9,
            y: 30,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_60",
          },
          {
            tag: "message",
            text: _("Will they, now?"),
          },
          {
            tag: "message",
            text: _("<i>What</i>?!"),
          },
          {
            tag: "message",
            text: _("Your western army has been slaughtered, Rakshas, and <i>you</i> will soon join them!"),
          },
          {
            tag: "message",
            text: _("But... but... how can this be?"),
          },
          {
            tag: "message",
            text: _("It’s called ‘The End’, foul orc. Forward! FOR KNALGA!!"),
          },
          {
            tag: "message",
            text: _("FOR FRIENDSHIP!!"),
          },
          {
            tag: "message",
            text: _("FOR PEACE!!"),
          },
          {
            tag: "message",
            text: _("FOR FUN!"),
          },
          {
            tag: "message",
            text: _("FOR HIDEL!!"),
          },
          {
            tag: "message",
            speaker: "Supporter",
            text: _("FOR DWARVEN DOORS!!"),
          },
          {
            tag: "message",
            text: _("FOR THE FREE PEOPLES OF THE NORTH! FALL ON THEM, MEN!!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 5,
          },
          {
            tag: "message",
            text: _("Sweet gods, look at all those orcs pouring out of that fortress."),
          },
          {
            tag: "message",
            text: _("Aye, and not just grunts either, those are all hardened veterans!"),
          },
          {
            tag: "message",
            text: _("Yeah. Obviously this is going to take some time. If necessary we can sit tight in our fortifications and besiege them until they starve!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Rakshas%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Die, you murderous beast! No longer shall you terrorize the people of the North!"),
          },
          {
            tag: "message",
            text: _("Learn the fate of one who offends the Dwarves of Knalga."),
          },
          {
            tag: "message",
            text: _("Or the elves of the Northern Forests."),
          },
          {
            tag: "message",
            speaker: "Supporter",
            text: _("Or the humans of Dwarven Doors."),
          },
          {
            tag: "message",
            text: _("(<i>Gurgle</i>) No...! This... cannot... be... happening... to... me..."),
          },
          {
            tag: "message",
            text: _("Such were the last words of Rakshas the great!"),
          },
          {
            tag: "message",
            text: _("(<i>Snicker</i>)"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "victory",
        once: true,
        children: [
          {
            tag: "message",
            text: _("At last! Rakshas has been slain, and the orcish host has been crushed. Peace and prosperity will come to the Northlands once again!"),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("At these words all the allied forces gave out a combined and thunderous cheer. The war was finally over."),
          },
          {
            tag: "message",
            text: _("(<i>Small voice lost in the uproar</i>) Awww, is it done already?"),
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("Father Morvin and his wife saw to the wounded as the rest set about preparing a victory feast."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: "7,8,9",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Hamel%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Argh!"),
          },
          {
            tag: "message",
            text: _("Hamel! Blast it, without the dwarves to hold the western flank we are as good as defeated."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
