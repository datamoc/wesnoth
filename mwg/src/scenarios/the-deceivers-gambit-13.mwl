            event: "branch_if_103",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("<i>_ Eldred has betrayed Wesnoth’s strife to the orcish clans. With grunts swarming along the riverbank, the road east to Delfador is no longer safe. There can be no more escape.</i>"),
          },
          {
            tag: "message",
            text: _("The orcs are back! There’s hordes of them!"),
          },
          {
            tag: "message",
            speaker: "Eldred",
            text: _("At ease, soldier. We’ve made a deal. They’re here to help us fight the rebels."),
          },
          {
            tag: "message",
            text: _("We’re working with orcs? But, your father—"),
          },
          {
            tag: "message",
            speaker: "Eldred",
            text: _("My father is <i><b>dead</b></i>, soldier. Let the beasts through."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Eldred",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Kestrel",
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Ghuvog",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_106",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%229%2C10%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%2C5%2C6%2C7%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Filthy trog. I don’t trust you, whatever Eldred says."),
          },
          {
            tag: "message",
            text: _("You’re lucky your boss is paying us off, weakling. We’ve free reign to pillage any town that resists his rule, so keep your mouth shut or your home will be next."),
          },
        ],
      },
