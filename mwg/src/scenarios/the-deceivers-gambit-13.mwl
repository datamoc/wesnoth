            filter: "%7B%22tag%22%3A%22put_to_recall_list%22%2C%22attributes%22%3A%7B%22id%22%3A%22%24unit.id%22%7D%2C%22children%22%3A%5B%5D%7D",
            heal: "no",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_64",
        on: "moveto",
        once: false,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 39,
            y: "9-12",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%2C%22first_time_only%22%3A%22no%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_condition%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22escape_turns_remaining%22%2C%22greater_than%22%3A%220%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Deoran%22%2C%22message%22%3A%22Fleeing%20too%20quickly%20will%20only%20seal%20my%20guilt%20in%20the%20eyes%20of%20Wesnoth%E2%80%99s%20commanders.%20I%20do%20not%20intend%20to%20run%20until%20I%20have%20no%20other%20choice!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22allow_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "escape_turns_remaining",
                greater_than: 0,
              },
            ],
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("Fleeing too quickly will only seal my guilt in the eyes of Wesnoth’s commanders. I do not intend to run until I have no other choice!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_65",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 7,
          },
        ],
      },
      {
        tag: "event",
        id: "ev_66",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "set_variable",
