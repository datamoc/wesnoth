          },
        ],
      },
      {
        tag: "event",
        id: "if_68",
        on: "branch_if_68",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s11_carryover",
            greater_than: 0,
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You will now start the next scenario with $bonus_gold total gold (plus $s11_carryover carryover from Delfador)"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_69",
        on: "branch_if_69",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s11_carryover",
            less_than_or_equal_to: 0,
          },
          {
            tag: "message",
