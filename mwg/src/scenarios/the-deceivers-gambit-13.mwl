            text: _("You will now start the next scenario with $bonus_gold total gold!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_67",
        on: "give_bonus_gold",
        once: false,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "keep_captured_explanation",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
