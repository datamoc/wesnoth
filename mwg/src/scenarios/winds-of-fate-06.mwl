        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Resha",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Resha",
            x: 51,
            y: 32,
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Gorlack, you have made landfall! Within sight of these humans!"),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("You have returned from patrol with fortunate timing, Resha. These creatures are to be our prey. I shall grant you the details at the keep. Fall in."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Gorlack, this is terribly unwise! The full ability of the humans is still unknown to us."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("We have no choice, we need the meat. When I give you the signal, light the beacon. It will call in our reinforcements."),
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Iryn",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1000,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Iryn",
            x: 26,
            y: 20,
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Vorlyan",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "horn-signals/horn-2.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 2000,
          },
          {
            tag: "message",
            speaker: "Iryn",
            text: _("General Vorlyan! We have a problem."),
          },
          {
            tag: "message",
            speaker: "Vorlyan",
            text: _("How many orcs? Have they made landfall yet?"),
          },
          {
            tag: "message",
            speaker: "Iryn",
            text: _("Not orcs, sir, dragons."),
          },
          {
            tag: "message",
            speaker: "Vorlyan",
            text: _("Dragons?!"),
          },
          {
            tag: "message",
            speaker: "Iryn",
            text: _("Indeed sir, they are moving in from our south. There is a horde of them."),
          },
          {
            tag: "message",
            speaker: "Vorlyan",
            text: _("They do move in hordes..."),
          },
          {
            tag: "message",
            speaker: "Vorlyan",
            text: _("Captain, ride east and order Carcyn Fisher to put his people on the boats and evacuate upriver. Tell that wesfolk traveller if he ignores <i>this</i> order you will evacuate his head from his shoulders."),
          },
          {
            tag: "message",
            speaker: "Vorlyan",
            text: _("Then go upriver yourself, all the way to Fort Weldyn. Bring word of our situation directly to King Haldric the Dragonbane."),
          },
          {
            tag: "message",
            speaker: "Iryn",
            text: _("Might we be overreacting, sir?"),
          },
          {
            tag: "message",
            speaker: "Vorlyan",
            text: _("We are students of war, Captain, and if recent years have taught our people anything, it is to be ready for the worst at all times."),
          },
          {
            tag: "message",
            speaker: "Iryn",
            text: _("Sir!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Iryn",
            x: 30,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Iryn",
          },
        ],
