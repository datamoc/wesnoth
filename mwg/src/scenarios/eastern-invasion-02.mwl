      {
        tag: "event",
        id: "ev_38",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Where are we? I can hardly see my own nose."),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("We are in a tunnel under the outpost. Smugglers originally dug it to sneak behind Wesnoth’s patrols. I believe it to be currently inhabited by trolls."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 15,
            y: 5,
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 15,
