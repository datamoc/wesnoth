          {
            tag: "message",
            speaker: "Myrilell",
            text: _("Dark magic streams forth from the underlevels, granting terrible un-life to things sprung from the deepest nightmares of humanity. With the spell broken that once sealed them below, the undead emerge to destroy us all!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "wail-sml.wav",
          },
          {
            tag: "hook",
