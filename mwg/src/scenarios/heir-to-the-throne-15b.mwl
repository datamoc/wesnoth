          {
            tag: "message",
            speaker: "Konrad",
            text: _("Look out! They’re preparing another assault."),
          },
          {
            tag: "message",
            text: _("For too long have we been trapped by your accursed seal! The undertunnels shall be thrown open and our followers shall flood across the land! You cannot stop the eternal life that we bring!"),
          },
          {
            tag: "gold",
            side: "3,4,5,6,7",
            amount: 120,
