      {
        tag: "event",
        id: "if_59",
        on: "branch_if_59",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "status_s15a",
            equals: "completed",
          },
          {
            tag: "message",
            speaker: "$speaker",
            text: _("Lo and behold, Konrad: my home! At last I return... but we are too late! Undead! The seal has already broken!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_60",
        on: "branch_if_60",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "status_s15a",
            not_equals: "completed",
          },
          {
            tag: "message",
            speaker: "Moremirmu",
            text: _("Lo and behold, Konrad! Fate has brought us to my home; the monastery of my order."),
          },
          {
            tag: "message",
            speaker: "Moremirmu",
            text: _("... but what calamity is this? Undead! The sacred seal has broken!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_61",
        on: "branch_if_61",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "status_s15a",
            equals: "completed",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Don’t give up hope! You sent Kaelor to find help, and he found me — Konrad, heir to the throne of Wesnoth. If there are undead here then it is my duty to help you stop them."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("You say there was once a spell that sealed these dead underground. Can you cast it again?"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_62",
        on: "branch_if_62",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "status_s15a",
            not_equals: "completed",
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Don’t give up hope! I am Konrad, heir to the throne of Wesnoth, and if there are undead here then it is my duty to help you stop them."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("But what is this place? You say there was once a spell that sealed these dead underground. Can you cast it again?"),
          },
        ],
      },
