            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gweddry%2COwaec%2CDacyn%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Gweddry,Owaec,Dacyn",
          },
          {
            tag: "hook",
            name: "command:teleport",
            id: "Owaec",
            x: 14,
            y: 22,
            to_x: 13,
            to_y: 21,
          },
          {
            tag: "hook",
            name: "command:teleport",
            id: "Gweddry",
            x: 15,
            y: 23,
            to_x: 14,
            to_y: 22,
          },
          {
            tag: "hook",
