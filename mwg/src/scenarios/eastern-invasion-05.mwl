            time: 1000,
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Now that both the outlaws and undead are defeated, we finally have some time to rest."),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("Good. Now leave me in peace while I consider how to combat this invasion."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 16,
            y: 24,
          },
          {
            tag: "hook",
            name: "command:scenario_move",
