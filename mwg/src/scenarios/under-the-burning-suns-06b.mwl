                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%2C%22id%22%3A%22take_belt%22%2C%22first_time_only%22%3A%22no%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22Based%20on%20the%20runes%20covering%20the%20walls%20this%20must%20be%20the%20tomb%20of%20some%20ancient%20dwarf.%20The%20tomb%20seems%20empty%20except%20for%20this%20ornate%20stone%20coffin.%20The%20skeleton%20inside%20the%20coffin%20has%20long%20since%20vanished%20into%20dust.%20All%20that%E2%80%99s%20left%20are%20a%20few%20ceremonial%20trinkets%20and%20this%20shining%20golden%20belt.%20Inscribed%20on%20this%20inside%20are%20the%20words%3A%20%3Ci%3E%E2%80%9CMay%20you%20have%20the%20toughness%20to%20stay%20standing%20long%20after%20your%20enemies%20fall.%E2%80%9D%3C%2Fi%3E%20Grave%20robbing%20is%20never%20a%20good%20thing%20to%20do%2C%20but%20this%20belt%20looks%20magical%20and%20its%20former%20owner%20certainly%20won%E2%80%99t%20miss%20it.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22option%22%2C%22attributes%22%3A%7B%22label%22%3A%22I%20fear%20no%20ghosts%2C%20I%E2%80%99ll%20take%20it.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22command%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22remove_event%22%2C%22attributes%22%3A%7B%22id%22%3A%22take_belt%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22The%20belt%20fits%20perfectly!%20Somehow%20I%20feel%20stronger%20and%20tougher.%20This%20is%20too%20easy%2C%20there%20seem%20to%20have%20been%20no%20traps%20set%20upon%20the%20coffin.%20Today%E2%80%99s%20my%20lucky%20day.%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22object%22%2C%22attributes%22%3A%7B%22id%22%3A%22DwarvenBelt%22%2C%22name%22%3A%22Dwarven%20Belt%22%2C%22description%22%3A%22The%20maximum%20hit%20points%20of%20the%20unit%20who%20wears%20this%20belt%20will%20increase%20by%2012.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22x%22%3A%2249%22%2C%22y%22%3A%2224%22%2C%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22increase_total%22%3A%2212%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22unit%22%2C%22attributes%22%3A%7B%22side%22%3A%225%22%2C%22type%22%3A%22Ghost%22%2C%22id%22%3A%22Angry%20Ghost%22%2C%22name%22%3A%22Angry%20Ghost%22%2C%22female_name%22%3A%22%22%2C%22x%22%3A%2247%22%2C%22y%22%3A%2222%22%2C%22random_traits%22%3A%22no%22%2C%22random_gender%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Angry%20Ghost%22%2C%22message%22%3A%22You%20who%20disturb%20my%20rest%2C%20come%20and%20join%20me%20in%20death!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22Then%20again%2C%20maybe%20I%20spoke%20too%20soon.%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22option%22%2C%22attributes%22%3A%7B%22label%22%3A%22On%20second%20thought%2C%20it%E2%80%99s%20better%20to%20leave%20the%20dead%20in%20peace.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22command%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22allow_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                text: _("Based on the runes covering the walls this must be the tomb of some ancient dwarf. The tomb seems empty except for this ornate stone coffin. The skeleton inside the coffin has long since vanished into dust. All that’s left are a few ceremonial trinkets and this shining golden belt. Inscribed on this inside are the words: <i>“May you have the toughness to stay standing long after your enemies fall.”</i> Grave robbing is never a good thing to do, but this belt looks magical and its former owner certainly won’t miss it."),
              },
              {
                tag: "choice",
                text: _("I fear no ghosts, I’ll take it."),
                event: "take_belt_opt0",
              },
              {
                tag: "choice",
                text: _("On second thought, it’s better to leave the dead in peace."),
                event: "take_belt_opt1",
              },
            ],
          },
        ],
      },
