          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22unit%22%2C%22attributes%22%3A%7B%22type%22%3A%22Tentacle%20of%20the%20Deep%22%2C%22id%22%3A%22Smaller%20Tentacle%22%2C%22side%22%3A%225%22%2C%22x%22%3A%2219%22%2C%22y%22%3A%229%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22modifications%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22intelligent%22%2C%22male_name%22%3A%22intelligent%22%2C%22female_name%22%3A%22female%5Eintelligent%22%2C%22help_text%22%3A%22%3Ci%3EIntelligent%3C%2Fi%3E%20units%20require%2020%25%20less%20experience%20than%20usual%20to%20advance.%5Cn%5Cn_%20Intelligent%20units%20are%20very%20useful%20at%20the%20beginning%20of%20a%20campaign%20as%20they%20can%20advance%20to%20higher%20levels%20more%20quickly.%20Later%20in%20campaigns%20Intelligent%20is%20not%20quite%20as%20useful%20because%20the%20%3Ci%3EAfter%20Maximum%20Level%20Advancement%3C%2Fi%3E%20(AMLA)%20is%20not%20as%20significant%20a%20change%20as%20advancing%20a%20level.%20If%20you%20have%20many%20%E2%80%98maximum%20level%E2%80%99%20units%20you%20may%20wish%20to%20recall%20units%20with%20more%20desirable%20traits.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22max_experience%22%2C%22increase%22%3A%22-20%25%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22quick%22%2C%22male_name%22%3A%22quick%22%2C%22female_name%22%3A%22female%5Equick%22%2C%22help_text%22%3A%22%3Ci%3EQuick%3C%2Fi%3E%20units%20have%201%20extra%20movement%20point%2C%20but%205%25%20less%20hitpoints%20than%20usual.%5Cn%5Cn_%20Quick%20is%20the%20most%20noticeable%20trait%2C%20particularly%20in%20slower%20moving%20units%20such%20as%20trolls%20or%20heavy%20infantry.%20Units%20with%20the%20quick%20trait%20often%20have%20greatly%20increased%20mobility%20in%20rough%