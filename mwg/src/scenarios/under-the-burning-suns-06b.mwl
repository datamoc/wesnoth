          {
            tag: "spawn",
            id: "u_5",
            type: "Dwarvish Scout",
            side: 2,
            x: 9,
            y: 33,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "u_5",
          },
          {
            tag: "message",
            speaker: "Dwarf Sergeant",
            text: _("Do you know what the first task of any dwarven warrior is, runt?"),
          },
          {
            tag: "message",
            text: _("Sir?"),
          },
          {
            tag: "message",
            speaker: "Dwarf Sergeant",
            text: _("Constant vigilance, boys; the enemy could be anywhere!"),
          },
          {
            tag: "message",
            text: _("But sir—"),
          },
          {
            tag: "message",
            speaker: "Dwarf Sergeant",
            text: _("Did I give you permissions to speak? Did I?"),
          },
          {
            tag: "message",
            speaker: "Dwarf Sergeant",
            text: _("I was killing trolls when you were in swaddling clothes. I wrote the book on killing trolls. And you’re not going anywhere until I’m done with you."),
          },
          {
            tag: "message",
            text: _("But sir, behind you...!"),
          },
          {
            tag: "message",
            speaker: "Dwarf Sergeant",
            text: _("Oh let me guess, a big nasty troll, right? And when I turn around you flee like the cowards you are. Do you think I’m stupid enough to fall for that one?"),
          },
          {
            tag: "switch",
            variable: "unit.race",
            children: [
              {
                tag: "case",
                equals: "quenoth, elf",
                children: [
                  {
                    tag: "message",
                    text: _("No, it’s an elf!"),
                  },
                  {
                    tag: "hook",
                    name: "command:modify_unit",
                    facing: "se",
                    filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Dwarf%20Sergeant%22%7D%2C%22children%22%3A%5B%5D%7D",
                    id: "Dwarf Sergeant",
                  },
                  {
                    tag: "message",
                    text: _("What...?! Right... First task, boys, kill the intruder!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: "troll",
                children: [
                  {
                    tag: "message",
                    text: _("I’m too young to die, save me!"),
                  },
                  {
                    tag: "hook",
                    name: "command:modify_unit",
                    facing: "se",
                    filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Dwarf%20Sergeant%22%7D%2C%22children%22%3A%5B%5D%7D",
                    id: "Dwarf Sergeant",
                  },
                  {
                    tag: "message",
                    speaker: "Dwarf Sergeant",
                    text: _("Oh, grow a backbone... Huh? Hey, for once the runt was telling the truth. Come on, boys, kill the intruder!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: "human",
                children: [
                  {
                    tag: "message",
                    text: _("No, it’s a... human?"),
                  },
                  {
                    tag: "hook",
                    name: "command:modify_unit",
                    facing: "se",
                    filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Dwarf%20Sergeant%22%7D%2C%22children%22%3A%5B%5D%7D",
                    id: "Dwarf Sergeant",
                  },
                  {
                    tag: "message",
                    speaker: "Dwarf Sergeant",
                    text: _("What is a human doing here? Come on, boys, kill the intruder!"),
                  },
                ],
              },
              {
                tag: "case",
                equals: "monster",
                children: [
                  {
                    tag: "message",
                    text: _("No, it’s a... what is that?"),
                  },
                  {
                    tag: "hook",
                    name: "command:modify_unit",
                    facing: "se",
                    filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Dwarf%20Sergeant%22%7D%2C%22children%22%3A%5B%5D%7D",
                    id: "Dwarf Sergeant",
                  },
                  {
                    tag: "message",
                    speaker: "Dwarf Sergeant",
                    text: _("What in the earth’s guts is that? Kill it!"),
                  },
                ],
              },
            ],
          },
        ],
      },
