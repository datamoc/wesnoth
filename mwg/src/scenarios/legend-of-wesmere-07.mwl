                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Urug-Pir%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("I die without getting da stone?"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_35",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Eradion%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:play_music",
            file: "sad.ogg",
            play_once: "yes",
          },
          {
            tag: "message",
            text: _("Be grateful, tree-shagger, for I have spared you the pain of seeing your precious citadel burned and razed."),
          },
          {
            tag: "message",
            text: _("Galtrid, my friend. Do not let my death be in vain. Destroy these foul orcs, and sing for me in the green woods when we have won."),
          },
          {
            tag: "message",
            text: _("We shall avenge you tenfold!"),
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Eradion",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_36",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Eradion%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Dead he is. Too quick. His screams were sweet."),
          },
          {
            tag: "message",
            text: _("Let us pursue the orc who murdered $unit.name|!"),
          },
          {
            tag: "message",
            text: _("No, don’t leave your formation. An elf was slain by beast. What does it matter which beast it was? We must kill them all."),
          },
        ],
      },
