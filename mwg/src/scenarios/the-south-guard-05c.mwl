              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("It’s a deal."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_35",
          },
