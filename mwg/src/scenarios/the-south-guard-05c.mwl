              },
            ],
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("Look out, a troll! Stay back everyone, it might leave us alone if we keep our distance."),
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 14,
            ys: 7,
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "14,7",
            radius: 1,
          },
          {
            tag: "message",
            text: _("Who you? You dead one? I smash dead ones!"),
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 15,
            ys: 8,
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "15,8",
            radius: 1,
          },
          {
            tag: "message",
            text: _("Mmm... no, dead ones do not speak. You humans. Humanses long time no see."),
          },
          {
            tag: "message",
            text: _("Humanses... I remember humanses. Humans go squish, fun to smash! What you doing in caves?"),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("Err, no need for any squishing, we don’t mean to trespass on your territory. We’re hunting the undead and have no quarrel with you."),
          },
          {
            tag: "message",
            text: _("Deads! Nasty deads take our home, make us hide! I hates them! They too stupid to find us here, but we no leave here either."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("It seems that we have a common enemy, then. Would you like to join forces to defeat the undead? My soldiers aren’t well-suited to fighting in caves."),
          },
          {
            tag: "message",
            text: _("Join? Join with humanses? Hmm. Okay. Humans friends. No squish friends."),
          },
          {
            tag: "message",
            text: _("We help you beat deads, but after they gone we take back our home and you leave. Okay?"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: 3,
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 1,
