          {
            tag: "hook",
            name: "command:config_side",
            side: 2,
            gold: 60,
            income: 4,
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("I do not fear oblivion. There can be no horrors worse than that to which I have already been subjected. Even if taking vengeance on your race requires me to destroy myself, it will be worth the sacrifice!"),
          },
          {
            tag: "message",
            speaker: "Mebrin",
            text: _("For if I was wise before, I have now become omniscient! The race of man shall be stricken off the face of the green world. Your corpses will serve me! Your bones will dance for my pleasure! I’ll make humanity into the mindless slaves that you all deserve to be!"),
          },
        ],
      },
