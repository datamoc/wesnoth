        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Now, I must tell you of another character in our drama. Durstorn, the lord of dwarfdom. Or at least of this clan."),
          },
        ],
      },
      {
        tag: "event",
        id: "story_7",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("Durstorn was not happy this day. Nor was he usually; but today he was unhappier than usual."),
          },
        ],
      },
      {
        tag: "event",
