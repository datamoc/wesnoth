            unit: "Kuhnar",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 10,
            y: 14,
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Another day older, another foot stuck in the sludge! Let’s start with some soft clay... Rugnur, how goes it at the western gate?"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Durstorn",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "se",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Durstorn",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Durstorn",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "se",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Durstorn",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 300,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Durstorn",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "se",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("... ?"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Where’s that fool Rugnur? He should be here to report on events in the surface world. He’s late!"),
          },
          {
            tag: "message",
            speaker: "Noiraran",
            text: _("Perhaps the outpost was held up?"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Ha! There hasn’t been a border attack since the men came from over the sea, why would someone attack us now?"),
          },
          {
            tag: "message",
            speaker: "Kuhnar",
            text: _("The elves might want our gold."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Good one, let them try to take it! Ha!"),
          },
          {
            tag: "message",
            speaker: "Noiraran",
            text: _("What about that time the mines of North Knalga were invaded by ancient-looking undead liches?"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Ye had to bring that up now lad?! Speak not about the undead, lest ye summon them upon us."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Rugnur",
            x: 7,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Baglur",
            unit: "Baglur",
            x: 9,
            y: 9,
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("(whew!) Sorry I’m late, but King Haldric came by just now, wanted to talk to you..."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Speak properly to your elders, boy! Why are you late?"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Huh? Didn’t a messenger come and tell you?"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("No, what are you talking about?"),
          },
          {
            tag: "message",
            speaker: "Baglur",
            text: _("I think you’d better let me explain. King Haldric II of Wesnoth came to the gate. Then we had to close it, which took considerable time."),
          },
          {
            tag: "message",
            speaker: "Glinar",
            text: _("What’d he want? And why’d you have to close the gate?"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("He wanted to make a deal with us. He gave us a magical stone, called the ‘Ruby of Fire’, and told us to make a sceptre out of it, to keep in the bad magic, or something like that. We closed the doors because elves were attacking us."),
          },
          {
            tag: "message",
            speaker: "Kuhnar",
            text: _("Why were the elves attacking?"),
          },
          {
            tag: "message",
            speaker: "Noiraran",
            text: _("More important than that, what’d the king offer for this sceptre, eh?"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("He paid us five thousand silver in advance, and he’ll give us five thousand more when we deliver the finished sceptre if we are done before he dies."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("What?! You already accepted? Foolish boy, you should have come for one of the elders! We could have gotten much more than ten thousand silver out of him! This is a task that will take many years, and now all of our work in that time will bring us very little gain."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Sorry, lord, but he said he would move on to another clan if I left."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Can’t you tell a bluff when you hear one?! He knows we’re the best craftsmen, and he wouldn’t have gone to another clan if we stalled for a year. Oh well, what’s done is done. We’ll have to work for less than I would prefer..."),
          },
          {
            tag: "message",
            speaker: "Baglur",
            text: _("Well, since this boy bargained so badly, why not make him fulfill the contract himself? If he fails, it’s on his head."),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Good idea, Baglur! He’ll need some help, though, and it will take a master smith to make the sceptre. Why don’t we send him to find Thursagan?"),
          },
          {
            tag: "message",
            speaker: "Baglur",
            text: _("You mean the insane dwarf who lives in the far north?!"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Yes. He is the only one I know of who could craft the sceptre the way Haldric wants it, bad magic and all. And he has nothing to do; he will be fine with wasting 25 years of his life on this insane task."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Very well, my lord. We will go into the north to find Thursagan. Do you have any idea where he is?"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Go to the furthest north entrance to the caves, and then go north. He’s somewhere in those hills."),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Thank you, Lord. I’ll find him and do us proud!"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("Too late for that, young fool. But go on, I can see there’s hope for you yet."),
          },
          {
            tag: "set_variable",
            name: "changealanin.x",
            value: 2,
          },
          {
            tag: "set_variable",
            name: "changealanin.y",
            value: 5,
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "changealanin",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Alanin",
            x: 5,
            y: 8,
          },
          {
            tag: "message",
            speaker: "Alanin",
            text: _("What did I miss, eh?"),
          },
          {
            tag: "message",
            speaker: "Rugnur",
            text: _("Where have you been? Lord-"),
          },
          {
            tag: "message",
            speaker: "Durstorn",
            text: _("A friend of Rugnur, huh? ... Follow him north. He needs all the help he can get!"),
          },
          {
            tag: "win",
          },
        ],
      },
    ],
  },
]
