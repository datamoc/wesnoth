      {
        tag: "event",
        id: "ev_45",
        on: "scenario_end",
        once: true,
        children: [
          {
            tag: "filter_condition",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "kalenz_arrives",
          },
          {
            tag: "message",
            text: _("We won! The Ka’lian is safe!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "horse-canter.wav",
          },
          {
            tag: "spawn",
