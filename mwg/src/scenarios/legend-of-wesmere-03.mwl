          {
            tag: "spawn",
            id: "scout",
            type: "Elvish Scout",
            side: 1,
            x: 25,
            y: 17,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "scout",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "scout",
          },
          {
            tag: "message",
            text: _("The elvish treasury is under attack! They need help desperately!"),
          },
          {
            tag: "message",
            text: _("Galtrid, your men are weary from long combat. Mine are fresher; I’ll go."),
          },
          {
            tag: "message",
            text: _("Hurry! We were near overwhelmed as I left."),
          },
          {
            tag: "message",
            text: _("Yes, go, Kalenz, I’ll guard the Ka’lian till our army returns from the front."),
          },
        ],
      },
