        children: [
          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mentoring.webp",
            text: _("Their initial attack will be especially powerful, but they will continue reinforcing Asheviere every day or two until she is defeated — or we are."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            portrait: "portraits/delfador-mentoring.webp",
            text: _("Each wave of attackers will be ready to move and fight the instant they arrive, so we should be careful not to leave our soldiers exposed near the attackers’ entry points."),
