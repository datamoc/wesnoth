            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_attacker_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Thea%2CMaudie%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22id%22%3A%22Maudie%2CThea%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("My name is Thea Nicolin. You killed my brother! Prepare to die!!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_44",
        on: "branch_if_44",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.race",
            equals: "human",
          },
          {
            tag: "message",
            speaker: "Maudie",
            text: _("Get away from my ship, you low-born churl! You’re all just leeches! The Bay should be <i>mine</i>, not yours!"),
          },
        ],
      },
      {
        tag: "event",
        id: "if_45",
        on: "branch_if_45",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "unit.race",
            not_equals: "human",
          },
          {
            tag: "message",
            speaker: "Maudie",
            text: _("Get away from my ship, you filthy fish! You’re all just leeches! The Bay should be <i>mine</i>, not yours!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_46",
        on: "attack_end",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                any: "yes",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22id%22%3A%22Maudie%22%2C%22formula%22%3A%22(%20%24this_unit.hitpoints%3E0%20and%20%24this_unit.hitpoints%3C%24this_unit.max_hitpoints%2F2%20)%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Maudie",
            text: _("But you’re just a bunch of fish and smallfolk! It’s my right to rule! How— I mean... well, surely you can’t fault a girl for having ambition?"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_43",
        on: "attack_end",
        once: true,
        children: [
          {
            tag: "filter",
            unit: "Maudie",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_44",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_45",
          },
          {
            tag: "message",
            speaker: "Maudie",
            text: _("It belongs to me and my blood by right! My noble ancestors fought our way to the top, and we would have stayed there if those idiot kings hadn’t stolen it from us and given it to the merfolk instead."),
          },
          {
            tag: "message",
            speaker: "Thea",
            text: _("You’re talking about when the Bay was first awarded to the merfolk? But that was over three hundred years ago!"),
          },
          {
            tag: "message",
            speaker: "Maudie",
            text: _("And my line <i>has not forgotten</i>! It should have been <i>me</i> who inherited the pearls! _Eating caviar instead of hardtack, served by slaves instead of outlaws, living in a villa instead of a smelly, grungy, fish-smelling pirate ship... oh, I’m going to be seasick again..."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_48",
        on: "branch_if_48",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "second_unit.id",
            equals: "Thea",
