      {
        tag: "event",
        id: "if_83",
        on: "branch_if_83",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "s11_from_north",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Reglok",
            text: _("Information, child. There is a hidden ford on the southwest side of the city. Very few people know about it, least of all the orcs. I can show you how to cross."),
          },
          {
            tag: "message",
            speaker: "Reglok",
            text: _("Alternatively, we can lay in wait until you give us a signal then ambush the orcs’ rear. Expect $thief_count of us to join the attack."),
          },
          {
            tag: "dialogue",
