      {
        tag: "event",
        id: "story_6",
        on: "start",
        children: [
          {
            tag: "message",
            speaker: "narrator",
            text: _("The path back to the dwarven city was well known to the travelers this time, so the journey south was relatively quick and uneventful. A week’s march brought the expedition to the familiar plaza, with two new members of their party — one expected, and one not."),
          },
        ],
      },
