            unit: "u_5",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.canrecruit",
                value: "yes",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "seats",
            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22Rp%22%2C%22variable%22%3A%22seats%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
          },
          {
            tag: "foreach",
            variable: "seats",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_rand",
                variable: "random",
                values: "Drake Burner,Drake Burner,Drake Burner,Drake Burner,Drake Clasher,Drake Clasher,Drake Clasher,Drake Clasher,Drake Fighter,Drake Fighter,Drake Fighter,Drake Fighter,Drake Glider,Drake Glider,Drake Glider,Drake Glider,Fire Drake,Fire Drake,Drake Warrior,Drake Warrior,Drake Flare,Drake Flare,Drake Thrasher,Drake Thrasher,Drake Arbiter,Drake Arbiter,WoF Sky Drake,WoF Sky Drake,Drake Flameheart,Inferno Drake,Drake Enforcer,Drake Warden,Drake Blademaster,WoF Hurricane Drake",
              },
              {
                tag: "hook",
                name: "command:spawn_dynamic",
                type: "$random",
                side: 3,
                x: "$this_item.x",
                y: "$this_item.y",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
