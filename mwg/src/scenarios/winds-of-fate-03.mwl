        side: 1,
        x: 13,
        y: 5,
        name: _("Gorlack"),
      },
      {
        tag: "unit",
        id: "Karron",
        type: "Drake Blademaster",
        side: 2,
        x: 13,
        y: 33,
        name: _("Karron"),
      },
      {
        tag: "event",
        id: "hide_side_3",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:config_side",
            side: 3,
            hidden: "yes",
