      {
        tag: "event",
        id: "ev_3",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: 1,
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "s",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_side",
            side: 2,
            variable: "side_2",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Karron",
            text: _("Today, my old mentor, it is I that teaches <i>you</i>. You shall learn a pivotal lesson in humility!"),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("If just sharp as your tongue were your teeth."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_6",
        on: "branch_if_6",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "side.recruit",
            equals: "",
          },
          {
            tag: "set_variable",
            name: "recruit",
            value: "",
          },
          {
            tag: "hook",
            name: "command:config_recruit",
            side: "$unit.side",
            mode: "allow",
            types: "$recruit",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_5",
        on: "recruit",
        once: false,
        children: [
          {
            tag: "hook",
            name: "command:config_recruit",
            side: "$unit.side",
            mode: "disallow",
            types: "$unit.type",
          },
          {
            tag: "hook",
            name: "command:set_variables",
            payload: "%7B%22name%22%3A%22%24unit.side%7C_recruit%22%2C%22mode%22%3A%22append%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22value%22%2C%22attributes%22%3A%7B%22type%22%3A%22%24unit.type%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "hook",
            name: "command:store_side",
            side: "$unit.side",
            variable: "side",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_6",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gorlack%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "$unit.id",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.hitpoints",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Karron%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "$unit.id",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.hitpoints",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "leader_kill",
            value: "yes",
            mode: "value",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "last_breath",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22id%22%3A%22Gorlack%2CKarron%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:put_to_recall_list",
            id: "$unit.id",
            filter: "%7B%22tag%22%3A%22put_to_recall_list%22%2C%22attributes%22%3A%7B%22id%22%3A%22%24unit.id%22%2C%22heal%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D",
            heal: "yes",
          },
        ],
      },
      {
        tag: "event",
        id: "if_11",
        on: "branch_if_11",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "side_1.num_villages",
            greater_than: "$side_2.num_villages",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "time_over",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_side",
            side: 1,
            variable: "side_1",
          },
          {
            tag: "hook",
            name: "command:store_side",
            side: 2,
            variable: "side_2",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_11",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "defeat",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Vladnir",
            text: _("Karron has ascended to the rank of dominant. The flight-in-contention is hereby entrusted to Dominant Karron’s keeping."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("This must be a dream. I no longer dwell in the shadow of Gorlack."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_14",
        on: "branch_if_14",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "leader_kill",
            equals: "yes",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("For winning by defeating the rival leader, you receive war claws!"),
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%7B%22applyTo%22%3A%22attack%22%2C%22range%22%3A%22melee%22%2C%22increaseDamage%22%3A4%7D%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Gorlack",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "victory",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Vladnir",
            text: _("Gorlack has ascended to the rank of dominant. The flight-in-contention is hereby entrusted to Dominant Gorlack’s keeping."),
          },
          {
            tag: "message",
            speaker: "Karron",
            text: _("........."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Drakes! Fellows of all castes, hear me! This is a dark time in which we endure. Our lands provide not as once they did. Unfed hatchlings succumb to the wasting. A war among us hastens. Worse than these all— your hearts bleed fear!"),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("This hope I offer you. There are lands beyond Morogor. Beyond its troubles. This oath I swear you. I shall lead you to the way beyond. With my new flight, I proceed to the far lands to plant my eyrie!"),
          },
          {
            tag: "message",
            speaker: "Vladnir",
            text: _("So it begins..."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Upon the greatest of all lands my eyrie will stand. The Greatland of the east!"),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Await my summons. For it will be your salvation!"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_14",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "scenario_end",
        once: true,
      },
    ],
  },
]
