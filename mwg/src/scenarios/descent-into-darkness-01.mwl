            value: 13,
          },
        ],
      },
      {
        tag: "objectives",
        side: 1,
        victory: _("Defend the river fort for two nights Kill the orcish leader"),
        defeat: _("Orcs reach the outskirts of Parthyn Death of Malin Keshar Death of Dela Keshar Death of Drogan"),
      },
      {
        tag: "event",
        id: "ev_1",
        on: "prestart",
