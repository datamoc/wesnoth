            y: 14,
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("A monolith of pale stone, luminous and bright, but cold and brittle to the touch."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "monolith",
            value: 1,
            mode: "add",
          },
          {
            tag: "hook",
