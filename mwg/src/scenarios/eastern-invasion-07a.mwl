            unit: "Dolburras",
            x: 28,
            y: 19,
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Look, this valley is inhabited by a tribe of ogres. They do not seem very bright..."),
          },
          {
            tag: "message",
            text: _("Guh... human? Human come! Run!"),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("Excellent, a source of slaves. If we surround and capture them, we can use them for risky missions and preserve our more valuable soldiers."),
          },
          {
            tag: "message",
            speaker: "Owaec",
            text: _("Slaves?! No, these shall be great warriors fighting alongside us! My Clansmen shall capture them one by one."),
          },
        ],
