              {
                tag: "case",
                equals: 1,
                children: [
                  {
                    tag: "message",
                    speaker: "Gweddry",
                    text: _("Taking slaves just doesn’t feel right. I only captured one."),
                  },
                  {
                    tag: "message",
                    speaker: "Dacyn",
                    text: _("Unfortunate, but at least we have one. Ogres are unskilled fighters but much cheaper to equip than our other soldiers, and thus <i><b>cost much less gold to recall.</b></i>"),
                  },
                ],
              },
              {
                tag: "case",
                equals: 2,
