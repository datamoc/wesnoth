            children: [
              {
                tag: "hook",
                name: "command:set_variables",
                payload: "%7B%22name%22%3A%22camp_event%22%2C%22mode%22%3A%22replace%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22value%22%2C%22attributes%22%3A%7B%22name%22%3A%22capture%22%2C%22first_time_only%22%3A%22yes%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%22%2C%22x%22%3A%22%24this_item.x%22%2C%22y%22%3A%22%24this_item.y%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22if%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22unit.side%22%2C%22not_equals%22%3A%224%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22then%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22set_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22random%22%2C%22rand%22%3A%22Walking%20Corpse%2CSoulless%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22unit%22%2C%22attributes%22%3A%7B%22side%22%3A%22%24%7Cunit.side%22%2C%22type%22%3A%22%24%7Crandom%22%2C%22x%22%3A%22%24%7Cx1%22%2C%22y%22%3A%22%24%7Cy1%22%2C%22generate_name%22%3A%22yes%22%2C%22random_traits%22%3A%22no%22%2C%22random_gender%22%3A%22yes%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22gold%22%2C%22attributes%22%3A%7B%22amount%22%3A%2220%22%2C%22side%22%3A%22%24%7Cunit.side%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22set_variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22elven_camps%22%2C%22sub%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22if%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22elven_camps%22%2C%22equals%22%3A%225%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22then%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22Kaleh%22%2C%22message%22%3A%22Too%20many%20of%20our%20people%20have%20been%20killed.%20We%20will%20surely%20be%20overwhelmed%20by%20the%20undead%20now.%20All%20is%20lost!%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22endlevel%22%2C%22attributes%22%3A%7B%22result%22%3A%22defeat%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "recruit",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_recruit_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%222%2C3%2C4%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "min_experience",
            value: "$(floor($unit.max_experience * 0.5))",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_rand",
            variable: "random",
            values: "$min_experience..$($unit.max_experience - 1)",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "unit.experience",
            value: "$random",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "unit",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
          {
            tag: "message",
            speaker: "Garak",
            text: _("These champions... I will challenge them. Zhul, bless my weapons with light of Eloh."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("Garak, but the suns..."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("You will not do any such thing, anyone trying to fight these creeps singlehanded will surely die. We need you, we will not make it without you."),
          },
          {
            tag: "message",
            speaker: "Garak",
            text: _("I had a dream this night Kaleh, full of gloom and darkness. My journey will end here one way or another."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("No! That’s not true, our future is what we make of it, stay behind for this fight and..."),
          },
          {
            tag: "message",
            speaker: "Garak",
            text: _("And what? You’ll help me become a coward? I lived long, I’m not afraid of the end, just let me give it some meaning."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("I bless you with the light that will come, I bless you with the memory and the promise. Lay down your shield, champion, and let your blade shine in the dark."),
          },
          {
            tag: "hook",
