      {
        tag: "event",
        id: "ev_49",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("He’s taken the bait. Quick, get down into the mines and alert the others."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_50",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_51",
          },
          {
            tag: "message",
            speaker: "knight",
            text: _("What about the prisoners, m’lady? Shall we execute them before the imposter arrives?"),
          },
          {
            tag: "message",
            speaker: "Ulfdain",
            text: _("C’mere and try it, ye yellow-bellied, cow-handed blunderbuss of a princess! Jus’ gimme the chance an’ I’ll rip that head right off yer ninnyhammerin’ neck, ye white-livered gasser!"),
          },
          {
            tag: "message",
            speaker: "Lisar",
            text: _("As tempting as the thought may be, Raery, I’m not about to kill innocents in cold blood. But we do need to get the dwarves out of here — both for their own safety and to keep them out of the rebels’ hands."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Elite Duelist",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_52",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 33,
            y: 8,
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Elite Fencer",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_53",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Elite Longbowman",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_54",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "generic_unitc",
            value: "Elite Heavy Infantryman",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_55",
          },
          {
            tag: "message",
            text: _("Too late, Konrad has come! Forget the prisoners and prepare for battle."),
          },
          {
            tag: "hook",
            name: "command:micro_ai",
            side: 2,
            ai_type: "wolves",
            action: "add",
            filter: "%7B%22role%22%3A%22squad%22%7D",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_56",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_57",
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-mad.webp",
            text: _("I’ve come to face you, princess! Only a true villain would threaten innocents to force someone into a fight."),
          },
          {
            tag: "message",
            speaker: "Lisar",
            portrait: "portraits/lisar-mad.webp",
            text: _("Oh please, the dwarves were never in any danger. You on the other hand, “prince” — I will not allow you to sow any more discord and chaos among my people. Your rebellion ends here."),
          },
        ],
      },
