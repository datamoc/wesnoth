      {
        tag: "event",
        id: "ev_66",
        on: "explain_prisoners",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Here are the prisoners! We can set them free, but if they join our side they will certainly come under attack."),
          },
          {
            tag: "message",
            speaker: "Ulfdain",
            text: _("Come an’ git some, ye nigmenog bolting-hutch of beastliness! Ah dare ye to square up an’ fight me, dwarf-to-dwarf!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Wait a minute! I don’t want to fight you. I’m here to rescue you!"),
          },
          {
            tag: "message",
            speaker: "Ulfdain",
            text: _("Oh, what’s that? Seems ah misjudged ye, son. Hurry up then, ye spoony cub, lemme an’ my boys out o’ these here cages so we can get to th’ fight!"),
          },
        ],
      },
