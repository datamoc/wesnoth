          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("You’re free now! How did you come to be imprisoned?"),
          },
          {
            tag: "message",
            speaker: "Ulfdain",
            text: _("Much better, thank ye for freein’ us! Tha’s the last time I dig a mine for yer human queen, lemme tell you. “Clean up the old crossroads mines”, she says. “The princess needs ’em for somethin’!”"),
          },
          {
            tag: "message",
            speaker: "Ulfdain",
            text: _("All we do is insult th’ queen a few times, all friendly-like and such, an’ it was straight to the gibbet! You beanpoles jus’ dinnae appreciate a good insult!"),
          },
          {
            tag: "message",
            speaker: "Ulfdain",
            text: _("An’ now tha’s my job gone; guess I got naught left fer me now but revenge. So if yer out to beat the queen, me an’ my boys are with ye!"),
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Konrad",
          },
          {
            tag: "hook",
            name: "command:allow_extra_recruit",
            id: "Konrad",
            types: "Dwarvish Miner",
          },
        ],
      },
