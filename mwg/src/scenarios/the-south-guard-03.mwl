          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("<span color=' <<'> + _If you have high-XP survivors from previous battles, remember to press <b>Alt+R</b> and recall them so they can continue gaining experience and be promoted to higher levels.</span>"),
          },
