      {
        tag: "event",
        id: "ev_91",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "leader2",
            text: _("Get lost, you troll-sniffing degenerates!"),
          },
          {
            tag: "message",
            speaker: "leader4",
            text: _("Khazg-worshipping tuskers! We come to trade and this is how you greet us? Some hospitality."),
          },
          {
            tag: "message",
            speaker: "leader2",
            text: _("Trade? You came here to sneak inside and slaughter us all in our sleep! I’m not having it. Get lost!"),
          },
          {
            tag: "message",
            speaker: "leader4",
            text: _("Oh yeah? Well— ...wait, do you see that?"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_92",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_93",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_94",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_konrad_units",
            kill: "no",
            side: 1,
          },
          {
            tag: "set_variable",
            name: "konrad_humans",
            value: 0,
          },
          {
            tag: "set_variable",
            name: "konrad_elves",
            value: 0,
          },
          {
            tag: "set_variable",
            name: "konrad_merfolk",
            value: 0,
          },
          {
            tag: "set_variable",
            name: "konrad_dwarves",
            value: 0,
          },
          {
            tag: "set_variable",
            name: "konrad_other",
            value: 0,
          },
          {
            tag: "foreach",
            variable: "stored_konrad_units",
            item: "this_item",
            children: [
              {
                tag: "switch",
                variable: "unit.race",
                children: [
                  {
                    tag: "case",
                    equals: "human",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "konrad_humans",
                        value: "$unit.cost",
                        mode: "add",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "elf",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "konrad_elves",
                        value: "$unit.cost",
                        mode: "add",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "merman",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "konrad_merfolk",
                        value: "$unit.cost",
                        mode: "add",
                      },
                    ],
                  },
                  {
                    tag: "case",
                    equals: "dwarf",
                    children: [
                      {
                        tag: "hook",
                        name: "command:set_variable_dynamic",
                        variable: "konrad_dwarves",
                        value: "$unit.cost",
                        mode: "add",
                      },
                    ],
                  },
                ],
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_95",
