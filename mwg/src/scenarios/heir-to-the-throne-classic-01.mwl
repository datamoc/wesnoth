          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: 0,
            y: 0,
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Very well, we have made it this far! But where do we go next?"),
          },
          {
            tag: "message",
