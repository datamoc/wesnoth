            time: 500,
          },
          {
            tag: "spawn",
            id: "Deoran",
            type: "Cavalryman Commander",
            side: 1,
            x: 16,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Deoran",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Deoran",
          },
          {
            tag: "message",
            speaker: "Deoran",
            portrait: "portraits/deoran-glad.webp",
            text: _("Lieutenant Deoran, reporting for duty SIR! ...err, ma’am."),
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("Relax, Lieutenant. Fresh from the academy, are we?"),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("Yes ma’am. —sir. And as His Majesty ordered, I’ve brought with me a contingent of fresh soldiers to reinforce Westin’s faltering South Guard!"),
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("I’m Mari. Got the same orders as you; guess someone wanted an officer with experience to keep an eye on you and your “fresh” company. Can’t imagine why."),
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("Well, orders are orders. Come on over here, Deoran — let’s get a closer look at you."),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Deoran",
                text: _(""),
              },
              {
                tag: "choice",
                text: _("On my way!"),
                event: "ev_5_opt0",
              },
              {
                tag: "choice",
                text: _("I know what I’m doing. (Skip tutorial)"),
                event: "ev_5_opt1",
              },
            ],
          },
        ],
      },
