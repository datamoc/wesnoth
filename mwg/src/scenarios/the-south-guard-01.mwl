          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "quintain",
          },
          {
            tag: "spawn",
            id: "quintain",
            type: "Quintain",
            side: 3,
            x: 9,
            y: 3,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "quintain",
          },
          {
            tag: "message",
            speaker: "Deoran",
            portrait: "portraits/deoran-mad.webp",
            text: _("Hey, this quintain fights back! I’m not about to lose to a dummy — let me attack again!"),
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("Nice try, but you already used up your chance to attack. Now it’s the <i>quintain’s</i> turn to act."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("The <i>dummy</i> gets a turn?"),
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("Why not? It’s a magical quintain, on loan from the wizards’ academy at Alduin. It strikes twice per attack, and will sting something fierce if it hits you. Brace yourself!"),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("<span color=' <<'> + _To end your turn, click the <b>“End Turn”</b> button in the bottom-right corner of the screen, or press <b>Ctrl+Space</b>.</span>"),
          },
        ],
      },
      {
        tag: "event",
