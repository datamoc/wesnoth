      {
        tag: "event",
        id: "ev_9",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            x: 10,
            y: 4,
          },
          {
            tag: "hook",
            name: "command:remove_item",
            x: "",
            y: "",
            item_name: "",
            image: "arrow",
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("<i>(Bows)</i> A pleasure to make your acquaintance, Captain."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("<span color=' <<'> + _Wondering about those percentages that appear on the ground when you move a unit? That’s your soldiers’ terrain defense — their <i><b>chance to evade</b></i> enemy attacks.</span>"),
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("Amazing, you know how to ride your horse. Now let’s see if you know how to swing your sword."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "stored_mari",
            kill: "yes",
            id: "Mari",
          },
          {
            tag: "spawn",
            id: "quintain",
            type: "Quintain",
            side: 3,
            x: 9,
            y: 3,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "quintain",
          },
          {
            tag: "hook",
            name: "command:unstore_unit",
            variable: "stored_mari",
            x: 9,
            y: 5,
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("Behold!"),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("...a quintain? You want me to attack a practice dummy?"),
          },
          {
            tag: "message",
            speaker: "Mari",
            text: _("You have fifty pounds of armor and a horse, rookie. I’m fairly sure you’ll win."),
          },
          {
            tag: "hook",
            name: "command:add_item",
            x: 11,
            y: 5,
            item_name: "arrow",
            image: "misc%2Fhighlight-hex.png",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23",
        on: "attack_end",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
            id: "quintain",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "hitpoints",
            value: "$STORE_UNIT_VAR_store.hitpoints",
            mode: "value",
