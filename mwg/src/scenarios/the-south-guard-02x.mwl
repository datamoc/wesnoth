          {
            tag: "spawn",
            id: "Sir_Gerrick",
            type: "Veteran Infantryman",
            side: 1,
            x: 28,
            y: 9,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Sir_Gerrick",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Sir_Gerrick",
          },
          {
            tag: "hook",
