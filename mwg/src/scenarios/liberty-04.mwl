      {
        tag: "event",
        id: "ev_37",
        on: "turn_refresh",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 4,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Harper",
            text: _("Them things look like evil spirits! Are they those undead you told me about, Uncle?"),
          },
          {
            tag: "message",
            speaker: "Baldras",
            text: _("They bears some likeness, but these men almost seem half alive. This be some kind of truly dreadful sorcery."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_38",
        on: "turn_refresh",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 7,
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Lord Maddock",
            text: _("So, their human aspect returns. Whatever these creatures are, we shall crush them all under the light of the sun."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_40",
        on: "branch_if_40",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_condition_tree",
                tree: "%7B%22tag%22%3A%22have_location%22%2C%22attributes%22%3A%7B%22time_of_day_id%22%3A%22dawn%2Cmorning%2Cafternoon%22%7D%2C%22children%22%3A%5B%5D%7D",
