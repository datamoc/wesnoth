          },
        ],
      },
      {
        tag: "event",
        id: "ev_19",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_attacker_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22race%22%3A%22bats%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Ack! Get away from me!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_20",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "0-7",
            y: "4-7",
          },
          {
            tag: "message",
            text: _("This tunnel seems to go deeper into the caves. We can’t go that way."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_22",
        on: "new_turn",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "escapee sidekick 0",
            text: _("How do we know these caves aren’t all dead ends? We might be stuck wandering until we die of thirst!"),
          },
          {
            tag: "message",
            speaker: "escapee leader",
            text: _("You’re welcome to go back to your cell."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_21",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 8,
            y: 8,
          },
        ],
      },
      {
        tag: "event",
        id: "ev_24",
        on: "new_turn",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "escapee sidekick 2",
            text: _("Even if we do find your commanders and escape, maybe we should consider staying in the north? It’s tranquil, and quiet.... and there’s no undead..."),
          },
          {
            tag: "message",
            speaker: "escapee sidekick 0",
            text: _("I didn’t come all this way just to give up at the words of a deserter!"),
          },
          {
            tag: "message",
            speaker: "escapee leader",
            text: _("Let’s focus on escaping the orcs before worrying about the future. Now quiet, I smell something foul up ahead."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_23",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
