      {
        tag: "event",
        id: "ev_13",
        on: "start",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:config_side",
            side: 2,
            controller: "null",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("Several of Gweddry’s men find themselves locked away in a crude orcish cell."),
          },
          {
            tag: "message",
            speaker: "escapee sidekick 1",
            text: _("We’ve got to get out of here!"),
          },
          {
            tag: "message",
            speaker: "escapee sidekick 2",
            text: _("I’m sure your commanders will come and save us!"),
          },
          {
            tag: "message",
            speaker: "escapee sidekick 0",
            text: _("What? Didn’t you see those huge orcs drag them away? It’s hopeless!"),
          },
          {
            tag: "message",
            speaker: "escapee leader",
            text: _("Be quiet, you three! There’s something back here..."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 21,
            y: 2,
          },
          {
            tag: "message",
            speaker: "escapee leader",
            text: _("Look! There’s a gap in the wall over here. I think I can slip through if I clear away some of these rocks..."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "cave-in.ogg",
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Uu^Dr",
            cells: "20,2",
          },
          {
            tag: "message",
            speaker: "escapee leader",
            text: _("Come on! This way!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "",
            x: 20,
            y: 2,
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "23-24",
            y: 4,
          },
          {
            tag: "message",
            text: _("The door won’t open from this side."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "new_turn",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "STORE_UNIT_VAR_store",
            kill: "no",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "deserter_name",
            value: "$STORE_UNIT_VAR_store.name",
            mode: "value",
          },
          {
            tag: "message",
            speaker: "escapee sidekick 1",
            text: _("$deserter_name, I don’t recognize you, and you look like you’ve been locked up longer than the rest of us. How did you get here?"),
          },
          {
            tag: "message",
            speaker: "escapee sidekick 2",
            text: _("When the undead burned Tath, I got... lost. I have family up north, but I didn’t even get across the ford before some orcs captured me. They marched me and many other slaves east along the river, until we arrived here."),
          },
          {
            tag: "message",
            speaker: "escapee leader",
            text: _("(scowling) A deserter. We should lock you back in your cell."),
          },
          {
            tag: "message",
            speaker: "escapee sidekick 2",
            text: _("No, please, you don’t understand! The undead are everywhere! I didn’t want to die like all my friends..."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_15",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 15,
            y: "2-3",
          },
        ],
      },
