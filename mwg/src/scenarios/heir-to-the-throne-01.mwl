          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("I’m here, Delfador! I thought you were calling me for more training, but there’s smoke rising from the forest. What’s going on?"),
          },
          {
            tag: "message",
            speaker: "Ethiliel",
            portrait: "portraits/ethiliel-mad.webp",
            text: _("Trouble from your Queen Asheviere, child! She knows that we sheltered you throughout your youth. Now she comes bearing fiery retribution, and the dawn of a dark age for the Aethenwood."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I have already been injured. I fear she is after you personally, Master Konrad!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("They have us nearly surrounded, but we can still flee to the west. I will protect you!"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-concerned.webp",
            text: _("But what about the elves? They are our friends! We have to help fight!"),
          },
          {
            tag: "message",
            speaker: "Galdrad",
            text: _("Asheviere is all of our enemy. We will fight the invaders, but you must escape, Konrad. Lord Kalenz has commanded your safety. It is imperative that you escape!"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Galdrad is right. Do not throw your life away so easily, Your Highness."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("There can be no looking back. We must go quickly!"),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: 9,
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 1,
              },
              {
                tag: "hook",
