          {
            tag: "message",
            speaker: "Gorlack",
            text: _("Our haul is too heavy to be flown with a dozen trips. We must not forsake it. Too much depends on it."),
          },
          {
            tag: "message",
            speaker: "Arinexis",
            text: _("Through thisss cave! Essscape through here..."),
