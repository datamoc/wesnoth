      {
        tag: "event",
        id: "ev_15",
        on: "sighted",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_sighted_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type_adv_tree%22%3A%22Lich%2C%20Draug%2C%20Banebow%2C%20Revenant%2C%20Deathblade%2C%20Death%20Knight%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_seer_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "$unit.id",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1500,
          },
          {
            tag: "message",
            text: _("Such a sickly looking creature."),
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("That is a ssskeletoid — humans’ true and ssstrongessst form. Every human that dies sssomeday rises again as one of those."),
          },
          {
            tag: "message",
            speaker: "Arinexis",
            text: _("Unlesss you burn, crush or eat the bones firssssst. Never leave the bones!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "moveto",
        once: false,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 8,
            y: 19,
          },
          {
            tag: "message",
            speaker: "narrator",
            text: _("Lodestane Mines of Gyldanwolf Clan Year of Wirk 368, 7th Month They elves wur back in the mushroom croft again, making dolly threats tae the laddies in that fancy tongue of thairs. Said thay wid attack if we gather ony mair wood tae feed oor mushrooms, it does nae even maiter if it be juist the pine! Hud the laddies pat up gates tae keep they elves oot fur now. If thay dae come back with an airmie we cannae handle, we hae flashpowder kegs aroond the load bearing walls. They elves ur sae impressed with that cute “magic” of thairs— think of the looks oan thair faces whin thay see dwarven kencraft at wirk! Still, oor woodcutters cannae harvest ony mair mushroom fodder oot of the forest withoot elves chipping away at thaim and the lodestane mines ur nearly tae the end of thair veins. Mibbie ah shuid trade this cave tae that streenge “lich” cratur efter all. Whit ever it be ah dae nae care; if the elves ever come back then thay kin deal with it."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 8,
            y: 19,
          },
          {
            tag: "hook",
            name: "command:modify_unit",
            experience: "$($unit.experience + 24)",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22%24unit.id%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "$unit.id",
          },
          {
            tag: "set_variable",
            name: "amount",
            value: 24,
          },
        ],
      },
      {
        tag: "event",
        id: "see_lich",
        on: "sighted",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_sighted_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Lich-Lord%20Selmar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_seer_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Lich-Lord Selmar",
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "",
            ys: "",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 1500,
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("Come to test your luck again, Khrakrahs?"),
          },
          {
            tag: "message",
            speaker: "Zedrix",
            text: _("It is to his ssstronger brother, Shek’kahan, that you ssspeak!"),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("So much the better then. Ah, and he has brought many friends, I see. You shall all make fine additions to my new legion. The only question is — will you serve willingly?"),
          },
          {
            tag: "message",
            speaker: "Arinexis",
            text: _("We sssaurians will never ssserve the likesss of a human monssster or your elf massstersss!"),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("Elf masters? Foolish little toad, I have not crossed half this world at the summons of mere tree-lords. They have something that should be mine and I am here to claim it. With the coming of the new moon, my portal to the land of the giants will open and its outpouring deluge shall sweep the elves from Wesmere. No living thing will remain standing between me and the Ruby of Fire."),
          },
          {
            tag: "message",
            speaker: "Arinexis",
            text: _("You hatched your plan too late, human. We already sssacked Wesssmere, the elves are dealt with."),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("You could never have done such a feat with even tenfold your motley warband. Wait... what is all that clamour behind you...?"),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("Fools, you have led the entire host of Wesmere to this secluded place! My plan will become clear to them if they so much as glimpse my unfinished portal with their faerie sight."),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("The Faerie... You say those things that pursue us are ‘Faerie’. That is a fearsome word known from even our oldest Memories. Tell us its full meaning."),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("It is a thing far beyond your crude comprehension; a world of powerful magics with minds all their own. And right now, you have their full attention, so begone! Leave the way you came and they may yet follow you away from my lair!"),
          },
          {
            tag: "message",
            speaker: "Resha",
            text: _("Gorlack, it is an ancient foe that hunts us. You must get our flight through this mountain at any cost."),
          },
          {
            tag: "message",
            speaker: "Gorlack",
            text: _("I shall have passage through this mountain. You are advised to move aside."),
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("Proceed any further and you shall pass only to the land of the dead, where I am lord and master."),
          },
          {
            tag: "message",
            speaker: "Arinexis",
            text: _("<i>*flicks tongue*</i> Dragonsss! Gate behind talking boness ssmellsss of fresh air. That isss way through mountain. We mussst break through that gate! With hassste, dragonsss!"),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 30,
            y: 0,
          },
        ],
      },
      {
        tag: "event",
        id: "ev_18",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Lich-Lord%20Selmar%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Lich-Lord Selmar",
            text: _("You fire breathing meddlers are a nuisance in any century. A curse upon you all, may your worst plans reach fruition so your descendants remember you with shame!"),
          },
          {
            tag: "hook",
            name: "command:heal_unit",
            amount: "full",
            restore_statuses: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Lich-Lord%20Selmar%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Lich-Lord Selmar",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Lich-Lord Selmar",
            x: 28,
            y: 6,
          },
          {
            tag: "hook",
            name: "command:scroll_to_unit",
            id: "Lich-Lord Selmar",
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Lich-Lord Selmar",
          },
          {
            tag: "hook",
            name: "command:teleport",
            id: "Lich-Lord Selmar",
            x: 1,
            y: 1,
            to_x: 0,
            to_y: 0,
          },
