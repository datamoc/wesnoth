                children: [
                  {
                    tag: "message",
                    text: _("This fighter is injured now, but he is willing to join us for our next battle."),
                  },
                ],
              },
              {
                tag: "case",
                equals: 3,
                children: [
                  {
                    tag: "message",
                    text: _("Konrad, I have convinced this fighter to join us in our next battle."),
                  },
                ],
              },
              {
                tag: "case",
                equals: 4,
                children: [
                  {
                    tag: "message",
