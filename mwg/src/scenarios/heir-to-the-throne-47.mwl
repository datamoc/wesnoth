      {
        tag: "event",
        id: "ev_172",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 3,
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("This is sheer madness. We cannot afford to wage war against these clansmen when we should be marching against the Queen..."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-mad.webp",
            text: _("Lord Bayar, halt this folly! I challenge you to a personal combat."),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("Ho! You have amused me, young heir. Ho, ho, challenge indeed."),
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-mad.webp",
            text: _("Young heir? Then you assent to my claim?"),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("Impudence. Bah! Do you see orcs on our plains? Did we not grant you a test of your strength?"),
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("This is hardly a test. Our battle serves only to spill needless blood and weaken us both."),
          },
          {
            tag: "message",
            speaker: "Bayar",
            text: _("No, whelp. You may be weakened, but the horse clans are eternal. _ I will promise you this, however. If your forces can defeat me personally, I myself will join your cause."),
          },
          {
            tag: "message",
            speaker: "Ruga",
            text: _("Aye."),
          },
          {
            tag: "message",
            speaker: "Daryn",
            text: _("Aye."),
          },
          {
            tag: "message",
            speaker: "Alric",
            text: _("Aye."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "explained_bonus_objective",
            value: "yes",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:show_objectives",
          },
        ],
      },
