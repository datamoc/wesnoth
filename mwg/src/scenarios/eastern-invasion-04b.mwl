      {
        tag: "event",
        id: "ev_71",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Hahid%20al-Ali%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Alas, my long, storied, and exceedingly profitable career has come to an end! Perhaps Safyam was right about the dangers of this place..."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Hahid al-Ali",
          },
          {
            tag: "message",
            speaker: "Safyam",
            text: _("My master has perished! It has been too many years since any of us have seen our homeland; we will return to mourn his passing."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "dunefolk_leave",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_72_opt0",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "give_full_gold",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_72_opt1",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "give_no_gold",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_72_opt2",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "give_extra_gold",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_72",
        on: "herbs_collected",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Ho ho, that’s all the herbs I need! Now if you’ll give me those $gold_cost gold pieces you promised, I’d be happy to point you in the direction of that undead fortress."),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("Even if we do manage to find them, how do you expect us to defeat the undead in the very heart of their territory? I have already told you that this foe is far beyond anything we can face alone. Confronting this menace with the few soldiers we have would be foolish."),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Gweddry",
                text: _(""),
              },
              {
                tag: "choice",
                text: _("Give Hahid $gold_cost gold; assault the undead fortress. <i>(challenging)</i>"),
                event: "ev_72_opt0",
              },
              {
                tag: "choice",
                text: _("Give Hahid nothing; return westward towards Wesnoth. <i>(normal)</i>"),
                event: "ev_72_opt1",
              },
              {
                tag: "choice",
                text: _("Give Hahid $gold_extra gold."),
                event: "ev_72_opt2",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "if_74",
        on: "branch_if_74",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "gold",
            less_than: "$gold_cost",
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("I’m afraid you don’t have the $gold_cost gold to pay for my information, so I must be off. Best of luck with that ‘Mal-Skraat’ you’re fighting!"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "dunefolk_leave",
          },
        ],
      },
      {
        tag: "event",
        id: "if_75",
        on: "branch_if_75",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "gold",
            greater_than_or_equal_to: "$gold_cost",
          },
          {
            tag: "hook",
            name: "command:modify_gold",
            side: 1,
            amount: "-$gold_cost",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gold.ogg",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Hahid al-Ali",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 4,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Safyam",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 4,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("If the threat is as grave as you say, I believe we must take advantage of our position behind the undead lines. Even outnumbered, we may still be able to disrupt their plans and cause some mischief within their city."),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("...so the great Gweddry intends to do what all of Wesnoth cannot. Very well. I cannot return to Wesnoth on my own, so it seems I have little choice but to join you in your folly."),
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "fork_04c",
            value: "yes",
            mode: "value",
          },
          {
            tag: "set_variable",
            name: "__next_scenario",
            value: "eastern-invasion-04c",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_73",
        on: "give_full_gold",
        once: false,
        children: [
          {
            tag: "hook",
            name: "command:store_gold",
            side: 1,
            variable: "gold",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_74",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_75",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_76",
        on: "give_no_gold",
        once: false,
        children: [
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("I heed Dacyn’s advice on this. Our armies are not strong enough to travel east."),
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Suit yourself! Now that I have what I need, it’s high time my friends and I returned to the Ashland."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "dunefolk_leave",
          },
          {
            tag: "hook",
            name: "command:modify_turns",
            add: 10,
          },
        ],
      },
      {
        tag: "event",
        id: "if_78_opt0",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "give_full_gold",
          },
        ],
      },
      {
        tag: "event",
        id: "if_78_opt1",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:fire_event",
            event: "give_no_gold",
          },
        ],
      },
      {
        tag: "event",
        id: "if_78",
        on: "branch_if_78",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "gold",
            less_than: "$gold_extra",
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Ho ho, very funny, for a moment I thought you meant it! But really now, do you want my information or not?"),
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                speaker: "Gweddry",
                text: _(""),
              },
              {
                tag: "choice",
                text: _("Give Hahid $gold_cost gold; assault the undead fortress. <i>(challenging)</i>"),
                event: "if_78_opt0",
              },
              {
                tag: "choice",
                text: _("Give Hahid nothing; return westward towards Wesnoth. <i>(normal)</i>"),
                event: "if_78_opt1",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "if_79",
        on: "branch_if_79",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "gold",
            greater_than_or_equal_to: "$gold_extra",
          },
          {
            tag: "hook",
            name: "command:modify_gold",
            side: 1,
            amount: "-$gold_extra",
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gold.ogg",
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("What the-? You’re serious!? Well, forget herbalism, I need to find out more about this mystical land where men pay thrice what they owe!"),
