          {
            tag: "hook",
            name: "command:modify_unit",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Safyam%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Safyam",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%7B%22applyTo%22%3A%22status%22%2C%22remove%22%3A%22poisoned%22%7D%5D%2C%22abilities%22%3A%5B%5D%7D",
            status_unpoisonable: "yes",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Thanks to my cure made from this marvelous herb, she is now immune to the swamp’s ill humours! With more, I can make an antitoxin strong enough to cure the draught of death itself!"),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("If we help you find more of this ‘alswdan’, will you share your cure with us? Our people have been attacked by undead and we must now fight this dark sorcerer to return home."),
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Ho ho, a haggler after my own heart! I don’t see why not. But if these undead are giving you such trouble, why not strike them in their capital? Safyam spotted it not far east of here. I want nothing to do with them of course, but I’m sure you military-minded folk would have no trouble storming their walls."),
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("If you can find enough alswdan and pay a small fee, I’d be happy to inoculate all of your men and point you in the direction of the undead fortress."),
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Hahid al-Ali",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
