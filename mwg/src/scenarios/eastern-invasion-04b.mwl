            id: "Dacyn",
            unit: "Dacyn",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_54_1",
        on: "turn_refresh",
        once: false,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 1,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: "1,4",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.status.poisoned",
                value: "yes",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_55_2",
        on: "side_turn_end",
        once: false,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 1,
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            side: "1,4",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.status.poisoned",
                value: "yes",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_56",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Ugh, the fumes from this swamp are horrific! I can barely see my nose and some of the men have started collapsing from sickness. I don’t think we can march much deeper."),
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("We have already marched much too far eastward. We should now head northwest and try to reach Wesnoth’s northern river outpost. Owaec’s soldiers have likely been routed or killed, but the outpost itself will still provide a place to regroup."),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("I had hoped to preserve the lives of our men, yet it seems we have no choice but to confront this infernal sorcerer."),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("This is a very dangerous place for us to fight. We must stay away from this swamp’s vapours, lest we become poisoned. And we should be cautious when venturing forth; there is no telling what lurks invisible under the water."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_58",
        on: "refresh_objective_string",
        once: false,
      },
      {
        tag: "event",
        id: "ev_57",
        on: "side_turn_end",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_side",
            equals: 1,
          },
          {
            tag: "spawn",
            id: "Safyam",
            type: "Dune Burner",
            side: 4,
            x: 16,
            y: 20,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Safyam",
          },
          {
            tag: "spawn",
            id: "Hahid_al-Ali",
            type: "Dune Apothecary",
            side: 4,
            x: 18,
            y: 20,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Hahid_al-Ali",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Hahid_al-Ali",
          },
          {
            tag: "hook",
            name: "command:add_item",
            x: 21,
            y: 20,
            item_name: "",
            image: "items%2Fswamp_herb.png",
          },
          {
            tag: "message",
            speaker: "Dacyn",
            text: _("Quiet, someone approaches..."),
          },
          {
            tag: "message",
            portrait: "units/unknown-unit1.png",
            text: _("It must be here somewhere! I’m telling you, alswdan only grows in swamps, and this is the grandest one on the continent."),
          },
          {
            tag: "message",
            portrait: "units/unknown-unit2.png",
            text: _("And <i>I’m</i> telling <i>you</i>, you’re going to get us killed wandering around these northlands! I haven’t seen home in years! Your ‘easy money’ expedition has already led us far-too-far astray from the dunes."),
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 17,
            y: 20,
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "17,19",
            radius: 4,
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Hail, strangers! Are you friend or foe? What brings you to this foul swamp?"),
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Ah, natives! Perhaps you can help us! I am Hahid al-Ali, herbalist extraordinaire, and this is my assistant Safyam. We’ve journeyed to your lands seeking the rare gwza-alswdan plant."),
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Why, there’s one now! Safyam, if you would."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Safyam",
            x: 20,
            y: 19,
          },
