                value: "sw",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Chantal",
            text: _("Deoran, are you sure you won’t reconsider staying in the Lintanir? What Elende said..."),
          },
          {
            tag: "message",
            speaker: "Deoran",
            text: _("My duty comes first, always. Would you truly want me any other way, Chantal?"),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("Deoran, it has been a pleasure to have you with us these years. And Delfador, I hope to someday say the same of you as well. Elende seems to think highly of you, and that means a great deal to me and my people. Should either of you ever find yourselves searching for a home away from Wesnoth, you will always be welcome with us."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Kalenz",
            x: 36,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            unit: "Kalenz",
          },
          {
            tag: "hook",
            name: "command:scenario_move",
