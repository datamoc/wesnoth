            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22canrecruit%22%3A%22yes%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%22side%22%3A%223%2C4%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
