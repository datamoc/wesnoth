            image: "items%2Fgohere.png",
          },
          {
            tag: "message",
            speaker: "Hahid al-Ali",
            text: _("Well I intend to cross first! Gold’s no good if I die before I can spend it! I’m not about to sacrifice myself to save you bunch of barbarians."),
          },
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("Everyone, get moving! Anyone left behind on this side of the bridge will surely be killed!"),
          },
          {
            tag: "message",
            speaker: "Addogin",
            text: _("I’m gettin’ too old for this life..."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("All units <b>(including non-recalled units!)</b> left behind will be lost."),
