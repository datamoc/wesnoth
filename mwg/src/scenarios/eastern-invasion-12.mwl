        id: "ev_82",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Gweddry",
            text: _("I can hardly believe it! We didn’t need to destroy the bridge after all."),
          },
          {
            tag: "message",
            speaker: "Owaec",
            text: _("Huzzah, a glorious victory in the name of the Clans! Man will never flee from orc and drake; we have taught these northerners not to trifle with Wesnoth!"),
          },
