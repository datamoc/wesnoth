        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            text: _("I see troops coming from the south! It must be that our army has beaten these elves and humans and will now help us crush these remaining elves!"),
          },
          {
            tag: "message",
            text: _("Our defenses are stretched thin. Men, prepare to face another orcish attack!"),
          },
          {
            tag: "message",
            text: _("The North Elves still stand. Prepare for battle!"),
          },
        ],
