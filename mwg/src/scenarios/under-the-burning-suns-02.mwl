            value: 0,
          },
        ],
      },
      {
        tag: "event",
        id: "if_46",
        on: "branch_if_46",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "ghost_spawn_locs.length",
            greater_than: 0,
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghosts_per_unit",
            value: "$($ghost_spawn_locs.length / 3)",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghosts_per_turn",
            value: "$(($turn_number / 21) + 2)",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghost_limit",
            value: "$($max_ghosts - $ghosts_already_spawned)",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghosts",
            value: "$(min([$ghosts_per_unit, $ghosts_per_turn, $ghost_limit]))",
            mode: "value",
          },
          {
            tag: "hook",
            name: "command:set_variable_rand",
            variable: "random",
            values: "0..$($ghost_spawn_locs.length - 1)",
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "spawn",
            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22variable%22%3A%22spawn%22%2C%22terrain%22%3A%22Hd%5E*%2C%20Dd%5E*%2C%20Ds%5E*%2C%20Rr%5E*%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent_location%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%22x%22%3A%22%24ghost_spawn_locs%5B%24random%5D.x%22%2C%22y%22%3A%22%24ghost_spawn_locs%5B%24random%5D.y%22%2C%22radius%22%3A%228%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "set_variable",
            name: "_mwg_repeat_8",
            value: 0,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "_mwg_repeat_8",
                less_than: "$ghosts",
              },
              {
                tag: "hook",
                name: "command:set_variable_rand",
                variable: "random",
                values: "0..$($spawn.length - 1)",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "ghosts_already_spawned",
                value: 1,
                mode: "add",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "_mwg_repeat_8",
                value: 1,
                mode: "add",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "ghosts_talk",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_45",
        on: "new_turn",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "variable",
                name: "ghosts_already_spawned",
                less_than: "$max_ghosts",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "ghost_spawn_locs",
            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22variable%22%3A%22ghost_spawn_locs%22%2C%22terrain%22%3A%22Hd%5E*%2C%20Dd%5E*%2C%20Ds%5E*%2C%20Rr%5E*%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22filter_adjacent_location%22%2C%22attributes%22%3A%7B%22count%22%3A%225%2C6%22%2C%22adjacent%22%3A%22n%2Cne%2Cse%2Cs%2Csw%2Cnw%22%2C%22terrain%22%3A%22Hd%5E*%2C%20Dd%5E*%2C%20Ds%5E*%2C%20Rr%5E*%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "hook",
