      {
        tag: "event",
        id: "ev_52",
        on: "ghosts_talk",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("You come and rise again, spirits? Have we not defeated you before?"),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("These lost souls cannot hold onto anything but memories of lives long gone. They will rise to plague us again, night after night."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_53",
        on: "ghosts_leave",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Flee, you craven spirits, and leave us in peace!"),
