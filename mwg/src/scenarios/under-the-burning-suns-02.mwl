            event: "branch_if_46",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_47",
        on: "ghosts_talk",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Garak",
            text: _("The sands are haunted with the spirits of tortured souls long since dead. At dusk they rise again, and during the Long Dark they can be particularly nasty. They disappear again at dawn, but personally I prefer the heat of the day to the horrors of the night."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("The combination of the heat of the day and the rising undead make dusk a particularly dangerous time of day."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_49",
        on: "branch_if_49",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "ghosts_killed",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghosts_killed",
            value: 1,
            mode: "add",
          },
        ],
      },
      {
        tag: "event",
        id: "if_50",
        on: "branch_if_50",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "ghosts_killed",
            not_equals: "",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "ghosts_already_spawned",
            value: "$max_ghosts",
            mode: "value",
          },
          {
            tag: "set_variable",
            name: "ghosts_killed",
            value: 0,
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "ghosts_leave",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_48",
        on: "die",
        once: false,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22role%22%3A%22LostSoul%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:fire_event",
