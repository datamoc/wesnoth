                value: "$(($unit_type_table_i + 1) % $unit_type_table.length)",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "_mwg_random_remaining_2",
                value: -1,
                mode: "add",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Garak",
            text: _("Do you want us to fight? We can still avoid them, but they are between us and the next oasis."),
          },
        ],
      },
      {
        tag: "event",
        id: "scorpion_ambush",
        on: "moveto",
        once: true,
        children: [
          {
