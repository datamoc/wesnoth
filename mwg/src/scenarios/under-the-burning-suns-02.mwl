      {
        tag: "event",
        id: "take_holy_water",
        on: "moveto",
        once: false,
        children: [
          {
            tag: "filter",
            side: 1,
            x: "$x1",
            y: "$y1",
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22event%22%2C%22attributes%22%3A%7B%22name%22%3A%22moveto%22%2C%22id%22%3A%22take_holy_water%22%2C%22delayed_variable_substitution%22%3A%22no%22%2C%22first_time_only%22%3A%22no%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22message%22%2C%22attributes%22%3A%7B%22speaker%22%3A%22unit%22%2C%22message%22%3A%22Should%20I%20take%20the%20holy%20water%3F%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22option%22%2C%22attributes%22%3A%7B%22label%22%3A%22Yes%2C%20I%E2%80%99ll%20take%20it.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22command%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22object%22%2C%22attributes%22%3A%7B%22id%22%3A%22PureWater%22%2C%22name%22%3A%22Holy%20Water%22%2C%22image%22%3A%22items%2Fholy-water.png%22%2C%22description%22%3A%22This%20water%20will%20make%20your%20melee%20weapons%20%3Ci%3Earcane%3C%2Fi%3E%2C%20and%20thus%20especially%20powerful%20against%20the%20undead.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22attack%22%2C%22range%22%3A%22melee%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22set_specials%22%2C%22attributes%22%3A%7B%22mode%22%3A%22append%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22damage_type%22%2C%22attributes%22%3A%7B%22id%22%3A%22arcane_damage%22%2C%22name%22%3A%22arcane%22%2C%22description%22%3A%22This%20attack%20combines%20the%20arcane%20type%20with%20the%20type%20of%20weapon%20used%20so%20that%20resistance%20to%20the%20arcane%20type%20does%20not%20penalize%20the%20user.%22%2C%22special_note%22%3A%22This%20unit%20can%20use%20the%20arcane%20type%20when%20the%20opponent%20is%20particularly%20sensitive%20to%20it%20in%20relation%20to%20the%20weapon%20on%20which%20it%20is%20applied.%22%2C%22alternative_type%22%3A%22arcane%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22remove_item%22%2C%22attributes%22%3A%7B%22x%22%3A%22%24x1%22%2C%22y%22%3A%22%24y1%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22remove_event%22%2C%22attributes%22%3A%7B%22id%22%3A%22take_holy_water%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22option%22%2C%22attributes%22%3A%7B%22label%22%3A%22No%2C%20I%20think%20someone%20else%20should%20take%20it.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22command%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22allow_undo%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "dialogue",
            children: [
              {
                tag: "message",
                text: _("Should I take the holy water?"),
              },
              {
                tag: "choice",
                text: _("Yes, I’ll take it."),
                event: "take_holy_water_opt0",
              },
              {
                tag: "choice",
                text: _("No, I think someone else should take it."),
                event: "take_holy_water_opt1",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_40",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Thorn%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("I surrender! I mean we surrender. Just please don’t kill me."),
          },
          {
            tag: "message",
            text: _("Please, have mercy on us. We’re just trying to survive in this horrible land."),
          },
          {
            tag: "hook",
            name: "command:add_item",
            x: "$x1",
            y: "$y1",
            item_name: "",
            image: "items%2Fholy-water.png",
          },
          {
            tag: "message",
            text: _("Here, take this vial of holy water. You’ll need it with all the undead around."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("I will take this vial, in exchange for your life. But leave these lands, and never darken our path again. Or I will show you no mercy."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("It’s Holy Water. When anointed on a weapon it makes it deadly to magical creatures. Vials such as these are rare and valuable. We should choose carefully who will use it."),
          },
          {
            tag: "hook",
            name: "command:kill_unit",
            filter: "%7B%22tag%22%3A%22kill%22%2C%22attributes%22%3A%7B%22side%22%3A%222%22%2C%22animate%22%3A%22no%22%2C%22fire_event%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "hook",
            name: "command:show_objectives",
          },
        ],
      },
