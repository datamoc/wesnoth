                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22x%22%3A%2229%22%2C%22y%22%3A%2262%22%2C%22radius%22%3A%223%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_wml%22%2C%22attributes%22%3A%7B%22usage%22%3A%22scout%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("Scorpions! We must have stumbled across a nest of them."),
          },
          {
            tag: "hook",
            name: "command:set_variables",
            payload: "%7B%22name%22%3A%22unit_type_table%22%2C%22mode%22%3A%22replace%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22split%22%2C%22attributes%22%3A%7B%22list%22%3A%22Sand%20Scuttler%22%2C%22key%22%3A%22type%22%2C%22separator%22%3A%22%2C%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "set_variable",
            name: "unit_type_table_i",
            value: 0,
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "_mwg_random_locations_3",
            filter: "%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22x%22%3A%2229%22%2C%22y%22%3A%2262%22%2C%22radius%22%3A%222%22%2C%22include_borders%22%3A%22no%22%7D%2C%22children%22%3A%5B%5D%7D",
          },
          {
            tag: "set_variable",
            name: "_mwg_random_remaining_5",
            value: 7,
          },
          {
            tag: "while",
            children: [
              {
                tag: "condition",
                variable: "_mwg_random_remaining_5",
                greater_than: 0,
              },
