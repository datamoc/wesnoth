            unit: "Zhul",
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: "18-22,19-21,20",
            ys: "8-9,7,10",
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
