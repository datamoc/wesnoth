            children: [
              {
                tag: "set_variable",
                name: "distance",
                value: 0,
              },
              {
                tag: "while",
                test: "wml_condition_tree('tree=%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22location.length%22%2C%22less_than%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22variable%22%2C%22attributes%22%3A%7B%22name%22%3A%22distance%22%2C%22less_than_equal_to%22%3A%226%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D')",
