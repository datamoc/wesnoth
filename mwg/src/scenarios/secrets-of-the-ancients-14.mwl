      {
        tag: "event",
        id: "ev_9",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 2,
          },
        ],
      },
      {
        tag: "event",
        id: "ev_10",
        on: "attack",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22id%22%3A%22Krongk%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Krongk",
            text: _("They’re attacking me!"),
          },
          {
            tag: "message",
            speaker: "Vok-Hroog",
            text: _("Yeah, yeah."),
          },
          {
            tag: "hook",
            name: "command:remove_object",
            object_id: "freeze_unit",
            id: "Krongk",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("We have crossed into the north. The dwarven kingdom of Knalga lies straight ahead."),
          },
          {
            tag: "message",
            speaker: "Shynal",
            text: _("Now I’m really far from home. I’ve never been north of the river before. I hope I get to see some dwarves!"),
          },
          {
            tag: "message",
            speaker: "Vok-Hroog",
            text: _("I claim this territory in the name of Krag-Ubor, the ruler of all true orcs! Leave now, Ishnak, or face the combined wrath of the five tribes."),
          },
          {
            tag: "message",
            speaker: "Rod-Ishnak",
            text: _("I arrived first, Hroog. It’s mine!"),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("This could be trouble."),
          },
          {
            tag: "message",
            speaker: "Ras-Tabahn",
            text: _("Many orcs are decent sorts (<i>cough, cough</i>). I fought alongside Krag-Ubor once, who the farther orc just mentioned."),
          },
          {
            tag: "message",
            speaker: "Vok-Hroog",
            text: _("Wait who’s that?"),
          },
          {
            tag: "message",
            speaker: "Rod-Ishnak",
            text: _("Wizards and deaders just like from back home! I <i>hate</i> those! I suggest a contest. Whoever kills the most wizards and skeletons and stuff takes this territory and all the human slaves."),
          },
          {
            tag: "message",
            speaker: "Vok-Hroog",
            text: _("Huh. Fine. That sounds like good sport."),
          },
          {
            tag: "message",
            speaker: "Krongk",
            text: _("I declare this competition official. I will support the claim of the winner."),
          },
          {
            tag: "message",
            speaker: "Vok-Hroog",
            text: _("Yeah, yeah."),
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("I did say this was trouble."),
          },
          {
            tag: "message",
            speaker: "Shynal",
            text: _("But we’ll win, won’t we?"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_12",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Ardonna%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Ardonna",
            text: _("No, no, NO, <i><b>NO</b></i>!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Ardonna%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "lose",
          },
        ],
      },
      {
