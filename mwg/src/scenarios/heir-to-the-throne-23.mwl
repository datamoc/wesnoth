                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22type%22%3A%22Yeti%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("They truly are real! This Yeti would be a majestic sight, if not for how determined it is to beat our heads in with its bare fists!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_73",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Yeti%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("Fantastic, the Yeti is defeated! Let me take a look at that tongue..."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Jeniver",
            x: "$unit.x",
            y: "$unit.y",
            raw: "yes",
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("Yes, yes, now one dash of mugwort... essence of skyworm, heated under a cold flame... and... and— And golden transmutation is achieved!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gold.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "message",
            speaker: "Konrad",
            portrait: "portraits/konrad-$konrad_portrait_base-glad.webp",
            text: _("Golden transmutation? You mean you can transmute other substances into gold? That’s an incredible accomplishment!"),
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("Err, well, no, not quite. It’s more of a... distillation — yes, a process for refining and extracting more value out of your existing coin. But “transmutation” is a much more exciting word for alchemists. And etymology aside, my discovery will certainly help boost your income!"),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Jeniver",
            x: 15,
            y: 12,
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Konrad",
          },
          {
            tag: "hook",
            name: "command:remove_object",
            object_id: "disable_transmutation",
            id: "Jeniver",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "yeti_killed",
