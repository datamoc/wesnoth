                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22type%22%3A%22Giant%20Spider%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
