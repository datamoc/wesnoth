                value: "no",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 250,
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("Ugh... well, so much for my treatise on the life-extending properties of venoms. Ah, well— well, setbacks are inevitable! At least the toxin, properly prepared, may make for a useful weapon."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            unit: "Jeniver",
            x: 15,
            y: 12,
          },
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22%22%2C%22effects%22%3A%5B%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "Konrad",
          },
          {
            tag: "hook",
            name: "command:remove_object",
            object_id: "disable_blowgun",
            id: "Jeniver",
          },
          {
            tag: "hook",
            name: "command:set_variable_dynamic",
            variable: "spider_killed",
            value: "yes",
            mode: "value",
