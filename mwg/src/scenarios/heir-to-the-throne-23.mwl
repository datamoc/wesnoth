          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_defender_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22type%22%3A%22Giant%20Spider%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Look out! That giant spider is furious, and it’s coming right at us!"),
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("Oh, come now, I’m sure it just wants to make friends. No need for violence; to get what I need, all you need to do is lever apart the front incisors and gently massage the venom sacks. I’m sure the spider won’t mind."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_71",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22type%22%3A%22Giant%20Spider%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("You have the spider venom! Fantastic! I shall just add a distillation of euphoria... a dash of elf-hair, a few other bits and bobs..."),
          },
          {
            tag: "hook",
            name: "command:scenario_move",
            id: "Jeniver",
            x: "$unit.x",
            y: "$unit.y",
            raw: "yes",
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("And... and! And my elixir of immortality is ready!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "potion.ogg",
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 3000,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "poison.ogg",
          },
          {
            tag: "hook",
            name: "command:harm_unit",
            amount: 8,
            poisoned: "yes",
            delay: 0,
            kill: "no",
            animate: "yes",
            filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Jeniver%22%7D%2C%22children%22%3A%5B%5D%7D",
            id: "Jeniver",
          },
          {
            tag: "message",
            speaker: "Jeniver",
            text: _("Blarghh!!!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "poison.ogg",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Jeniver",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
