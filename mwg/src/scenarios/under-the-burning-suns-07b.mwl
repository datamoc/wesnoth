      },
      {
        tag: "event",
        id: "if_5",
        on: "branch_if_5",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "ally_id",
            equals: "Grog",
          },
          {
            tag: "message",
            speaker: "Spiritual Advisor",
            text: _("We may be able to help you find a way back to the sunlit lands. In our temples we do keep records of the past. We have not walked above the earth for many many generations, not since the darkness drove us underground. But we are masters of the underground lands, and we have explored many tunnels. Recently one of our scouts found a path that leads north back to the sunlit lands, I think it may be the way you are trying to go. In reward for your achievements, we will help you. Grog has volunteered to protect you and lead you back to the sunlight lands."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_6",
        on: "branch_if_6",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "ally_id",
            not_equals: "Grog",
          },
          {
            tag: "message",
            speaker: "Spiritual Advisor",
            text: _("We may be able to help you find a way back to the sunlit lands. In our temples we do keep records of the past. We have not walked above the earth for many many generations, not since the darkness drove us underground. But we are masters of the underground lands, and we have explored many tunnels. Recently one of our scouts found a path that leads north back to the sunlit lands, I think it may be the way you are trying to go. In reward for your achievements, we will help you. Nog has volunteered to protect you and lead you back to the sunlight lands."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_7",
        on: "branch_if_7",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "saved_grog",
            equals: "yes",
          },
          {
            tag: "message",
            speaker: "Grog",
            text: _("You saved Grog’s life. Grog still owe you a debt of thanks. In return Grog will protect little elves and show them the way back to lighted lands."),
          },
          {
            tag: "message",
            speaker: "Nog",
            text: _("You rescued Nog’s brother, and he died like a warrior in battle, not like a coward in chains. Nog is very grateful. You proved yourselves to be brave strong warriors, and Nog will help you find way back to lighted lands."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_8",
        on: "branch_if_8",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "saved_grog",
            not_equals: "yes",
          },
          {
            tag: "message",
            speaker: "Nog",
            text: _("You did trolls big service. Nog like to wander in tunnels, and Chief say that he knows the upper tunnels the best. Nog want to help elves so even though he not want to leave battle, he agrees to show elves way back to lighted lands."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_9",
        on: "branch_if_9",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "ally_id",
            equals: "Grog",
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Thank you very much for your help. We were worried about getting lost in all these twisting tunnels. And we would be honored to have you come with us, Grog."),
          },
        ],
      },
      {
        tag: "event",
        id: "if_10",
        on: "branch_if_10",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "ally_id",
            not_equals: "Grog",
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("Thank you very much for your help. We were worried about getting lost in all these twisting tunnels. And we would be honored to have you come with us, Nog."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_4",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("It is clear that this chamber used to be quite ornately decorated, but almost all of it has been destroyed, revealing a stone and dirt floor. What remains is a large stone throne, which has been covered with skulls and animal skins and bright paint. The walls were once covered with frescoes and dwarven runes, but several trolls are busy chipping them off. The floor was once tiled in dark slate, but only two small patches of tiles remain around the two chairs in this chamber. You’re surprised to see that small tile path running up the center of the chamber has been left untouched. It leads to a small stone chair facing the large throne."),
          },
          {
            tag: "message",
            speaker: "Great Leader Darmog",
            text: _("I, Great Leader Darmog, greet you, Kaleh."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("I Kaleh, leader of the Quenoth Elves, thank you for meeting with me."),
          },
          {
            tag: "message",
            speaker: "Great Leader Darmog",
            text: _("On behalf of all trolls, Darmog thank you for great victory over the dwarves. You have helped drive back the nasty dwarves and given us time to strengthen our defenses. Us trolls not always enemies of dwarves. Until recently we not have much contact with small people. But dwarves invade our tunnels, defile our holy places and kill our women and young. Dwarf not care about anything except gold and pretty gems. The shamans say that the spirits of our kin cry out for vengeance and Darmog will not rest until every dwarf is dead!"),
          },
          {
            tag: "message",
            speaker: "Spiritual Advisor",
            text: _("But I am curious, we do not know of your kind. We thank you for your help, but who are you and why do you come down here with so many of your people?"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("It’s a long story, but we come from the south, where we lived above ground in the desert. Our village was destroyed, and I am leading my people on a journey to find a new home. Our god Eloh appeared to me in a vision, and told me to go north, but when we came to the mountains she said I should go under them instead of trying to cross the snowy peaks. We do not want to live down here, we are just trying to find a way to the other side of the mountains."),
          },
          {
            tag: "message",
            speaker: "Great Leader Darmog",
            text: _("Darmog has never been above ground, but Darmog understand your story. A leader must protect and care for his people. Every people deserve to find their own home. If we can help you we will."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_5",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_6",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_7",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_8",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_9",
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "branch_if_10",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11_opt0",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:apply_object",
            object: "%7B%22id%22%3A%22FlamingSword%22%2C%22effects%22%3A%5B%7B%22applyTo%22%3A%22attack%22%2C%22range%22%3A%22melee%22%7D%5D%2C%22abilities%22%3A%5B%5D%7D",
            id: "FlamingSword",
            side: 1,
          },
          {
            tag: "message",
            text: _("I will wield this blade proudly, and whenever I look upon it I shall remember you, Elyssa."),
          },
          {
            tag: "message",
            speaker: "Great Leader Darmog",
            text: _("And now Darmog think you should be off as soon as possible. The dwarves are sneaky, they retreat today but may attack again tomorrow. The sooner you leave the safer you will be."),
          },
          {
            tag: "message",
            speaker: "Nym",
            text: _("This is a marvelous city, but I for one can’t wait to feel the sun upon my face again and the wind in my hair."),
          },
          {
            tag: "hook",
            name: "command:config_side",
            side: 1,
            gold: "$stored_side_1.gold",
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_11_opt1",
        once: true,
      },
      {
        tag: "event",
        id: "ev_11",
        on: "moveto",
        once: false,
        children: [
          {
            tag: "filter",
            side: 1,
            x: 9,
            y: 9,
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
