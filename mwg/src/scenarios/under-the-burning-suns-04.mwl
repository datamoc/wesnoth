            unit: "u_10",
          },
          {
            tag: "message",
            speaker: "Orac",
            text: _("Come forth, creatures of the lake! Fulfill the oaths you have made and help us drive these hated creatures from our lands."),
          },
          {
            tag: "message",
            speaker: "Scylla",
            text: _("Yesss, we remember the oath... Sssslay them all!"),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "moveto",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Panok%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_vision%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Panok",
            text: _("These elves are stronger than we thought. Send for more reinforcements!"),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("How can he move that fast? He is faster than any goblin rider I have ever seen. It’s almost unnatural."),
          },
        ],
      },
      {
