            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$unit_moved_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%2C%22race%22%3A%22quenoth%2Celf%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_location%22%2C%22attributes%22%3A%7B%22time_of_day_id%22%3A%22underground%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22id%22%3A%22Kaleh%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "$unit.id",
            text: _("Ugh! These tunnels are pitch black! It’s as bad as fighting in a moonless night, and it stinks of orc filth. I can hardly think of a place I would less like to go into."),
          },
          {
            tag: "message",
            speaker: "Kaleh",
            text: _("We have no choice. We cannot cross over these mountains, so we must go beneath them. If the orcs skulk in their tunnels and block our way, we must enter their dark places and fight them, no matter what the conditions."),
          },
          {
            tag: "message",
            speaker: "Zhul",
            text: _("Remember, Kaleh, it’s nasty fighting underground. We will be at a disadvantage against orcs and other things that prefer the darkness."),
          },
          {
            tag: "message",
            speaker: "Elyssa",
            text: _("Also, any time you find a particularly tough orc blocking a passage, my fireballs can blast him quick enough."),
          },
        ],
      },
