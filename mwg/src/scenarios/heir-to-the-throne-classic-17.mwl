            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22variable%22%3A%22potential_locs%22%2C%22terrain%22%3A%22Xu%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22U*%2C%20Re%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22filter_adjacent_location%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22U*%2C%20Re%22%2C%22count%22%3A%224-5%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%2C%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22x%22%3A%22%24sceptre_x%22%2C%22y%22%3A%22%24sceptre_y%22%2C%22radius%22%3A%225%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22not%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22Ql%22%2C%22radius%22%3A%225%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
