      {
        tag: "event",
        id: "ev_5",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Konrad",
            text: _("The Sceptre must be getting close now! Where shall we go?"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("We cannot explore this much area by ourselves, especially if we are beset by the denizens of these caves. We must ask our dwarven allies to help search the caves with us."),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("Yes, I feel it is near here! We must search for it carefully."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "rumble.ogg",
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 4,
            y: -1,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -11,
            y: -1,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 4,
            y: 4,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -1,
            y: -11,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -1,
            y: 4,
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "rumble.ogg",
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 4,
            y: -1,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -11,
            y: -1,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 4,
            y: 4,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -1,
            y: -11,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -1,
            y: 4,
          },
          {
            tag: "message",
            speaker: "Li'sar",
            text: _("An earthquake! We’ll be trapped!"),
          },
          {
            tag: "message",
            speaker: "Kalenz",
            text: _("No, not an earthquake, but I feel it too. Something is... aware... of us."),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            text: _("Aware? Who? Delfador, what does he mean?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("The Sceptre... the earth... the molten lava... the fire... the air around us... everything. It calls out to the heir — I can barely hold it back in my mind. It was forged here, not far north of where we now stand. The sheer power of it!"),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "rumble.ogg",
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 4,
            y: -1,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -11,
            y: -1,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: 4,
            y: 4,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -1,
            y: -11,
          },
          {
            tag: "hook",
            name: "command:scroll_to",
            x: -1,
            y: 4,
          },
          {
            tag: "message",
            speaker: "Konrad",
            text: _("Where? Where is it?"),
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("North. More than that, I cannot tell."),
          },
          {
            tag: "message",
            speaker: "Li'sar",
            text: _("Konrad, as promised, here is my purse, full of gold."),
          },
          {
            tag: "hook",
            name: "command:play_sound",
            file: "gold.ogg",
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("You receive 300 pieces of gold!"),
          },
          {
            tag: "gold",
            side: 1,
            amount: 300,
          },
          {
            tag: "hook",
            name: "command:store_locations",
            variable: "sceptre_vicinity",
            filter: "%7B%22tag%22%3A%22store_locations%22%2C%22attributes%22%3A%7B%22terrain%22%3A%22Xu%2CQxu%2CQl%22%2C%22variable%22%3A%22sceptre_vicinity%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22and%22%2C%22attributes%22%3A%7B%22location_id%22%3A%22sceptre%22%2C%22radius%22%3A%223%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22or%22%2C%22attributes%22%3A%7B%22location_id%22%3A%22sceptre%22%2C%22radius%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D",
          },
          {
            tag: "foreach",
            variable: "sceptre_vicinity",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_terrain",
                terrain: "Uu",
                cells: "$this_item.x,$this_item.y",
              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_terrain",
            terrain: "Uu^Ii",
            cells: "",
          },
          {
            tag: "message",
            speaker: "Delfador",
            text: _("I think... I think if I were to concentrate a bit I could tell you where it is."),
          },
          {
            tag: "message",
            speaker: "narrator",
            portrait: "wesnoth-icon.png",
            text: _("If Delfador rests, he can concentrate on the location of the Sceptre of Fire."),
          },
        ],
      },
      {
