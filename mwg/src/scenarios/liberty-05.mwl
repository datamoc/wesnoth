            children: [
              {
                tag: "hook",
                name: "command:set_variables",
                payload: "%7B%22name%22%3A%22traits_without_quick%22%2C%22mode%22%3A%22replace%22%2C%22to_variable%22%3A%22%22%2C%22children%22%3A%5B%7B%22tag%22%3A%22value%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22strong%22%2C%22male_name%22%3A%22strong%22%2C%22female_name%22%3A%22female%5Estrong%22%2C%22help_text%22%3A%22%3Ci%3EStrong%3C%2Fi%3E%20units%20do%201%20more%20damage%20for%20every%20successful%20strike%20in%20melee%20combat%2C%20and%20have%201%20additional%20hitpoint.%5Cn%5Cn_%20While%20useful%20for%20any%20close-combat%20unit%2C%20strong%20is%20most%20effective%20for%20units%20who%20have%20a%20high%20number%20of%20swings%20such%20as%20the%20elvish%20fighter.%20Strong%20units%20can%20be%20very%20useful%20when%20a%20tiny%20bit%20of%20extra%20damage%20is%20all%20that%20is%20needed%20to%20turn%20a%20damaging%20stroke%20into%20a%20killing%20blow.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22attack%22%2C%22range%22%3A%22melee%22%2C%22increase_damage%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22increase_total%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22value%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22resilient%22%2C%22male_name%22%3A%22resilient%22%2C%22female_name%22%3A%22female%5Eresilient%22%2C%22help_text%22%3A%22%3Ci%3EResilient%3C%2Fi%3E%20units%20have%20an%20additional%204%20hitpoints%2C%20and%20gain%201%20more%20per%20level.%5Cn%5Cn_%20Resilient%20units%20can%20be%20useful%20at%20all%20stages%20of%20a%20campaign%2C%20and%20this%20is%20a%20useful%20trait%20for%20all%20units.%20Resilient%20is%20often%20most%20helpful%20as%20a%20trait%20when%20it%20occurs%20in%20a%20unit%20that%20has%20some%20combination%20of%20low%20hitpoints%2C%20good%20defense%2C%20or%20high%20resistances.%20Resilient%20units%20are%20especially%20useful%20for%20holding%20strategic%20positions%20against%20opponents.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22increase_total%22%3A%224%22%7D%2C%22children%22%3A%5B%5D%7D%2C%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22hitpoints%22%2C%22times%22%3A%22per%20level%22%2C%22increase_total%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22value%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22fearless%22%2C%22male_name%22%3A%22fearless%22%2C%22female_name%22%3A%22female%5Efearless%22%2C%22description%22%3A%22Fights%20normally%20during%20unfavorable%20times%20of%20day%2Fnight%22%2C%22help_text%22%3A%22Aversion%20to%20light%20and%20dark%20holds%20no%20sway%20over%20these%20brave%20individuals.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22fearless%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%2C%7B%22tag%22%3A%22value%22%2C%22attributes%22%3A%7B%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22trait%22%2C%22attributes%22%3A%7B%22id%22%3A%22intelligent%22%2C%22male_name%22%3A%22intelligent%22%2C%22female_name%22%3A%22female%5Eintelligent%22%2C%22help_text%22%3A%22%3Ci%3EIntelligent%3C%2Fi%3E%20units%20require%2020%25%20less%20experience%20than%20usual%20to%20advance.%5Cn%5Cn_%20Intelligent%20units%20are%20very%20useful%20at%20the%20beginning%20of%20a%20campaign%20as%20they%20can%20advance%20to%20higher%20levels%20more%20quickly.%20Later%20in%20campaigns%20Intelligent%20is%20not%20quite%20as%20useful%20because%20the%20%3Ci%3EAfter%20Maximum%20Level%20Advancement%3C%2Fi%3E%20(AMLA)%20is%20not%20as%20significant%20a%20change%20as%20advancing%20a%20level.%20If%20you%20have%20many%20%E2%80%98maximum%20level%E2%80%99%20units%20you%20may%20wish%20to%20recall%20units%20with%20more%20desirable%20traits.%22%7D%2C%22children%22%3A%5B%7B%22tag%22%3A%22effect%22%2C%22attributes%22%3A%7B%22apply_to%22%3A%22max_experience%22%2C%22increase%22%3A%22-20%25%22%7D%2C%22children%22%3A%5B%5D%7D%5D%7D%5D%7D%5D%7D",
