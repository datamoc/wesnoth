                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Baran%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("It is over, I am vanquished."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_16",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Arvith%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("All is lost now that I am dead..."),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_17",
        on: "time_over",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Arvith",
            text: _("I don’t think we can rescue anyone from these villages. It is too late."),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("I was too weak to protect these people. Oh, why did this happen to me?!"),
          },
        ],
      },
    ],
  },
]
