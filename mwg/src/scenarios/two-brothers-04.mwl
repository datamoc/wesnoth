        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:recall_unit",
            id: "Baran",
            unit: "Baran",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            id: "Baran",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "hook",
                name: "command:set_variable_dynamic",
                variable: "this_item.facing",
                value: "ne",
                mode: "value",
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
        ],
      },
      {
        tag: "event",
        id: "ev_6",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Arvith",
            text: _("There. The village is just across those hills, and already I see men coming to greet us!"),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("No, they are fleeing from something. We must find out what is happening over there!"),
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("Men! Ready your arms!"),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("We should find Reeve Hoban. Maybe he knows what is going on here."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "sighted",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_sighted_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Tairach%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_seer_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            text: _("We’re almost there!"),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("That warlord! It’s..."),
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("Yes, I’d know that face anywhere. Especially after what you did to it."),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("The warlord from Toen Caric."),
          },
          {
            tag: "message",
            speaker: "Tairach",
            text: _("You! The mage who scarred me with fire! KILL THEM!"),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("Let’s finish what we started, brother."),
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("Aye. I’ll be the right arm, and you’ll be the left. Let’s go!"),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "defeat_enemy_leader_objectives",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_8",
        on: "sighted",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_sighted_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22side%22%3A%223%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_seer_id",
                filter: "%7B%22tag%22%3A%22filter_second%22%2C%22attributes%22%3A%7B%22side%22%3A%221%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Reeve Hoban",
            text: _("I am glad to see you returned."),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("No gladder than I am to be here. But what has happened to Maghre?"),
          },
          {
            tag: "message",
            speaker: "Reeve Hoban",
            text: _("Soon after you departed we were beset by orcs. With half the men of Maghre gone, we could not stop them."),
          },
          {
            tag: "message",
            speaker: "Reeve Hoban",
            text: _("The orcish warlord aims to enslave us. We will not be able to hold out for much longer."),
          },
          {
            tag: "message",
            speaker: "Reeve Hoban",
            text: _("Have a care, his men are fell fighters and have killed many. Very few remain who can bear arms, but I will send them to aid you in battle."),
          },
          {
            tag: "hook",
            name: "command:fire_event",
            event: "defeat_enemy_leader_objectives",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_9",
        on: "defeat_enemy_leader_objectives",
        once: true,
      },
      {
        tag: "event",
        id: "ev_10",
        on: "attack",
        once: true,
        children: [
          {
