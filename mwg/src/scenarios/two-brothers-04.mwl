              },
            ],
          },
          {
            tag: "hook",
            name: "command:set_achievement",
            id: "baran_returns",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_14",
        on: "enemies_defeated",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Arvith",
            text: _("It is finished. We’ve defeated him at last. It was good to have you at my side, Baran."),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("So much has been destroyed. It will be difficult to repair all that the orcs and undead have wrecked. And they could come again."),
          },
          {
            tag: "message",
            speaker: "Arvith",
            text: _("I must go back to earning my living. But you have my word, little brother; if you are beset again, I will come."),
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
