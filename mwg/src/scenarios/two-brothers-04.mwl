      {
        tag: "event",
        id: "ev_12",
        on: "battle_text",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Tairach",
            text: _("Today, you shall pay for disfiguring my face, mage!"),
          },
          {
            tag: "message",
            speaker: "Baran",
            text: _("I have already paid with the lives of my men at Toen Caric. It is time I righted that mistake and finished this once and for all."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_13",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Tairach%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
