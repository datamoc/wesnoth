            file: "breaking_the_chains.ogg",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_2",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
            side: 1,
            cells: "",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_3",
        on: "prestart",
        once: true,
        children: [
          {
            tag: "hook",
            name: "command:capture_village",
