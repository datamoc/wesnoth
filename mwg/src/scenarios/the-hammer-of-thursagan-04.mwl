      {
        tag: "event",
        id: "ev_37",
        on: "victory_cutscene",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Do you hear that, Angarthing? There is shouting from the north."),
          },
          {
            tag: "hook",
            name: "command:delay",
            time: 500,
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 17,
            ys: 0,
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "17,0",
            radius: 2,
            multiturn: "no",
          },
          {
            tag: "hook",
            name: "command:clear_shroud",
            side: 1,
            xs: 16,
            ys: 2,
          },
          {
            tag: "hook",
            name: "command:lift_fog",
            side: 1,
            cells: "16,2",
            radius: 1,
            multiturn: "no",
          },
          {
            tag: "spawn",
            id: "Ratheln",
            type: "Red Mage",
            side: 4,
            x: 18,
            y: 0,
          },
          {
            tag: "hook",
            name: "command:spawn_unit",
            unit: "Ratheln",
          },
          {
            tag: "hook",
            name: "command:make_loyal",
            unit: "Ratheln",
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("Hail!"),
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("Hail, dwarves! I am Ratheln. Are you friends or foes?"),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I do not know you, and you have done my kin no harm. I wish no ill upon you."),
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("Then please, help us! My colleagues and I are assailed by a flight of drakes!"),
          },
          {
            tag: "message",
            speaker: "Ratheln",
            text: _("Our fire magic is useless against those fire-breathing monsters. Our camp is not far from here, to the northeast."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Northeast is the way we are traveling. And I’d not leave anyone who needs our help stranded to burn. Lead the way."),
          },
          {
            tag: "hook",
            name: "command:transform_unit",
            side: 4,
            type: "Grounded Gryphon",
            transform_to: "Gryphon Rider",
          },
          {
            tag: "hook",
            name: "command:store_unit",
            variable: "MODIFY_UNIT_store",
            kill: "yes",
            type: "Gryphon Rider",
          },
          {
            tag: "foreach",
            variable: "MODIFY_UNIT_store",
            item: "this_item",
            children: [
              {
                tag: "set_variable",
                name: "this_item.side",
                value: 1,
              },
              {
                tag: "hook",
                name: "command:unstore_unit",
                variable: "this_item",
              },
            ],
          },
          {
            tag: "win",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_38",
        on: "last_breath",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Aiglondur%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I fall!"),
          },
          {
            tag: "lose",
          },
        ],
      },
      {
        tag: "event",
        id: "ev_39",
        on: "die",
        once: true,
        children: [
          {
            tag: "filter_condition",
            children: [
              {
                tag: "predicate",
                name: "wml_filter",
                unit: "$last_dead_id",
                filter: "%7B%22tag%22%3A%22filter%22%2C%22attributes%22%3A%7B%22id%22%3A%22Angarthing%22%7D%2C%22children%22%3A%5B%5D%7D",
              },
            ],
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("Oh no! Without a loremaster we cannot complete our mission!"),
          },
          {
            tag: "lose",
          },
        ],
      },
    ],
  },
