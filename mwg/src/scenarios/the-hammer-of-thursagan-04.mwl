      {
        tag: "event",
        id: "ev_6",
        on: "start",
        once: true,
        children: [
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Behold, the High Pass. By the old maps, we are two months’ journey from Kal Kartha here."),
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("I hear the howling of wolves, and the shrill cries of gryphons. Traveling here may prove dangerous."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("It may also prove useful. The dwarves of yesteryear rode armies of gryphons into battle, but few remain in Knalga today."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("Gryphons here will be wild; unaccustomed to our kind. But perhaps we can train them to accept riders, if we capture them first."),
          },
        ],
      },
      {
        tag: "event",
        id: "ev_7",
        on: "turn",
        once: true,
        children: [
          {
            tag: "condition",
            variable: "turn_number",
            equals: 4,
          },
          {
            tag: "message",
            speaker: "Aiglondur",
            text: _("It is an honor to travel alongside a loremaster, Angarthing. One cannot begin to fathom the secrets of your order."),
          },
          {
            tag: "message",
            speaker: "Angarthing",
            text: _("I keep the Law. I witness the Deeds. Act with honor, Aiglondur."),
          },
        ],
      },
